// The `kairos` command written in Kairós (M16): what each subcommand does, as src/main.rs does it.
// ki.krs (`run`, the standard library from a folder) and kairos.krs (every subcommand, the
// standard library carried in the program) use it.
import "interp.krs"
import "image_read.krs"

fn cli_usage() -> str {
    let lines_ = [
        "Kairós — a language for financial research and AI",
        "",
        "usage:",
        "  kairos run <file.krs> [args...]",
        "                            check and run a program (`args()` gives the arguments)",
        "  kairos check <file.krs>   type-check only",
        "  kairos exec <file.kim> [args...]",
        "                            run the image of a program compiled by the compiler written",
        "                            in Kairós (`kairos run compiler/kc.krs <std> <out> file.krs`)",
        "  kairos repl               interactive session (also: just `kairos`)",
        "  kairos ledger             the holdout ledger: months seen, protocols, holdouts opened",
        "  kairos ledger withdraw <protocol>",
        "                            give up a protocol whose holdout was never opened",
        "  kairos --version",
    ]
    join(lines_, from_codes([10]))
}

// the text without its last line break (eprint adds one)
fn cli_chomp(s: str) -> str {
    if ends_with(s, from_codes([10])) { substr(s, 0, len(s) - 1) } else { s }
}

// a file's name without its folder and without .krs: the program's name in the registry
fn cli_stem(path: str) -> str {
    let parts = split(replace(path, from_codes([92]), "/"), "/")
    let file = parts[len(parts) - 1]
    var last = -1
    for i in 0..len(file) {
        if substr(file, i, 1) == "." { last = i }
    }
    if last > 0 { substr(file, 0, last) } else { file }
}

// the text of a file of the standard library ("<prelude>", "<std/sim.krs>"): the checker's own
// copy, or the file in its folder
fn cli_std_text(ck: Checker, key: str) -> str {
    if contains(ck.std_srcs, key) { return ck.std_srcs[key] }
    if key == "<prelude>" { return read_text(ck.std_dir + "/prelude.krs") }
    read_text(ck.std_dir + "/" + substr(key, 5, len(key) - 6))
}

// A checker with the prelude checked: the standard library from std_dir, or from `srcs` (its files
// by the checker's names) when it is not empty.
fn cli_checker(std_dir: str, srcs: Map[str, str]) -> Checker {
    var ck = new_checker(std_dir)
    ck.std_srcs = srcs
    check_file(inout ck, "<prelude>", cli_std_text(ck, "<prelude>"))
    assert(not ck.failed, "the prelude does not check: " + ck.code + " " + ck.msg)
    ck
}

// The source of each file the checker read (`extra`: what was not read from a file, by its name).
fn cli_sources(ck: Checker, extra: Map[str, str]) -> List[str] {
    var out: List[str] = []
    for f in ck.files {
        if contains(extra, f) {
            out.push(extra[f])
        } else if f == "<prelude>" or starts_with(f, "<std/") {
            out.push(cli_std_text(ck, f))
        } else {
            out.push(read_text(f))
        }
    }
    out
}

// The first error of the checker, as `kairos` writes it.
fn cli_check_error(ck: Checker, srcs: List[str]) -> str {
    let fi = if ck.efile >= 0 and ck.efile < len(srcs) { ck.efile } else { len(srcs) - 1 }
    render_diag_l(ck.code, ck.msg, ck.label, ck.hint, srcs[fi], ck.files[fi], ck.elo, ck.ehi)
}

// `kairos run <file> [args]` (run) and `kairos check <file>`: the exit code.
fn cli_file(base: Checker, path: str, prog_args: List[str], run: bool) -> i64 {
    let src = try_read_text(path)
    if src.1 != "" {
        eprint("cannot read " + path + ": " + src.1)
        return 2
    }
    var ck = base
    ck.imported[norm_path(path)] = true
    check_file(inout ck, path, src.0)
    let none: Map[str, str] = [:]
    if ck.failed {
        eprint(cli_chomp(cli_check_error(ck, cli_sources(ck, none))))
        return 1
    }
    if not run {
        print(path + ": ok")
        return 0
    }
    var st = ki_new(ck, cli_sources(ck, none), prog_args)
    st.prog = cli_stem(path)
    if not ki_run(inout st) {
        eprint(cli_chomp(ki_render(st)))
        return 1
    }
    0
}

// `kairos exec <file.kim> [args]` (src/main.rs exec_cmd): runs the image of a program, on a new
// checker (std_dir, srcs: where the standard library's text is, for messages).
fn cli_exec(std_dir: str, srcs: Map[str, str], path: str, prog_args: List[str]) -> i64 {
    let src = try_read_text(path)
    if src.1 != "" {
        eprint("cannot read " + path + ": " + src.1)
        return 2
    }
    var base = new_checker(std_dir)
    base.std_srcs = srcs
    let r = image_read(base, src.0)
    if r.0 != "" {
        eprint(path + ": " + r.0)
        return 2
    }
    let none: Map[str, str] = [:]
    let known: List[str] = []
    var st = ki_new(r.1, cli_srcs_of(r.1, known, none), prog_args)
    st.prog = cli_stem(path)
    if not ki_run(inout st) {
        eprint(cli_chomp(ki_render(st)))
        return 1
    }
    0
}

// `kairos tokens <file>`: the lexer's tokens, one per line.
fn cli_tokens(path: str) -> i64 {
    let src = try_read_text(path)
    if src.1 != "" {
        eprint("cannot read " + path + ": " + src.1)
        return 2
    }
    let r = lex(src.0)
    if r.0 {
        for t in r.1 { print(token_line(t)) }
    } else {
        print("error " + r.2.code + " " + str(r.2.lo) + " " + str(r.2.hi) + " " + r.2.msg)
        if r.2.hint != "" { print("hint " + r.2.hint) }
    }
    0
}

// `kairos ast <file>`: the syntax tree, one item per line.
fn cli_ast(path: str) -> i64 {
    let src = try_read_text(path)
    if src.1 != "" {
        eprint("cannot read " + path + ": " + src.1)
        return 2
    }
    let r = parse_program(src.0)
    if r.0 {
        for it in r.1 { print(node_line(it)) }
    } else {
        print("error " + r.2.code + " " + str(r.2.elo) + " " + str(r.2.ehi) + " " + r.2.msg)
        if r.2.hint != "" { print("hint " + r.2.hint) }
    }
    0
}

// `kairos types <file>` (and `hir`, with the HIR and what the temporal analysis knows).
fn cli_dump(base: Checker, path: str, hir: bool) -> i64 {
    let src = try_read_text(path)
    if src.1 != "" {
        eprint(cli_usage())
        return 2
    }
    var ck = base
    ck.imported[norm_path(path)] = true
    let m = mark(ck)
    check_file(inout ck, path, src.0)
    if ck.failed {
        print("error " + ck.code + " " + str(ck.elo) + " " + str(ck.ehi) + " " + ck.msg)
        if ck.hint != "" { print("hint " + ck.hint) }
        return 0
    }
    for l in declarations_since(ck, m) { print(l) }
    if hir {
        for l in hir_since(ck, m) { print(l) }
        for l in temporal_since(ck, m) { print(l) }
    }
    0
}

// `kairos ledger` and `kairos ledger withdraw <protocol>` (src/main.rs ledger_cmd): the exit code.
fn cli_ledger(rest: List[str]) -> i64 {
    if not (len(rest) == 0 or (len(rest) == 2 and rest[0] == "withdraw")) {
        eprint(cli_usage())
        return 2
    }
    let none: List[RtProto] = []
    let s = rt_b3_fresh(none, "")
    var code = ""
    var msg = ""
    var text = ""
    if s.results == "" {
        code = "R0100"
        msg = "no results folder: the ledger lives next to the B3 data"
    } else {
        let lo = open_ledger(s.results, 201901)
        if lo.0 != "" {
            code = "R0500"
            msg = lo.0
        } else if len(rest) == 0 {
            text = ledger_describe(s.results + "/holdout_ledger.csv", lo.1)
        } else {
            var rows = lo.1
            let w = ledger_withdraw(s.results, inout rows, rest[1], today())
            if w.0 != "" {
                code = "R0502"
                msg = w.0
            } else {
                text = w.1
            }
        }
    }
    if code != "" {
        eprint("error[" + code + "]: " + msg)
        // (the Rust command gives a hint to these two only)
        let hint = if code == "R0100" { "set KAIROS_DATA to the quant-b3 `data` folder" } else if code == "R0500" { rt_b3_hint(code, msg) } else { "" }
        if hint != "" { eprint("  = hint: " + hint) }
        return 1
    }
    print(cli_chomp(text))
    0
}

// ------------------------------------------------------------------ the REPL (src/main.rs repl)

// How many ( [ { are open in the text (strings and comments aside): the REPL reads on while any is.
fn cli_open_delims(src: str) -> i64 {
    var depth = 0
    var in_str = false
    var prev = 0
    for line in lines(src) {
        let code = if in_str { line } else { split(line, "//")[0] }
        for c in codes(code) {
            if in_str {
                if c == 34 and prev != 92 { in_str = false }
            } else if c == 34 {
                in_str = true
            } else if c == 40 or c == 91 or c == 123 {
                depth += 1
            } else if c == 41 or c == 93 or c == 125 {
                depth -= 1
            }
            prev = c
        }
    }
    depth
}

// The source of each file the checker read: `known` for the first ones, then the others (the
// session's inputs from `texts`).
fn cli_srcs_of(ck: Checker, known: List[str], texts: Map[str, str]) -> List[str] {
    var out = known
    for i in len(known)..len(ck.files) {
        let f = ck.files[i]
        if contains(texts, f) {
            out.push(texts[f])
        } else if f == "<prelude>" or starts_with(f, "<std/") {
            out.push(cli_std_text(ck, f))
        } else {
            out.push(try_read_text(f).0)
        }
    }
    out
}

// Runs the top-level statements from the t0-th on, on the session's frame (a runtime error is
// written): (no error, whether the last one shows its value, its text). A statement of the file
// `echo` shows its value when it is not `()`.
fn cli_repl_run(inout st: KSt, inout f: List[KV], texts: Map[str, str], t0: i64, echo: i64) -> (bool, bool, str) {
    st.srcs = cli_srcs_of(st.ck, st.srcs, texts)
    while len(f) < len(st.ck.main.slot_tys) { f.push(st.unit) }
    // each input runs as a new interpreter on the session's frame (src/session.rs run)
    st.ctl = 0
    st.depth = 0
    st.tracking = false
    st.tape = rt_d_new()
    var shows = false
    var text = ""
    for i in t0..len(st.ck.all_tops) {
        let t = st.ck.all_tops[i]
        let v = ki_ev(inout st, inout f, t)
        if st.ctl == 4 {
            eprint(cli_chomp(ki_render(st)))
            st.ctl = 0
            return (false, false, "")
        }
        st.ctl = 0
        shows = t.f == echo and v.k != 0
        text = if shows { ki_show(st, v, false) } else { "" }
    }
    (true, shows, text)
}

// A check that failed: its error is written and the session goes back to `back`.
fn cli_repl_undo(inout st: KSt, back: Checker, texts: Map[str, str], file: i64) {
    if st.ck.efile < 0 { st.ck.efile = file }
    eprint(cli_chomp(cli_check_error(st.ck, cli_srcs_of(st.ck, st.srcs, texts))))
    st.ck = back
}

// One input, as the Rust session takes it: each import checked and run first (each file once),
// then the input's own items, checked against everything before them, and run. A failed check
// leaves the session as it was before it.
fn cli_repl_input(inout st: KSt, inout f: List[KV], texts: Map[str, str], name: str, src: str) {
    var back = st.ck
    let file = len(st.ck.files)
    st.ck.files.push(name)
    let r = parse_program(src)
    if not r.0 {
        ck_fail(inout st.ck, r.2.code, r.2.elo, r.2.ehi, r.2.msg, r.2.hint)
        cli_repl_undo(inout st, back, texts, file)
        return
    }
    var items: List[Node] = []
    for it in r.1 {
        if it.kind != "import" {
            items.push(it)
            continue
        }
        let rp = resolve_import(inout st.ck, name, unhex(it.text), it.lo, it.hi)
        if st.ck.failed {
            cli_repl_undo(inout st, back, texts, file)
            return
        }
        if contains(st.ck.imported, rp.1) { continue }
        st.ck.imported[rp.1] = true
        let t0 = len(st.ck.all_tops)
        check_file(inout st.ck, if starts_with(rp.1, "<") { rp.1 } else { rp.0 }, ck_text(st.ck, rp))
        if st.ck.failed {
            cli_repl_undo(inout st, back, texts, file)
            return
        }
        if not cli_repl_run(inout st, inout f, texts, t0, -1).0 { return }
        back = st.ck
    }
    let t0 = len(st.ck.all_tops)
    check_items(inout st.ck, items, file)
    if st.ck.failed {
        cli_repl_undo(inout st, back, texts, file)
        return
    }
    let run = cli_repl_run(inout st, inout f, texts, t0, file)
    if run.1 { print("= " + run.2) }
}

// `kairos repl` (and `kairos` alone): an interactive session; the exit code.
fn cli_repl(base: Checker, version: str) -> i64 {
    print("Kairós " + version + " — type :help for help, :q to quit")
    var texts: Map[str, str] = [:]
    let none: List[str] = []
    var st = ki_new(base, none, none)
    st.prog = "repl"
    var f: List[KV] = []
    // the prelude's statements
    let _ = cli_repl_run(inout st, inout f, texts, 0, -1)
    var buf = ""
    var n = 0
    while true {
        print_raw(if buf == "" { "kai> " } else { "...  " })
        let line = read_line()
        if line == "" {
            print("")
            return 0
        }
        let t = trim(line)
        if buf == "" {
            if t == ":q" or t == ":quit" or t == ":exit" { return 0 }
            if t == ":help" or t == ":h" {
                print("Write declarations (fn, struct, enum) or statements; the value of an expression is shown.")
                print("Multi-line input continues while ( [ { are open. Standard library: mean, variance,")
                print("std_dev, product, compound, wealth, max_drawdown, sharpe (std/prelude.krs).")
                continue
            }
            if t == "" { continue }
        }
        buf = buf + line
        if cli_open_delims(buf) > 0 { continue }
        n += 1
        let name = "<repl:" + str(n) + ">"
        texts[name] = buf
        cli_repl_input(inout st, inout f, texts, name, buf)
        buf = ""
    }
    0
}
