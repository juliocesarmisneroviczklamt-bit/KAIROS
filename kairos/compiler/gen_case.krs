// Writes compiler/rt_case.krs: `upper` and `lower` as Rust's `str` has them (to_uppercase and
// to_lowercase: a character can become two or three), and the two classes of characters that
// lower's one rule of context reads (a final sigma, Σ at the end of a word, becomes ς), for the
// runtime of the WebAssembly modules. All of it is found by asking the interpreter about every
// code point.
//
//   kairos run kairos/compiler/gen_case.krs kairos/compiler/rt_case.krs
//
// A case table is a text of base-64 digits, 16 for each character that changes: its code point,
// then the 3 code points it becomes (0 for none). A class is a text of boundaries, as in
// rt_unicode.krs. The rule of the final sigma skips the case-ignorable characters, then asks
// whether a character is cased; both are read here from what `lower` does with Σ:
// - lower(c + "Σ") ends in ς when c is cased and not case-ignorable;
// - lower("A" + c + "Σ") ends in ς when c is case-ignorable or cased.

fn digit(d: i64) -> str {
    substr("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/", d, 1)
}

fn four(x: i64) -> str {
    digit(shr(x, 18)) + digit(bit_and(shr(x, 12), 63)) + digit(bit_and(shr(x, 6), 63)) + digit(bit_and(x, 63))
}

// a long text in lines of 96 characters, joined with + (at the end of a line: a line that starts
// with + would end the statement)
fn literal(s: str) -> str {
    let nl = from_codes([10])
    var lines: List[str] = []
    var i = 0
    while i < len(s) {
        lines.push("\"" + substr(s, i, 96) + "\"")
        i += 96
    }
    if len(lines) == 0 { lines.push("\"\"") }
    join(lines, " +" + nl + "        ")
}

fn last_code(s: str) -> i64 {
    let cs = codes(s)
    cs[len(cs) - 1]
}

var up: List[str] = []
var low: List[str] = []
var n_up = 0
var n_low = 0
var ign: List[i64] = []
var cased: List[i64] = []
var in_ign = false
var in_cased = false
// beyond ASCII, the characters Rust's `{:?}` writes as \u{...} (not printable, or grapheme extenders)
var esc: List[i64] = []
var in_esc = false
let sigma = from_codes([931])
for c in 0..1114112 {
    // the surrogates are not characters
    var is_ign = false
    var is_cased = false
    if c < 55296 or c > 57343 {
        let s = from_codes([c])
        for k in 0..2 {
            let m = codes(if k == 0 { upper(s) } else { lower(s) })
            if len(m) != 1 or m[0] != c {
                var e = four(c)
                for i in 0..3 { e = e + four(if i < len(m) { m[i] } else { 0 }) }
                if k == 0 {
                    up.push(e)
                    n_up += 1
                } else {
                    low.push(e)
                    n_low += 1
                }
            }
        }
        let alone = last_code(lower(s + sigma)) == 962
        let after_a = last_code(lower("A" + s + sigma)) == 962
        is_cased = alone
        is_ign = after_a and not alone
    }
    var is_esc = false
    if c >= 128 and (c < 55296 or c > 57343) {
        let s = from_codes([c])
        is_esc = str([s]) != "[\"" + s + "\"]"
    }
    if is_esc != in_esc {
        esc.push(c)
        in_esc = is_esc
    }
    if is_ign != in_ign {
        ign.push(c)
        in_ign = is_ign
    }
    if is_cased != in_cased {
        cased.push(c)
        in_cased = is_cased
    }
}
if in_ign { ign.push(1114112) }
if in_cased { cased.push(1114112) }
if in_esc { esc.push(1114112) }

fn bounds(xs: List[i64]) -> str {
    var parts: List[str] = []
    for x in xs { parts.push(four(x)) }
    join(parts, "")
}

let nl = from_codes([10])
var out = "// upper and lower as Rust's `str` has them, written by gen_case.krs (do not edit): a case table has" + nl
out = out + "// 16 base-64 digits for each character that changes (it, then the 3 it becomes, 0 for none); a class" + nl
out = out + "// has its boundaries, 4 digits each (rt.krs reads them)." + nl
out = out + nl + "// to_uppercase: " + str(n_up) + " characters change" + nl
out = out + "fn rt_case_upper() -> str {" + nl + "    " + literal(join(up, "")) + nl + "}" + nl
out = out + nl + "// to_lowercase: " + str(n_low) + " characters change (Σ: by the rule of the final sigma)" + nl
out = out + "fn rt_case_lower() -> str {" + nl + "    " + literal(join(low, "")) + nl + "}" + nl
out = out + nl + "// case-ignorable: " + str(len(ign) / 2) + " ranges" + nl
out = out + "fn rt_case_ignorable() -> str {" + nl + "    " + literal(bounds(ign)) + nl + "}" + nl
out = out + nl + "// cased, and not case-ignorable: " + str(len(cased) / 2) + " ranges" + nl
out = out + "fn rt_case_cased() -> str {" + nl + "    " + literal(bounds(cased)) + nl + "}" + nl
out = out + nl + "// escaped by {:?}, beyond ASCII: " + str(len(esc) / 2) + " ranges" + nl
out = out + "fn rt_case_escaped() -> str {" + nl + "    " + literal(bounds(esc)) + nl + "}" + nl
write_text(args()[0], out)
print("upper", n_up, "lower", n_low, "ignorable", len(ign) / 2, "cased", len(cased) / 2, "escaped", len(esc) / 2)
