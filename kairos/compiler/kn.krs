// kn: Kairós to a Windows executable, written in Kairós (M21). It checks programs with the front
// end in Kairós, makes each one's WebAssembly module with the operating system written in Kairós
// (rt_win.krs) and translates it to x86-64 (native.krs): no Rust, no WebAssembly runtime.
//
//   kairos run kairos/compiler/kn.krs <std folder> <output folder> program.krs [more.krs ...]
//
// Each `program.krs` becomes `<output folder>/program.exe`; a program with an error, or with what
// the back ends do not compile yet, is reported (`file: error CODE ...`) and gets no executable.
import "wasmgen.krs"
import "native.krs"

fn kn_base_name(path: str) -> str {
    let p = replace(path, from_codes([92]), "/")
    let parts = split(p, "/")
    let last = parts[len(parts) - 1]
    if ends_with(last, ".krs") { substr(last, 0, len(last) - 4) } else { last }
}

// The source of each file the checker read (the standard library from its folder).
fn kn_sources(ck: Checker, std_dir: str) -> List[str] {
    var out: List[str] = []
    for f in ck.files {
        if f == "<prelude>" {
            out.push(read_text(std_dir + "/prelude.krs"))
        } else if starts_with(f, "<std/") {
            out.push(read_text(std_dir + "/" + substr(f, 5, len(f) - 6)))
        } else {
            out.push(read_text(f))
        }
    }
    out
}

// A file of the runtime, checked into the base (once).
fn kn_runtime(inout base: Checker, path: str) {
    base.imported[norm_path(path)] = true
    check_file(inout base, path, read_text(path))
    assert(not base.failed, path + " does not check: " + base.code + " " + str(base.elo) + " " + base.msg)
}

let std_dir = args()[0]
let out_dir = args()[1]
var base = new_checker(std_dir)
check_file(inout base, "<prelude>", read_text(std_dir + "/prelude.krs"))
assert(not base.failed, "the prelude does not check: " + base.code + " " + base.msg)
let up = dir_of(std_dir)
let compiler = (if up == "" { "" } else { up + "/" }) + "compiler/"
kn_runtime(inout base, compiler + "rt.krs")
kn_runtime(inout base, compiler + "rt_zip.krs")
kn_runtime(inout base, compiler + "rt_win.krs")
var base_b3 = base
var b3_ready = false
make_dir(out_dir)
var failed = 0
for k in 2..len(args()) {
    let path = args()[k]
    var ck = base
    ck.imported[norm_path(path)] = true
    check_file(inout ck, path, read_text(path))
    if ck.failed {
        print(path + ": error " + ck.code + " " + str(ck.elo) + " " + str(ck.ehi) + " " + ck.msg)
        failed += 1
        continue
    }
    var w = wasm_module_native(ck, kn_sources(ck, std_dir), kn_base_name(path))
    if not w.0 and w.2 == "b3" {
        if not b3_ready {
            kn_runtime(inout base_b3, compiler + "rt_b3.krs")
            b3_ready = true
        }
        var cb = base_b3
        cb.imported[norm_path(path)] = true
        check_file(inout cb, path, read_text(path))
        if cb.failed {
            print(path + ": error W0001 a program that uses `b3` and has a name of the runtime of `b3`: " + cb.msg)
            failed += 1
            continue
        }
        w = wasm_module_native(cb, kn_sources(cb, std_dir), kn_base_name(path))
    }
    if not w.0 {
        print(path + ": error W0001 " + w.2)
        failed += 1
        continue
    }
    let exe = native_exe(w.1)
    if exe.0 {
        write_bytes(out_dir + "/" + kn_base_name(path) + ".exe", exe.1)
    } else {
        print(path + ": error N0001 " + exe.2)
        failed += 1
    }
}
if failed > 0 { print(str(failed) + " program(s) not compiled") }
