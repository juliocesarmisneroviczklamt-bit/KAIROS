// Generated by gen_std.krs from kairos/std and kairos/Cargo.toml: the standard library and the
// version the command written in Kairós carries (as the Rust one, with include_str!). Do not edit.

fn std_version() -> str {
    "0.19.0"
}

// the files by the name the checker gives them ("<prelude>", "<std/sim.krs>"...)
fn std_embedded() -> Map[str, str] {
    var m: Map[str, str] = [:]
    m["<std/base64.krs>"] = "// Base64 (RFC 4648, standard alphabet, with padding), written in Kairós:\n// `import \"std/base64.krs\"`.\n//\n//   base64_encode(b: Bytes) -> str\n//   base64_text(s) -> str          the Base64 of the text's UTF-8 bytes\n//   base64_decode(s) -> Bytes      stops the program (R0003) when `s` is not Base64\n\nfn b64_alphabet() -> List[i64] {\n    codes(\"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\")\n}\n\nfn base64_encode(b: Bytes) -> str {\n    let a = b64_alphabet()\n    let n = len(b)\n    var out = []\n    var i = 0\n    while i + 2 < n {\n        let x = get_u8(b, i) * 65536 + get_u8(b, i + 1) * 256 + get_u8(b, i + 2)\n        out.push(a[x / 262144])\n        out.push(a[(x / 4096) % 64])\n        out.push(a[(x / 64) % 64])\n        out.push(a[x % 64])\n        i += 3\n    }\n    if n - i == 1 {\n        let x = get_u8(b, i) * 65536\n        for c in [a[x / 262144], a[(x / 4096) % 64], 61, 61] { out.push(c) }\n    } else if n - i == 2 {\n        let x = get_u8(b, i) * 65536 + get_u8(b, i + 1) * 256\n        for c in [a[x / 262144], a[(x / 4096) % 64], a[(x / 64) % 64], 61] { out.push(c) }\n    }\n    from_codes(out)\n}\n\nfn base64_text(s: str) -> str {\n    var b = bytes()\n    b.put_str(s)\n    base64_encode(b)\n}\n\nfn base64_decode(s: str) -> Bytes {\n    var value: Map[i64, i64] = [:]\n    let a = b64_alphabet()\n    for k in 0..64 { value[a[k]] = k }\n    var vals = []\n    var pad = 0\n    for c in codes(s) {\n        if c == 61 {\n            pad += 1\n        } else {\n            assert(pad == 0 and contains(value, c), \"base64: not Base64 text\")\n            vals.push(value[c])\n        }\n    }\n    assert((len(vals) + pad) % 4 == 0 and pad <= 2, \"base64: the length is not a multiple of 4\")\n    var out = bytes()\n    var i = 0\n    while i < len(vals) {\n        let k = min(4, len(vals) - i)\n        var x = 0\n        for j in 0..4 { x = x * 64 + (if j < k { vals[i + j] } else { 0 }) }\n        out.put_u8(x / 65536)\n        if k > 2 { out.put_u8((x / 256) % 256) }\n        if k > 3 { out.put_u8(x % 256) }\n        i += 4\n    }\n    out\n}\n"
    m["<std/csv.krs>"] = "// CSV (RFC 4180), written in Kairós: `import \"std/csv.krs\"`.\n//\n//   csv_parse(text, sep) -> List[List[str]]       the rows (empty lines are skipped)\n//   csv_records(text, sep) -> List[Map[str, str]] by column name (the first row names them)\n//   csv_line(fields, sep) -> str                  one row, quoting what needs quotes\n//\n// A field in quotes may hold the separator, line breaks and quotes (written \"\").\n\nfn csv_parse(text: str, sep: str) -> List[List[str]] {\n    var rows = []\n    // no quotes: lines and separators\n    if not contains(text, \"\\\"\") {\n        for l in lines(text) {\n            if l != \"\" { rows.push(split(l, sep)) }\n        }\n        return rows\n    }\n    let c = codes(text)\n    let s = codes(sep)[0]\n    let n = len(c)\n    var row = []\n    var field = []\n    var quoted = false\n    var i = 0\n    while i < n {\n        let ch = c[i]\n        if quoted {\n            if ch == 34 {\n                if i + 1 < n and c[i + 1] == 34 {\n                    field.push(34)\n                    i += 1\n                } else {\n                    quoted = false\n                }\n            } else {\n                field.push(ch)\n            }\n        } else if ch == 34 {\n            quoted = true\n        } else if ch == s {\n            row.push(from_codes(field))\n            field = []\n        } else if ch == 10 or ch == 13 {\n            if ch == 13 and i + 1 < n and c[i + 1] == 10 { i += 1 }\n            row.push(from_codes(field))\n            field = []\n            if not (len(row) == 1 and row[0] == \"\") { rows.push(row) }\n            row = []\n        } else {\n            field.push(ch)\n        }\n        i += 1\n    }\n    if len(field) > 0 or len(row) > 0 {\n        row.push(from_codes(field))\n        rows.push(row)\n    }\n    rows\n}\n\nfn csv_records(text: str, sep: str) -> List[Map[str, str]] {\n    let rows = csv_parse(text, sep)\n    var out = []\n    if len(rows) == 0 { return out }\n    let head = rows[0]\n    for r in 1..len(rows) {\n        var m: Map[str, str] = [:]\n        for j in 0..len(head) {\n            m[head[j]] = if j < len(rows[r]) { rows[r][j] } else { \"\" }\n        }\n        out.push(m)\n    }\n    out\n}\n\nfn csv_field(f: str, sep: str) -> str {\n    if contains(f, sep) or contains(f, \"\\\"\") or contains(f, \"\\n\") or contains(f, \"\\r\") {\n        return \"\\\"\" + replace(f, \"\\\"\", \"\\\"\\\"\") + \"\\\"\"\n    }\n    f\n}\n\nfn csv_line(fields: List[str], sep: str) -> str {\n    var out = []\n    for f in fields { out.push(csv_field(f, sep)) }\n    join(out, sep)\n}\n"
    m["<std/dates.krs>"] = "// Dates as YYYYMMDD integers (20261103), in the Gregorian calendar: `import \"std/dates.krs\"`.\n//\n//   date_days(d), days_date(n)     days since 1970-01-01, and back\n//   add_days(d, n), days_between(a, b)\n//   weekday(d)                     0 = Monday ... 6 = Sunday; is_weekend(d)\n//   date_year(d), date_month(d), date_day(d), date_ym(d) (YYYYMM), month_end(d)\n//   date_iso(d) \"2026-11-03\"; date_from_iso(\"2026-11-03\"); date_from_br(\"03/11/2026\")\n//\n// The arithmetic is the civil-from-days algorithm (H. Hinnant), exact for any year.\n\nfn date_days(d: i64) -> i64 {\n    let m = (d / 100) % 100\n    let dd = d % 100\n    let y = if m <= 2 { d / 10000 - 1 } else { d / 10000 }\n    let era = (if y >= 0 { y } else { y - 399 }) / 400\n    let yoe = y - era * 400\n    let mp = if m > 2 { m - 3 } else { m + 9 }\n    let doy = (153 * mp + 2) / 5 + dd - 1\n    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy\n    era * 146097 + doe - 719468\n}\n\nfn days_date(n: i64) -> i64 {\n    let z = n + 719468\n    let era = (if z >= 0 { z } else { z - 146096 }) / 146097\n    let doe = z - era * 146097\n    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365\n    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)\n    let mp = (5 * doy + 2) / 153\n    let d = doy - (153 * mp + 2) / 5 + 1\n    let m = if mp < 10 { mp + 3 } else { mp - 9 }\n    let y = yoe + era * 400 + (if m <= 2 { 1 } else { 0 })\n    y * 10000 + m * 100 + d\n}\n\nfn add_days(d: i64, n: i64) -> i64 {\n    days_date(date_days(d) + n)\n}\n\nfn days_between(a: i64, b: i64) -> i64 {\n    date_days(b) - date_days(a)\n}\n\n// 1970-01-01 was a Thursday\nfn weekday(d: i64) -> i64 {\n    ((date_days(d) + 3) % 7 + 7) % 7\n}\n\nfn is_weekend(d: i64) -> bool {\n    weekday(d) >= 5\n}\n\nfn date_year(d: i64) -> i64 {\n    d / 10000\n}\n\nfn date_month(d: i64) -> i64 {\n    (d / 100) % 100\n}\n\nfn date_day(d: i64) -> i64 {\n    d % 100\n}\n\nfn date_ym(d: i64) -> i64 {\n    d / 100\n}\n\n// the last day of d's month\nfn month_end(d: i64) -> i64 {\n    let first_next = if date_month(d) == 12 { (date_year(d) + 1) * 10000 + 101 } else { d / 100 * 100 + 101 }\n    add_days(first_next, -1)\n}\n\nfn date_two(n: i64) -> str {\n    if n < 10 { \"0\" + str(n) } else { str(n) }\n}\n\nfn date_iso(d: i64) -> str {\n    str(date_year(d)) + \"-\" + date_two(date_month(d)) + \"-\" + date_two(date_day(d))\n}\n\nfn date_from_iso(s: str) -> i64 {\n    let p = split(substr(trim(s), 0, 10), \"-\")\n    parse_int(p[0]) * 10000 + parse_int(p[1]) * 100 + parse_int(p[2])\n}\n\nfn date_from_br(s: str) -> i64 {\n    let p = split(trim(s), \"/\")\n    parse_int(substr(p[2], 0, 4)) * 10000 + parse_int(p[1]) * 100 + parse_int(p[0])\n}\n"
    m["<std/json.krs>"] = "// JSON (RFC 8259), written in Kairós: `import \"std/json.krs\"`.\n//\n//   json_parse(text) -> Json     a malformed text stops the program, saying where\n//   json_try(text) -> (bool, Json)   (true, value), or (false, Str(what is wrong and where))\n//   json_text(v) -> str          compact JSON; json_pretty(v): indented by two spaces\n//   json_get(v, key), json_at(v, i)                  a field / an element (Null when missing)\n//   json_num(v), json_str(v), json_bool(v), json_list(v), json_keys(v)\n//\n// Numbers are f64; whole numbers are written without decimals (202611, not 202611.0), and\n// NaN or infinities as null. Objects keep the order of their keys. The reader is strict, as\n// RFC 8259 (and Rust's serde_json): no unknown escapes, no control characters inside strings,\n// no lone surrogates.\n\nenum Json {\n    Null,\n    Bool(bool),\n    Num(f64),\n    Str(str),\n    Arr(List[Json]),\n    Obj(Map[str, Json]),\n}\n\n// where the reader is, and the first problem found (\"\" while there is none)\nstruct JsonPos {\n    i: i64,\n    err: str,\n}\n\nfn json_try(text: str) -> (bool, Json) {\n    let c = codes(text)\n    var p = JsonPos { i: 0, err: \"\" }\n    let v = jp_value(c, inout p)\n    if p.err == \"\" {\n        jp_ws(c, inout p)\n        if p.i < len(c) { jp_fail(inout p, \"text after the value\") }\n    }\n    if p.err != \"\" { return (false, Json.Str(p.err)) }\n    (true, v)\n}\n\nfn json_parse(text: str) -> Json {\n    let r = json_try(text)\n    if not r.0 { assert(false, \"json: \" + json_str(r.1)) }\n    r.1\n}\n\nfn jp_fail(inout p: JsonPos, what: str) {\n    if p.err == \"\" { p.err = what + \" at character \" + str(p.i + 1) }\n}\n\n// spaces, tabs and line breaks\nfn jp_ws(c: List[i64], inout p: JsonPos) {\n    while p.i < len(c) and (c[p.i] == 32 or c[p.i] == 9 or c[p.i] == 10 or c[p.i] == 13) { p.i += 1 }\n}\n\nfn jp_value(c: List[i64], inout p: JsonPos) -> Json {\n    jp_ws(c, inout p)\n    if p.i >= len(c) {\n        jp_fail(inout p, \"missing value\")\n        return Json.Null\n    }\n    let ch = c[p.i]\n    if ch == 123 { return jp_object(c, inout p) }                       // {\n    if ch == 91 { return jp_array(c, inout p) }                         // [\n    if ch == 34 { return Json.Str(jp_string(c, inout p)) }              // \"\n    if ch == 116 {\n        jp_word(c, inout p, \"true\")\n        return Json.Bool(true)\n    }\n    if ch == 102 {\n        jp_word(c, inout p, \"false\")\n        return Json.Bool(false)\n    }\n    if ch == 110 {\n        jp_word(c, inout p, \"null\")\n        return Json.Null\n    }\n    if ch == 45 or (ch >= 48 and ch <= 57) { return Json.Num(jp_number(c, inout p)) }   // - 0-9\n    jp_fail(inout p, \"unexpected \" + from_codes([ch]))\n    Json.Null\n}\n\nfn jp_word(c: List[i64], inout p: JsonPos, word: str) {\n    let w = codes(word)\n    for k in 0..len(w) {\n        if p.i + k >= len(c) or c[p.i + k] != w[k] {\n            jp_fail(inout p, \"expected \" + word)\n            return\n        }\n    }\n    p.i += len(w)\n}\n\nfn jp_number(c: List[i64], inout p: JsonPos) -> f64 {\n    let start = p.i\n    if c[p.i] == 45 { p.i += 1 }\n    // digits, the point, the exponent and its sign\n    while p.i < len(c) and ((c[p.i] >= 48 and c[p.i] <= 57) or c[p.i] == 46 or c[p.i] == 101 or c[p.i] == 69 or c[p.i] == 43 or c[p.i] == 45) {\n        p.i += 1\n    }\n    var digits = []\n    for k in start..p.i { digits.push(c[k]) }\n    let x = parse_float(from_codes(digits))\n    if is_nan(x) {\n        p.i = start\n        jp_fail(inout p, \"invalid number\")\n    }\n    x\n}\n\nfn jp_hex4(c: List[i64], inout p: JsonPos) -> i64 {\n    var u = 0\n    for k in 0..4 {\n        if p.i >= len(c) {\n            jp_fail(inout p, \"short unicode escape\")\n            return 0\n        }\n        let h = c[p.i]\n        let d = if h >= 48 and h <= 57 { h - 48 } else if h >= 97 and h <= 102 { h - 87 } else if h >= 65 and h <= 70 { h - 55 } else { -1 }\n        if d < 0 {\n            jp_fail(inout p, \"invalid unicode escape\")\n            return 0\n        }\n        u = u * 16 + d\n        p.i += 1\n    }\n    u\n}\n\nfn jp_string(c: List[i64], inout p: JsonPos) -> str {\n    let start = p.i\n    p.i += 1\n    var out = []\n    while true {\n        if p.i >= len(c) {\n            p.i = start\n            jp_fail(inout p, \"unterminated string\")\n            return \"\"\n        }\n        let ch = c[p.i]\n        if ch == 34 {\n            p.i += 1\n            break\n        }\n        if ch < 32 {\n            jp_fail(inout p, \"control character in a string\")\n            return \"\"\n        }\n        if ch == 92 {\n            if p.i + 1 >= len(c) {\n                jp_fail(inout p, \"unterminated escape\")\n                return \"\"\n            }\n            let e = c[p.i + 1]\n            p.i += 2\n            if e == 110 {\n                out.push(10)\n            } else if e == 116 {\n                out.push(9)\n            } else if e == 114 {\n                out.push(13)\n            } else if e == 98 {\n                out.push(8)\n            } else if e == 102 {\n                out.push(12)\n            } else if e == 34 or e == 92 or e == 47 {\n                out.push(e)\n            } else if e == 117 {\n                // 4 hex digits, with surrogate pairs for code points above U+FFFF\n                var u = jp_hex4(c, inout p)\n                if p.err != \"\" { return \"\" }\n                if u >= 55296 and u <= 56319 and p.i + 1 < len(c) and c[p.i] == 92 and c[p.i + 1] == 117 {\n                    p.i += 2\n                    let lo = jp_hex4(c, inout p)\n                    if p.err != \"\" { return \"\" }\n                    if lo < 56320 or lo > 57343 {\n                        jp_fail(inout p, \"invalid surrogate pair\")\n                        return \"\"\n                    }\n                    u = 65536 + (u - 55296) * 1024 + (lo - 56320)\n                }\n                if u >= 55296 and u <= 57343 {\n                    jp_fail(inout p, \"lone surrogate\")\n                    return \"\"\n                }\n                out.push(u)\n            } else {\n                p.i -= 2\n                jp_fail(inout p, \"invalid escape\")\n                return \"\"\n            }\n            continue\n        }\n        out.push(ch)\n        p.i += 1\n    }\n    from_codes(out)\n}\n\nfn jp_array(c: List[i64], inout p: JsonPos) -> Json {\n    p.i += 1\n    var xs = []\n    jp_ws(c, inout p)\n    if p.i < len(c) and c[p.i] == 93 {\n        p.i += 1\n        return Json.Arr(xs)\n    }\n    while true {\n        xs.push(jp_value(c, inout p))\n        if p.err != \"\" { return Json.Null }\n        jp_ws(c, inout p)\n        if p.i >= len(c) {\n            jp_fail(inout p, \"unterminated array\")\n            return Json.Null\n        }\n        if c[p.i] == 44 {\n            p.i += 1\n            continue\n        }\n        if c[p.i] == 93 {\n            p.i += 1\n            break\n        }\n        jp_fail(inout p, \"expected , or ]\")\n        return Json.Null\n    }\n    Json.Arr(xs)\n}\n\nfn jp_object(c: List[i64], inout p: JsonPos) -> Json {\n    p.i += 1\n    var m: Map[str, Json] = [:]\n    jp_ws(c, inout p)\n    if p.i < len(c) and c[p.i] == 125 {\n        p.i += 1\n        return Json.Obj(m)\n    }\n    while true {\n        jp_ws(c, inout p)\n        if p.i >= len(c) or c[p.i] != 34 {\n            jp_fail(inout p, \"expected a key in quotes\")\n            return Json.Null\n        }\n        let k = jp_string(c, inout p)\n        if p.err != \"\" { return Json.Null }\n        jp_ws(c, inout p)\n        if p.i >= len(c) or c[p.i] != 58 {\n            jp_fail(inout p, \"expected :\")\n            return Json.Null\n        }\n        p.i += 1\n        m[k] = jp_value(c, inout p)\n        if p.err != \"\" { return Json.Null }\n        jp_ws(c, inout p)\n        if p.i >= len(c) {\n            jp_fail(inout p, \"unterminated object\")\n            return Json.Null\n        }\n        if c[p.i] == 44 {\n            p.i += 1\n            continue\n        }\n        if c[p.i] == 125 {\n            p.i += 1\n            break\n        }\n        jp_fail(inout p, \"expected , or }\")\n        return Json.Null\n    }\n    Json.Obj(m)\n}\n\n// ------------------------------------------------------------------ writing\n\nfn json_num_text(x: f64) -> str {\n    if is_nan(x - x) { return \"null\" }\n    if x == floor(x) and abs(x) < 9007199254740992.0 { return str(int(x)) }\n    str(x)\n}\n\nfn json_quote(s: str) -> str {\n    let hx = codes(\"0123456789abcdef\")\n    var out = [34]\n    for ch in codes(s) {\n        if ch == 34 or ch == 92 {\n            out.push(92)\n            out.push(ch)\n        } else if ch == 10 {\n            out.push(92)\n            out.push(110)\n        } else if ch == 13 {\n            out.push(92)\n            out.push(114)\n        } else if ch == 9 {\n            out.push(92)\n            out.push(116)\n        } else if ch < 32 {\n            for d in [92, 117, 48, 48, hx[ch / 16], hx[ch % 16]] { out.push(d) }\n        } else {\n            out.push(ch)\n        }\n    }\n    out.push(34)\n    from_codes(out)\n}\n\nfn json_text(v: Json) -> str {\n    match v {\n        Null => \"null\",\n        Bool(b) => if b { \"true\" } else { \"false\" },\n        Num(x) => json_num_text(x),\n        Str(s) => json_quote(s),\n        Arr(xs) => {\n            var parts = []\n            for x in xs { parts.push(json_text(x)) }\n            \"[\" + join(parts, \",\") + \"]\"\n        },\n        Obj(m) => {\n            var parts = []\n            for (k, x) in items(m) { parts.push(json_quote(k) + \":\" + json_text(x)) }\n            \"{\" + join(parts, \",\") + \"}\"\n        },\n    }\n}\n\nfn json_indent(v: Json, pad: str) -> str {\n    let inner = pad + \"  \"\n    match v {\n        Arr(xs) => {\n            if len(xs) == 0 { return \"[]\" }\n            var parts = []\n            for x in xs { parts.push(inner + json_indent(x, inner)) }\n            \"[\\n\" + join(parts, \",\\n\") + \"\\n\" + pad + \"]\"\n        },\n        Obj(m) => {\n            if len(m) == 0 { return \"{}\" }\n            var parts = []\n            for (k, x) in items(m) { parts.push(inner + json_quote(k) + \": \" + json_indent(x, inner)) }\n            \"{\\n\" + join(parts, \",\\n\") + \"\\n\" + pad + \"}\"\n        },\n        _ => json_text(v),\n    }\n}\n\nfn json_pretty(v: Json) -> str {\n    json_indent(v, \"\")\n}\n\n// ------------------------------------------------------------------ reading values\n\nfn json_get(v: Json, key: str) -> Json {\n    match v {\n        Obj(m) => get(m, key, Json.Null),\n        _ => Json.Null,\n    }\n}\n\nfn json_at(v: Json, i: i64) -> Json {\n    match v {\n        Arr(xs) => if i >= 0 and i < len(xs) { xs[i] } else { Json.Null },\n        _ => Json.Null,\n    }\n}\n\n// a number (also one written as text, as some APIs do); NaN otherwise\nfn json_num(v: Json) -> f64 {\n    match v {\n        Num(x) => x,\n        Str(s) => parse_float(s),\n        _ => nan,\n    }\n}\n\nfn json_str(v: Json) -> str {\n    match v {\n        Str(s) => s,\n        Num(x) => json_num_text(x),\n        Bool(b) => if b { \"true\" } else { \"false\" },\n        _ => \"\",\n    }\n}\n\nfn json_bool(v: Json) -> bool {\n    match v {\n        Bool(b) => b,\n        _ => false,\n    }\n}\n\nfn json_list(v: Json) -> List[Json] {\n    match v {\n        Arr(xs) => xs,\n        _ => [],\n    }\n}\n\nfn json_keys(v: Json) -> List[str] {\n    match v {\n        Obj(m) => keys(m),\n        _ => [],\n    }\n}\n"
    m["<prelude>"] = "// Kairós prelude: the standard library, written in Kairós itself.\n// Loaded into every session before user code.\n// (`mean`, `sum` and `prod` are builtins: they work on lists and on tensors.)\n\n// statistics and the lab's simulator (b3.evaluate and b3.simulate run it), written in Kairós\nimport \"std/stats.krs\"\nimport \"std/sim.krs\"\n\n// sample variance (n - 1)\nfn variance(xs: List[f64]) -> f64 {\n    assert(len(xs) > 1, \"variance needs at least two values\")\n    let m = mean(xs)\n    var acc = 0.0\n    for x in xs { acc += (x - m) ^ 2 }\n    acc / float(len(xs) - 1)\n}\n\nfn std_dev(xs: List[f64]) -> f64 {\n    sqrt(variance(xs))\n}\n\nfn product(xs: List[f64]) -> f64 {\n    var p = 1.0\n    for x in xs { p *= x }\n    p\n}\n\n// compound return of a series of simple returns: (1 + r1)(1 + r2)... - 1\nfn compound(returns: List[f64]) -> f64 {\n    var g = 1.0\n    for r in returns { g *= 1.0 + r }\n    g - 1.0\n}\n\n// cumulative wealth path starting at 1\nfn wealth(returns: List[f64]) -> List[f64] {\n    var w = 1.0\n    var path = []\n    for r in returns {\n        w *= 1.0 + r\n        path.push(w)\n    }\n    path\n}\n\n// worst peak-to-trough loss (a negative number)\nfn max_drawdown(returns: List[f64]) -> f64 {\n    var peak = 1.0\n    var worst = 0.0\n    for w in wealth(returns) {\n        peak = max(peak, w)\n        worst = min(worst, w / peak - 1.0)\n    }\n    worst\n}\n\n// annualized Sharpe ratio of monthly returns over a monthly risk-free rate\nfn sharpe(returns: List[f64], rf: f64) -> f64 {\n    let ex = returns.map(|r| r - rf)\n    mean(ex) / std_dev(ex) * sqrt(12.0)\n}\n\n// Result of `b3.evaluate(weights, ...)`: the quant-b3 realistic simulator, after costs\n// (and after taxes with `tax: true`). Rates are fractions: 0.146 = 14.6% a year.\nstruct Evaluation {\n    months: i64,       // simulated months\n    cagr: f64,         // compound annual growth of total wealth\n    vol: f64,          // annualized volatility of monthly returns\n    sharpe: f64,       // annualized Sharpe over the CDI\n    max_dd: f64,       // worst drawdown of the monthly series (negative)\n    beta: f64,         // CAPM beta against the NEFIN market factor\n    alpha: f64,        // annualized CAPM alpha (Newey-West regression)\n    t_alpha: f64,      // t statistic of the alpha\n    turnover: f64,     // traded value per year, as a fraction of wealth (buys + sells)\n    cost_bps: f64,     // average cost paid per traded real, in basis points\n    trials: i64,       // trials the DSR accounts for: the whole registry (research), 1 (holdout)\n    dsr: f64,          // deflated Sharpe ratio: P(true Sharpe > best of `trials` tries without skill)\n}\n\n// What `b3.simulate` returns: the simulation month by month (NaN outside the simulated months),\n// for the studies that compute their own statistics. It is a trial in the registry, like\n// `b3.evaluate`.\nstruct Simulation {\n    ret: Tensor[month; f64],        // monthly return of total wealth, after costs and IR\n    exposure: Tensor[month; f64],   // fraction of wealth invested\n    turnover: Tensor[month; f64],   // value traded / wealth (buys + sells)\n    cost_bps: f64,                  // average cost per traded real, in basis points\n    tax_paid: f64,                  // R$\n    final_value: f64,               // R$\n    liq_value: f64,                 // R$, selling everything at the end (paying the deferred IR)\n    capped: f64,                    // fraction of the target value cut by `cap_adv`\n    exempt_months: i64,             // months with sales, exempt (up to R$ 20 thousand) or taxed\n    taxed_months: i64,\n    trials: i64,\n    dsr: f64,\n}\n\n// ------------------------------------------------------------------ AI engine (M4)\n// Written in Kairós itself: `grad` differentiates any of it, and the optimizers are generic over\n// the parameters (any struct/tuple of f64 and f64 tensors: the tangent space).\n\naxis sample      // rows of a data set\naxis feature     // inputs\naxis hidden      // hidden units\naxis output      // outputs\n\n// Multilayer perceptron with one hidden layer of `tanh` units.\nstruct Mlp {\n    w1: Tensor[feature, hidden; f64],\n    b1: Tensor[hidden; f64],\n    w2: Tensor[hidden, output; f64],\n    b2: Tensor[output; f64],\n}\n\n// Reproducible initialization (Xavier/Glorot scale for tanh).\nfn mlp_init(seed: i64, inputs: i64, width: i64, outputs: i64) -> Mlp {\n    Mlp {\n        w1: randn(seed: seed, feature: inputs, hidden: width) * sqrt(1.0 / float(inputs)),\n        b1: zeros(hidden: width),\n        w2: randn(seed: seed + 1, hidden: width, output: outputs) * sqrt(1.0 / float(width)),\n        b2: zeros(output: outputs),\n    }\n}\n\nfn mlp(p: Mlp, x: Tensor[sample, feature; f64]) -> Tensor[sample, output; f64] {\n    let h = tanh(contract(x, p.w1, over: feature) + p.b1)\n    contract(h, p.w2, over: hidden) + p.b2\n}\n\n// mean squared error\nfn mse(pred: Tensor[sample, output; f64], target: Tensor[sample, output; f64]) -> f64 {\n    mean((pred - target) ^ 2.0)\n}\n\n// One step of gradient descent, for any differentiable parameters.\nfn sgd_step[P](inout p: P, g: P, lr: f64) {\n    p = p - lr * g\n}\n\n// One step of Adam (Kingma & Ba, 2015). `m` and `v` start as `zeros_like(p)`; `t` counts from 1.\nfn adam_step[P](inout p: P, g: P, inout m: P, inout v: P, t: i64, lr: f64) {\n    let b1 = 0.9\n    let b2 = 0.999\n    m = b1 * m + (1.0 - b1) * g\n    v = b2 * v + (1.0 - b2) * (g * g)\n    let mh = m / (1.0 - b1 ^ float(t))\n    let vh = v / (1.0 - b2 ^ float(t))\n    p = p - lr * mh / (sqrt(vh) + 1e-8)\n}\n"
    m["<std/sha256.krs>"] = "// SHA-256 (FIPS 180-4) in Kairós: the hash the lab uses to name strategies (the weights of an\n// evaluation) and files. Words of 32 bits are kept in i64, masked to 32 bits.\n\nfn sha_k() -> List[i64] {\n    [1116352408, 1899447441, 3049323471, 3921009573, 961987163, 1508970993, 2453635748, 2870763221,\n        3624381080, 310598401, 607225278, 1426881987, 1925078388, 2162078206, 2614888103, 3248222580,\n        3835390401, 4022224774, 264347078, 604807628, 770255983, 1249150122, 1555081692, 1996064986,\n        2554220882, 2821834349, 2952996808, 3210313671, 3336571891, 3584528711, 113926993, 338241895,\n        666307205, 773529912, 1294757372, 1396182291, 1695183700, 1986661051, 2177026350, 2456956037,\n        2730485921, 2820302411, 3259730800, 3345764771, 3516065817, 3600352804, 4094571909, 275423344,\n        430227734, 506948616, 659060556, 883997877, 958139571, 1322822218, 1537002063, 1747873779,\n        1955562222, 2024104815, 2227730452, 2361852424, 2428436474, 2756734187, 3204031479, 3329325298]\n}\n\nfn sha_rotr(x: i64, n: i64) -> i64 {\n    bit_and(bit_or(shr(x, n), shl(x, 32 - n)), 4294967295)\n}\n\nfn sha_add(a: i64, b: i64) -> i64 {\n    bit_and(a + b, 4294967295)\n}\n\n// The hash of the bytes of b, in lowercase hexadecimal (64 digits).\nfn sha256_hex(b: Bytes) -> str {\n    let k = sha_k()\n    var h = [1779033703, 3144134277, 1013904242, 2773480762, 1359893119, 2600822924, 528734635, 1541459225]\n    let n = len(b)\n    // the message, then 0x80, zeros, and its length in bits (64 bits, big-endian)\n    var msg: List[i64] = []\n    for i in 0..n { msg.push(get_u8(b, i)) }\n    msg.push(128)\n    while len(msg) % 64 != 56 { msg.push(0) }\n    let bits = n * 8\n    var s = 56\n    while s >= 0 {\n        msg.push(bit_and(shr(bits, s), 255))\n        s -= 8\n    }\n    var w: List[i64] = []\n    for i in 0..64 { w.push(0) }\n    var at = 0\n    while at < len(msg) {\n        for i in 0..16 {\n            let j = at + 4 * i\n            w[i] = bit_or(bit_or(shl(msg[j], 24), shl(msg[j + 1], 16)), bit_or(shl(msg[j + 2], 8), msg[j + 3]))\n        }\n        for i in 16..64 {\n            let s0 = bit_xor(bit_xor(sha_rotr(w[i - 15], 7), sha_rotr(w[i - 15], 18)), shr(w[i - 15], 3))\n            let s1 = bit_xor(bit_xor(sha_rotr(w[i - 2], 17), sha_rotr(w[i - 2], 19)), shr(w[i - 2], 10))\n            w[i] = sha_add(sha_add(w[i - 16], s0), sha_add(w[i - 7], s1))\n        }\n        var a = h[0]\n        var bb = h[1]\n        var c = h[2]\n        var d = h[3]\n        var e = h[4]\n        var f = h[5]\n        var g = h[6]\n        var hh = h[7]\n        for i in 0..64 {\n            let s1 = bit_xor(bit_xor(sha_rotr(e, 6), sha_rotr(e, 11)), sha_rotr(e, 25))\n            let ch = bit_xor(bit_and(e, f), bit_and(bit_xor(e, 4294967295), g))\n            let t1 = sha_add(sha_add(sha_add(hh, s1), sha_add(ch, k[i])), w[i])\n            let s0 = bit_xor(bit_xor(sha_rotr(a, 2), sha_rotr(a, 13)), sha_rotr(a, 22))\n            let maj = bit_xor(bit_xor(bit_and(a, bb), bit_and(a, c)), bit_and(bb, c))\n            let t2 = sha_add(s0, maj)\n            hh = g\n            g = f\n            f = e\n            e = sha_add(d, t1)\n            d = c\n            c = bb\n            bb = a\n            a = sha_add(t1, t2)\n        }\n        h[0] = sha_add(h[0], a)\n        h[1] = sha_add(h[1], bb)\n        h[2] = sha_add(h[2], c)\n        h[3] = sha_add(h[3], d)\n        h[4] = sha_add(h[4], e)\n        h[5] = sha_add(h[5], f)\n        h[6] = sha_add(h[6], g)\n        h[7] = sha_add(h[7], hh)\n        at += 64\n    }\n    var out = \"\"\n    for x in h { out = out + to_hex(x, 8) }\n    out\n}\n"
    m["<std/sim.krs>"] = "// The lab's realistic simulator, written in Kairós (it was quant-b3's src/backtest.rs):\n// `b3.evaluate` and `b3.simulate` check the weights and the holdout, then run it.\n//\n// - The cost of each trade: B3's fees + half the real spread (the median of the last 21\n//   sessions, from the best bid and ask at the close) + market impact k·σ·√(order / daily volume).\n// - An optional delay of execution (`lag`, in sessions).\n// - Capacity: the largest position is cap_adv × the median daily volume.\n// - The individual investor's income tax (today's rules, over the whole period): 15% of the\n//   month's net gain on stocks; exempt when the month's sales add up to R$ 20 thousand or less;\n//   losses carried forward; average purchase cost; 15% withheld on JCP; dividends exempt.\n// - What is not in stocks earns the CDI.\n//\n// The sums run in the order Rust ran them (positions by asset), so the results are the same bits.\nimport \"std/stats.krs\"\n\n// The panel compactly, as the runtime gives it: the sessions each asset traded, asset after\n// asset (the rows of asset t are first[t] .. first[t + 1]), up to where the program may see.\nstruct PanelDays {\n    first: List[i64],\n    di: List[i64],      // the session (index in the calendar)\n    r: List[f64],       // total return since the asset's previous session\n    vol: List[f64],     // traded volume (R$)\n    div: List[f64],     // the part of r from dividends\n    jcp: List[f64],     // the part of r from JCP (gross)\n    spr: List[f64],     // relative bid-ask spread at the close (NaN without both)\n    px: List[f64],      // unadjusted close\n}\n\nstruct Calendar {\n    dates: List[i64],        // YYYYMMDD of every session\n    month_first: List[i64],  // the first session of every month\n    cdi: List[f64],          // the CDI of every session (fraction)\n}\n\nstruct SimCfg {\n    capital: f64,       // in R$ of the start\n    lag: i64,           // sessions between the decision (a month's last close) and the trade\n    real_costs: bool,\n    cost_bps: f64,      // when not real_costs\n    tax: bool,\n    cap_adv: f64,       // 0: no capacity limit\n}\n\nstruct SimRun {\n    mi: List[i64],          // the months simulated\n    ret: List[f64],         // the month's return of the whole wealth, after costs and tax\n    turnover: List[f64],\n    exposure: List[f64],\n    cost_paid: f64,\n    traded: f64,\n    tax_paid: f64,\n    jcp_withheld: f64,\n    final_value: f64,\n    liq_value: f64,         // the final value selling everything and paying the tax on the gain\n    exempt_months: i64,\n    taxed_months: i64,\n    capped_frac: f64,       // the part of the target value cut for lack of liquidity\n}\n\nstruct Liq {\n    half_spread: f64,\n    sigma: f64,\n    adv: f64,\n}\n\n// The first row of asset t at session `s` or later.\nfn sim_row(p: PanelDays, t: i64, s: i64) -> i64 {\n    var lo = p.first[t]\n    var hi = p.first[t + 1]\n    while lo < hi {\n        let mid = (lo + hi) / 2\n        if p.di[mid] < s { lo = mid + 1 } else { hi = mid }\n    }\n    lo\n}\n\n// the upper median (the middle value, sorted)\nfn sim_median(v: List[f64]) -> f64 {\n    var xs = v\n    xs.sort()\n    xs[len(xs) / 2]\n}\n\n// The asset's liquidity with data up to session s - 1 (nothing from the future).\nfn sim_liq(p: PanelDays, t: i64, s: i64) -> Liq {\n    let hi = sim_row(p, t, s)\n    var vols = []\n    var rs = []\n    for k in max(hi - 63, p.first[t])..hi {\n        vols.push(p.vol[k])\n        rs.push(p.r[k])\n    }\n    let adv = if len(vols) == 0 { 0.0 } else { sim_median(vols) }\n    let sigma = stat_sd(rs)\n    var sprs = []\n    for k in max(hi - 21, p.first[t])..hi {\n        let v = p.spr[k]\n        if not is_nan(v - v) and v >= 0.0 { sprs.push(v) }\n    }\n    // without bid and ask: a 4% spread (conservative)\n    let spr = if len(sprs) == 0 { 0.04 } else { sim_median(sprs) }\n    Liq {\n        half_spread: min(max(spr, 0.0002) / 2.0, 0.10),\n        sigma: if is_nan(sigma - sigma) { 0.03 } else { min(sigma, 0.20) },\n        adv: max(adv, 1.0),\n    }\n}\n\nfn sim_liq_cached(inout cache: Map[i64, Liq], p: PanelDays, t: i64, s: i64) -> Liq {\n    let key = t * 1000000 + s\n    if not contains(cache, key) { cache[key] = sim_liq(p, t, s) }\n    cache[key]\n}\n\nfn sim_cost(cfg: SimCfg, l: Liq, amt: f64) -> f64 {\n    if cfg.real_costs { amt * (0.0003 + l.half_spread + 0.5 * l.sigma * sqrt(amt / l.adv)) } else { amt * cfg.cost_bps / 10000.0 }\n}\n\n// the value of the positions, by asset\nfn sim_held_value(held: List[i64], val: Map[i64, f64]) -> f64 {\n    var s = 0.0\n    for t in held { s += val[t] }\n    s\n}\n\n// Monthly plans (month, assets, weights; a weight is a fraction of the wealth, what is left earns\n// the CDI) through the market, session by session.\nfn sim_run(p: PanelDays, cal: Calendar, plan_m: List[i64], plan_t: List[List[i64]], plan_w: List[List[f64]], cfg: SimCfg) -> SimRun {\n    let nd = len(cal.dates)\n    let nm = len(cal.month_first)\n    var cache: Map[i64, Liq] = [:]\n    var cash = cfg.capital\n    var held: List[i64] = []            // the assets in the portfolio, in order\n    var val: Map[i64, f64] = [:]\n    var basis: Map[i64, f64] = [:]\n    var carry = 0.0                     // losses to offset\n    var capped = 0.0\n    var targeted = 0.0\n    var mis = []\n    var rets = []\n    var turns = []\n    var exps = []\n    var cost_paid = 0.0\n    var traded_all = 0.0\n    var tax_paid = 0.0\n    var jcp_withheld = 0.0\n    var exempt_months = 0\n    var taxed_months = 0\n    for k in 0..len(plan_m) {\n        let mi = plan_m[k]\n        let raw_s = cal.month_first[mi] + cfg.lag\n        if raw_s == 0 or raw_s > nd { break }\n        let s = min(raw_s, nd)\n        let e = min(if mi + 1 < nm { cal.month_first[mi + 1] + cfg.lag } else { nd }, nd)\n        let v0 = cash + sim_held_value(held, val)\n        if v0 <= 0.0 { break }\n        // the targets (with the capacity limit)\n        var target: Map[i64, f64] = [:]\n        for j in 0..len(plan_t[k]) {\n            let t = plan_t[k][j]\n            var tv = plan_w[k][j] * v0\n            targeted += tv\n            if cfg.cap_adv > 0.0 {\n                let cap = cfg.cap_adv * sim_liq_cached(inout cache, p, t, s).adv\n                if tv > cap {\n                    capped += tv - cap\n                    tv = cap\n                }\n            }\n            target[t] = get(target, t, 0.0) + tv\n        }\n        var ts = keys(target)\n        ts.sort()\n        // the sales first\n        var sales = 0.0\n        var realized = 0.0\n        var traded = 0.0\n        let eps = 0.0000001 * v0\n        for t in held {\n            let tv = get(target, t, 0.0)\n            let l = sim_liq_cached(inout cache, p, t, s)\n            if val[t] > tv + eps {\n                let sell = val[t] - tv\n                let c = sim_cost(cfg, l, sell)\n                let b_out = basis[t] * sell / val[t]\n                realized += sell - c - b_out\n                basis[t] = basis[t] - b_out\n                val[t] = val[t] - sell\n                cash += sell - c\n                cost_paid += c\n                sales += sell\n                traded += sell\n            }\n        }\n        var kept = []\n        for t in held {\n            if val[t] > eps {\n                kept.push(t)\n            } else {\n                remove(inout val, t)\n                remove(inout basis, t)\n            }\n        }\n        held = kept\n        // the purchases, limited to the cash there is\n        var buys = []\n        for t in ts {\n            let cur = get(val, t, 0.0)\n            let tv = target[t]\n            if tv > cur + eps {\n                let amt = tv - cur\n                buys.push((t, amt, sim_cost(cfg, sim_liq_cached(inout cache, p, t, s), amt)))\n            }\n        }\n        var need = 0.0\n        for b in buys { need += b.1 + b.2 }\n        let scale = if need > cash { max(cash / need, 0.0) } else { 1.0 }\n        for b in buys {\n            let t = b.0\n            let amt = b.1 * scale\n            let c = b.2 * scale\n            if amt <= 0.0 { continue }\n            cash -= amt + c\n            cost_paid += c\n            traded += amt\n            if not contains(val, t) {\n                val[t] = 0.0\n                basis[t] = 0.0\n                held.push(t)\n            }\n            val[t] = val[t] + amt\n            basis[t] = basis[t] + (amt + c)\n        }\n        held.sort()\n        // the portfolio through [s, e), session by session: the price moves the position, the\n        // dividends become cash\n        var cur_k = []\n        var end_k = []\n        for t in held {\n            cur_k.push(sim_row(p, t, s))\n            end_k.push(sim_row(p, t, e))\n        }\n        for di in s..e {\n            var income = 0.0\n            for h in 0..len(held) {\n                let k2 = cur_k[h]\n                if k2 < end_k[h] and p.di[k2] == di {\n                    cur_k[h] = k2 + 1\n                    let t = held[h]\n                    let dv = p.div[k2]\n                    let jc = p.jcp[k2]\n                    let jcp_net = if cfg.tax { 0.85 * jc } else { jc }\n                    if cfg.tax { jcp_withheld += val[t] * 0.15 * jc }\n                    income += val[t] * (dv + jcp_net)\n                    val[t] = val[t] * (1.0 + (p.r[k2] - dv - jc))\n                }\n            }\n            cash = cash * (1.0 + cal.cdi[di]) + income\n        }\n        // the income tax of the month of the sales\n        if cfg.tax and sales > 0.0 {\n            if sales <= 20000.0 {\n                exempt_months += 1\n                if realized < 0.0 { carry -= realized }\n            } else {\n                taxed_months += 1\n                let net = realized - carry\n                if net > 0.0 {\n                    let tax = 0.15 * net\n                    cash -= tax\n                    tax_paid += tax\n                    carry = 0.0\n                } else {\n                    carry = -net\n                }\n            }\n        }\n        if e > s {\n            let v1 = cash + sim_held_value(held, val)\n            mis.push(mi)\n            rets.push(v1 / v0 - 1.0)\n            turns.push(traded / v0)\n            var x = 0.0\n            for w in plan_w[k] { x += w }\n            exps.push(x)\n        }\n        traded_all += traded\n    }\n    let final_value = cash + sim_held_value(held, val)\n    var unreal = 0.0\n    for t in held { unreal += val[t] - basis[t] }\n    SimRun {\n        mi: mis,\n        ret: rets,\n        turnover: turns,\n        exposure: exps,\n        cost_paid: cost_paid,\n        traded: traded_all,\n        tax_paid: tax_paid,\n        jcp_withheld: jcp_withheld,\n        final_value: final_value,\n        liq_value: if cfg.tax { final_value - 0.15 * max(unreal - carry, 0.0) } else { final_value },\n        exempt_months: exempt_months,\n        taxed_months: taxed_months,\n        capped_frac: if targeted > 0.0 { capped / targeted } else { 0.0 },\n    }\n}\n\nstruct SimEval {\n    cagr: f64,\n    vol: f64,\n    sharpe: f64,        // over the CDI\n    max_dd: f64,\n    beta: f64,          // CAPM against NEFIN's value-weighted market (NaN with less than 24 months)\n    alpha: f64,         // a year\n    t_alpha: f64,       // Newey-West\n    turnover: f64,      // a year\n    cost_bps: f64,      // per real traded\n}\n\n// The statistics of a simulation, as the lab computes them.\nfn sim_eval(run: SimRun) -> SimEval {\n    sim_eval_on(run, b3.cdi(), b3.nefin(\"rm_rf\", vw: true), b3.nefin(\"rf\", vw: true), b3.nefin(\"rf\"))\n}\n\n// The same with the market's series given (each over the months, from the first): the CDI,\n// NEFIN's value-weighted market over the risk-free rate and its risk-free rate, and the equally\n// weighted series' risk-free rate.\nfn sim_eval_on(run: SimRun, cdi: Tensor[month; f64], rm: Tensor[month; f64], rf: Tensor[month; f64], rf_ew: Tensor[month; f64]) -> SimEval {\n    var ex = []\n    for k in 0..len(run.mi) { ex.push(run.ret[k] - cdi[month: run.mi[k]]) }\n    // CAPM: the months with both of NEFIN's series\n    var y = []\n    var x = []\n    for k in 0..len(run.mi) {\n        let m = run.mi[k]\n        if not is_nan(rf[month: m]) and not is_nan(rf_ew[month: m]) {\n            y.push(run.ret[k] - rf[month: m])\n            x.push(rm[month: m])\n        }\n    }\n    var beta = nan\n    var alpha = nan\n    var t_alpha = nan\n    if len(y) >= 24 {\n        let o = ols_nw(y, [x], nw_lags(len(y)))\n        if o.ok {\n            alpha = o.coef[0] * 12.0\n            beta = o.coef[1]\n            t_alpha = o.t[0]\n        }\n    }\n    SimEval {\n        cagr: stat_cagr(run.ret, 12.0),\n        vol: stat_sd(run.ret) * sqrt(12.0),\n        sharpe: stat_mean(ex) / stat_sd(ex) * sqrt(12.0),\n        max_dd: stat_max_dd(run.ret),\n        beta: beta,\n        alpha: alpha,\n        t_alpha: t_alpha,\n        turnover: stat_mean(run.turnover) * 12.0,\n        cost_bps: if run.traded > 0.0 { run.cost_paid / run.traded * 10000.0 } else { 0.0 },\n    }\n}\n"
    m["<std/stats.krs>"] = "// Statistics, written in Kairós: `import \"std/stats.krs\"` (loaded with the prelude, since the\n// simulator uses it). They are the lab's (quant-b3's src/stats.rs), with the same operations in\n// the same order, so the results are the same bits; only `stat_cagr` may differ from Rust's in\n// the last bit (x^y is the same pure-Rust function on every system here, the system's pow there).\n//\n//   stat_mean, stat_sd (n - 1), stat_corr, stat_corr_finite, stat_cagr, stat_max_dd,\n//   nw_lags, ols_nw (Newey-West t statistics) -> Ols, mat_invert, mat_mul, stat_annual\n\nfn stat_mean(x: List[f64]) -> f64 {\n    if len(x) == 0 { return nan }\n    var s = 0.0\n    for v in x { s += v }\n    s / float(len(x))\n}\n\n// Sample standard deviation (n - 1).\nfn stat_sd(x: List[f64]) -> f64 {\n    let n = len(x)\n    if n < 2 { return nan }\n    let m = stat_mean(x)\n    var s = 0.0\n    for v in x { s += (v - m) * (v - m) }\n    sqrt(s / float(n - 1))\n}\n\nfn stat_corr(x: List[f64], y: List[f64]) -> f64 {\n    let n = min(len(x), len(y))\n    if n < 3 { return nan }\n    var sx = 0.0\n    var sy = 0.0\n    for i in 0..n {\n        sx += x[i]\n        sy += y[i]\n    }\n    let mx = sx / float(n)\n    let my = sy / float(n)\n    var sxy = 0.0\n    var sxx = 0.0\n    var syy = 0.0\n    for i in 0..n {\n        let a = x[i] - mx\n        let b = y[i] - my\n        sxy += a * b\n        sxx += a * a\n        syy += b * b\n    }\n    sxy / sqrt(sxx * syy)\n}\n\n// The pairs where both are finite.\nfn stat_corr_finite(x: List[f64], y: List[f64]) -> (f64, i64) {\n    var a = []\n    var b = []\n    for i in 0..min(len(x), len(y)) {\n        if not is_nan(x[i] - x[i]) and not is_nan(y[i] - y[i]) {\n            a.push(x[i])\n            b.push(y[i])\n        }\n    }\n    (stat_corr(a, b), len(a))\n}\n\n// Compound annual growth; `ppy`: periods per year.\nfn stat_cagr(x: List[f64], ppy: f64) -> f64 {\n    if len(x) == 0 { return nan }\n    var w = 1.0\n    for r in x { w *= 1.0 + r }\n    w ^ (ppy / float(len(x))) - 1.0\n}\n\nfn stat_max_dd(x: List[f64]) -> f64 {\n    var w = 1.0\n    var peak = 1.0\n    var mdd = 0.0\n    for r in x {\n        w *= 1.0 + r\n        peak = max(peak, w)\n        mdd = min(mdd, w / peak - 1.0)\n    }\n    mdd\n}\n\n// Newey-West's rule of thumb for the number of lags.\nfn nw_lags(n: i64) -> i64 {\n    int(floor(4.0 * (float(n) / 100.0) ^ (2.0 / 9.0)))\n}\n\n// y = a + X b + e, with Newey-West t statistics. `ok` is false when it cannot be estimated.\nstruct Ols {\n    coef: List[f64],   // [intercept, betas...]\n    t: List[f64],\n    r2: f64,\n    ok: bool,\n}\n\n// Gauss-Jordan with partial pivoting (the last row of the largest pivot, as Rust's `max_by`).\n// `m`: k x k, row by row. Empty when singular.\nfn mat_invert(m: List[f64], k: i64) -> List[f64] {\n    let w = 2 * k\n    var a = []\n    for i in 0..k {\n        for j in 0..k { a.push(m[i * k + j]) }\n        for j in 0..k { a.push(if i == j { 1.0 } else { 0.0 }) }\n    }\n    for c in 0..k {\n        var piv = c\n        for r in c + 1..k {\n            if abs(a[r * w + c]) >= abs(a[piv * w + c]) { piv = r }\n        }\n        if abs(a[piv * w + c]) < 1e-14 { return [] }\n        if piv != c {\n            for j in 0..w {\n                let t = a[c * w + j]\n                a[c * w + j] = a[piv * w + j]\n                a[piv * w + j] = t\n            }\n        }\n        let d = a[c * w + c]\n        for j in 0..w { a[c * w + j] = a[c * w + j] / d }\n        for r in 0..k {\n            if r == c { continue }\n            let f = a[r * w + c]\n            if f != 0.0 {\n                for j in 0..w {\n                    let t = a[c * w + j]\n                    a[r * w + j] = a[r * w + j] - f * t\n                }\n            }\n        }\n    }\n    var out = []\n    for i in 0..k {\n        for j in 0..k { out.push(a[i * w + k + j]) }\n    }\n    out\n}\n\nfn mat_mul(a: List[f64], b: List[f64], k: i64) -> List[f64] {\n    var c = []\n    for i in 0..k * k { c.push(0.0) }\n    for i in 0..k {\n        for l in 0..k {\n            for j in 0..k {\n                c[i * k + j] = c[i * k + j] + a[i * k + l] * b[l * k + j]\n            }\n        }\n    }\n    c\n}\n\nfn ols_nw(y: List[f64], xs: List[List[f64]], lags: i64) -> Ols {\n    let n = len(y)\n    let k = len(xs) + 1\n    let fail = Ols { coef: [], t: [], r2: nan, ok: false }\n    if n <= k + 2 { return fail }\n    for x in xs {\n        if len(x) != n { return fail }\n    }\n    // the rows of X, with the intercept first\n    var rows = []\n    for i in 0..n {\n        rows.push(1.0)\n        for x in xs { rows.push(x[i]) }\n    }\n    var xtx = []\n    for i in 0..k * k { xtx.push(0.0) }\n    var xty = []\n    for i in 0..k { xty.push(0.0) }\n    for i in 0..n {\n        for a in 0..k {\n            xty[a] = xty[a] + rows[i * k + a] * y[i]\n            for b in 0..k {\n                xtx[a * k + b] = xtx[a * k + b] + rows[i * k + a] * rows[i * k + b]\n            }\n        }\n    }\n    let inv = mat_invert(xtx, k)\n    if len(inv) == 0 { return fail }\n    var beta = []\n    for a in 0..k {\n        var s = 0.0\n        for b in 0..k { s += inv[a * k + b] * xty[b] }\n        beta.push(s)\n    }\n    var u = []\n    for i in 0..n {\n        var s = 0.0\n        for a in 0..k { s += rows[i * k + a] * beta[a] }\n        u.push(y[i] - s)\n    }\n    var s = []\n    for i in 0..k * k { s.push(0.0) }\n    for i in 0..n {\n        for a in 0..k {\n            for b in 0..k {\n                s[a * k + b] = s[a * k + b] + u[i] * u[i] * rows[i * k + a] * rows[i * k + b]\n            }\n        }\n    }\n    for l in 1..=min(lags, n - 1) {\n        let w = 1.0 - float(l) / (float(lags) + 1.0)\n        for i in l..n {\n            let uu = u[i] * u[i - l]\n            for a in 0..k {\n                for b in 0..k {\n                    s[a * k + b] = s[a * k + b] + w * uu * (rows[i * k + a] * rows[(i - l) * k + b] + rows[(i - l) * k + a] * rows[i * k + b])\n                }\n            }\n        }\n    }\n    let v = mat_mul(mat_mul(inv, s, k), inv, k)\n    var t = []\n    for a in 0..k { t.push(beta[a] / sqrt(v[a * k + a])) }\n    let ym = stat_mean(y)\n    var sst = 0.0\n    var sse = 0.0\n    for v in y { sst += (v - ym) * (v - ym) }\n    for e in u { sse += e * e }\n    Ols { coef: beta, t: t, r2: 1.0 - sse / sst, ok: true }\n}\n\n// (annual mean, annual volatility, Newey-West t of the mean, Sharpe) of monthly returns.\nfn stat_annual(x: List[f64]) -> (f64, f64, f64, f64) {\n    let m = stat_mean(x)\n    let s = stat_sd(x)\n    let o = ols_nw(x, [], nw_lags(len(x)))\n    let t = if o.ok { o.t[0] } else { nan }\n    (m * 12.0, s * sqrt(12.0), t, m / s * sqrt(12.0))\n}\n"
    m
}
