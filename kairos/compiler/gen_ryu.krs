// Writes compiler/rt_ryu.krs: the tables of Ryu (Ulf Adams, "Ryū: fast float-to-string
// conversion", PLDI 2018) that the runtime uses to write floats, computed exactly with big
// integers.
//
//   kairos run kairos/compiler/gen_ryu.krs kairos/compiler/rt_ryu.krs
//
// POW5[i] (i < 326) is 5^i with 125 significant bits: 5^i shifted right (or left) to 125 bits.
// INV[i] (i < 342) is floor(2^j / 5^i) + 1 with j = bits(5^i) - 1 + 125. Each is split in its
// low and high 64 bits, written as i64 (the same bits).

// a big natural number: limbs of 30 bits, the lowest first
fn big(n: i64) -> List[i64] {
    var out: List[i64] = []
    var x = n
    while x > 0 {
        out.push(bit_and(x, 1073741823))
        x = shr(x, 30)
    }
    out
}

fn trimmed(a: List[i64]) -> List[i64] {
    var out = a
    while len(out) > 0 and out[len(out) - 1] == 0 { let _ = out.pop() }
    out
}

fn mul_small(a: List[i64], m: i64) -> List[i64] {
    var out: List[i64] = []
    var carry = 0
    for d in a {
        let v = d * m + carry
        out.push(bit_and(v, 1073741823))
        carry = shr(v, 30)
    }
    while carry > 0 {
        out.push(bit_and(carry, 1073741823))
        carry = shr(carry, 30)
    }
    out
}

fn bits(a: List[i64]) -> i64 {
    let t = trimmed(a)
    if len(t) == 0 { return 0 }
    var top = t[len(t) - 1]
    var b = 0
    while top > 0 {
        b += 1
        top = shr(top, 1)
    }
    (len(t) - 1) * 30 + b
}

fn bit_at(a: List[i64], k: i64) -> i64 {
    let limb = k / 30
    if limb >= len(a) { return 0 }
    bit_and(shr(a[limb], k % 30), 1)
}

// a * 2^k
fn shl_big(a: List[i64], k: i64) -> List[i64] {
    var out: List[i64] = []
    let n = bits(a) + k
    var limbs = n / 30 + 1
    for i in 0..limbs { out.push(0) }
    for i in 0..bits(a) {
        if bit_at(a, i) == 1 {
            let j = i + k
            out[j / 30] = bit_or(out[j / 30], shl(1, j % 30))
        }
    }
    trimmed(out)
}

// floor(a / 2^k)
fn shr_big(a: List[i64], k: i64) -> List[i64] {
    var out: List[i64] = []
    let n = bits(a)
    if n <= k { return out }
    for i in 0..(n - k) / 30 + 1 { out.push(0) }
    for i in k..n {
        if bit_at(a, i) == 1 {
            let j = i - k
            out[j / 30] = bit_or(out[j / 30], shl(1, j % 30))
        }
    }
    trimmed(out)
}

fn cmp(a: List[i64], b: List[i64]) -> i64 {
    let x = trimmed(a)
    let y = trimmed(b)
    if len(x) != len(y) { return if len(x) < len(y) { -1 } else { 1 } }
    var i = len(x) - 1
    while i >= 0 {
        if x[i] != y[i] { return if x[i] < y[i] { -1 } else { 1 } }
        i -= 1
    }
    0
}

// a - b, with a >= b
fn sub(a: List[i64], b: List[i64]) -> List[i64] {
    var out: List[i64] = []
    var borrow = 0
    for i in 0..len(a) {
        var v = a[i] - borrow - (if i < len(b) { b[i] } else { 0 })
        if v < 0 {
            v += 1073741824
            borrow = 1
        } else {
            borrow = 0
        }
        out.push(v)
    }
    trimmed(out)
}

// floor(2^j / d), by binary long division
fn pow2_div(j: i64, d: List[i64]) -> List[i64] {
    var q: List[i64] = []
    var r: List[i64] = []
    var k = j
    while k >= 0 {
        r = shl_big(r, 1)
        if k == j {
            if len(r) == 0 { r = [1] } else { r[0] = bit_or(r[0], 1) }
        }
        q = shl_big(q, 1)
        if cmp(r, d) >= 0 {
            r = sub(r, d)
            if len(q) == 0 { q = [1] } else { q[0] = bit_or(q[0], 1) }
        }
        k -= 1
    }
    trimmed(q)
}

// bits lo..lo+63 as an i64 (the same bits)
fn word(a: List[i64], lo: i64) -> i64 {
    var v = 0
    for i in 0..64 {
        if bit_at(a, lo + i) == 1 { v = bit_or(v, shl(1, i)) }
    }
    v
}

fn lit(v: i64) -> str {
    if v == -9223372036854775807 - 1 { "-9223372036854775807 - 1" } else { str(v) }
}

let nl = from_codes([10])
var pow5_lo = []
var pow5_hi = []
var inv_lo = []
var inv_hi = []
var p = big(1)
for i in 0..342 {
    let n = bits(p)
    if i < 326 {
        let v = if n > 125 { shr_big(p, n - 125) } else { shl_big(p, 125 - n) }
        pow5_lo.push("        " + str(i) + " => " + lit(word(v, 0)) + ",")
        pow5_hi.push("        " + str(i) + " => " + lit(word(v, 64)) + ",")
    }
    let inv = pow2_div(n - 1 + 125, p)
    var inv1 = inv
    // + 1
    var carry = 1
    for k in 0..len(inv1) {
        if carry == 1 {
            inv1[k] = inv1[k] + 1
            if inv1[k] == 1073741824 { inv1[k] = 0 } else { carry = 0 }
        }
    }
    if carry == 1 { inv1.push(1) }
    inv_lo.push("        " + str(i) + " => " + lit(word(inv1, 0)) + ",")
    inv_hi.push("        " + str(i) + " => " + lit(word(inv1, 64)) + ",")
    p = mul_small(p, 5)
}

fn table(name: str, what: str, arms: List[str]) -> str {
    let nl = from_codes([10])
    "// " + what + nl + "fn " + name + "(i: i64) -> i64 {" + nl + "    match i {" + nl + join(arms, nl) + nl + "        _ => 0," + nl + "    }" + nl + "}" + nl
}

var out = "// The tables of Ryu for 64-bit floats, written by gen_ryu.krs (do not edit): 5^i and" + nl
out = out + "// 2^j / 5^i with 125 significant bits, each as its low and high 64 bits (i64, the same bits)." + nl + nl
out = out + table("rt_ryu_pow5_lo", "5^i, i < 326: the low 64 bits", pow5_lo) + nl
out = out + table("rt_ryu_pow5_hi", "5^i, i < 326: the high 64 bits", pow5_hi) + nl
out = out + table("rt_ryu_inv_lo", "floor(2^j / 5^i) + 1, i < 342: the low 64 bits", inv_lo) + nl
out = out + table("rt_ryu_inv_hi", "floor(2^j / 5^i) + 1, i < 342: the high 64 bits", inv_hi)
write_text(args()[0], out)
print("wrote " + args()[0])
