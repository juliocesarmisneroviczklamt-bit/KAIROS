// The type checker of Kairós, written in Kairós (M12), second part: the bodies. Statements,
// patterns, expressions and calls get the types src/types.rs gives them, by the same
// unification in the same order, and fail with the same first error; and each becomes the
// same HIR node (src/hir.rs) the Rust checker builds. What is not ported yet (a builtin added
// to the Rust checker and not here yet) stops the check with the code K0000.
import "check.krs"

fn mix_hint() -> str {
    "Kairós never mixes `i64` and `f64` silently: convert with `float(x)` or `int(x)`"
}

// An expression checked: its HIR and its type.
struct Ex {
    h: H,
    t: Ty,
}

fn typed(h: H, t: Ty) -> Ex {
    var ht = h
    ht.t = t
    Ex { h: ht, t: t }
}

// what a failed check returns (the error is in the checker)
fn bad() -> Ex {
    Ex { h: h_none(), t: Ty.TUnit }
}

// a node with the span of a syntax node
fn hspan(kind: str, text: str, kids: List[H], e: Node) -> H {
    hn(kind, text, -1, -1, kids, e.lo, e.hi)
}

fn hlit(value: str) -> H {
    hn("lit", value, -1, -1, [], -1, -1)
}

fn hval(h: H) -> H {
    hk("val", [h])
}

// an axis as a builtin's argument (-1: all of them)
fn ax_lit(a: i64) -> H {
    hval(hlit("i64 " + str(a)))
}

fn fail_at(inout ck: Checker, code: str, e: Node, msg: str, hint: str) -> Ty {
    ck_fail(inout ck, code, e.lo, e.hi, msg, hint)
    Ty.TUnit
}

fn fail_ex(inout ck: Checker, code: str, e: Node, msg: str, hint: str) -> Ex {
    ck_fail(inout ck, code, e.lo, e.hi, msg, hint)
    bad()
}

fn unsupported(inout ck: Checker, e: Node, what: str) -> Ex {
    fail_ex(inout ck, "K0000", e, "not in the checker written in Kairós yet: " + what, "")
}

fn mismatch(inout ck: Checker, got: str, want: str, lo: i64, hi: i64, hint: str) {
    let mixed = (got == "i64" and want == "f64") or (got == "f64" and want == "i64")
    let h = if hint != "" { hint } else if mixed { mix_hint() } else { "" }
    ck_fail_l(inout ck, if mixed { "E0107" } else { "E0101" }, lo, hi, "mismatched types: expected `" + want + "`, found `" + got + "`", "expected `" + want + "`", h)
}

fn expect_ty(inout ck: Checker, got: Ty, want: Ty, lo: i64, hi: i64) {
    if ck.failed { return }
    if unify(inout ck, got, want) { return }
    mismatch(inout ck, show(ck, got), show(ck, want), lo, hi, "")
}

fn expect_at(inout ck: Checker, got: Ty, want: Ty, e: Node) {
    expect_ty(inout ck, got, want, e.lo, e.hi)
}

// a fresh type variable: its id
fn fresh_id(inout ck: Checker, kind: i64) -> i64 {
    let _ = fresh(inout ck, kind)
    len(ck.subst) - 1
}

fn ensure_numeric(inout ck: Checker, t: Ty, e: Node, what: str) {
    if ck.failed { return }
    let r = resolve(ck, t)
    match r {
        TInt => {},
        TFloat => {},
        TNever => {},
        TVar(v) => { ck.kinds[v] = 1 },
        _ => { let _ = fail_at(inout ck, "E0101", e, what + " needs a number, found `" + show(ck, r) + "`", "") },
    }
}

// Unresolved numeric variables inside `t` become `i64` (done at `let` boundaries).
fn default_nums(inout ck: Checker, t: Ty) {
    match resolve(ck, t) {
        TVar(v) => {
            if ck.kinds[v] == 1 {
                ck.subst[v] = Ty.TInt
                ck.bound[v] = true
            }
        },
        TList(x) => default_nums(inout ck, x),
        TMap(k, x) => {
            default_nums(inout ck, k)
            default_nums(inout ck, x)
        },
        TTuple(xs) => {
            for x in xs { default_nums(inout ck, x) }
        },
        TFn(ps, r) => {
            for x in ps { default_nums(inout ck, x) }
            default_nums(inout ck, r)
        },
        _ => {},
    }
}

fn list_elem(inout ck: Checker, t: Ty, e: Node) -> Ty {
    if ck.failed { return Ty.TUnit }
    let r = resolve(ck, t)
    match r {
        TList(x) => x,
        TVar(v) => {
            let x = fresh(inout ck, 0)
            expect_at(inout ck, t, Ty.TList(x), e)
            x
        },
        _ => fail_at(inout ck, "E0101", e, "expected a list, found `" + show(ck, r) + "`", ""),
    }
}

fn is_tensor(ck: Checker, t: Ty) -> bool {
    match resolve(ck, t) {
        TTensor(a, x) => true,
        _ => false,
    }
}

// The element type of a tensor, or the type itself.
fn elem_of(ck: Checker, t: Ty) -> Ty {
    let r = resolve(ck, t)
    match r {
        TTensor(a, x) => x,
        _ => r,
    }
}

// f64, f64 tensors, and structs, tuples and lists of them (the types `grad` works on).
fn differentiable(ck: Checker, t: Ty) -> bool {
    let none: List[i64] = []
    diff_go(ck, t, none)
}

fn diff_go(ck: Checker, t: Ty, seen: List[i64]) -> bool {
    match resolve(ck, t) {
        TFloat => true,
        TTensor(a, x) => x == Ty.TFloat,
        TStruct(id) => {
            if contains(seen, id) { return false }
            var s2 = seen
            s2.push(id)
            for f in ck.structs[id].fields {
                if not diff_go(ck, f.1, s2) { return false }
            }
            true
        },
        TTuple(ts) => {
            for x in ts {
                if not diff_go(ck, x, seen) { return false }
            }
            true
        },
        TList(x) => diff_go(ck, x, seen),
        TParam(p) => true,
        _ => false,
    }
}

// A struct, tuple or type parameter made of differentiable values: the tangent space, where
// `p - 0.01 * g` works field by field.
fn tangent(ck: Checker, t: Ty) -> bool {
    match resolve(ck, t) {
        TStruct(i) => differentiable(ck, t),
        TTuple(xs) => differentiable(ck, t),
        TParam(p) => differentiable(ck, t),
        _ => false,
    }
}

// ------------------------------------------------------------------ scopes

fn push_scope(inout ck: Checker) {
    let k = len(ck.ctxs) - 1
    let s: Map[str, Local] = [:]
    ck.ctxs[k].scopes.push(s)
}

fn pop_scope(inout ck: Checker) {
    let k = len(ck.ctxs) - 1
    let _ = ck.ctxs[k].scopes.pop()
}

fn declare(inout ck: Checker, name: str, t: Ty, mutable: bool) -> i64 {
    let affine = resolve(ck, t) == Ty.THoldout
    let k = len(ck.ctxs) - 1
    let depth = ck.ctxs[k].loops
    let slot = new_slot(inout ck.ctxs[k], t)
    let j = len(ck.ctxs[k].scopes) - 1
    ck.ctxs[k].scopes[j][name] = Local { slot: slot, ty: t, mutable: mutable, affine: affine, loop_depth: depth, captured: false }
    slot
}

fn no_local() -> Local {
    Local { slot: -1, ty: Ty.TUnit, mutable: false, affine: false, loop_depth: 0, captured: false }
}

// the local `name` in the scopes of a context, innermost first
fn find_local(c: Ctx, name: str) -> (bool, Local) {
    var j = len(c.scopes) - 1
    while j >= 0 {
        if contains(c.scopes[j], name) { return (true, c.scopes[j][name]) }
        j -= 1
    }
    (false, no_local())
}

fn lookup(inout ck: Checker, name: str) -> (bool, Local) {
    let n = len(ck.ctxs)
    if n == 0 { return (false, no_local()) }
    lookup_in(inout ck, n - 1, name)
}

// Lambdas capture outer locals by value: the first use creates a slot in the lambda frame.
fn lookup_in(inout ck: Checker, ci: i64, name: str) -> (bool, Local) {
    let r = find_local(ck.ctxs[ci], name)
    if r.0 { return r }
    if ck.ctxs[ci].kind == 2 and ci > 0 {
        let o = lookup_in(inout ck, ci - 1, name)
        if not o.0 { return o }
        let slot = new_slot(inout ck.ctxs[ci], o.1.ty)
        ck.ctxs[ci].captures.push((o.1.slot, slot))
        let l = Local { slot: slot, ty: o.1.ty, mutable: false, affine: o.1.affine, loop_depth: 0, captured: true }
        ck.ctxs[ci].scopes[0][name] = l
        return (true, l)
    }
    (false, no_local())
}

// ------------------------------------------------------------------ statements and blocks

fn expr0(inout ck: Checker, e: Node) -> Ex {
    ck_expr(inout ck, e, false, Ty.TUnit)
}

fn expr1(inout ck: Checker, e: Node, want: Ty) -> Ex {
    ck_expr(inout ck, e, true, want)
}

fn ck_stmt(inout ck: Checker, s: Node) -> Ex {
    if s.kind != "let" and s.kind != "var" { return expr0(inout ck, s) }
    var declared = Ty.TUnit
    let has_decl = s.kids[1].kind != "-"
    if has_decl {
        declared = resolve_type(inout ck, s.kids[1])
        if ck.failed { return bad() }
    }
    let init = s.kids[2]
    let r = ck_expr(inout ck, init, has_decl, declared)
    if ck.failed { return bad() }
    var t = r.t
    if has_decl {
        expect_at(inout ck, t, declared, init)
        if ck.failed { return bad() }
        t = declared
    } else {
        default_nums(inout ck, t)
    }
    let hp = ck_pattern(inout ck, s.kids[0], t, s.kind == "var", false)
    if ck.failed { return bad() }
    typed(hk("let", [hp, r.h]), Ty.TUnit)
}

fn ck_block(inout ck: Checker, b: Node, has_exp: bool, exp: Ty) -> Ex {
    push_scope(inout ck)
    let r = block_in(inout ck, b, has_exp, exp)
    pop_scope(inout ck)
    r
}

fn block_in(inout ck: Checker, b: Node, has_exp: bool, exp: Ty) -> Ex {
    var diverges = false
    var hs: List[H] = []
    for s in b.kids[0].kids {
        let r = ck_stmt(inout ck, s)
        if ck.failed { return bad() }
        if resolve(ck, r.t) == Ty.TNever { diverges = true }
        hs.push(r.h)
    }
    let tail = b.kids[1]
    if tail.kind != "-" {
        let r = ck_expr(inout ck, tail, has_exp, exp)
        if ck.failed { return bad() }
        hs.push(r.h)
        return typed(hk("block", hs), r.t)
    }
    hs.push(h_none())
    typed(hk("block", hs), if diverges { Ty.TNever } else { Ty.TUnit })
}

// ------------------------------------------------------------------ patterns

// A pattern: its HIR (`pwild`, `pbind`, `plit`, `pintlit`, `ptuple`, `pvariant`).
fn ck_pattern(inout ck: Checker, p: Node, t: Ty, mutable: bool, refutable_ok: bool) -> H {
    let k = p.kind
    if k == "pwild" { return hk("pwild", []) }
    if k == "pbind" {
        let slot = declare(inout ck, p.text, t, mutable)
        return hn("pbind", "", slot, -1, [], -1, -1)
    }
    if k == "ptuple" {
        var elems: List[Ty] = []
        var known = false
        match resolve(ck, t) {
            TTuple(ts) => {
                if len(ts) == len(p.kids) {
                    elems = ts
                    known = true
                }
            },
            _ => {},
        }
        if not known {
            for q in p.kids { elems.push(fresh(inout ck, 0)) }
            expect_ty(inout ck, Ty.TTuple(elems), t, p.lo, p.hi)
            if ck.failed { return h_none() }
        }
        var subs: List[H] = []
        for i in 0..len(p.kids) {
            let sub = ck_pattern(inout ck, p.kids[i], elems[i], mutable, refutable_ok)
            if ck.failed { return h_none() }
            subs.push(sub)
        }
        return hk("ptuple", subs)
    }
    if not refutable_ok {
        ck_fail(inout ck, "E0117", p.lo, p.hi, "this pattern can fail to match here", "use `match` to test values; `let` and `for` only bind names and tuples")
        return h_none()
    }
    if k == "pint" {
        let id = fresh_id(inout ck, 1)
        expect_ty(inout ck, Ty.TVar(id), t, p.lo, p.hi)
        return hn("pintlit", p.text, id, -1, [], -1, -1)
    }
    if k == "pstr" {
        expect_ty(inout ck, Ty.TStr, t, p.lo, p.hi)
        return hn("plit", "str " + p.text, -1, -1, [], -1, -1)
    }
    if k == "pbool" {
        expect_ty(inout ck, Ty.TBool, t, p.lo, p.hi)
        return hn("plit", "bool " + p.text, -1, -1, [], -1, -1)
    }
    variant_pattern(inout ck, p, t, mutable, refutable_ok)
}

fn variant_pattern(inout ck: Checker, p: Node, t: Ty, mutable: bool, refutable_ok: bool) -> H {
    let dot = find(p.text, ".")
    let ename = substr(p.text, 0, dot)
    let vname = substr(p.text, dot + 1, len(p.text))
    var eid = -1
    if ename != "" {
        if not contains(ck.enum_ids, ename) {
            ck_fail(inout ck, "E0100", p.lo, p.hi, "unknown enum `" + ename + "`", "")
            return h_none()
        }
        eid = ck.enum_ids[ename]
    } else {
        match resolve(ck, t) {
            TEnum(x) => { eid = x },
            _ => {},
        }
        if eid < 0 {
            var found: List[i64] = []
            for i in 0..len(ck.enums) {
                for v in ck.enums[i].variants {
                    if v.0 == vname {
                        found.push(i)
                        break
                    }
                }
            }
            if len(found) == 0 {
                ck_fail(inout ck, "E0100", p.lo, p.hi, "unknown variant `" + vname + "`", "")
                return h_none()
            }
            if len(found) > 1 {
                ck_fail(inout ck, "E0100", p.lo, p.hi, "ambiguous variant `" + vname + "`", "qualify it: `Enum.Variant`")
                return h_none()
            }
            eid = found[0]
        }
    }
    expect_ty(inout ck, Ty.TEnum(eid), t, p.lo, p.hi)
    if ck.failed { return h_none() }
    let def = ck.enums[eid]
    var vi = -1
    for i in 0..len(def.variants) {
        if def.variants[i].0 == vname {
            vi = i
            break
        }
    }
    if vi < 0 {
        ck_fail(inout ck, "E0100", p.lo, p.hi, "enum `" + def.name + "` has no variant `" + vname + "`", "")
        return h_none()
    }
    let ptys = def.variants[vi].1
    if len(ptys) != len(p.kids) {
        ck_fail(inout ck, "E0103", p.lo, p.hi, "variant `" + vname + "` has " + str(len(ptys)) + " field(s), but the pattern has " + str(len(p.kids)), "")
        return h_none()
    }
    var subs: List[H] = []
    for i in 0..len(ptys) {
        let sub = ck_pattern(inout ck, p.kids[i], ptys[i], mutable, refutable_ok)
        if ck.failed { return h_none() }
        subs.push(sub)
    }
    hn("pvariant", "", eid, vi, subs, -1, -1)
}

fn irrefutable(p: H) -> bool {
    if p.kind == "pwild" or p.kind == "pbind" { return true }
    if p.kind == "ptuple" {
        for q in p.kids {
            if not irrefutable(q) { return false }
        }
        return true
    }
    false
}

fn check_exhaustive(inout ck: Checker, t: Ty, pats: List[H], e: Node) {
    for p in pats {
        if irrefutable(p) { return }
    }
    var missing = "_"
    match resolve(ck, t) {
        TBool => {
            var has_true = false
            var has_false = false
            for p in pats {
                if p.kind == "plit" and p.text == "bool true" { has_true = true }
                if p.kind == "plit" and p.text == "bool false" { has_false = true }
            }
            missing = if not has_true { "true" } else if not has_false { "false" } else { "" }
        },
        TEnum(eid) => {
            missing = ""
            let def = ck.enums[eid]
            for vi in 0..len(def.variants) {
                var covered = false
                for p in pats {
                    if p.kind == "pvariant" and p.n == eid and p.m == vi {
                        var whole = true
                        for q in p.kids {
                            if not irrefutable(q) { whole = false }
                        }
                        if whole { covered = true }
                    }
                }
                if not covered {
                    missing = def.name + "." + def.variants[vi].0
                    break
                }
            }
        },
        _ => {},
    }
    if missing != "" {
        ck_fail(inout ck, "E0110", e.lo, e.hi, "non-exhaustive match: `" + missing + "` is not covered", "add an arm for it, or a catch-all `_ => ...` arm")
    }
}

// ------------------------------------------------------------------ places (assignment targets)

// A place: its HIR (`plocal`, `pfield`, `pindex`), its type, the slot of the variable it is
// part of.
fn place(inout ck: Checker, e: Node) -> (H, Ty, i64) {
    if ck.failed { return (h_none(), Ty.TUnit, -1) }
    if e.kind == "name" {
        let n = e.text
        let r = lookup(inout ck, n)
        if not r.0 {
            let _ = fail_at(inout ck, "E0100", e, "cannot find `" + n + "` in this scope", "")
            return (h_none(), Ty.TUnit, -1)
        }
        if r.1.affine {
            let _ = fail_at(inout ck, "E0501", e, "holdout `" + n + "` cannot be assigned or passed as `inout`", "a holdout is opened once: `open_once(h, weights)`")
            return (h_none(), Ty.TUnit, -1)
        }
        if not r.1.mutable {
            let _ = fail_at(inout ck, "E0104", e, "cannot modify `" + n + "`: it is not mutable", "declare it with `var " + n + " = ...` (or as an `inout` parameter)")
            return (h_none(), Ty.TUnit, -1)
        }
        return (hn("plocal", "", r.1.slot, -1, [], -1, -1), r.1.ty, r.1.slot)
    }
    if e.kind == "field" {
        let r = place(inout ck, e.kids[0])
        if ck.failed { return r }
        let f = field_of(inout ck, r.1, e.text, e)
        return (hn("pfield", "", f.0, -1, [r.0], -1, -1), f.1, r.2)
    }
    if e.kind == "tindex" {
        let r = place(inout ck, e.kids[0])
        if ck.failed { return r }
        let k = parse_int(e.text)
        let et = tuple_elem(inout ck, r.1, k, e)
        return (hn("pfield", "", k, -1, [r.0], -1, -1), et, r.2)
    }
    if e.kind == "index" {
        let obj = e.kids[0]
        let r = place(inout ck, obj)
        if ck.failed { return r }
        let t = r.1
        if is_tensor(ck, t) {
            let _ = fail_at(inout ck, "E0116", e, "a tensor slice cannot be passed as `inout` or changed in parts", "assign to the slice directly, e.g. `x[month: i] = v`")
            return r
        }
        let idx = list_index(inout ck, e.kids[1].kids, t)
        if ck.failed { return r }
        match resolve(ck, t) {
            TMap(kt, vt) => {
                let k = expr1(inout ck, idx, kt)
                expect_at(inout ck, k.t, kt, idx)
                return (hspan("pindex", "", [r.0, k.h], e), vt, r.2)
            },
            _ => {},
        }
        let elem = list_elem(inout ck, t, obj)
        if ck.failed { return r }
        let i = expr1(inout ck, idx, Ty.TInt)
        expect_at(inout ck, i.t, Ty.TInt, idx)
        return (hspan("pindex", "", [r.0, i.h], e), elem, r.2)
    }
    let _ = fail_at(inout ck, "E0116", e, "this expression cannot be assigned to or passed as `inout`", "")
    (h_none(), Ty.TUnit, -1)
}

// The single positional index of a list (`xs[i]`).
fn list_index(inout ck: Checker, idx: List[Node], t: Ty) -> Node {
    for it in idx {
        let ax = it.kids[0]
        if ax.kind != "-" {
            match resolve(ck, t) {
                TVar(v) => { let _ = fail_at(inout ck, "E0202", ax, "cannot index by axis `" + ax.text + "` here: the type of this value is not known yet", "add a type annotation, e.g. `x: Tensor[month, asset; f64]`") },
                _ => { let _ = fail_at(inout ck, "E0202", ax, "`" + show(ck, t) + "` has no named axes", "only tensors are indexed by axis; lists take a position: `xs[i]`") },
            }
            return none_node()
        }
    }
    if len(idx) > 1 {
        let _ = fail_at(inout ck, "E0103", idx[1].kids[1], "a list takes a single index", "for a list of lists write `xs[i][j]`")
        return none_node()
    }
    idx[0].kids[1]
}

// A field of a struct: (its index, its type).
fn field_of(inout ck: Checker, t: Ty, f: str, e: Node) -> (i64, Ty) {
    if ck.failed { return (-1, Ty.TUnit) }
    let r = resolve(ck, t)
    match r {
        TStruct(sid) => {
            let fields = ck.structs[sid].fields
            for i in 0..len(fields) {
                if fields[i].0 == f { return (i, fields[i].1) }
            }
            (-1, fail_at(inout ck, "E0105", e, "struct `" + ck.structs[sid].name + "` has no field `" + f + "`", ""))
        },
        TVar(v) => (-1, fail_at(inout ck, "E0105", e, "type `" + show(ck, r) + "` has no field `" + f + "`", "add a type annotation so Kairós knows the type here")),
        _ => (-1, fail_at(inout ck, "E0105", e, "type `" + show(ck, r) + "` has no field `" + f + "`", "fields exist on structs; tuple elements are `.0`, `.1`, ...")),
    }
}

fn tuple_elem(inout ck: Checker, t: Ty, k: i64, e: Node) -> Ty {
    if ck.failed { return Ty.TUnit }
    let r = resolve(ck, t)
    match r {
        TTuple(ts) => {
            if k < len(ts) { return ts[k] }
            fail_at(inout ck, "E0105", e, "tuple has " + str(len(ts)) + " element(s), there is no `." + str(k) + "`", "")
        },
        _ => fail_at(inout ck, "E0105", e, "type `" + show(ck, r) + "` is not a tuple", "add a type annotation so Kairós knows the type here"),
    }
}

// ------------------------------------------------------------------ expressions

fn ck_expr(inout ck: Checker, e: Node, has_exp: bool, exp: Ty) -> Ex {
    if ck.failed { return bad() }
    let k = e.kind
    if k == "int" {
        let id = fresh_id(inout ck, 1)
        let t = Ty.TVar(id)
        if has_exp { let _ = unify(inout ck, t, exp) }
        return typed(hn("intlit", e.text, id, -1, [], -1, -1), t)
    }
    if k == "float" { return typed(hlit("f64 " + e.text), Ty.TFloat) }
    if k == "str" { return typed(hlit("str " + e.text), Ty.TStr) }
    if k == "bool" { return typed(hlit("bool " + e.text), Ty.TBool) }
    if k == "unit" { return typed(hlit("unit"), Ty.TUnit) }
    if k == "name" { return name_expr(inout ck, e) }
    if k == "list" { return list_expr(inout ck, e, has_exp, exp) }
    if k == "map" { return map_expr(inout ck, e, has_exp, exp) }
    if k == "tuple" { return tuple_expr(inout ck, e, has_exp, exp) }
    if k == "structlit" { return ck_struct_lit(inout ck, e) }
    if k == "field" { return field_expr(inout ck, e) }
    if k == "tindex" {
        let r = expr0(inout ck, e.kids[0])
        let kk = parse_int(e.text)
        let et = tuple_elem(inout ck, r.t, kk, e)
        if ck.failed { return bad() }
        return typed(hn("field", "", kk, -1, [r.h], -1, -1), et)
    }
    if k == "index" { return index_expr(inout ck, e) }
    if k == "call" { return call_expr(inout ck, e) }
    if k == "method" { return method_call(inout ck, e) }
    if k == "neg" or k == "not" { return unary_expr(inout ck, e, has_exp, exp) }
    if k == "bin" { return binary(inout ck, e) }
    if k == "and" or k == "or" { return logic_expr(inout ck, e) }
    if k == "assign" { return assign_expr(inout ck, e) }
    if k == "if" { return ck_if_expr(inout ck, e, has_exp, exp) }
    if k == "while" {
        let cond = e.kids[0]
        let c = expr1(inout ck, cond, Ty.TBool)
        expect_at(inout ck, c.t, Ty.TBool, cond)
        if ck.failed { return bad() }
        let body = e.kids[1]
        let b = loop_body(inout ck, body)
        expect_at(inout ck, b.t, Ty.TUnit, body)
        if ck.failed { return bad() }
        return typed(hk("while", [c.h, b.h]), Ty.TUnit)
    }
    if k == "for" { return for_expr(inout ck, e) }
    if k == "range" { return fail_ex(inout ck, "E0113", e, "ranges can only be used in `for` loops and tensor indices (for now)", "") }
    if k == "match" { return ck_match_expr(inout ck, e, has_exp, exp) }
    if k == "lambda" { return ck_lambda(inout ck, e, has_exp, exp) }
    if k == "block" { return ck_block(inout ck, e, has_exp, exp) }
    if k == "return" { return return_expr(inout ck, e) }
    // `break` and `continue`
    if ck.ctxs[len(ck.ctxs) - 1].loops == 0 { return fail_ex(inout ck, "E0119", e, "`break` and `continue` must be inside a loop", "") }
    typed(hk(k, []), Ty.TNever)
}

fn list_expr(inout ck: Checker, e: Node, has_exp: bool, exp: Ty) -> Ex {
    var elem = Ty.TUnit
    var known = false
    if has_exp {
        match resolve(ck, exp) {
            TList(t) => {
                elem = t
                known = true
            },
            _ => {},
        }
    }
    if not known { elem = fresh(inout ck, 0) }
    var hs: List[H] = []
    for it in e.kids {
        let r = expr1(inout ck, it, elem)
        expect_at(inout ck, r.t, elem, it)
        if ck.failed { return bad() }
        hs.push(r.h)
    }
    typed(hk("list", hs), Ty.TList(elem))
}

fn map_expr(inout ck: Checker, e: Node, has_exp: bool, exp: Ty) -> Ex {
    var kt = Ty.TUnit
    var vt = Ty.TUnit
    var known = false
    if has_exp {
        match resolve(ck, exp) {
            TMap(a, b) => {
                kt = a
                vt = b
                known = true
            },
            _ => {},
        }
    }
    if not known {
        kt = fresh(inout ck, 2)
        vt = fresh(inout ck, 0)
    }
    var hs: List[H] = []
    for pr in e.kids {
        let kn = pr.kids[0]
        let rk = expr1(inout ck, kn, kt)
        if ck.failed { return bad() }
        if not unify(inout ck, rk.t, kt) {
            return fail_ex(inout ck, "E0101", kn, "map keys must be `i64` or `str` (all of one type), found `" + show(ck, rk.t) + "`", "")
        }
        let vn = pr.kids[1]
        let rv = expr1(inout ck, vn, vt)
        expect_at(inout ck, rv.t, vt, vn)
        if ck.failed { return bad() }
        hs.push(rk.h)
        hs.push(rv.h)
    }
    typed(hk("map", hs), Ty.TMap(kt, vt))
}

fn tuple_expr(inout ck: Checker, e: Node, has_exp: bool, exp: Ty) -> Ex {
    var want: List[Ty] = []
    if has_exp {
        match resolve(ck, exp) {
            TTuple(ts) => {
                if len(ts) == len(e.kids) { want = ts }
            },
            _ => {},
        }
    }
    var hs: List[H] = []
    var ts: List[Ty] = []
    for i in 0..len(e.kids) {
        let r = if len(want) > 0 { expr1(inout ck, e.kids[i], want[i]) } else { expr0(inout ck, e.kids[i]) }
        if ck.failed { return bad() }
        hs.push(r.h)
        ts.push(r.t)
    }
    typed(hk("tuple", hs), Ty.TTuple(ts))
}

fn field_expr(inout ck: Checker, e: Node) -> Ex {
    let obj = e.kids[0]
    if obj.kind == "name" {
        if not lookup(inout ck, obj.text).0 and contains(ck.enum_ids, obj.text) {
            let none: List[Node] = []
            return variant_ctor(inout ck, ck.enum_ids[obj.text], e.text, none, e)
        }
    }
    let r = expr0(inout ck, obj)
    let f = field_of(inout ck, r.t, e.text, e)
    if ck.failed { return bad() }
    typed(hn("field", "", f.0, -1, [r.h], -1, -1), f.1)
}

fn index_expr(inout ck: Checker, e: Node) -> Ex {
    let obj = e.kids[0]
    let o = expr0(inout ck, obj)
    if ck.failed { return bad() }
    let to = o.t
    if is_tensor(ck, to) {
        let s = tensor_sels(inout ck, tensor_axes(ck, to), to, e.kids[1].kids)
        if ck.failed { return bad() }
        var kids = [o.h]
        for x in s.0 { kids.push(x) }
        return typed(hspan("tindex", "", kids, e), mk_tensor(s.1, elem_of(ck, to)))
    }
    let idx = list_index(inout ck, e.kids[1].kids, to)
    if ck.failed { return bad() }
    match resolve(ck, to) {
        TMap(kt, vt) => {
            let rk = expr1(inout ck, idx, kt)
            expect_at(inout ck, rk.t, kt, idx)
            if ck.failed { return bad() }
            return typed(hspan("index", "", [o.h, rk.h], e), vt)
        },
        _ => {},
    }
    let elem = list_elem(inout ck, to, obj)
    if ck.failed { return bad() }
    let ri = expr1(inout ck, idx, Ty.TInt)
    expect_at(inout ck, ri.t, Ty.TInt, idx)
    if ck.failed { return bad() }
    typed(hspan("index", "", [o.h, ri.h], e), elem)
}

fn unary_expr(inout ck: Checker, e: Node, has_exp: bool, exp: Ty) -> Ex {
    let x = e.kids[0]
    let r = ck_expr(inout ck, x, has_exp, exp)
    if ck.failed { return bad() }
    let t = r.t
    let neg = e.kind == "neg"
    let h = hspan("unary", if neg { "-" } else { "not" }, [r.h], e)
    match resolve(ck, t) {
        TTensor(a, elem) => {
            let want = if neg { Ty.TFloat } else { Ty.TBool }
            let word = if neg { "`-`" } else { "`not`" }
            if elem != want {
                return fail_ex(inout ck, "E0101", e, word + " needs a `" + show(ck, want) + "` tensor, found `" + show(ck, t) + "`", "")
            }
            return typed(h, t)
        },
        _ => {},
    }
    if neg {
        if not tangent(ck, t) { ensure_numeric(inout ck, t, e, "`-`") }
    } else {
        expect_at(inout ck, t, Ty.TBool, x)
    }
    if ck.failed { return bad() }
    typed(h, t)
}

fn logic_expr(inout ck: Checker, e: Node) -> Ex {
    let l = e.kids[0]
    let r = e.kids[1]
    let a = expr1(inout ck, l, Ty.TBool)
    if ck.failed { return bad() }
    let tl = a.t
    let lt = is_tensor(ck, tl)
    if not lt {
        expect_at(inout ck, tl, Ty.TBool, l)
        if ck.failed { return bad() }
    }
    let b = expr1(inout ck, r, Ty.TBool)
    if ck.failed { return bad() }
    let tr = b.t
    if not lt and not is_tensor(ck, tr) {
        expect_at(inout ck, tr, Ty.TBool, r)
        if ck.failed { return bad() }
        return typed(hk(e.kind, [a.h, b.h]), Ty.TBool)
    }
    // element-wise on bool tensors (no short-circuit)
    let word = "`" + e.kind + "`"
    let axes = frame_axes(inout ck, [(tl, l), (tr, r)], word, e)
    if ck.failed { return bad() }
    let first = elem_of(ck, tl)
    let et = elem_of(ck, tr)
    if not unify(inout ck, first, et) {
        return fail_ex(inout ck, "E0101", r, word + " mixes `" + show(ck, first) + "` and `" + show(ck, et) + "` values", "")
    }
    let elem = resolve(ck, first)
    if elem != Ty.TBool { return fail_ex(inout ck, "E0101", e, word + " needs `bool` values, found `" + show(ck, elem) + "`", "") }
    typed(hspan("builtin", e.kind, [hval(a.h), hval(b.h)], e), mk_tensor(axes, Ty.TBool))
}

fn assign_expr(inout ck: Checker, e: Node) -> Ex {
    let target = e.kids[0]
    let value = e.kids[1]
    let op = e.text
    if target.kind == "index" {
        let whole = place(inout ck, target.kids[0])
        if ck.failed { return bad() }
        let tw = whole.1
        if is_tensor(ck, tw) {
            let elem = elem_of(ck, tw)
            let s = tensor_sels(inout ck, tensor_axes(ck, tw), tw, target.kids[1].kids)
            if ck.failed { return bad() }
            let v = expr1(inout ck, value, elem)
            if ck.failed { return bad() }
            check_tensor_store(inout ck, s.1, elem, v.t, op, true, value, e)
            if ck.failed { return bad() }
            var kids = [whole.0]
            for x in s.0 { kids.push(x) }
            kids.push(v.h)
            return typed(hspan("tassign", op, kids, e), Ty.TUnit)
        }
    }
    let p = place(inout ck, target)
    if ck.failed { return bad() }
    let t = p.1
    if is_tensor(ck, t) {
        let v = expr1(inout ck, value, t)
        if ck.failed { return bad() }
        check_tensor_store(inout ck, tensor_axes(ck, t), elem_of(ck, t), v.t, op, false, value, e)
        if ck.failed { return bad() }
        if op == "=" { return typed(hk("assign", [p.0, v.h]), Ty.TUnit) }
        return typed(hspan("opassign", op, [p.0, v.h], e), Ty.TUnit)
    }
    let v = expr1(inout ck, value, t)
    expect_at(inout ck, v.t, t, value)
    if ck.failed { return bad() }
    if op == "=" { return typed(hk("assign", [p.0, v.h]), Ty.TUnit) }
    if not (resolve(ck, t) == Ty.TStr and op == "+") {
        ensure_numeric(inout ck, t, e, "`" + op + "=`")
        if ck.failed { return bad() }
    }
    typed(hspan("opassign", op, [p.0, v.h], e), Ty.TUnit)
}

fn ck_if_expr(inout ck: Checker, e: Node, has_exp: bool, exp: Ty) -> Ex {
    let cond = e.kids[0]
    let c = expr1(inout ck, cond, Ty.TBool)
    expect_at(inout ck, c.t, Ty.TBool, cond)
    if ck.failed { return bad() }
    let then = e.kids[1]
    let tb = ck_block(inout ck, then, has_exp, exp)
    if ck.failed { return bad() }
    let tt = tb.t
    let els = e.kids[2]
    if els.kind == "-" {
        if not unify(inout ck, tt, Ty.TUnit) {
            let tail = then.kids[1]
            let at = if tail.kind != "-" { tail } else { then }
            mismatch(inout ck, show(ck, tt), "()", at.lo, at.hi, "an `if` without `else` produces no value: add an `else` branch")
            return bad()
        }
        return typed(hk("if", [c.h, tb.h, h_none()]), Ty.TUnit)
    }
    let never = resolve(ck, tt) == Ty.TNever
    let eb = if never { ck_expr(inout ck, els, has_exp, exp) } else { expr1(inout ck, els, tt) }
    if ck.failed { return bad() }
    let te = eb.t
    if not unify(inout ck, tt, te) {
        return fail_ex(inout ck, "E0101", els, "`if` and `else` have incompatible types: `" + show(ck, tt) + "` and `" + show(ck, te) + "`", "")
    }
    typed(hk("if", [c.h, tb.h, eb.h]), if resolve(ck, tt) == Ty.TNever { te } else { tt })
}

fn return_expr(inout ck: Checker, e: Node) -> Ex {
    let k = len(ck.ctxs) - 1
    if ck.ctxs[k].kind == 0 { return fail_ex(inout ck, "E0118", e, "`return` outside of a function", "") }
    let ret = ck.ctxs[k].ret
    let x = e.kids[0]
    if x.kind != "-" {
        let r = expr1(inout ck, x, ret)
        expect_at(inout ck, r.t, ret, x)
        if ck.failed { return bad() }
        return typed(hk("return", [r.h]), Ty.TNever)
    }
    expect_at(inout ck, Ty.TUnit, ret, e)
    if ck.failed { return bad() }
    typed(hk("return", [h_none()]), Ty.TNever)
}

fn loop_body(inout ck: Checker, body: Node) -> Ex {
    let k = len(ck.ctxs) - 1
    ck.ctxs[k].loops += 1
    let r = ck_block(inout ck, body, true, Ty.TUnit)
    ck.ctxs[k].loops -= 1
    r
}

fn for_expr(inout ck: Checker, e: Node) -> Ex {
    let pat = e.kids[0]
    let iter = e.kids[1]
    let body = e.kids[2]
    if iter.kind == "range" {
        let lo = iter.kids[0]
        let hi = iter.kids[1]
        let a = expr1(inout ck, lo, Ty.TInt)
        expect_at(inout ck, a.t, Ty.TInt, lo)
        if ck.failed { return bad() }
        let b = expr1(inout ck, hi, Ty.TInt)
        expect_at(inout ck, b.t, Ty.TInt, hi)
        if ck.failed { return bad() }
        push_scope(inout ck)
        var slot = -1
        var name = "_"
        if pat.kind == "pbind" {
            slot = declare(inout ck, pat.text, Ty.TInt, false)
            name = pat.text
        } else if pat.kind == "pwild" {
            slot = declare(inout ck, "_", Ty.TInt, false)
        } else {
            pop_scope(inout ck)
            return fail_ex(inout ck, "E0117", pat, "a range loop binds a single name", "")
        }
        let rb = loop_body(inout ck, body)
        expect_at(inout ck, rb.t, Ty.TUnit, body)
        pop_scope(inout ck)
        if ck.failed { return bad() }
        let incl = if iter.text == "..=" { 1 } else { 0 }
        return typed(hn("forrange", name, slot, incl, [a.h, b.h, rb.h], -1, -1), Ty.TUnit)
    }
    let l = expr0(inout ck, iter)
    let elem = list_elem(inout ck, l.t, iter)
    if ck.failed { return bad() }
    push_scope(inout ck)
    let hp = ck_pattern(inout ck, pat, elem, false, false)
    var hb = h_none()
    if not ck.failed {
        let rb = loop_body(inout ck, body)
        expect_at(inout ck, rb.t, Ty.TUnit, body)
        hb = rb.h
    }
    pop_scope(inout ck)
    if ck.failed { return bad() }
    typed(hk("forlist", [hp, l.h, hb]), Ty.TUnit)
}

fn ck_match_expr(inout ck: Checker, e: Node, has_exp: bool, exp: Ty) -> Ex {
    let s = expr0(inout ck, e.kids[0])
    if ck.failed { return bad() }
    let ts = s.t
    var has = has_exp
    var result = exp
    var pats: List[H] = []
    var kids = [s.h]
    for arm in e.kids[1].kids {
        push_scope(inout ck)
        let hp = ck_pattern(inout ck, arm.kids[0], ts, false, true)
        let body = arm.kids[1]
        var rb = bad()
        if not ck.failed { rb = ck_expr(inout ck, body, has, result) }
        pop_scope(inout ck)
        if ck.failed { return bad() }
        let tb = rb.t
        if has {
            if not unify(inout ck, tb, result) {
                return fail_ex(inout ck, "E0101", body, "match arms have incompatible types: `" + show(ck, result) + "` and `" + show(ck, tb) + "`", "")
            }
            if resolve(ck, result) == Ty.TNever { result = tb }
        } else {
            result = tb
            has = true
        }
        pats.push(hp)
        kids.push(hk("arm", [hp, rb.h]))
    }
    check_exhaustive(inout ck, ts, pats, e)
    if ck.failed { return bad() }
    typed(hspan("match", "", kids, e), if has { result } else { Ty.TUnit })
}

fn ck_lambda(inout ck: Checker, e: Node, has_exp: bool, exp: Ty) -> Ex {
    let params = e.kids[0].kids
    let body = e.kids[1]
    var known = false
    var eps: List[Ty] = []
    var er = Ty.TUnit
    if has_exp {
        match resolve(ck, exp) {
            TFn(ps, r) => {
                if len(ps) == len(params) {
                    known = true
                    eps = ps
                    er = r
                }
            },
            _ => {},
        }
    }
    var ptys: List[Ty] = []
    for i in 0..len(params) {
        let te = params[i].kids[0]
        var t = Ty.TUnit
        if te.kind != "-" {
            t = resolve_type(inout ck, te)
            if ck.failed { return bad() }
            if known {
                expect_at(inout ck, t, eps[i], params[i])
                if ck.failed { return bad() }
            }
        } else if known {
            t = eps[i]
        } else {
            t = fresh(inout ck, 0)
        }
        ptys.push(t)
    }
    let ret = if known { er } else { fresh(inout ck, 0) }
    var c = ctx_new(2, ret)
    for i in 0..len(params) {
        let slot = new_slot(inout c, ptys[i])
        c.scopes[0][params[i].text] = Local { slot: slot, ty: ptys[i], mutable: false, affine: false, loop_depth: 0, captured: false }
    }
    ck.ctxs.push(c)
    let rb = expr1(inout ck, body, ret)
    let done = ck.ctxs.pop()
    if ck.failed { return bad() }
    expect_at(inout ck, rb.t, ret, body)
    if ck.failed { return bad() }
    let def = len(ck.lambdas)
    var outer = []
    var inner: List[i64] = []
    for cp in done.captures {
        outer.push(str(cp.0))
        inner.push(cp.1)
    }
    ck.lambdas.push(LambdaH { caps: inner, n_params: len(params), n_slots: done.n_slots, body: rb.h, slot_tys: done.slot_tys })
    typed(hn("lambda", join(outer, " "), def, -1, [], -1, -1), Ty.TFn(ptys, ret))
}

// A holdout is affine: using it consumes it (M5, E0501).
fn consume(inout ck: Checker, n: str, l: Local, e: Node) {
    let hint = "a holdout is opened once: use it in a single place, outside loops and lambdas"
    if l.captured {
        let _ = fail_at(inout ck, "E0501", e, "holdout `" + n + "` cannot be used inside a lambda", hint)
        return
    }
    let k = len(ck.ctxs) - 1
    if ck.ctxs[k].loops > l.loop_depth {
        let _ = fail_at(inout ck, "E0501", e, "holdout `" + n + "` cannot be used inside a loop: it would be opened more than once", hint)
        return
    }
    if contains(ck.ctxs[k].consumed, l.slot) {
        ck_fail_l(inout ck, "E0501", e.lo, e.hi, "holdout `" + n + "` was already used", "a holdout can be opened (or handed over) only once", hint)
        return
    }
    ck.ctxs[k].consumed[l.slot] = true
}

fn name_expr(inout ck: Checker, e: Node) -> Ex {
    let n = e.text
    let r = lookup(inout ck, n)
    if r.0 {
        if r.1.affine {
            consume(inout ck, n, r.1, e)
            if ck.failed { return bad() }
        }
        return typed(hn("local", "", r.1.slot, -1, [], -1, -1), r.1.ty)
    }
    if contains(ck.fn_ids, n) {
        let fid = ck.fn_ids[n]
        let sig = ck.sigs[fid]
        if len(sig.type_params) > 0 {
            return fail_ex(inout ck, "E0114", e, "generic function `" + n + "` cannot be used as a value yet", "call it directly, or wrap it in a lambda with concrete types")
        }
        var ps: List[Ty] = []
        for p in sig.params {
            if p.2 { return fail_ex(inout ck, "E0114", e, "`" + n + "` has `inout` parameters and cannot be used as a value", "") }
            ps.push(p.1)
        }
        return typed(hn("fnref", "", fid, -1, [], -1, -1), Ty.TFn(ps, sig.ret))
    }
    if n == "nan" { return typed(hlit("f64 NaN"), Ty.TFloat) }
    if n == "inf" { return typed(hlit("f64 inf"), Ty.TFloat) }
    if n == "pi" { return typed(hlit("f64 " + str(pi)), Ty.TFloat) }
    if n == "b3" { return fail_ex(inout ck, "E0101", e, "`b3` is the B3 data module, not a value", "call its functions, e.g. `b3.monthly_returns()`") }
    if contains(ck.builtins, n) {
        return fail_ex(inout ck, "E0114", e, "builtin `" + n + "` cannot be used as a value yet", "wrap it in a lambda, e.g. `|x| " + n + "(x)`")
    }
    if contains(ck.axis_ids, n) {
        return fail_ex(inout ck, "E0101", e, "`" + n + "` is an axis, not a value", "axes appear in types, in indices like `x[" + n + ": i]` and in arguments like `over: " + n + "`")
    }
    var hint = ""
    let in_fn = len(ck.ctxs) > 0 and ck.ctxs[0].kind != 0
    if in_fn and (contains(ck.top_names, n) or find_local(ck.main, n).0) {
        hint = "functions cannot read top-level variables: pass it as a parameter"
    }
    fail_ex(inout ck, "E0100", e, "cannot find `" + n + "` in this scope", hint)
}

fn ck_struct_lit(inout ck: Checker, e: Node) -> Ex {
    let name = e.text
    if not contains(ck.struct_ids, name) { return fail_ex(inout ck, "E0100", e, "unknown struct `" + name + "`", "") }
    let sid = ck.struct_ids[name]
    let fields = ck.structs[sid].fields
    // the values in the order of the declaration
    var vals: List[H] = []
    var given: List[bool] = []
    for f in fields {
        vals.push(h_none())
        given.push(false)
    }
    for init in e.kids {
        let fname = init.text
        let fe = init.kids[0]
        var idx = -1
        for i in 0..len(fields) {
            if fields[i].0 == fname {
                idx = i
                break
            }
        }
        if idx < 0 { return fail_ex(inout ck, "E0105", fe, "struct `" + name + "` has no field `" + fname + "`", "") }
        if given[idx] { return fail_ex(inout ck, "E0112", fe, "field `" + fname + "` is given twice", "") }
        let fty = fields[idx].1
        let r = expr1(inout ck, fe, fty)
        expect_at(inout ck, r.t, fty, fe)
        if ck.failed { return bad() }
        vals[idx] = r.h
        given[idx] = true
    }
    for i in 0..len(given) {
        if not given[i] { return fail_ex(inout ck, "E0105", e, "missing field `" + fields[i].0 + "` in `" + name + "`", "") }
    }
    typed(hn("struct", "", sid, -1, vals, -1, -1), Ty.TStruct(sid))
}

fn no_named_args(inout ck: Checker, call_args: List[Node], what: str) {
    for a in call_args {
        let nm = a.kids[0]
        if nm.kind != "-" {
            let _ = fail_at(inout ck, "E0120", nm, what + " does not take named arguments", "pass `" + nm.text + "` by position; named arguments like `over: asset` are for builtin functions")
            return
        }
    }
}

fn variant_ctor(inout ck: Checker, eid: i64, vname: str, call_args: List[Node], e: Node) -> Ex {
    let def = ck.enums[eid]
    var vi = -1
    for i in 0..len(def.variants) {
        if def.variants[i].0 == vname {
            vi = i
            break
        }
    }
    if vi < 0 { return fail_ex(inout ck, "E0100", e, "enum `" + def.name + "` has no variant `" + vname + "`", "") }
    let ptys = def.variants[vi].1
    if len(ptys) != len(call_args) {
        return fail_ex(inout ck, "E0103", e, "`" + def.name + "." + vname + "` takes " + str(len(ptys)) + " value(s), but " + str(len(call_args)) + " were given", "")
    }
    no_named_args(inout ck, call_args, "`" + def.name + "." + vname + "`")
    if ck.failed { return bad() }
    var hs: List[H] = []
    for i in 0..len(call_args) {
        let a = call_args[i]
        let ae = a.kids[1]
        if a.text == "inout" { return fail_ex(inout ck, "E0115", ae, "enum values are not `inout`", "") }
        let r = expr1(inout ck, ae, ptys[i])
        expect_at(inout ck, r.t, ptys[i], ae)
        if ck.failed { return bad() }
        hs.push(r.h)
    }
    typed(hn("variant", "", eid, vi, hs, -1, -1), Ty.TEnum(eid))
}

// `+ - * /` on the tangent space: two values of the same type, or one with an `f64`.
// (it applies, its type)
fn tangent_binary(inout ck: Checker, op: str, tl: Ty, tr: Ty, e: Node) -> (bool, Ty) {
    let a = tangent(ck, tl)
    let b = tangent(ck, tr)
    if not (a or b) or not contains(["+", "-", "*", "/"], op) { return (false, Ty.TUnit) }
    let s = if a { tl } else { tr }
    let other = if a { tr } else { tl }
    let ok = if a and b { unify(inout ck, tl, tr) } else { unify(inout ck, other, Ty.TFloat) }
    if not ok {
        let _ = fail_at(inout ck, "E0101", e, "cannot apply `" + op + "` to `" + show(ck, tl) + "` and `" + show(ck, tr) + "`", "field-by-field arithmetic takes two values of the same type, or one of them and an `f64`")
        return (false, Ty.TUnit)
    }
    (true, resolve(ck, s))
}

fn binary(inout ck: Checker, e: Node) -> Ex {
    let op = e.text
    let a = expr0(inout ck, e.kids[0])
    if ck.failed { return bad() }
    let tl = a.t
    let b = expr1(inout ck, e.kids[1], tl)
    if ck.failed { return bad() }
    let tr = b.t
    let h = hspan("binary", op, [a.h, b.h], e)
    if is_tensor(ck, tl) or is_tensor(ck, tr) {
        let t = tensor_binary(inout ck, op, tl, tr, e.kids[0], e.kids[1], e)
        if ck.failed { return bad() }
        return typed(h, t)
    }
    let tg = tangent_binary(inout ck, op, tl, tr, e)
    if ck.failed { return bad() }
    if tg.0 { return typed(h, tg.1) }
    if not unify(inout ck, tl, tr) {
        let x = show(ck, tl)
        let y = show(ck, tr)
        let mixed = (x == "i64" and y == "f64") or (x == "f64" and y == "i64")
        return fail_ex(inout ck, if mixed { "E0107" } else { "E0101" }, e, "cannot apply `" + op + "` to `" + x + "` and `" + y + "`", if mixed { mix_hint() } else { "" })
    }
    let t = resolve(ck, tl)
    if op == "+" {
        if t != Ty.TStr { ensure_numeric(inout ck, t, e, "`+`") }
        if ck.failed { return bad() }
        return typed(h, t)
    }
    if op == "-" or op == "*" or op == "/" or op == "%" or op == "^" {
        ensure_numeric(inout ck, t, e, "`" + op + "`")
        if ck.failed { return bad() }
        return typed(h, t)
    }
    if op == "==" or op == "!=" {
        match t {
            TFn(ps, r) => { return fail_ex(inout ck, "E0101", e, "functions cannot be compared", "") },
            _ => {},
        }
        return typed(h, Ty.TBool)
    }
    match t {
        TInt => {},
        TFloat => {},
        TStr => {},
        TNever => {},
        TVar(v) => ensure_numeric(inout ck, t, e, "a comparison"),
        _ => { let _ = fail_at(inout ck, "E0101", e, "`" + show(ck, t) + "` values cannot be ordered", "") },
    }
    if ck.failed { return bad() }
    typed(h, Ty.TBool)
}

// ------------------------------------------------------------------ calls

fn call_expr(inout ck: Checker, e: Node) -> Ex {
    let callee = e.kids[0]
    let call_args = e.kids[1].kids
    if callee.kind == "name" {
        let n = callee.text
        if not lookup(inout ck, n).0 {
            if contains(ck.fn_ids, n) { return call_user(inout ck, ck.fn_ids[n], false, none_node(), call_args, e) }
            if contains(ck.builtins, n) { return call_builtin(inout ck, n, false, none_node(), call_args, e) }
        }
    }
    let c = expr0(inout ck, callee)
    if ck.failed { return bad() }
    let tc = c.t
    var ps: List[Ty] = []
    var r = Ty.TUnit
    let rc = resolve(ck, tc)
    match rc {
        TFn(a, b) => {
            ps = a
            r = b
        },
        TVar(v) => {
            for a in call_args { ps.push(fresh(inout ck, 0)) }
            r = fresh(inout ck, 0)
            expect_at(inout ck, tc, Ty.TFn(ps, r), callee)
            if ck.failed { return bad() }
        },
        _ => { return fail_ex(inout ck, "E0102", callee, "`" + show(ck, rc) + "` is not a function", "") },
    }
    no_named_args(inout ck, call_args, "a function value")
    if ck.failed { return bad() }
    if len(ps) != len(call_args) {
        return fail_ex(inout ck, "E0103", e, "this function takes " + str(len(ps)) + " argument(s), but " + str(len(call_args)) + " were given", "")
    }
    var kids = [c.h]
    for i in 0..len(call_args) {
        let a = call_args[i]
        let ae = a.kids[1]
        if a.text == "inout" { return fail_ex(inout ck, "E0115", ae, "only named functions take `inout` arguments", "") }
        let x = expr1(inout ck, ae, ps[i])
        expect_at(inout ck, x.t, ps[i], ae)
        if ck.failed { return bad() }
        kids.push(x.h)
    }
    typed(hspan("callv", "", kids, e), r)
}

// `x.f(a)` is `f(x, a)` (uniform call syntax); `Enum.Variant(a)` builds an enum value.
fn method_call(inout ck: Checker, e: Node) -> Ex {
    let recv = e.kids[0]
    let name = e.text
    let call_args = e.kids[1].kids
    if recv.kind == "name" {
        let tn = recv.text
        if not lookup(inout ck, tn).0 {
            if tn == "b3" { return b3_call(inout ck, e) }
            if contains(ck.enum_ids, tn) { return variant_ctor(inout ck, ck.enum_ids[tn], name, call_args, e) }
        }
    }
    if contains(ck.fn_ids, name) { return call_user(inout ck, ck.fn_ids[name], true, recv, call_args, e) }
    if contains(ck.builtins, name) { return call_builtin(inout ck, name, true, recv, call_args, e) }
    fail_ex(inout ck, "E0100", e, "no function named `" + name + "`", "`x.f(y)` calls the function `f(x, y)`")
}

fn b3_nargs(inout ck: Checker, what: str, positional: i64, want: i64, e: Node) -> bool {
    if positional == want { return true }
    let _ = fail_at(inout ck, "E0103", e, what + " takes " + str(want) + " argument(s), but " + str(positional) + " were given", "")
    false
}

fn host(text: str, kids: List[H], e: Node) -> H {
    hspan("host", text, kids, e)
}

// `b3.f(...)`: the bridge to the quant-b3 lab (data and the realistic simulator). The axes of
// its tensors are the built-in ones: month 0, day 1, asset 2, session 3.
fn b3_call(inout ck: Checker, e: Node) -> Ex {
    let method = e.text
    let call_args = e.kids[1].kids
    let what = "`b3." + method + "`"
    let none: List[H] = []
    if not contains(["evaluate", "simulate", "nefin", "nefin_daily"], method) {
        no_named_args(inout ck, call_args, what)
        if ck.failed { return bad() }
    }
    for a in call_args {
        if a.text == "inout" { return fail_ex(inout ck, "E0115", a.kids[1], what + " takes no `inout` arguments", "") }
    }
    var positional = 0
    for a in call_args {
        if a.kids[0].kind == "-" { positional += 1 }
    }
    let fl = Ty.TFloat
    let plain = ["monthly_returns", "eligible", "cdi", "ipca", "months", "tickers", "daily_returns", "daily_volume", "daily_price", "daily_dividends", "sessions", "session_dates", "issuers", "classes"]
    let one = contains(["month_index", "evaluate", "simulate", "deflate_trial", "results_sha256", "nefin", "nefin_daily", "holdout"], method)
    if contains(plain, method) or one or method == "record_trial" {
        if not b3_nargs(inout ck, what, positional, if contains(plain, method) { 0 } else if one { 1 } else { 5 }, e) { return bad() }
    }
    if method == "monthly_returns" { return typed(host(method, none, e), Ty.TTensor([0, 2], fl)) }
    if method == "eligible" { return typed(host(method, none, e), Ty.TTensor([0, 2], Ty.TBool)) }
    if method == "cdi" or method == "ipca" { return typed(host(method, none, e), Ty.TTensor([0], fl)) }
    if method == "months" { return typed(host(method, none, e), Ty.TList(Ty.TInt)) }
    if method == "tickers" or method == "issuers" or method == "classes" { return typed(host(method, none, e), Ty.TList(Ty.TStr)) }
    let daily = ["daily_returns", "daily_volume", "daily_price", "daily_dividends"]
    for i in 0..len(daily) {
        if method == daily[i] { return typed(host("daily " + str(i), none, e), Ty.TTensor([0, 3, 2], fl)) }
    }
    if method == "sessions" { return typed(host(method, none, e), Ty.TTensor([0, 3], Ty.TBool)) }
    if method == "session_dates" { return typed(host(method, none, e), Ty.TTensor([0, 3], fl)) }
    if method == "month_index" {
        let x = call_args[0].kids[1]
        let h = int_expr(inout ck, x)
        if ck.failed { return bad() }
        return typed(host(method, [h], e), Ty.TInt)
    }
    if method == "evaluate" or method == "simulate" {
        let first = call_args[0]
        if first.kids[0].kind != "-" { return fail_ex(inout ck, "E0120", first.kids[1], "positional arguments must come before named ones", "") }
        var named: List[(str, Node, Node)] = []
        for k in 1..len(call_args) {
            let a = call_args[k]
            if a.kids[0].kind == "-" {
                return fail_ex(inout ck, "E0120", a.kids[1], "positional arguments must come before named ones", "e.g. `b3.evaluate(w, cost_bps: 25.0, lag: 1)`")
            }
            named.push((a.kids[0].text, a.kids[0], a.kids[1]))
        }
        let w = weights_and_options(inout ck, "b3.evaluate", first.kids[1], false, named, e)
        if ck.failed { return bad() }
        if method == "evaluate" { return typed(host("evaluate " + str(w.0), w.1, e), Ty.TStruct(w.0)) }
        if not contains(ck.struct_ids, "Simulation") { return fail_ex(inout ck, "E0100", e, "the prelude's `Simulation` struct is missing", "") }
        let sim = ck.struct_ids["Simulation"]
        return typed(host("simulate " + str(sim), w.1, e), Ty.TStruct(sim))
    }
    if method == "record_trial" {
        var xs: List[H] = []
        for k in 0..len(call_args) {
            let want = if k < 4 { Ty.TStr } else { Ty.TList(fl) }
            let x = call_args[k].kids[1]
            let r = expr1(inout ck, x, want)
            expect_at(inout ck, r.t, want, x)
            if ck.failed { return bad() }
            xs.push(r.h)
        }
        return typed(host(method, xs, e), Ty.TStr)
    }
    if method == "deflate_trial" or method == "results_sha256" {
        let want = if method == "deflate_trial" { Ty.TList(fl) } else { Ty.TStr }
        let x = call_args[0].kids[1]
        let r = expr1(inout ck, x, want)
        expect_at(inout ck, r.t, want, x)
        if ck.failed { return bad() }
        return typed(host(method, [r.h], e), want)
    }
    if method == "nefin" or method == "nefin_daily" {
        let first = call_args[0]
        let names = ["rm_rf", "smb", "hml", "wml", "iml", "rf"]
        var factor = -1
        if first.kids[1].kind == "str" and first.kids[0].kind == "-" {
            let fname = unhex(first.kids[1].text)
            for i in 0..len(names) {
                if names[i] == fname and factor < 0 { factor = i }
            }
        }
        if factor < 0 {
            return fail_ex(inout ck, "E0101", first.kids[1], "`b3.nefin` takes the factor's name in quotes", "one of \"rm_rf\", \"smb\", \"hml\", \"wml\", \"iml\", \"rf\" (equally weighted; `vw: true` for value weighted)")
        }
        var vw = hlit("bool false")
        for k in 1..len(call_args) {
            let a = call_args[k]
            let nm = a.kids[0]
            if nm.kind == "-" { return fail_ex(inout ck, "E0120", a.kids[1], "positional arguments must come before named ones", "") }
            if nm.text != "vw" { return fail_ex(inout ck, "E0120", nm, "`b3.nefin` has no option `" + nm.text + "`", "its only option is `vw: true`") }
            let r = expr1(inout ck, a.kids[1], Ty.TBool)
            expect_at(inout ck, r.t, Ty.TBool, a.kids[1])
            if ck.failed { return bad() }
            vw = r.h
        }
        if method == "nefin" { return typed(host("nefin " + str(factor), [vw], e), Ty.TTensor([0], fl)) }
        return typed(host("nefin_daily " + str(factor), [vw], e), Ty.TTensor([0, 3], fl))
    }
    if method == "holdout" {
        let x = call_args[0].kids[1]
        if x.kind != "str" { return fail_ex(inout ck, "E0101", x, "`b3.holdout` takes the protocol's name in quotes", "") }
        let pname = unhex(x.text)
        for i in 0..len(ck.protocols) {
            if ck.protocols[i].name == pname { return typed(host("holdout " + str(i), none, e), Ty.THoldout) }
        }
        return fail_ex(inout ck, "E0100", x, "no protocol named `" + pname + "`", "declare it first: `protocol \"" + pname + "\" { research: until 201812  holdout: from 201901  rule: \"...\" }`")
    }
    fail_ex(inout ck, "E0100", e, "the `b3` module has no function `" + method + "`", "available: monthly_returns, eligible, cdi, months, tickers, month_index, evaluate, holdout, daily_returns, daily_volume, daily_price, sessions, session_dates, issuers, classes, nefin, nefin_daily, simulate, record_trial, ipca, daily_dividends, results_sha256, deflate_trial")
}

// Replaces type parameters by their instances.
fn subst_params(t: Ty, inst: List[(i64, Ty)]) -> Ty {
    match t {
        TParam(p) => {
            for q in inst {
                if q.0 == p { return q.1 }
            }
            t
        },
        TList(x) => Ty.TList(subst_params(x, inst)),
        TMap(k, x) => Ty.TMap(subst_params(k, inst), subst_params(x, inst)),
        TTuple(xs) => {
            var ys: List[Ty] = []
            for x in xs { ys.push(subst_params(x, inst)) }
            Ty.TTuple(ys)
        },
        TFn(ps, r) => {
            var ys: List[Ty] = []
            for x in ps { ys.push(subst_params(x, inst)) }
            Ty.TFn(ys, subst_params(r, inst))
        },
        TTensor(a, x) => Ty.TTensor(a, subst_params(x, inst)),
        _ => t,
    }
}

fn call_user(inout ck: Checker, fid: i64, has_recv: bool, recv: Node, call_args: List[Node], e: Node) -> Ex {
    var sig = ck.sigs[fid]
    // a generic function: fresh instances of its type parameters at every call
    var inst: List[(i64, Ty)] = []
    for p in sig.type_params { inst.push((p, fresh(inout ck, 0))) }
    if len(inst) > 0 {
        var params: List[(str, Ty, bool)] = []
        for p in sig.params { params.push((p.0, subst_params(p.1, inst), p.2)) }
        sig.params = params
        sig.ret = subst_params(sig.ret, inst)
    }
    let r = call_user_sig(inout ck, fid, sig, has_recv, recv, call_args, e)
    if ck.failed { return bad() }
    for q in inst {
        if not differentiable(ck, q.1) {
            return fail_ex(inout ck, "E0402", e, "`" + sig.name + "` needs `" + ck.type_param_names[q.0] + "` to be differentiable, found `" + show(ck, q.1) + "`", "differentiable types: f64, f64 tensors, and structs, tuples and lists of them")
        }
    }
    r
}

fn call_user_sig(inout ck: Checker, fid: i64, sig: FnSig, has_recv: bool, recv: Node, call_args: List[Node], e: Node) -> Ex {
    no_named_args(inout ck, call_args, "`" + sig.name + "`")
    if ck.failed { return bad() }
    // (the expression, written `inout`, is the receiver)
    var all: List[(Node, bool, bool)] = []
    if has_recv { all.push((recv, false, true)) }
    for a in call_args { all.push((a.kids[1], a.text == "inout", false)) }
    if len(all) != len(sig.params) {
        return fail_ex(inout ck, "E0103", e, "`" + sig.name + "` takes " + str(len(sig.params)) + " argument(s), but " + str(len(all)) + " were given", "")
    }
    var hargs: List[H] = []
    var roots: List[i64] = []
    for i in 0..len(all) {
        let x = all[i]
        let p = sig.params[i]
        let en = x.0
        if p.2 {
            if not x.1 and not x.2 {
                return fail_ex(inout ck, "E0115", en, "parameter `" + p.0 + "` of `" + sig.name + "` is `inout`", "pass it as `inout x`; the function will modify `x`")
            }
            let pl = place(inout ck, en)
            if ck.failed { return bad() }
            expect_at(inout ck, pl.1, p.1, en)
            if ck.failed { return bad() }
            if contains(roots, pl.2) { return fail_ex(inout ck, "E0111", en, "the same variable is passed as `inout` twice", "") }
            roots.push(pl.2)
            hargs.push(hk("inout", [pl.0]))
        } else {
            if x.1 { return fail_ex(inout ck, "E0115", en, "parameter `" + p.0 + "` of `" + sig.name + "` is not `inout`", "") }
            let r = expr1(inout ck, en, p.1)
            expect_at(inout ck, r.t, p.1, en)
            if ck.failed { return bad() }
            hargs.push(hval(r.h))
        }
    }
    typed(hn("call", "", fid, -1, hargs, e.lo, e.hi), sig.ret)
}

// ------------------------------------------------------------------ builtins

fn arity_ok(inout ck: Checker, name: str, n: i64, want: i64, e: Node, positional: bool) -> bool {
    if n == want { return true }
    let _ = fail_at(inout ck, "E0103", e, "`" + name + "` takes " + str(want) + (if positional { " positional" } else { "" }) + " argument(s), but " + str(n) + " were given", "")
    false
}

// The arguments of a builtin whose parameters have fixed types.
fn fixed_args(inout ck: Checker, all: List[(Node, bool)], want: List[Ty], e: Node, name: str) -> List[H] {
    var hs: List[H] = []
    if len(all) != len(want) {
        let _ = fail_at(inout ck, "E0103", e, "`" + name + "` takes " + str(len(want)) + " argument(s), but " + str(len(all)) + " were given", "")
        return hs
    }
    for i in 0..len(want) {
        let x = all[i].0
        let r = expr1(inout ck, x, want[i])
        expect_at(inout ck, r.t, want[i], x)
        if ck.failed { return hs }
        hs.push(hval(r.h))
    }
    hs
}

// The builtins whose parameters have fixed types: (it is one, the parameters, the result).
fn fixed_sig(name: str) -> (bool, List[Ty], Ty) {
    let s = Ty.TStr
    let i = Ty.TInt
    let b = Ty.TBool
    let ls = Ty.TList(Ty.TStr)
    let by = Ty.TBytes
    let u = Ty.TUnit
    if name == "split" { return (true, [s, s], ls) }
    if name == "lines" { return (true, [s], ls) }
    if name == "trim" or name == "upper" or name == "lower" { return (true, [s], s) }
    if name == "starts_with" or name == "ends_with" { return (true, [s, s], b) }
    if name == "find" { return (true, [s, s], i) }
    if name == "replace" { return (true, [s, s, s], s) }
    if name == "parse_int" { return (true, [s], i) }
    if name == "parse_float" { return (true, [s], Ty.TFloat) }
    if name == "join" { return (true, [ls, s], s) }
    if name == "codes" { return (true, [s], Ty.TList(i)) }
    if name == "from_codes" { return (true, [Ty.TList(i)], s) }
    if name == "read_text" or name == "env" { return (true, [s], s) }
    if name == "write_text" or name == "append_text" { return (true, [s, s], u) }
    if name == "file_exists" { return (true, [s], b) }
    if name == "list_dir" { return (true, [s], ls) }
    if name == "make_dir" { return (true, [s], u) }
    if name == "args" { return (true, [], ls) }
    if name == "today" { return (true, [], i) }
    if name == "http_get" { return (true, [s], s) }
    if name == "read_lines" { return (true, [s, Ty.TList(Ty.TTuple([i, s]))], ls) }
    if name == "bytes" { return (true, [], by) }
    if name == "utf8_len" { return (true, [s], i) }
    if name == "get_u8" or name == "get_u32" or name == "get_u64" or name == "get_i64" { return (true, [by, i], i) }
    if name == "get_f64" or name == "get_f32" { return (true, [by, i], Ty.TFloat) }
    if name == "get_str" { return (true, [by, i, i], s) }
    if name == "write_bytes" { return (true, [s, by], u) }
    if name == "read_bytes" { return (true, [s], by) }
    if contains(["bit_and", "bit_or", "bit_xor", "shl", "shr", "wrapping_add", "wrapping_mul"], name) { return (true, [i, i], i) }
    if name == "to_hex" { return (true, [i, i], s) }
    if name == "file_size" or name == "file_date" { return (true, [s], i) }
    if contains(["is_alphabetic", "is_alphanumeric", "is_whitespace", "is_uppercase"], name) { return (true, [i], b) }
    if name == "to_bits" { return (true, [Ty.TFloat], i) }
    if name == "exit" { return (true, [i], u) }
    if name == "try_read_text" or name == "try_http_get" { return (true, [s], Ty.TTuple([s, s])) }
    if name == "try_read_bytes" { return (true, [s], Ty.TTuple([by, s])) }
    if name == "try_write_text" { return (true, [s, s, b], s) }
    if name == "try_write_bytes" { return (true, [s, by], s) }
    if name == "try_list_dir" { return (true, [s], Ty.TTuple([ls, s])) }
    if name == "try_make_dir" { return (true, [s], s) }
    if name == "try_read_lines" { return (true, [s, Ty.TList(Ty.TTuple([i, s]))], Ty.TTuple([ls, s])) }
    if name == "try_download" { return (true, [s, s], Ty.TTuple([i, s])) }
    if name == "read_line" { return (true, [], s) }
    if name == "print_raw" { return (true, [s], u) }
    if name == "from_bits" { return (true, [i], Ty.TFloat) }
    if name == "http_get_all" { return (true, [ls, i], Ty.TList(Ty.TTuple([b, s]))) }
    if name == "download" { return (true, [s, s], i) }
    (false, [], u)
}

fn tensor_aware(name: str) -> bool {
    contains(["sum", "mean", "prod", "max", "min", "nan_sum", "nan_mean", "nan_prod", "nan_count", "count", "abs", "sqrt", "exp",
        "ln", "floor", "ceil", "round", "is_nan", "fill_nan", "where", "size", "zeros", "ones", "full", "zeros_like", "full_like",
        "tensor", "to_list", "rank", "top_k", "bottom_k", "nan_quantile", "merge_days", "contract", "observed", "grad",
        "value_and_grad", "tanh", "sigmoid", "relu", "softplus", "randn", "smooth_max", "smooth_min", "smooth_step", "open_once"], name)
}

fn bcall(name: str, args: List[H], e: Node) -> H {
    hspan("builtin", name, args, e)
}

fn call_builtin(inout ck: Checker, name: str, has_recv: bool, recv: Node, call_args: List[Node], e: Node) -> Ex {
    // the positional arguments (the expression, written `inout`) and the named ones
    var all: List[(Node, bool)] = []
    var named: List[(str, Node, Node)] = []
    if has_recv { all.push((recv, true)) }
    for a in call_args {
        let nm = a.kids[0]
        let ae = a.kids[1]
        if nm.kind != "-" {
            if a.text == "inout" { return fail_ex(inout ck, "E0115", ae, "named arguments are never `inout`", "") }
            for q in named {
                if q.0 == nm.text { return fail_ex(inout ck, "E0112", nm, "argument `" + nm.text + "` is given twice", "") }
            }
            named.push((nm.text, nm, ae))
        } else {
            if len(named) > 0 { return fail_ex(inout ck, "E0120", ae, "positional arguments must come before named ones", "") }
            all.push((ae, a.text == "inout"))
        }
    }
    let mutating = contains(["push", "pop", "sort", "reverse", "remove", "put_u8", "put_u32", "put_u64", "put_i64", "put_f64", "put_f32", "put_str"], name)
    for i in 0..len(all) {
        let is_recv = has_recv and i == 0
        let x = all[i]
        if mutating and i == 0 {
            if not x.1 { return fail_ex(inout ck, "E0115", x.0, "`" + name + "` modifies its first argument", "write `x." + name + "(...)` or `" + name + "(inout x, ...)`") }
        } else if x.1 and not is_recv {
            return fail_ex(inout ck, "E0115", x.0, "this argument of `" + name + "` is not `inout`", "")
        }
    }
    if tensor_aware(name) { return tensor_builtin(inout ck, name, all, named, e) }
    if len(named) > 0 {
        return fail_ex(inout ck, "E0120", named[0].1, "`" + name + "` does not take named arguments", "pass `" + named[0].0 + "` by position")
    }
    let n = len(all)
    let fs = fixed_sig(name)
    if fs.0 {
        let hs = fixed_args(inout ck, all, fs.1, e, name)
        if ck.failed { return bad() }
        return typed(bcall(name, hs, e), fs.2)
    }
    if name == "print" or name == "eprint" {
        var hs: List[H] = []
        for x in all {
            let r = expr0(inout ck, x.0)
            if ck.failed { return bad() }
            default_nums(inout ck, r.t)
            hs.push(hval(r.h))
        }
        return typed(bcall(name, hs, e), Ty.TUnit)
    }
    if name == "len" {
        if not arity_ok(inout ck, name, n, 1, e, false) { return bad() }
        let r = expr0(inout ck, all[0].0)
        if ck.failed { return bad() }
        match resolve(ck, r.t) {
            TStr => {},
            TList(x) => {},
            TMap(a, b) => {},
            TBytes => {},
            _ => { let _ = list_elem(inout ck, r.t, all[0].0) },
        }
        if ck.failed { return bad() }
        return typed(bcall(name, [hval(r.h)], e), Ty.TInt)
    }
    if name == "push" or name == "pop" or name == "sort" or name == "reverse" {
        if not arity_ok(inout ck, name, n, if name == "push" { 2 } else { 1 }, e, false) { return bad() }
        let pl = place(inout ck, all[0].0)
        if ck.failed { return bad() }
        let elem = list_elem(inout ck, pl.1, all[0].0)
        if ck.failed { return bad() }
        var hs = [hk("inout", [pl.0])]
        if name == "push" {
            let r = expr1(inout ck, all[1].0, elem)
            expect_at(inout ck, r.t, elem, all[1].0)
            if ck.failed { return bad() }
            hs.push(hval(r.h))
            return typed(bcall(name, hs, e), Ty.TUnit)
        }
        return typed(bcall(name, hs, e), if name == "pop" { elem } else { Ty.TUnit })
    }
    if name == "contains" {
        if not arity_ok(inout ck, name, n, 2, e, false) { return bad() }
        let l = expr0(inout ck, all[0].0)
        if ck.failed { return bad() }
        // `contains(s, sub)`: a string inside another; `contains(m, k)`: a key of a map
        var elem = Ty.TStr
        let rl = resolve(ck, l.t)
        if rl != Ty.TStr {
            match rl {
                TMap(kt, vt) => { elem = kt },
                _ => { elem = list_elem(inout ck, l.t, all[0].0) },
            }
            if ck.failed { return bad() }
        }
        let x = expr1(inout ck, all[1].0, elem)
        expect_at(inout ck, x.t, elem, all[1].0)
        if ck.failed { return bad() }
        return typed(bcall(name, [hval(l.h), hval(x.h)], e), Ty.TBool)
    }
    if name == "map" or name == "filter" {
        if not arity_ok(inout ck, name, n, 2, e, false) { return bad() }
        let l = expr0(inout ck, all[0].0)
        let elem = list_elem(inout ck, l.t, all[0].0)
        if ck.failed { return bad() }
        let out = if name == "map" { fresh(inout ck, 0) } else { Ty.TBool }
        let want = Ty.TFn([elem], out)
        let f = expr1(inout ck, all[1].0, want)
        expect_at(inout ck, f.t, want, all[1].0)
        if ck.failed { return bad() }
        return typed(bcall(name, [hval(l.h), hval(f.h)], e), if name == "map" { Ty.TList(out) } else { Ty.TList(elem) })
    }
    if name == "minimum" or name == "maximum" {
        if not arity_ok(inout ck, name, n, 1, e, false) { return bad() }
        let l = expr0(inout ck, all[0].0)
        let elem = list_elem(inout ck, l.t, all[0].0)
        ensure_numeric(inout ck, elem, all[0].0, "`" + name + "`")
        if ck.failed { return bad() }
        return typed(bcall(name, [hval(l.h)], e), elem)
    }
    if name == "float" or name == "int" {
        if not arity_ok(inout ck, name, n, 1, e, false) { return bad() }
        let r = expr0(inout ck, all[0].0)
        ensure_numeric(inout ck, r.t, all[0].0, "`" + name + "`")
        if ck.failed { return bad() }
        default_nums(inout ck, r.t)
        return typed(bcall(name, [hval(r.h)], e), if name == "float" { Ty.TFloat } else { Ty.TInt })
    }
    if name == "str" {
        if not arity_ok(inout ck, name, n, 1, e, false) { return bad() }
        let r = expr0(inout ck, all[0].0)
        if ck.failed { return bad() }
        default_nums(inout ck, r.t)
        return typed(bcall(name, [hval(r.h)], e), Ty.TStr)
    }
    if starts_with(name, "put_") {
        if not arity_ok(inout ck, name, n, 2, e, false) { return bad() }
        let pl = place(inout ck, all[0].0)
        if ck.failed { return bad() }
        expect_at(inout ck, pl.1, Ty.TBytes, all[0].0)
        if ck.failed { return bad() }
        let want = if name == "put_f64" or name == "put_f32" { Ty.TFloat } else if name == "put_str" { Ty.TStr } else { Ty.TInt }
        let x = expr1(inout ck, all[1].0, want)
        expect_at(inout ck, x.t, want, all[1].0)
        if ck.failed { return bad() }
        return typed(bcall(name, [hk("inout", [pl.0]), hval(x.h)], e), Ty.TUnit)
    }
    if name == "keys" or name == "values" or name == "items" or name == "get" or name == "remove" {
        if not arity_ok(inout ck, name, n, if name == "get" { 3 } else if name == "remove" { 2 } else { 1 }, e, false) { return bad() }
        var tm = Ty.TUnit
        var hm = h_none()
        if name == "remove" {
            let pl = place(inout ck, all[0].0)
            tm = pl.1
            hm = hk("inout", [pl.0])
        } else {
            let r = expr0(inout ck, all[0].0)
            tm = r.t
            hm = hval(r.h)
        }
        if ck.failed { return bad() }
        var kt = Ty.TUnit
        var vt = Ty.TUnit
        match resolve(ck, tm) {
            TMap(a, b) => {
                kt = a
                vt = b
            },
            _ => { return fail_ex(inout ck, "E0101", all[0].0, "`" + name + "` needs a map, found `" + show(ck, tm) + "`", "") },
        }
        var hs = [hm]
        if name == "get" or name == "remove" {
            let k = expr1(inout ck, all[1].0, kt)
            expect_at(inout ck, k.t, kt, all[1].0)
            if ck.failed { return bad() }
            hs.push(hval(k.h))
        }
        if name == "get" {
            let d = expr1(inout ck, all[2].0, vt)
            expect_at(inout ck, d.t, vt, all[2].0)
            if ck.failed { return bad() }
            hs.push(hval(d.h))
            return typed(bcall(name, hs, e), vt)
        }
        if name == "keys" { return typed(bcall(name, hs, e), Ty.TList(kt)) }
        if name == "values" { return typed(bcall(name, hs, e), Ty.TList(vt)) }
        if name == "items" { return typed(bcall(name, hs, e), Ty.TList(Ty.TTuple([kt, vt]))) }
        return typed(bcall(name, hs, e), Ty.TUnit)
    }
    if name == "substr" or name == "format_fixed" {
        let want = if name == "substr" { [Ty.TStr, Ty.TInt, Ty.TInt] } else { [Ty.TFloat, Ty.TInt] }
        if not arity_ok(inout ck, name, n, len(want), e, false) { return bad() }
        var hs: List[H] = []
        for i in 0..len(want) {
            let r = expr1(inout ck, all[i].0, want[i])
            expect_at(inout ck, r.t, want[i], all[i].0)
            if ck.failed { return bad() }
            hs.push(hval(r.h))
        }
        return typed(bcall(name, hs, e), Ty.TStr)
    }
    if name == "assert" {
        if n != 1 and n != 2 { return fail_ex(inout ck, "E0103", e, "`assert` takes a condition and an optional message", "") }
        let c = expr1(inout ck, all[0].0, Ty.TBool)
        expect_at(inout ck, c.t, Ty.TBool, all[0].0)
        if ck.failed { return bad() }
        var hs = [hval(c.h)]
        if n == 2 {
            let m = expr1(inout ck, all[1].0, Ty.TStr)
            expect_at(inout ck, m.t, Ty.TStr, all[1].0)
            if ck.failed { return bad() }
            hs.push(hval(m.h))
        }
        return typed(bcall(name, hs, e), Ty.TUnit)
    }
    unsupported(inout ck, e, "`" + name + "`")
}

// ------------------------------------------------------------------ tensors
//
// A tensor type is `Tensor[axes; f64|bool]`. Element-wise operations need one operand's axes to
// contain every other operand's (smaller operands repeat along the missing axes); anything else
// is E0201. Reductions, indices, ranks and contractions always name the axis.

// The tensor type over these axes (sorted); with no axes left it is a scalar.
fn mk_tensor(axes: List[i64], elem: Ty) -> Ty {
    if len(axes) == 0 { return elem }
    Ty.TTensor(sorted_ids(axes), elem)
}

fn tensor_axes(ck: Checker, t: Ty) -> List[i64] {
    match resolve(ck, t) {
        TTensor(a, x) => a,
        _ => [],
    }
}

fn int_expr(inout ck: Checker, e: Node) -> H {
    let r = expr1(inout ck, e, Ty.TInt)
    expect_at(inout ck, r.t, Ty.TInt, e)
    r.h
}

// An integer written as a constant (`3`, `-1`): (it is one, its value).
fn int_const(inout ck: Checker, e: Node, what: str) -> (bool, i64) {
    if e.kind == "int" { return (true, parse_int(e.text)) }
    if e.kind == "neg" and e.kids[0].kind == "int" { return (true, -parse_int(e.kids[0].text)) }
    let _ = fail_at(inout ck, "E0101", e, "`" + what + "` must be an integer constant", "")
    (false, 0)
}

// An axis written as an argument: `over: asset`, `size(x, month)`.
fn axis_of_expr(inout ck: Checker, e: Node) -> i64 {
    if e.kind == "name" { return axis_id(inout ck, e.text, e.lo, e.hi) }
    let _ = fail_at(inout ck, "E0200", e, "expected an axis name", "e.g. `over: asset`")
    -1
}

// The element type for a new tensor: an integer literal or unknown becomes `f64`; only `f64`
// and `bool` are allowed.
fn tensor_elem(inout ck: Checker, t: Ty, e: Node) -> Ty {
    var x = resolve(ck, t)
    match x {
        TVar(v) => {
            let _ = unify(inout ck, x, Ty.TFloat)
            x = Ty.TFloat
        },
        _ => {},
    }
    if not (x == Ty.TFloat or x == Ty.TBool) {
        return fail_at(inout ck, "E0101", e, "tensor elements must be `f64` or `bool`, found `" + show(ck, x) + "`", "")
    }
    x
}

fn need_tensor(inout ck: Checker, name: str, t: Ty, e: Node) -> bool {
    if is_tensor(ck, t) { return true }
    let _ = fail_at(inout ck, "E0101", e, "`" + name + "` needs a tensor, found `" + show(ck, t) + "`", "")
    false
}

fn need_elem(inout ck: Checker, name: str, t: Ty, want: Ty, e: Node) {
    if elem_of(ck, t) != want {
        let _ = fail_at(inout ck, "E0101", e, "`" + name + "` needs a `" + show(ck, want) + "` tensor, found `" + show(ck, t) + "`", "")
    }
}

fn has_axis(inout ck: Checker, axes: List[i64], a: i64, t: Ty, at: Node) {
    if not contains(axes, a) {
        let _ = fail_at(inout ck, "E0201", at, "`" + show(ck, t) + "` has no axis `" + ck.axes[a].name + "`", "")
    }
}

fn without(axes: List[i64], a: i64) -> List[i64] {
    var out: List[i64] = []
    for x in axes {
        if x != a { out.push(x) }
    }
    out
}

// Selects `x[month: i, asset: a .. b]`: (the selectors' HIR, the axes that remain).
fn tensor_sels(inout ck: Checker, axes: List[i64], t: Ty, idx: List[Node]) -> (List[H], List[i64]) {
    var sels: List[H] = []
    var kept = axes
    var seen: List[i64] = []
    for it in idx {
        let an = it.kids[0]
        let ie = it.kids[1]
        if an.kind == "-" {
            ck_fail_l(inout ck, "E0202", ie.lo, ie.hi, "tensor indices must name their axis", "`" + show(ck, t) + "` has axes " + axes_str(ck, axes), "write `x[" + ck.axes[axes[0]].name + ": i]`: axes have names, not positions")
            return (sels, kept)
        }
        let id = axis_id(inout ck, an.text, an.lo, an.hi)
        if ck.failed { return (sels, kept) }
        if not contains(axes, id) {
            let _ = fail_at(inout ck, "E0201", an, "`" + show(ck, t) + "` has no axis `" + an.text + "`", "")
            return (sels, kept)
        }
        if contains(seen, id) {
            let _ = fail_at(inout ck, "E0112", an, "axis `" + an.text + "` is indexed twice", "")
            return (sels, kept)
        }
        if ie.kind == "range" {
            let a = int_expr(inout ck, ie.kids[0])
            if ck.failed { return (sels, kept) }
            let b = int_expr(inout ck, ie.kids[1])
            sels.push(hn("range", "", id, if ie.text == "..=" { 1 } else { 0 }, [a, b], -1, -1))
        } else {
            kept = without(kept, id)
            sels.push(hn("at", "", id, -1, [int_expr(inout ck, ie)], -1, -1))
        }
        if ck.failed { return (sels, kept) }
        seen.push(id)
    }
    (sels, kept)
}

// The axes of an element-wise combination: the tensor operand with the most axes (the last
// of them) must contain every other tensor operand's axes. Scalars repeat everywhere.
fn frame_axes(inout ck: Checker, ops: List[(Ty, Node)], what: str, e: Node) -> List[i64] {
    var parts: List[(i64, List[i64])] = []
    for i in 0..len(ops) {
        if is_tensor(ck, ops[i].0) { parts.push((i, tensor_axes(ck, ops[i].0))) }
    }
    if len(parts) == 0 { return [] }
    var bi = 0
    for k in 0..len(parts) {
        if len(parts[k].1) >= len(parts[bi].1) { bi = k }
    }
    for k in 0..len(parts) {
        var inside = true
        for x in parts[k].1 {
            if not contains(parts[bi].1, x) { inside = false }
        }
        if not inside {
            // the two sides in the order they were written
            let p = if parts[k].0 < parts[bi].0 { k } else { bi }
            let q = if parts[k].0 < parts[bi].0 { bi } else { k }
            let xn = ops[parts[p].0].1
            let yn = ops[parts[q].0].1
            let label = if xn.kind == "name" and yn.kind == "name" and xn.text != yn.text {
                "`" + xn.text + "` has axes " + axes_str(ck, parts[p].1) + ", `" + yn.text + "` has " + axes_str(ck, parts[q].1)
            } else {
                "one side has axes " + axes_str(ck, parts[p].1) + ", the other has " + axes_str(ck, parts[q].1)
            }
            ck_fail_l(inout ck, "E0201", e.lo, e.hi, "incompatible axes in " + what, label, "element-wise operations need one side's axes to contain the other's: reduce with `sum(x, over: ...)`, select with `x[axis: i]` or use `contract(x, w, over: ...)`")
            return []
        }
    }
    parts[bi].1
}

// The type of `x op y` where at least one side is a tensor.
fn tensor_binary(inout ck: Checker, op: str, tl: Ty, tr: Ty, l: Node, r: Node, e: Node) -> Ty {
    let what = if l.kind == "name" and r.kind == "name" { "`" + l.text + " " + op + " " + r.text + "`" } else { "`" + op + "`" }
    let axes = frame_axes(inout ck, [(tl, l), (tr, r)], what, e)
    if ck.failed { return Ty.TUnit }
    let el = elem_of(ck, tl)
    let er = elem_of(ck, tr)
    if not unify(inout ck, el, er) {
        let x = show(ck, el)
        let y = show(ck, er)
        let mixed = (x == "i64" and y == "f64") or (x == "f64" and y == "i64")
        return fail_at(inout ck, if mixed { "E0107" } else { "E0101" }, e, "cannot apply `" + op + "` to `" + show(ck, tl) + "` and `" + show(ck, tr) + "`", if mixed { mix_hint() } else { "" })
    }
    let elem = resolve(ck, el)
    if op == "==" or op == "!=" { return mk_tensor(axes, Ty.TBool) }
    if elem != Ty.TFloat { return fail_at(inout ck, "E0101", e, "`" + op + "` needs `f64` values, found `" + show(ck, elem) + "`", "") }
    if op == "<" or op == "<=" or op == ">" or op == ">=" { mk_tensor(axes, Ty.TBool) } else { mk_tensor(axes, Ty.TFloat) }
}

// Store into a tensor: `slice` is a selection like `x[month: i] = v`, otherwise the whole
// variable. A slice takes a scalar (filling it) or a tensor with exactly its axes; `op=` also
// accepts any tensor whose axes the destination contains. A whole variable keeps its type.
fn check_tensor_store(inout ck: Checker, dst: List[i64], elem: Ty, tv: Ty, op: str, slice: bool, value: Node, e: Node) {
    let dst_ty = mk_tensor(dst, elem)
    if op != "=" {
        if elem != Ty.TFloat {
            let _ = fail_at(inout ck, "E0101", e, "`" + op + "=` needs `f64` values, found `" + show(ck, dst_ty) + "`", "")
            return
        }
        if is_tensor(ck, tv) {
            var inside = true
            for a in tensor_axes(ck, tv) {
                if not contains(dst, a) { inside = false }
            }
            if not (elem_of(ck, tv) == Ty.TFloat and inside) {
                let _ = fail_at(inout ck, "E0201", value, "cannot apply `" + op + "=` with `" + show(ck, tv) + "` to `" + show(ck, dst_ty) + "`", "the right side's axes must be among the destination's")
            }
            return
        }
        expect_at(inout ck, tv, Ty.TFloat, value)
        return
    }
    if is_tensor(ck, tv) {
        if tensor_axes(ck, tv) != dst {
            let _ = fail_at(inout ck, "E0201", value, "cannot store `" + show(ck, tv) + "` into `" + show(ck, dst_ty) + "`", "the stored tensor must have exactly the destination's axes")
        } else if elem_of(ck, tv) != elem {
            mismatch(inout ck, show(ck, tv), show(ck, dst_ty), value.lo, value.hi, "")
        }
        return
    }
    if slice or len(dst) == 0 {
        expect_at(inout ck, tv, elem, value)
        return
    }
    mismatch(inout ck, show(ck, tv), show(ck, dst_ty), value.lo, value.hi, "to set every element write `x = full_like(x, v)`, or assign a slice: `x[month: i] = v`")
}

// `max(a, b)` / `min(a, b)`: numbers, or element-wise when a tensor is involved.
fn max_min2(inout ck: Checker, name: str, all: List[(Node, bool)], e: Node) -> Ex {
    let a = expr0(inout ck, all[0].0)
    if ck.failed { return bad() }
    let ta = a.t
    let ea = elem_of(ck, ta)
    let b = expr1(inout ck, all[1].0, ea)
    if ck.failed { return bad() }
    let tb = b.t
    let h = bcall(name, [hval(a.h), hval(b.h)], e)
    if is_tensor(ck, ta) or is_tensor(ck, tb) {
        let axes = frame_axes(inout ck, [(ta, all[0].0), (tb, all[1].0)], "`" + name + "`", e)
        if ck.failed { return bad() }
        let eb = elem_of(ck, tb)
        if not unify(inout ck, ea, eb) or resolve(ck, ea) != Ty.TFloat {
            return fail_ex(inout ck, "E0101", e, "`" + name + "` needs `f64` values, found `" + show(ck, ta) + "` and `" + show(ck, tb) + "`", "")
        }
        return typed(h, mk_tensor(axes, Ty.TFloat))
    }
    expect_at(inout ck, tb, ta, all[1].0)
    ensure_numeric(inout ck, ta, e, "`" + name + "`")
    if ck.failed { return bad() }
    typed(h, ta)
}

// The builtins that understand tensors.
fn tensor_builtin(inout ck: Checker, name: str, all: List[(Node, bool)], named: List[(str, Node, Node)], e: Node) -> Ex {
    if name == "observed" { return observed_ty(inout ck, all, named, e) }
    if name == "grad" or name == "value_and_grad" { return grad_ty(inout ck, name, all, named, e) }
    if name == "randn" { return randn_ty(inout ck, all, named, e) }
    if name == "smooth_max" or name == "smooth_min" or name == "smooth_step" { return smooth_ty(inout ck, name, all, named, e) }
    if name == "open_once" { return open_once_ty(inout ck, all, named, e) }
    let n = len(all)
    let takes_over = contains(["sum", "mean", "prod", "max", "min", "nan_sum", "nan_mean", "nan_prod", "nan_count", "count", "rank", "top_k", "bottom_k", "nan_quantile", "contract"], name)
    let takes_sizes = name == "zeros" or name == "ones" or name == "full"
    if not takes_sizes {
        for q in named {
            if not takes_over { return fail_ex(inout ck, "E0120", q.1, "`" + name + "` does not take named arguments", "pass `" + q.0 + "` by position") }
            if q.0 != "over" { return fail_ex(inout ck, "E0120", q.1, "`" + name + "` has no argument `" + q.0 + "`", "the axis is given as `over: axis`") }
        }
    }
    // `over: axis`: (given, the axis, where it is written)
    var has_over = false
    var over = -1
    var over_at = none_node()
    if takes_over and len(named) > 0 {
        over_at = named[0].2
        over = axis_of_expr(inout ck, over_at)
        if ck.failed { return bad() }
        has_over = true
    }
    let fty = Ty.TFloat
    if contains(["sum", "mean", "prod", "max", "min", "nan_sum", "nan_mean", "nan_prod", "nan_count", "count"], name) {
        if (name == "max" or name == "min") and n == 2 {
            if has_over { return fail_ex(inout ck, "E0103", over_at, "`" + name + "` of two values takes no `over:`", "") }
            return max_min2(inout ck, name, all, e)
        }
        if not arity_ok(inout ck, name, n, 1, e, true) { return bad() }
        let e0 = all[0].0
        let r = expr0(inout ck, e0)
        if ck.failed { return bad() }
        let t = r.t
        if is_tensor(ck, t) {
            if name == "count" {
                need_elem(inout ck, name, t, Ty.TBool, e0)
            } else if name != "sum" and name != "mean" {
                need_elem(inout ck, name, t, fty, e0)
            }
            if ck.failed { return bad() }
            let axes = tensor_axes(ck, t)
            let h = bcall(name, [hval(r.h), ax_lit(over)], e)
            if has_over {
                has_axis(inout ck, axes, over, t, over_at)
                if ck.failed { return bad() }
                return typed(h, mk_tensor(without(axes, over), fty))
            }
            return typed(h, fty)
        }
        if has_over { return fail_ex(inout ck, "E0201", over_at, "`over:` needs a tensor, found `" + show(ck, t) + "`", "") }
        if name == "sum" {
            let elem = list_elem(inout ck, t, e0)
            ensure_numeric(inout ck, elem, e0, "`sum`")
            if ck.failed { return bad() }
            let zid = fresh_id(inout ck, 1)
            let _ = unify(inout ck, Ty.TVar(zid), elem)
            return typed(bcall(name, [hval(r.h), hval(hn("intlit", "0", zid, -1, [], -1, -1))], e), elem)
        }
        if name == "mean" or name == "prod" {
            let elem = list_elem(inout ck, t, e0)
            expect_at(inout ck, elem, fty, e0)
            if ck.failed { return bad() }
            return typed(bcall(name, [hval(r.h)], e), fty)
        }
        if name == "max" or name == "min" {
            let big = if name == "max" { "largest" } else { "smallest" }
            let list_fn = if name == "max" { "maximum" } else { "minimum" }
            return fail_ex(inout ck, "E0103", e, "`" + name + "` takes two values or a tensor", "for the " + big + " element of a list use `" + list_fn + "(xs)`")
        }
        return fail_ex(inout ck, "E0101", e0, "`" + name + "` needs a tensor, found `" + show(ck, t) + "`", "")
    }
    if contains(["abs", "sqrt", "exp", "ln", "floor", "ceil", "round", "tanh", "sigmoid", "relu", "softplus"], name) {
        if not arity_ok(inout ck, name, n, 1, e, true) { return bad() }
        let x = all[0].0
        let r = if name == "abs" { expr0(inout ck, x) } else { expr1(inout ck, x, fty) }
        if ck.failed { return bad() }
        let t = r.t
        let h = bcall(name, [hval(r.h)], e)
        if is_tensor(ck, t) {
            need_elem(inout ck, name, t, fty, x)
            if ck.failed { return bad() }
            return typed(h, t)
        }
        // field by field on the tangent space (rounding is not differentiable)
        if tangent(ck, t) and not (name == "floor" or name == "ceil" or name == "round") { return typed(h, t) }
        if name == "abs" {
            ensure_numeric(inout ck, t, x, "`abs`")
            if ck.failed { return bad() }
            return typed(h, t)
        }
        expect_at(inout ck, t, fty, x)
        if ck.failed { return bad() }
        return typed(h, fty)
    }
    if name == "is_nan" {
        if not arity_ok(inout ck, name, n, 1, e, true) { return bad() }
        let r = expr1(inout ck, all[0].0, fty)
        if ck.failed { return bad() }
        let t = r.t
        let h = bcall(name, [hval(r.h)], e)
        if is_tensor(ck, t) {
            need_elem(inout ck, name, t, fty, all[0].0)
            if ck.failed { return bad() }
            return typed(h, mk_tensor(tensor_axes(ck, t), Ty.TBool))
        }
        expect_at(inout ck, t, fty, all[0].0)
        if ck.failed { return bad() }
        return typed(h, Ty.TBool)
    }
    if name == "fill_nan" {
        if not arity_ok(inout ck, name, n, 2, e, true) { return bad() }
        let r = expr1(inout ck, all[0].0, fty)
        if ck.failed { return bad() }
        let t = r.t
        let v = expr1(inout ck, all[1].0, fty)
        expect_at(inout ck, v.t, fty, all[1].0)
        if ck.failed { return bad() }
        let h = bcall(name, [hval(r.h), hval(v.h)], e)
        if is_tensor(ck, t) {
            need_elem(inout ck, name, t, fty, all[0].0)
            if ck.failed { return bad() }
            return typed(h, t)
        }
        expect_at(inout ck, t, fty, all[0].0)
        if ck.failed { return bad() }
        return typed(h, fty)
    }
    if name == "where" {
        if not arity_ok(inout ck, name, n, 3, e, true) { return bad() }
        let c = expr1(inout ck, all[0].0, Ty.TBool)
        if ck.failed { return bad() }
        let a = expr0(inout ck, all[1].0)
        if ck.failed { return bad() }
        let ea = elem_of(ck, a.t)
        let b = expr1(inout ck, all[2].0, ea)
        if ck.failed { return bad() }
        let ec = elem_of(ck, c.t)
        expect_at(inout ck, ec, Ty.TBool, all[0].0)
        if ck.failed { return bad() }
        let eb = elem_of(ck, b.t)
        if not unify(inout ck, ea, eb) {
            return fail_ex(inout ck, "E0101", all[2].0, "`where` branches have different types: `" + show(ck, a.t) + "` and `" + show(ck, b.t) + "`", "")
        }
        let h = bcall(name, [hval(c.h), hval(a.h), hval(b.h)], e)
        if not (is_tensor(ck, c.t) or is_tensor(ck, a.t) or is_tensor(ck, b.t)) { return typed(h, resolve(ck, ea)) }
        let axes = frame_axes(inout ck, [(c.t, all[0].0), (a.t, all[1].0), (b.t, all[2].0)], "`where`", e)
        if ck.failed { return bad() }
        let elem = tensor_elem(inout ck, ea, all[1].0)
        if ck.failed { return bad() }
        return typed(h, mk_tensor(axes, elem))
    }
    if name == "size" {
        if not arity_ok(inout ck, name, n, 2, e, true) { return bad() }
        let r = expr0(inout ck, all[0].0)
        if ck.failed { return bad() }
        let ax = axis_of_expr(inout ck, all[1].0)
        if ck.failed { return bad() }
        if not is_tensor(ck, r.t) {
            return fail_ex(inout ck, "E0101", all[0].0, "`size` needs a tensor, found `" + show(ck, r.t) + "`", "the length of a list is `len(xs)`")
        }
        has_axis(inout ck, tensor_axes(ck, r.t), ax, r.t, all[1].0)
        if ck.failed { return bad() }
        return typed(bcall(name, [hval(r.h), ax_lit(ax)], e), Ty.TInt)
    }
    if takes_sizes {
        if not arity_ok(inout ck, name, n, if name == "full" { 1 } else { 0 }, e, true) { return bad() }
        if len(named) == 0 {
            let v = if name == "full" { "0.0, " } else { "" }
            return fail_ex(inout ck, "E0103", e, "`" + name + "` needs the size of each axis", "e.g. `" + name + "(" + v + "month: 12, asset: 3)`")
        }
        var hs: List[H] = []
        var elem = fty
        if name == "full" {
            let v = expr1(inout ck, all[0].0, fty)
            if ck.failed { return bad() }
            elem = tensor_elem(inout ck, v.t, all[0].0)
            if ck.failed { return bad() }
            hs.push(hval(v.h))
        }
        var axes: List[i64] = []
        for q in named {
            let id = axis_id(inout ck, q.0, q.1.lo, q.1.hi)
            if ck.failed { return bad() }
            if contains(axes, id) { return fail_ex(inout ck, "E0112", q.1, "axis `" + q.0 + "` is given twice", "") }
            let hsz = int_expr(inout ck, q.2)
            if ck.failed { return bad() }
            hs.push(ax_lit(id))
            hs.push(hval(hsz))
            axes.push(id)
        }
        return typed(bcall(name, hs, e), mk_tensor(axes, elem))
    }
    if name == "zeros_like" or name == "full_like" {
        if not arity_ok(inout ck, name, n, if name == "full_like" { 2 } else { 1 }, e, true) { return bad() }
        let r = expr0(inout ck, all[0].0)
        if ck.failed { return bad() }
        let t = r.t
        // the zero of the tangent space (optimizer state, accumulated gradients)
        if name == "zeros_like" and (tangent(ck, t) or resolve(ck, t) == fty) { return typed(bcall(name, [hval(r.h)], e), t) }
        if not need_tensor(inout ck, name, t, all[0].0) { return bad() }
        var hs = [hval(r.h)]
        var elem = fty
        if name == "full_like" {
            let v = expr1(inout ck, all[1].0, fty)
            if ck.failed { return bad() }
            elem = tensor_elem(inout ck, v.t, all[1].0)
            if ck.failed { return bad() }
            hs.push(hval(v.h))
        }
        return typed(bcall(name, hs, e), mk_tensor(tensor_axes(ck, t), elem))
    }
    if name == "tensor" {
        if not arity_ok(inout ck, name, n, 2, e, true) { return bad() }
        let r = expr0(inout ck, all[0].0)
        if ck.failed { return bad() }
        let ax = axis_of_expr(inout ck, all[1].0)
        if ck.failed { return bad() }
        let x = list_elem(inout ck, r.t, all[0].0)
        if ck.failed { return bad() }
        let elem = tensor_elem(inout ck, x, all[0].0)
        if ck.failed { return bad() }
        let is_bool = hval(hlit(if elem == Ty.TBool { "bool true" } else { "bool false" }))
        return typed(bcall(name, [hval(r.h), ax_lit(ax), is_bool], e), Ty.TTensor([ax], elem))
    }
    if name == "to_list" {
        if not arity_ok(inout ck, name, n, 1, e, true) { return bad() }
        let r = expr0(inout ck, all[0].0)
        if ck.failed { return bad() }
        if not need_tensor(inout ck, name, r.t, all[0].0) { return bad() }
        if len(tensor_axes(ck, r.t)) != 1 {
            return fail_ex(inout ck, "E0201", all[0].0, "`to_list` needs a tensor with one axis, found `" + show(ck, r.t) + "`", "select or reduce the other axes first")
        }
        return typed(bcall(name, [hval(r.h)], e), Ty.TList(elem_of(ck, r.t)))
    }
    if name == "nan_quantile" or name == "rank" or name == "top_k" or name == "bottom_k" {
        if not arity_ok(inout ck, name, n, if name == "rank" { 1 } else { 2 }, e, true) { return bad() }
        let r = expr0(inout ck, all[0].0)
        if ck.failed { return bad() }
        let t = r.t
        if not need_tensor(inout ck, name, t, all[0].0) { return bad() }
        need_elem(inout ck, name, t, fty, all[0].0)
        if ck.failed { return bad() }
        let axes = tensor_axes(ck, t)
        // the axis: `over:`, or the only axis of a one-axis tensor
        var ax = -1
        if has_over {
            has_axis(inout ck, axes, over, t, over_at)
            ax = over
        } else if len(axes) == 1 {
            ax = axes[0]
        } else {
            return fail_ex(inout ck, "E0201", e, "`" + name + "` over which axis of `" + show(ck, t) + "`?", "name it with `over: " + ck.axes[axes[0]].name + "`")
        }
        if ck.failed { return bad() }
        if name == "nan_quantile" {
            let q = expr1(inout ck, all[1].0, fty)
            expect_at(inout ck, q.t, fty, all[1].0)
            if ck.failed { return bad() }
            return typed(bcall(name, [hval(r.h), hval(q.h), ax_lit(ax)], e), mk_tensor(without(axes, ax), fty))
        }
        var hs = [hval(r.h)]
        if name != "rank" {
            let k = int_expr(inout ck, all[1].0)
            if ck.failed { return bad() }
            hs.push(hval(k))
        }
        hs.push(ax_lit(ax))
        return typed(bcall(name, hs, e), mk_tensor(axes, if name == "rank" { fty } else { Ty.TBool }))
    }
    if name == "merge_days" {
        if not arity_ok(inout ck, name, n, 1, e, true) { return bad() }
        let r = expr0(inout ck, all[0].0)
        if ck.failed { return bad() }
        let t = r.t
        if not need_tensor(inout ck, name, t, all[0].0) { return bad() }
        let axes = tensor_axes(ck, t)
        if not contains(axes, 0) or not contains(axes, 3) {
            return fail_ex(inout ck, "E0201", all[0].0, "`merge_days` needs a tensor with the axes `month` and `session`, found `" + show(ck, t) + "`", "the daily data of `b3` comes as `Tensor[month, session, asset]`")
        }
        var out = [1]
        for a in axes {
            if a != 0 and a != 3 { out.push(a) }
        }
        return typed(bcall(name, [hval(r.h)], e), mk_tensor(out, elem_of(ck, t)))
    }
    if name == "contract" {
        if not arity_ok(inout ck, name, n, 2, e, true) { return bad() }
        let x = expr0(inout ck, all[0].0)
        if ck.failed { return bad() }
        let y = expr0(inout ck, all[1].0)
        if ck.failed { return bad() }
        if not need_tensor(inout ck, name, x.t, all[0].0) { return bad() }
        if not need_tensor(inout ck, name, y.t, all[1].0) { return bad() }
        need_elem(inout ck, name, x.t, fty, all[0].0)
        need_elem(inout ck, name, y.t, fty, all[1].0)
        if ck.failed { return bad() }
        if not has_over { return fail_ex(inout ck, "E0103", e, "`contract` needs the axis to sum over", "e.g. `contract(x, w, over: feature)`") }
        let ax_x = tensor_axes(ck, x.t)
        let ax_y = tensor_axes(ck, y.t)
        has_axis(inout ck, ax_x, over, x.t, over_at)
        has_axis(inout ck, ax_y, over, y.t, over_at)
        if ck.failed { return bad() }
        var out: List[i64] = []
        for a in ax_x {
            if a != over and not contains(out, a) { out.push(a) }
        }
        for a in ax_y {
            if a != over and not contains(out, a) { out.push(a) }
        }
        return typed(bcall(name, [hval(x.h), hval(y.h), ax_lit(over)], e), mk_tensor(out, fty))
    }
    unsupported(inout ck, e, "`" + name + "`")
}

// `grad(f)` / `grad(f, wrt: k)` / `value_and_grad(f)`: f returns f64 (a loss); the result is a
// function with the same parameters returning the gradient (and the value) with respect to
// parameter k (from 1).
fn grad_ty(inout ck: Checker, name: str, all: List[(Node, bool)], named: List[(str, Node, Node)], e: Node) -> Ex {
    if len(all) != 1 {
        return fail_ex(inout ck, "E0103", e, "`" + name + "` takes the function to differentiate", "e.g. `" + name + "(loss)` or `" + name + "(loss, wrt: 2)`")
    }
    var wrt = 1
    for q in named {
        if q.0 != "wrt" { return fail_ex(inout ck, "E0120", q.1, "`" + name + "` has no argument `" + q.0 + "`", "choose the parameter with `wrt: k` (from 1)") }
        let c = int_const(inout ck, q.2, "wrt:")
        if not c.0 { return bad() }
        wrt = c.1
    }
    let f = all[0].0
    let rf = expr0(inout ck, f)
    if ck.failed { return bad() }
    var ps: List[Ty] = []
    var r = Ty.TUnit
    let tf = resolve(ck, rf.t)
    match tf {
        TFn(a, b) => {
            ps = a
            r = b
        },
        _ => { return fail_ex(inout ck, "E0101", f, "`" + name + "` needs a function, found `" + show(ck, tf) + "`", "pass a named function, or a lambda with typed parameters: `|x: f64| x * x`") },
    }
    if not unify(inout ck, r, Ty.TFloat) {
        return fail_ex(inout ck, "E0401", f, "`" + name + "` needs a function that returns `f64` (a loss), found one returning `" + show(ck, r) + "`", "")
    }
    let k = wrt - 1
    if k < 0 or k >= len(ps) {
        return fail_ex(inout ck, "E0103", e, "`wrt: " + str(wrt) + "`, but the function has " + str(len(ps)) + " parameter(s)", "")
    }
    let p = ps[k]
    if not differentiable(ck, p) {
        return fail_ex(inout ck, "E0402", f, "cannot differentiate with respect to a `" + show(ck, p) + "`", "differentiable types: f64, f64 tensors, and structs, tuples and lists of them")
    }
    let vg = name == "value_and_grad"
    let ret = if vg { Ty.TTuple([Ty.TFloat, p]) } else { p }
    let args = [hval(rf.h), hval(hlit("i64 " + str(k))), hval(hlit(if vg { "bool true" } else { "bool false" }))]
    typed(bcall(name, args, e), Ty.TFn(ps, ret))
}

// `randn(seed: k, month: 12, asset: 3)`: reproducible normal samples.
fn randn_ty(inout ck: Checker, all: List[(Node, bool)], named: List[(str, Node, Node)], e: Node) -> Ex {
    let example = "e.g. `randn(seed: 7, feature: 4, hidden: 16)`"
    if len(all) > 0 { return fail_ex(inout ck, "E0103", e, "`randn` takes only named arguments", example) }
    var seed = -1
    for i in 0..len(named) {
        if named[i].0 == "seed" and seed < 0 { seed = i }
    }
    if seed < 0 { return fail_ex(inout ck, "E0103", e, "`randn` needs `seed:` (results must be reproducible)", example) }
    let hseed = int_expr(inout ck, named[seed].2)
    if ck.failed { return bad() }
    var hs = [hval(hseed)]
    var axes: List[i64] = []
    for q in named {
        if q.0 == "seed" { continue }
        let id = axis_id(inout ck, q.0, q.1.lo, q.1.hi)
        if ck.failed { return bad() }
        if contains(axes, id) { return fail_ex(inout ck, "E0112", q.1, "axis `" + q.0 + "` is given twice", "") }
        hs.push(ax_lit(id))
        let hsz = int_expr(inout ck, q.2)
        if ck.failed { return bad() }
        hs.push(hval(hsz))
        axes.push(id)
    }
    if len(axes) == 0 { return fail_ex(inout ck, "E0103", e, "`randn` needs the size of each axis", example) }
    typed(bcall("randn", hs, e), mk_tensor(axes, Ty.TFloat))
}

// `smooth_max(x, y, scale: s)`, `smooth_min`, `smooth_step(x, scale: s)`: the exact rule outside
// `grad`, a smooth relaxation (softplus, sigmoid) inside it.
fn smooth_ty(inout ck: Checker, name: str, all: List[(Node, bool)], named: List[(str, Node, Node)], e: Node) -> Ex {
    let want = if name == "smooth_step" { 1 } else { 2 }
    if len(all) != want { return fail_ex(inout ck, "E0103", e, "`" + name + "` takes " + str(want) + " value(s) and `scale:`", "") }
    var scale = -1
    for i in 0..len(named) {
        if named[i].0 == "scale" and scale < 0 { scale = i }
    }
    if scale < 0 {
        return fail_ex(inout ck, "E0103", e, "`" + name + "` needs `scale:`: how wide the smooth transition is", "e.g. `" + name + "(x" + (if want == 2 { ", 0.0" } else { "" }) + ", scale: 100.0)`")
    }
    for q in named {
        if q.0 != "scale" { return fail_ex(inout ck, "E0120", q.1, "`" + name + "` has no argument `" + q.0 + "`", "") }
    }
    let fty = Ty.TFloat
    var t = Ty.TUnit
    var hs: List[H] = []
    if name == "smooth_step" {
        let r = expr1(inout ck, all[0].0, fty)
        if ck.failed { return bad() }
        t = r.t
        if is_tensor(ck, t) { need_elem(inout ck, name, t, fty, all[0].0) } else { expect_at(inout ck, t, fty, all[0].0) }
        if ck.failed { return bad() }
        hs.push(hval(r.h))
    } else {
        let r = max_min2(inout ck, if name == "smooth_max" { "max" } else { "min" }, all, e)
        if ck.failed { return bad() }
        t = r.t
        if resolve(ck, t) == Ty.TInt { return fail_ex(inout ck, "E0101", e, "`" + name + "` needs `f64` values", "") }
        hs = r.h.kids
    }
    let se = named[scale].2
    let s = expr1(inout ck, se, fty)
    expect_at(inout ck, s.t, fty, se)
    if ck.failed { return bad() }
    hs.push(hval(s.h))
    typed(bcall(name, hs, e), t)
}

// `observed(x)` / `observed(x, lag: k)`: row `t` of `x` (over its temporal axis) becomes known at
// the end of `t + k`.
fn observed_ty(inout ck: Checker, all: List[(Node, bool)], named: List[(str, Node, Node)], e: Node) -> Ex {
    if len(all) != 1 { return fail_ex(inout ck, "E0103", e, "`observed` takes 1 positional argument, but " + str(len(all)) + " were given", "") }
    var lag = 0
    for q in named {
        if q.0 != "lag" { return fail_ex(inout ck, "E0120", q.1, "`observed` has no argument `" + q.0 + "`", "the delay is given as `lag: k`") }
        let x = q.2
        if x.kind == "int" {
            lag = parse_int(x.text)
        } else if x.kind == "neg" and x.kids[0].kind == "int" {
            lag = -parse_int(x.kids[0].text)
        } else {
            return fail_ex(inout ck, "E0101", x, "`lag:` must be an integer constant", "e.g. `observed(x, lag: 1)`")
        }
    }
    let r = expr0(inout ck, all[0].0)
    if ck.failed { return bad() }
    let t = r.t
    if not need_tensor(inout ck, "observed", t, all[0].0) { return bad() }
    var temporal: List[i64] = []
    for a in tensor_axes(ck, t) {
        if ck.axes[a].temporal != "" { temporal.push(a) }
    }
    if len(temporal) != 1 {
        return fail_ex(inout ck, "E0201", all[0].0, "`observed` needs a tensor with exactly one temporal axis, found `" + show(ck, t) + "`", "temporal axes are `month`, `day` and those declared with `axis name: temporal(...)`")
    }
    typed(bcall("observed", [hval(r.h), hval(hlit("i64 " + str(temporal[0]))), hval(hlit("i64 " + str(lag)))], e), t)
}

// The weights (`Tensor[month, asset; f64]`, or a function without parameters returning them
// when `as_fn`) and the options of an evaluation: (the `Evaluation` struct, the HIR of the
// weights and of the 7 options, defaults filled in).
fn weights_and_options(inout ck: Checker, what: str, w: Node, as_fn: bool, named: List[(str, Node, Node)], e: Node) -> (i64, List[H]) {
    var xs: List[H] = []
    if not contains(ck.struct_ids, "Evaluation") {
        let _ = fail_at(inout ck, "E0100", e, "the prelude's `Evaluation` struct is missing", "")
        return (-1, xs)
    }
    let sid = ck.struct_ids["Evaluation"]
    let tensor = Ty.TTensor([0, 2], Ty.TFloat)
    let want = if as_fn { Ty.TFn([], tensor) } else { tensor }
    let rw = expr1(inout ck, w, want)
    if ck.failed { return (-1, xs) }
    let tw = rw.t
    if not unify(inout ck, tw, want) {
        // a tensor with other axes is an axis error; anything else (including a tensor where
        // the function is expected) is a type error
        let code = if not as_fn and is_tensor(ck, tw) { "E0201" } else { "E0101" }
        let needs = if as_fn { "a function without parameters that returns the weights" } else { "weights" }
        let hint = if as_fn { "the holdout's data exists only while that function runs: e.g. `open_once(h, || weights())`" } else { "one weight per month and asset; a month whose weights are all zero stays in cash (CDI)" }
        let _ = fail_at(inout ck, code, w, "`" + what + "` needs " + needs + " of type `" + show(ck, want) + "`, found `" + show(ck, tw) + "`", hint)
        return (-1, xs)
    }
    let opts = ["cost_bps", "lag", "capital", "real_costs", "tax", "cap_adv", "trial"]
    let otys = [Ty.TFloat, Ty.TInt, Ty.TFloat, Ty.TBool, Ty.TBool, Ty.TFloat, Ty.TBool]
    var vals = [hlit("f64 25.0"), hlit("i64 1"), hlit("f64 1000000.0"), hlit("bool false"), hlit("bool false"), hlit("f64 0.0"), hlit("bool true")]
    var seen: List[str] = []
    for q in named {
        var k = -1
        for i in 0..len(opts) {
            if opts[i] == q.0 { k = i }
        }
        if k < 0 {
            let _ = fail_at(inout ck, "E0120", q.1, "`" + what + "` has no option `" + q.0 + "`", "its options are cost_bps, lag, capital, real_costs, tax, cap_adv and trial")
            return (-1, xs)
        }
        if contains(seen, q.0) {
            let _ = fail_at(inout ck, "E0112", q.1, "option `" + q.0 + "` is given twice", "")
            return (-1, xs)
        }
        seen.push(q.0)
        let r = expr1(inout ck, q.2, otys[k])
        expect_at(inout ck, r.t, otys[k], q.2)
        if ck.failed { return (-1, xs) }
        vals[k] = r.h
    }
    xs.push(rw.h)
    for v in vals { xs.push(v) }
    (sid, xs)
}

// `open_once(h, || weights(), ...)`: evaluates on the holdout of `h`'s protocol, once (M5).
fn open_once_ty(inout ck: Checker, all: List[(Node, bool)], named: List[(str, Node, Node)], e: Node) -> Ex {
    if len(all) != 2 {
        return fail_ex(inout ck, "E0103", e, "`open_once` takes the holdout and the function that computes the weights", "e.g. `open_once(h, || weights(), lag: 1)`")
    }
    let rh = expr0(inout ck, all[0].0)
    if ck.failed { return bad() }
    if resolve(ck, rh.t) != Ty.THoldout {
        return fail_ex(inout ck, "E0101", all[0].0, "`open_once` needs a holdout, found `" + show(ck, rh.t) + "`", "get it from a protocol: `let h = b3.holdout(\"name\")`")
    }
    let w = weights_and_options(inout ck, "open_once", all[1].0, true, named, e)
    if ck.failed { return bad() }
    var xs = [rh.h]
    for x in w.1 { xs.push(x) }
    typed(host("open_once " + str(w.0), xs, e), Ty.TStruct(w.0))
}

// ------------------------------------------------------------------ functions and files

fn check_fn(inout ck: Checker, id: i64, f: Node) {
    let sig = ck.sigs[id]
    var c = ctx_new(1, sig.ret)
    for p in sig.params {
        let slot = new_slot(inout c, p.1)
        c.scopes[0][p.0] = Local { slot: slot, ty: p.1, mutable: p.2, affine: p.1 == Ty.THoldout, loop_depth: 0, captured: false }
    }
    ck.ctxs.push(c)
    // the type parameters are in scope in the body (`let z: P = ...`)
    ck.generic_scope = [:]
    for p in sig.type_params {
        let tp = ck.type_param_names[p]
        ck.generic_scope[tp] = p
    }
    // `@ end(e)`: an integer expression over the parameters (checked by the temporal pass)
    let at = f.kids[3]
    var hat = h_none()
    if at.kind != "-" {
        let ke = at.kids[0]
        let k = expr1(inout ck, ke, Ty.TInt)
        expect_at(inout ck, k.t, Ty.TInt, ke)
        hat = hn("at", "", -1, -1, [k.h], at.lo, at.hi)
    }
    let body = f.kids[4]
    var r = bad()
    if not ck.failed { r = ck_block(inout ck, body, true, sig.ret) }
    let done = ck.ctxs.pop()
    ck.generic_scope = [:]
    if ck.failed { return }
    let t = r.t
    if not unify(inout ck, t, sig.ret) {
        let tail = body.kids[1]
        let at2 = if tail.kind != "-" { tail } else { body }
        let g = show(ck, t)
        let w = show(ck, sig.ret)
        var hint = ""
        if w == "()" {
            hint = "add `-> " + g + "` to the signature"
        } else if g == "()" {
            hint = "the last line of the body is the return value: remove a trailing `;` or use `return`"
        }
        ck_fail(inout ck, "E0108", at2.lo, at2.hi, "function `" + sig.name + "` must return `" + w + "`, but its body has type `" + g + "`", hint)
        return
    }
    ck.bodies[id] = done.slot_tys
    ck.has_body[id] = true
    ck.fn_hir[id] = r.h
    ck.fn_at[id] = hat
}

