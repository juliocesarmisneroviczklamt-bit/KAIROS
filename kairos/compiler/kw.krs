// kw: Kairós to WebAssembly, written in Kairós (M13). It checks programs with the front end in
// Kairós (the prelude first) and writes each one as a WebAssembly module for WASI.
//
//   kairos run kairos/compiler/kw.krs <std folder> <output folder> program.krs [more.krs ...]
//
// Each `program.krs` becomes `<output folder>/program.wasm` (run it with any WASI runtime:
// `wasmtime program.wasm`); a program with an error, or with what the back end does not
// compile yet, is reported (`file: error CODE ...`) and gets no module.
import "wasmgen.krs"

fn base_name(path: str) -> str {
    let p = replace(path, from_codes([92]), "/")
    let parts = split(p, "/")
    let last = parts[len(parts) - 1]
    if ends_with(last, ".krs") { substr(last, 0, len(last) - 4) } else { last }
}

// The source of each file the checker read (the standard library from its folder).
fn sources(ck: Checker, std_dir: str) -> List[str] {
    var out: List[str] = []
    for f in ck.files {
        if f == "<prelude>" {
            out.push(read_text(std_dir + "/prelude.krs"))
        } else if starts_with(f, "<std/") {
            out.push(read_text(std_dir + "/" + substr(f, 5, len(f) - 6)))
        } else {
            out.push(read_text(f))
        }
    }
    out
}

// The index of a file in the checker's list (0 if it is not there).
fn file_index(ck: Checker, path: str) -> i64 {
    var k = 0
    for i in 0..len(ck.files) {
        if ck.files[i] == path { k = i }
    }
    k
}

let std_dir = args()[0]
let out_dir = args()[1]
var base = new_checker(std_dir)
check_file(inout base, "<prelude>", read_text(std_dir + "/prelude.krs"))
assert(not base.failed, "the prelude does not check: " + base.code + " " + base.msg)
// the runtime of the modules (rt.krs, next to this compiler: `<std folder>/../compiler`)
let up = dir_of(std_dir)
let rt_path = (if up == "" { "" } else { up + "/" }) + "compiler/rt.krs"
check_file(inout base, rt_path, read_text(rt_path))
assert(not base.failed, "the runtime does not check: " + base.code + " " + base.msg)
// read_lines and its ZIP archives (rt_zip.krs: it uses the runtime)
let zip_path = (if up == "" { "" } else { up + "/" }) + "compiler/rt_zip.krs"
check_file(inout base, zip_path, read_text(zip_path))
assert(not base.failed, "the runtime of read_lines does not check: " + base.code + " " + str(base.elo) + " " + base.msg)
// with the bridge to the lab (rt_b3.krs, over kairos/lab), checked when a program first reaches
// `b3` (the module of a program that does is made again with it)
var base_b3 = base
var b3_ready = false
make_dir(out_dir)
var failed = 0
for k in 2..len(args()) {
    let path = args()[k]
    var ck = base
    ck.imported[norm_path(path)] = true
    check_file(inout ck, path, read_text(path))
    if ck.failed {
        print(path + ": error " + ck.code + " " + str(ck.elo) + " " + str(ck.ehi) + " " + ck.msg)
        failed += 1
        continue
    }
    var w = wasm_module(ck, sources(ck, std_dir), base_name(path))
    if not w.0 and w.2 == "b3" {
        if not b3_ready {
            let b3_path = (if up == "" { "" } else { up + "/" }) + "compiler/rt_b3.krs"
            check_file(inout base_b3, b3_path, read_text(b3_path))
            assert(not base_b3.failed, "the runtime of `b3` does not check: " + base_b3.code + " " + str(base_b3.elo) + " " + base_b3.msg)
            b3_ready = true
        }
        var cb = base_b3
        cb.imported[norm_path(path)] = true
        check_file(inout cb, path, read_text(path))
        if cb.failed {
            // the runtime's names and the program's share one space
            let why = "a program that uses `b3` and has a name of the runtime of `b3` (rt_b3.krs, kairos/lab): " + cb.msg
            w = (false, bytes(), str(file_index(cb, path)) + " " + str(cb.elo) + " " + str(cb.ehi) + " not in the WebAssembly back end yet: " + why)
        } else {
            w = wasm_module(cb, sources(cb, std_dir), base_name(path))
        }
    }
    if w.0 {
        write_bytes(out_dir + "/" + base_name(path) + ".wasm", w.1)
    } else {
        print(path + ": error W0001 " + w.2)
        failed += 1
    }
}
if failed > 0 { print(str(failed) + " program(s) not compiled") }
