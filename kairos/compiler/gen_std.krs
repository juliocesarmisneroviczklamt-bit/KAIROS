// Writes std_embed.krs: the standard library (kairos/std) and the version (kairos/Cargo.toml) the
// command written in Kairós carries, as the Rust one carries them (include_str!).
//
//   kairos run kairos/compiler/gen_std.krs kairos [output file]
//
// Each file becomes a string literal written as Rust's {:?} writes it (the lexer reads that back).

// the literal of a text
fn gen_lit(s: str) -> str {
    let d = str([s])
    substr(d, 1, len(d) - 2)
}

let root = args()[0]
let dest = if len(args()) > 1 { args()[1] } else { root + "/compiler/std_embed.krs" }
var names: List[str] = []
for f in list_dir(root + "/std") {
    if ends_with(f, ".krs") { names.push(f) }
}
var version = ""
for l in lines(read_text(root + "/Cargo.toml")) {
    if starts_with(l, "version = ") and version == "" { version = replace(replace(l, "version = ", ""), from_codes([34]), "") }
}
var out: List[str] = []
out.push("// Generated by gen_std.krs from kairos/std and kairos/Cargo.toml: the standard library and the")
out.push("// version the command written in Kairós carries (as the Rust one, with include_str!). Do not edit.")
out.push("")
out.push("fn std_version() -> str {")
out.push("    " + gen_lit(version))
out.push("}")
out.push("")
out.push("// the files by the name the checker gives them (\"<prelude>\", \"<std/sim.krs>\"...)")
out.push("fn std_embedded() -> Map[str, str] {")
out.push("    var m: Map[str, str] = [:]")
for n in names {
    let key = if n == "prelude.krs" { "<prelude>" } else { "<std/" + n + ">" }
    // line breaks as the repository keeps them (a checkout may have turned them into CR LF)
    out.push("    m[" + gen_lit(key) + "] = " + gen_lit(replace(read_text(root + "/std/" + n), from_codes([13, 10]), from_codes([10]))))
}
out.push("    m")
out.push("}")
write_text(dest, join(out, from_codes([10])) + from_codes([10]))
print("std_embed.krs: " + str(len(names)) + " files, version " + version)
