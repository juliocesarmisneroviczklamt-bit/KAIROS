// The runtime of Kairós programs compiled to WebAssembly (M13), written in Kairós. The back end
// (wasmgen.krs) compiles these functions with the program, as it needs them.
//
// A function named `wasm_*` is an instruction: the back end replaces each call with the
// WebAssembly that does it, and its body here only lets the checkers type it. Addresses are
// byte offsets in the module's memory.
//
// Every object in memory starts with the count of its references (32 bits, little-endian): a value
// that is copied counts one more, one that is dropped one less, and at 0 the object is freed. A
// count of 0 from the start marks a constant (the program's texts, in its data): never freed.
// Changing a value whose object has other references copies it first, so values never share
// changes (the interpreter's semantics).
//
// A text: the count, its length in bytes, then its UTF-8 bytes. Texts never change once made.
import "rt_ryu.krs"
import "rt_math.krs"
import "rt_unicode.krs"
import "rt_decimal.krs"
import "rt_tensor.krs"

fn wasm_load8(addr: i64) -> i64 {
    addr * 0
}

fn wasm_store8(addr: i64, v: i64) {
}

fn wasm_load32(addr: i64) -> i64 {
    addr * 0
}

fn wasm_store32(addr: i64, v: i64) {
}

// `n` bytes of new memory
fn wasm_alloc(n: i64) -> i64 {
    n * 0
}

// the address of a text's object, and the text at an address
fn wasm_str_addr(s: str) -> i64 {
    0
}

fn wasm_str_at(addr: i64) -> str {
    ""
}

// ------------------------------------------------------------------ the heap
//
// Memory is given in blocks of 2^k bytes (16 at least). A freed block goes to the list of its
// size: the address of its first block is at 64 + 4k, and each block holds the next one.

fn rt_class(n: i64) -> i64 {
    var k = 4
    while shl(1, k) < n { k += 1 }
    k
}

fn rt_alloc(n: i64) -> i64 {
    let k = rt_class(n)
    let head = 64 + 4 * k
    let p = wasm_load32(head)
    if p == 0 { return wasm_alloc(shl(1, k)) }
    wasm_store32(head, wasm_load32(p))
    p
}

// the block of an object of n bytes, now free
fn rt_free(p: i64, n: i64) {
    let head = 64 + 4 * rt_class(n)
    wasm_store32(p, wasm_load32(head))
    wasm_store32(head, p)
}

// ------------------------------------------------------------------ texts

fn rt_new_str(n: i64) -> i64 {
    let p = rt_alloc(8 + n)
    wasm_store32(p, 1)
    wasm_store32(p + 4, n)
    p
}

fn rt_concat(a: str, b: str) -> str {
    let pa = wasm_str_addr(a)
    let pb = wasm_str_addr(b)
    let na = wasm_load32(pa + 4)
    let nb = wasm_load32(pb + 4)
    let p = rt_new_str(na + nb)
    for i in 0..na { wasm_store8(p + 8 + i, wasm_load8(pa + 8 + i)) }
    for i in 0..nb { wasm_store8(p + 8 + na + i, wasm_load8(pb + 8 + i)) }
    wasm_str_at(p)
}

// -1, 0 or 1: byte order, which is the order of the characters
fn rt_str_cmp(a: str, b: str) -> i64 {
    let pa = wasm_str_addr(a)
    let pb = wasm_str_addr(b)
    let na = wasm_load32(pa + 4)
    let nb = wasm_load32(pb + 4)
    let n = if na < nb { na } else { nb }
    for i in 0..n {
        let x = wasm_load8(pa + 8 + i)
        let y = wasm_load8(pb + 8 + i)
        if x < y { return -1 }
        if x > y { return 1 }
    }
    if na < nb { -1 } else if na > nb { 1 } else { 0 }
}

fn rt_str_eq(a: str, b: str) -> bool {
    rt_str_cmp(a, b) == 0
}

// the number of characters: the bytes that do not continue a character
fn rt_str_len(s: str) -> i64 {
    let p = wasm_str_addr(s)
    let n = wasm_load32(p + 4)
    var c = 0
    for i in 0..n {
        if bit_and(wasm_load8(p + 8 + i), 192) != 128 { c += 1 }
    }
    c
}

// the byte where character `k` starts (the length when there are fewer)
fn rt_char_at_byte(p: i64, n: i64, k: i64) -> i64 {
    var seen = 0
    for i in 0..n {
        if bit_and(wasm_load8(p + 8 + i), 192) != 128 {
            if seen == k { return i }
            seen += 1
        }
    }
    n
}

// `substr(s, start, count)`: characters, both clamped at 0
fn rt_substr(s: str, start: i64, count: i64) -> str {
    let p = wasm_str_addr(s)
    let n = wasm_load32(p + 4)
    let a = if start > 0 { start } else { 0 }
    let c = if count > 0 { count } else { 0 }
    let from = rt_char_at_byte(p, n, a)
    let to = if c > n { n } else { rt_char_at_byte(p, n, a + c) }
    let len_ = if to > from { to - from } else { 0 }
    let q = rt_new_str(len_)
    for i in 0..len_ { wasm_store8(q + 8 + i, wasm_load8(p + 8 + from + i)) }
    wasm_str_at(q)
}

// The decimal digits of an integer (negative ones built downwards, so i64's minimum fits).
fn rt_str_i64(v: i64) -> str {
    var n = 1
    if v < 0 { n += 1 }
    var t = v / 10
    while t != 0 {
        n += 1
        t = t / 10
    }
    let p = rt_new_str(n)
    var x = v
    var i = n - 1
    while true {
        let d = x % 10
        wasm_store8(p + 8 + i, if d < 0 { 48 - d } else { 48 + d })
        x = x / 10
        i -= 1
        if x == 0 { break }
    }
    if v < 0 { wasm_store8(p + 8, 45) }
    wasm_str_at(p)
}

// The bytes that write byte c inside quotes: escaped as Rust's `{:?}` escapes it, or itself.
fn rt_esc_len(c: i64) -> i64 {
    if c == 34 or c == 92 or c == 10 or c == 13 or c == 9 or c == 0 { return 2 }
    if c < 32 or c == 127 { return if c < 16 { 5 } else { 6 } }
    1
}

fn rt_hex_digit(d: i64) -> i64 {
    if d < 10 { 48 + d } else { 87 + d }
}

// Writes byte c, escaped, at q: the address after it.
fn rt_put_esc(q: i64, c: i64) -> i64 {
    let n = rt_esc_len(c)
    if n == 1 {
        wasm_store8(q, c)
        return q + 1
    }
    wasm_store8(q, 92)
    if n == 2 {
        let e = if c == 10 { 110 } else if c == 13 { 114 } else if c == 9 { 116 } else if c == 0 { 48 } else { c }
        wasm_store8(q + 1, e)
        return q + 2
    }
    // u{X} or u{XX}, after the backslash
    wasm_store8(q + 1, 117)
    wasm_store8(q + 2, 123)
    var at = q + 3
    if c >= 16 {
        wasm_store8(at, rt_hex_digit(c / 16))
        at += 1
    }
    wasm_store8(at, rt_hex_digit(c % 16))
    wasm_store8(at + 1, 125)
    at + 2
}

// A text inside a value (a list, a struct...), as Rust's `{:?}` writes it: between quotes, with
// quotes, backslashes and control characters escaped. (Characters beyond ASCII are written as
// they are: Rust also escapes the few it does not consider printable.)
fn rt_str_debug(s: str) -> str {
    let p = wasm_str_addr(s)
    let n = wasm_load32(p + 4)
    var m = 2
    for i in 0..n { m += rt_esc_len(wasm_load8(p + 8 + i)) }
    let q = rt_new_str(m)
    wasm_store8(q + 8, 34)
    var at = q + 9
    for i in 0..n { at = rt_put_esc(at, wasm_load8(p + 8 + i)) }
    wasm_store8(at, 34)
    wasm_str_at(q)
}

// ------------------------------------------------------------------ lists
//
// A list: the count, its length, its capacity, then its elements from offset 16, 8 bytes each
// (an i64, an f64, or the 32 bits of a bool or of an address).

fn wasm_load64(addr: i64) -> i64 {
    addr * 0
}

fn wasm_store64(addr: i64, v: i64) {
}

fn rt_list_new(n: i64) -> i64 {
    let p = rt_alloc(16 + 8 * n)
    wasm_store32(p, 1)
    wasm_store32(p + 4, n)
    wasm_store32(p + 8, n)
    p
}

// The list at o (no one else has it) with room for one more element: o itself, or a bigger block
// with the same elements (they move; the old block is freed).
fn rt_list_room(o: i64) -> i64 {
    let n = wasm_load32(o + 4)
    let cap = wasm_load32(o + 8)
    if n < cap { return o }
    let c = if cap < 4 { 4 } else { 2 * cap }
    let p = rt_alloc(16 + 8 * c)
    wasm_store32(p, 1)
    wasm_store32(p + 4, n)
    wasm_store32(p + 8, c)
    for i in 0..n { wasm_store64(p + 16 + 8 * i, wasm_load64(o + 16 + 8 * i)) }
    rt_free(o, 16 + 8 * cap)
    p
}

// The texts of a list joined with `sep` between them.
fn rt_join(xs: List[str], sep: str) -> str {
    let ps = wasm_str_addr(sep)
    let ns = wasm_load32(ps + 4)
    var total = 0
    var k = 0
    for x in xs {
        if k > 0 { total += ns }
        total += wasm_load32(wasm_str_addr(x) + 4)
        k += 1
    }
    let q = rt_new_str(total)
    var at = q + 8
    k = 0
    for x in xs {
        if k > 0 {
            for i in 0..ns { wasm_store8(at + i, wasm_load8(ps + 8 + i)) }
            at += ns
        }
        let px = wasm_str_addr(x)
        let nx = wasm_load32(px + 4)
        for i in 0..nx { wasm_store8(at + i, wasm_load8(px + 8 + i)) }
        at += nx
        k += 1
    }
    wasm_str_at(q)
}

// The bytes from..to of the text at p, as a new text.
fn rt_bytes_str(p: i64, from: i64, to: i64) -> str {
    let q = rt_new_str(to - from)
    for i in from..to { wasm_store8(q + 8 + i - from, wasm_load8(p + 8 + i)) }
    wasm_str_at(q)
}

// Does the text at p have the bytes of the text at q at byte `at`?
fn rt_bytes_at(p: i64, at: i64, q: i64) -> bool {
    let n = wasm_load32(q + 4)
    if at + n > wasm_load32(p + 4) { return false }
    for i in 0..n {
        if wasm_load8(p + 8 + at + i) != wasm_load8(q + 8 + i) { return false }
    }
    true
}

// `split(s, sep)` with a separator that is not empty: the pieces between its occurrences.
fn rt_split(s: str, sep: str) -> List[str] {
    let p = wasm_str_addr(s)
    let q = wasm_str_addr(sep)
    let n = wasm_load32(p + 4)
    let m = wasm_load32(q + 4)
    var out: List[str] = []
    var start = 0
    var i = 0
    while i + m <= n {
        if rt_bytes_at(p, i, q) {
            out.push(rt_bytes_str(p, start, i))
            i += m
            start = i
        } else {
            i += 1
        }
    }
    out.push(rt_bytes_str(p, start, n))
    out
}

// The byte where the text at q first appears in the text at p, or -1.
fn rt_find_bytes(p: i64, q: i64) -> i64 {
    let n = wasm_load32(p + 4)
    let m = wasm_load32(q + 4)
    var i = 0
    while i + m <= n {
        if rt_bytes_at(p, i, q) { return i }
        i += 1
    }
    -1
}

fn rt_str_contains(s: str, sub: str) -> bool {
    rt_find_bytes(wasm_str_addr(s), wasm_str_addr(sub)) >= 0
}

// `find(s, sub)`: the character where sub first appears in s, or -1
fn rt_find(s: str, sub: str) -> i64 {
    let p = wasm_str_addr(s)
    let b = rt_find_bytes(p, wasm_str_addr(sub))
    if b < 0 { return -1 }
    var c = 0
    for i in 0..b {
        if bit_and(wasm_load8(p + 8 + i), 192) != 128 { c += 1 }
    }
    c
}

fn rt_starts_with(s: str, pre: str) -> bool {
    rt_bytes_at(wasm_str_addr(s), 0, wasm_str_addr(pre))
}

fn rt_ends_with(s: str, suf: str) -> bool {
    let p = wasm_str_addr(s)
    let q = wasm_str_addr(suf)
    let at = wasm_load32(p + 4) - wasm_load32(q + 4)
    at >= 0 and rt_bytes_at(p, at, q)
}

// The Unicode code points of a text (UTF-8, which a text always is).
fn rt_codes(s: str) -> List[i64] {
    let p = wasm_str_addr(s)
    let n = wasm_load32(p + 4)
    var out: List[i64] = []
    var i = 0
    while i < n {
        let b = wasm_load8(p + 8 + i)
        if b < 128 {
            out.push(b)
            i += 1
        } else if b < 224 {
            out.push(bit_or(shl(bit_and(b, 31), 6), bit_and(wasm_load8(p + 9 + i), 63)))
            i += 2
        } else if b < 240 {
            out.push(bit_or(bit_or(shl(bit_and(b, 15), 12), shl(bit_and(wasm_load8(p + 9 + i), 63), 6)), bit_and(wasm_load8(p + 10 + i), 63)))
            i += 3
        } else {
            let c = bit_or(shl(bit_and(b, 7), 18), shl(bit_and(wasm_load8(p + 9 + i), 63), 12))
            out.push(bit_or(bit_or(c, shl(bit_and(wasm_load8(p + 10 + i), 63), 6)), bit_and(wasm_load8(p + 11 + i), 63)))
            i += 4
        }
    }
    out
}

// The first code that is not a Unicode code point (a surrogate, negative, beyond 0x10FFFF), as
// its index in the list, or the list's length.
fn rt_bad_code(xs: List[i64]) -> i64 {
    var k = 0
    for c in xs {
        if c < 0 or c > 1114111 or (c >= 55296 and c <= 57343) { return k }
        k += 1
    }
    k
}

fn rt_utf8_len(c: i64) -> i64 {
    if c < 128 { 1 } else if c < 2048 { 2 } else if c < 65536 { 3 } else { 4 }
}

// The text of a list of code points (all valid: rt_bad_code).
fn rt_from_codes(xs: List[i64]) -> str {
    var n = 0
    for c in xs { n += rt_utf8_len(c) }
    let q = rt_new_str(n)
    var at = q + 8
    for c in xs {
        let k = rt_utf8_len(c)
        if k == 1 {
            wasm_store8(at, c)
        } else if k == 2 {
            wasm_store8(at, bit_or(192, shr(c, 6)))
            wasm_store8(at + 1, bit_or(128, bit_and(c, 63)))
        } else if k == 3 {
            wasm_store8(at, bit_or(224, shr(c, 12)))
            wasm_store8(at + 1, bit_or(128, bit_and(shr(c, 6), 63)))
            wasm_store8(at + 2, bit_or(128, bit_and(c, 63)))
        } else {
            wasm_store8(at, bit_or(240, shr(c, 18)))
            wasm_store8(at + 1, bit_or(128, bit_and(shr(c, 12), 63)))
            wasm_store8(at + 2, bit_or(128, bit_and(shr(c, 6), 63)))
            wasm_store8(at + 3, bit_or(128, bit_and(c, 63)))
        }
        at += k
    }
    wasm_str_at(q)
}

// ------------------------------------------------------------------ maps
//
// A map keeps its keys in the order they came (as the interpreter's): the count, the number of
// entries, their capacity, the size of its table (a power of 2), then the entries from offset 16
// (16 bytes each: the key, an i64 or the 32 bits of a text's address, then the value), then the
// table (32 bits each: 1 + the index of an entry, or 0). `skey` says the keys are texts.

fn rt_map_tsize(cap: i64) -> i64 {
    var t = 8
    while t < 2 * cap { t = 2 * t }
    t
}

fn rt_map_bytes(cap: i64, tsize: i64) -> i64 {
    16 + 16 * cap + 4 * tsize
}

fn rt_map_new(cap: i64) -> i64 {
    let ts = rt_map_tsize(cap)
    let m = rt_alloc(rt_map_bytes(cap, ts))
    wasm_store32(m, 1)
    wasm_store32(m + 4, 0)
    wasm_store32(m + 8, cap)
    wasm_store32(m + 12, ts)
    let t = m + 16 + 16 * cap
    for i in 0..ts { wasm_store32(t + 4 * i, 0) }
    m
}

fn rt_map_key(m: i64, i: i64, skey: bool) -> i64 {
    if skey { wasm_load32(m + 16 + 16 * i) } else { wasm_load64(m + 16 + 16 * i) }
}

// FNV-1a over a text's bytes; a multiplicative mix for an integer
fn rt_map_hash(k: i64, skey: bool) -> i64 {
    if not skey { return shr(wrapping_mul(k, -7046029254386353131), 20) }
    var h = -3750763034362895579
    let n = wasm_load32(k + 4)
    for i in 0..n { h = wrapping_mul(bit_xor(h, wasm_load8(k + 8 + i)), 1099511628211) }
    shr(h, 20)
}

fn rt_map_keq(a: i64, b: i64, skey: bool) -> bool {
    if not skey or a == b { return a == b }
    let n = wasm_load32(a + 4)
    if wasm_load32(b + 4) != n { return false }
    for i in 0..n {
        if wasm_load8(a + 8 + i) != wasm_load8(b + 8 + i) { return false }
    }
    true
}

// The index of the entry with key k, or -1.
fn rt_map_find(m: i64, k: i64, skey: bool) -> i64 {
    let ts = wasm_load32(m + 12)
    let t = m + 16 + 16 * wasm_load32(m + 8)
    var h = bit_and(rt_map_hash(k, skey), ts - 1)
    while true {
        let e = wasm_load32(t + 4 * h)
        if e == 0 { return -1 }
        if rt_map_keq(rt_map_key(m, e - 1, skey), k, skey) { return e - 1 }
        h = bit_and(h + 1, ts - 1)
    }
    -1
}

// Entry i in the table (its key is not there yet).
fn rt_map_place(m: i64, i: i64, skey: bool) {
    let ts = wasm_load32(m + 12)
    let t = m + 16 + 16 * wasm_load32(m + 8)
    var h = bit_and(rt_map_hash(rt_map_key(m, i, skey), skey), ts - 1)
    while wasm_load32(t + 4 * h) != 0 { h = bit_and(h + 1, ts - 1) }
    wasm_store32(t + 4 * h, i + 1)
}

fn rt_map_rebuild(m: i64, skey: bool) {
    let ts = wasm_load32(m + 12)
    let t = m + 16 + 16 * wasm_load32(m + 8)
    for i in 0..ts { wasm_store32(t + 4 * i, 0) }
    for i in 0..wasm_load32(m + 4) { rt_map_place(m, i, skey) }
}

// The map at m (no one else has it) with room for one more entry: m itself, or a bigger block
// with the same entries (they move; the old block is freed).
fn rt_map_room(m: i64, skey: bool) -> i64 {
    let n = wasm_load32(m + 4)
    let cap = wasm_load32(m + 8)
    if n < cap { return m }
    let c = if cap < 4 { 4 } else { 2 * cap }
    let q = rt_map_new(c)
    for i in 0..16 * n { wasm_store8(q + 16 + i, wasm_load8(m + 16 + i)) }
    wasm_store32(q + 4, n)
    rt_map_rebuild(q, skey)
    rt_free(m, rt_map_bytes(cap, wasm_load32(m + 12)))
    q
}

// A new entry with key k at the end (the map has room); its value is 0 until it is set.
fn rt_map_add(m: i64, k: i64, skey: bool) -> i64 {
    let n = wasm_load32(m + 4)
    if skey { wasm_store32(m + 16 + 16 * n, k) } else { wasm_store64(m + 16 + 16 * n, k) }
    wasm_store64(m + 24 + 16 * n, 0)
    wasm_store32(m + 4, n + 1)
    rt_map_place(m, n, skey)
    n
}

// Entry i leaves the map (its key and value were dropped); the others keep their order.
fn rt_map_remove(m: i64, i: i64, skey: bool) {
    let n = wasm_load32(m + 4)
    for j in 16 * i..16 * (n - 1) { wasm_store8(m + 16 + j, wasm_load8(m + 32 + j)) }
    wasm_store32(m + 4, n - 1)
    rt_map_rebuild(m, skey)
}

// ------------------------------------------------------------------ bytes
//
// Bytes: the count, the length, the capacity, then the bytes from offset 16.

fn rt_bytes_new(cap: i64) -> i64 {
    let p = rt_alloc(16 + cap)
    wasm_store32(p, 1)
    wasm_store32(p + 4, 0)
    wasm_store32(p + 8, cap)
    p
}

// The bytes at o (no one else has them) with room for `extra` more: o itself, or a bigger block
// with the same bytes (the old block is freed).
fn rt_bytes_room(o: i64, extra: i64) -> i64 {
    let n = wasm_load32(o + 4)
    let cap = wasm_load32(o + 8)
    if n + extra <= cap { return o }
    var c = if cap < 16 { 16 } else { 2 * cap }
    while c < n + extra { c = 2 * c }
    let p = rt_bytes_new(c)
    for i in 0..n { wasm_store8(p + 16 + i, wasm_load8(o + 16 + i)) }
    wasm_store32(p + 4, n)
    rt_free(o, 16 + cap)
    p
}

// A copy of the n bytes at address p, as a text.
fn rt_text_of(p: i64, n: i64) -> str {
    let q = rt_new_str(n)
    for i in 0..n { wasm_store8(q + 8 + i, wasm_load8(p + i)) }
    wasm_str_at(q)
}

fn rt_cont(b: i64) -> bool {
    bit_and(b, 192) == 128
}

// Are the n bytes at p UTF-8 (as Rust's from_utf8 decides: no overlong forms, no surrogates,
// nothing beyond U+10FFFF, no sequence cut short)?
fn rt_utf8_ok(p: i64, n: i64) -> bool {
    var i = 0
    while i < n {
        let b = wasm_load8(p + i)
        if b < 128 {
            i += 1
        } else if b < 194 {
            return false
        } else if b < 224 {
            if i + 1 >= n or not rt_cont(wasm_load8(p + i + 1)) { return false }
            i += 2
        } else if b < 240 {
            if i + 2 >= n { return false }
            let c = wasm_load8(p + i + 1)
            let lo = if b == 224 { 160 } else { 128 }
            let hi = if b == 237 { 159 } else { 191 }
            if c < lo or c > hi or not rt_cont(wasm_load8(p + i + 2)) { return false }
            i += 3
        } else if b < 245 {
            if i + 3 >= n { return false }
            let c = wasm_load8(p + i + 1)
            let lo = if b == 240 { 144 } else { 128 }
            let hi = if b == 244 { 143 } else { 191 }
            if c < lo or c > hi or not rt_cont(wasm_load8(p + i + 2)) or not rt_cont(wasm_load8(p + i + 3)) { return false }
            i += 4
        } else {
            return false
        }
    }
    true
}

// The text of a file's n bytes at p, as the interpreter reads it: UTF-8, or else Latin-1 (each
// byte a character); a byte order mark at the start is dropped.
fn rt_decode(p: i64, n: i64) -> str {
    var start = 0
    if rt_utf8_ok(p, n) {
        if n >= 3 and wasm_load8(p) == 239 and wasm_load8(p + 1) == 187 and wasm_load8(p + 2) == 191 { start = 3 }
        return rt_text_of(p + start, n - start)
    }
    var m = 0
    for i in 0..n { m += if wasm_load8(p + i) < 128 { 1 } else { 2 } }
    let q = rt_new_str(m)
    var at = q + 8
    for i in 0..n {
        let b = wasm_load8(p + i)
        if b < 128 {
            wasm_store8(at, b)
            at += 1
        } else {
            wasm_store8(at, bit_or(192, shr(b, 6)))
            wasm_store8(at + 1, bit_or(128, bit_and(b, 63)))
            at += 2
        }
    }
    wasm_str_at(q)
}

// "<n bytes>"
fn rt_bytes_show(b: Bytes) -> str {
    "<" + str(wasm_load32(wasm_bytes_addr(b) + 4)) + " bytes>"
}

fn rt_bytes_eq(a: Bytes, b: Bytes) -> bool {
    let pa = wasm_bytes_addr(a)
    let pb = wasm_bytes_addr(b)
    let n = wasm_load32(pa + 4)
    if wasm_load32(pb + 4) != n { return false }
    for i in 0..n {
        if wasm_load8(pa + 16 + i) != wasm_load8(pb + 16 + i) { return false }
    }
    true
}

// get_str: the n bytes at `at` as a text (the back end checks the bounds); false when they are
// not UTF-8.
fn rt_get_str(b: Bytes, at: i64, n: i64) -> (bool, str) {
    let p = wasm_bytes_addr(b) + 16 + at
    if not rt_utf8_ok(p, n) { return (false, "") }
    (true, rt_text_of(p, n))
}

// ------------------------------------------------------------------ files, through WASI
//
// Paths are relative to the first folder the WASI runtime opens for the program (descriptor 3:
// `wasmtime --dir=. program.wasm`). An error is WASI's code; its text is the one Rust gives on
// Linux for the usual ones.

fn wasm_bytes_addr(b: Bytes) -> i64 {
    0
}

fn wasm_bytes_at(addr: i64) -> Bytes {
    bytes()
}

fn wasm_wasi_args_sizes_get(argc_at: i64, size_at: i64) -> i64 {
    0
}

fn wasm_wasi_args_get(argv_at: i64, buf_at: i64) -> i64 {
    0
}

fn wasm_wasi_environ_sizes_get(n_at: i64, size_at: i64) -> i64 {
    0
}

fn wasm_wasi_environ_get(env_at: i64, buf_at: i64) -> i64 {
    0
}

fn wasm_wasi_path_open(dir: i64, flags: i64, path_at: i64, path_len: i64, oflags: i64, rights: i64, inherit: i64, fdflags: i64, fd_at: i64) -> i64 {
    0
}

fn wasm_wasi_fd_read(fd: i64, iovs: i64, n: i64, nread_at: i64) -> i64 {
    0
}

fn wasm_wasi_fd_write(fd: i64, iovs: i64, n: i64, nwritten_at: i64) -> i64 {
    0
}

fn wasm_wasi_fd_close(fd: i64) -> i64 {
    0
}

fn wasm_wasi_path_create_directory(dir: i64, path_at: i64, path_len: i64) -> i64 {
    0
}

fn wasm_wasi_path_filestat_get(dir: i64, flags: i64, path_at: i64, path_len: i64, stat_at: i64) -> i64 {
    0
}

fn rt_errno_text(e: i64) -> str {
    if e == 44 { return "No such file or directory (os error 2)" }
    if e == 2 or e == 63 or e == 76 { return "Permission denied (os error 13)" }
    if e == 20 { return "File exists (os error 17)" }
    if e == 54 { return "Not a directory (os error 20)" }
    if e == 31 { return "Is a directory (os error 21)" }
    "WASI error " + str(e)
}

// The text of a path, its bytes at a new address (a C string is not needed: WASI takes lengths).
fn rt_path_addr(p: str) -> i64 {
    wasm_str_addr(p) + 8
}

fn rt_path_len(p: str) -> i64 {
    wasm_load32(wasm_str_addr(p) + 4)
}

// Opens a file: (WASI's error code, the descriptor). For writing it is created or emptied.
fn rt_open(p: str, write: bool) -> (i64, i64) {
    let cell = rt_alloc(16)
    let oflags = if write { 9 } else { 0 }
    let rights = if write { 100 } else { 2097190 }
    let e = wasm_wasi_path_open(3, 1, rt_path_addr(p), rt_path_len(p), oflags, rights, 0, 0, cell)
    let fd = wasm_load32(cell)
    rt_free(cell, 16)
    (e, fd)
}

// All the bytes of a file: (WASI's error code, the bytes).
fn rt_read_file(p: str) -> (i64, Bytes) {
    let o = rt_open(p, false)
    if o.0 != 0 { return (o.0, bytes()) }
    var b = rt_bytes_new(4096)
    let io = rt_alloc(16)
    var e = 0
    while true {
        b = rt_bytes_room(b, 4096)
        let n = wasm_load32(b + 4)
        wasm_store32(io, b + 16 + n)
        wasm_store32(io + 4, wasm_load32(b + 8) - n)
        e = wasm_wasi_fd_read(o.1, io, 1, io + 8)
        let got = wasm_load32(io + 8)
        if e != 0 or got == 0 { break }
        wasm_store32(b + 4, n + got)
    }
    rt_free(io, 16)
    let _ = wasm_wasi_fd_close(o.1)
    (e, wasm_bytes_at(b))
}

// The n bytes at address q to a file (created or emptied): WASI's error code.
fn rt_write_file(p: str, q: i64, n: i64) -> i64 {
    let o = rt_open(p, true)
    if o.0 != 0 { return o.0 }
    let io = rt_alloc(16)
    var at = 0
    var e = 0
    while at < n {
        wasm_store32(io, q + at)
        wasm_store32(io + 4, n - at)
        e = wasm_wasi_fd_write(o.1, io, 1, io + 8)
        if e != 0 { break }
        at += wasm_load32(io + 8)
    }
    rt_free(io, 16)
    let _ = wasm_wasi_fd_close(o.1)
    e
}

fn rt_read_text(p: str) -> (i64, str) {
    let r = rt_read_file(p)
    if r.0 != 0 { return (r.0, "") }
    let b = wasm_bytes_addr(r.1)
    (0, rt_decode(b + 16, wasm_load32(b + 4)))
}

fn rt_write_text(p: str, s: str) -> i64 {
    rt_write_file(p, wasm_str_addr(s) + 8, wasm_load32(wasm_str_addr(s) + 4))
}

fn rt_write_bytes(p: str, b: Bytes) -> i64 {
    rt_write_file(p, wasm_bytes_addr(b) + 16, wasm_load32(wasm_bytes_addr(b) + 4))
}

// A file's size, or -1 (and whether it exists): WASI's filestat has the size at offset 32.
fn rt_file_size(p: str) -> i64 {
    let st = rt_alloc(64)
    let e = wasm_wasi_path_filestat_get(3, 1, rt_path_addr(p), rt_path_len(p), st)
    let n = if e == 0 { wasm_load64(st + 32) } else { -1 }
    rt_free(st, 64)
    n
}

fn rt_file_exists(p: str) -> bool {
    let st = rt_alloc(64)
    let e = wasm_wasi_path_filestat_get(3, 1, rt_path_addr(p), rt_path_len(p), st)
    rt_free(st, 64)
    e == 0
}

// make_dir: each folder on the way (as create_dir_all): WASI's error code.
fn rt_make_dir(p: str) -> i64 {
    let a = rt_path_addr(p)
    let n = rt_path_len(p)
    var i = 0
    while i <= n {
        if i == n or wasm_load8(a + i) == 47 {
            if i > 0 {
                let e = wasm_wasi_path_create_directory(3, a, i)
                // 20: it exists already
                if e != 0 and e != 20 { return e }
            }
        }
        i += 1
    }
    0
}

// The C strings at the addresses in the list at `at` (count of them), from the k-th.
fn rt_cstrs(at: i64, count: i64, k: i64) -> List[str] {
    var out: List[str] = []
    for i in k..count {
        let p = wasm_load32(at + 4 * i)
        var n = 0
        while wasm_load8(p + n) != 0 { n += 1 }
        out.push(rt_text_of(p, n))
    }
    out
}

// args(): the program's arguments (WASI gives the program's name first)
fn rt_args() -> List[str] {
    let sz = rt_alloc(16)
    let _ = wasm_wasi_args_sizes_get(sz, sz + 4)
    let argc = wasm_load32(sz)
    let size = wasm_load32(sz + 4)
    let argv = rt_alloc(4 * argc + 4)
    let buf = rt_alloc(size + 1)
    let _ = wasm_wasi_args_get(argv, buf)
    let out = rt_cstrs(argv, argc, 1)
    rt_free(argv, 4 * argc + 4)
    rt_free(buf, size + 1)
    rt_free(sz, 16)
    out
}

// env(name): the value of a variable of the environment, or ""
fn rt_env(name: str) -> str {
    let sz = rt_alloc(16)
    let _ = wasm_wasi_environ_sizes_get(sz, sz + 4)
    let count = wasm_load32(sz)
    let size = wasm_load32(sz + 4)
    let env = rt_alloc(4 * count + 4)
    let buf = rt_alloc(size + 1)
    let _ = wasm_wasi_environ_get(env, buf)
    let all = rt_cstrs(env, count, 0)
    rt_free(env, 4 * count + 4)
    rt_free(buf, size + 1)
    rt_free(sz, 16)
    let pre = name + "="
    for kv in all {
        if rt_starts_with(kv, pre) { return substr(kv, len(pre), len(kv) - len(pre)) }
    }
    ""
}

fn rt_copy(dst: i64, src: i64, n: i64) {
    for i in 0..n { wasm_store8(dst + i, wasm_load8(src + i)) }
}

// A copy of the bytes at o, with a count of 1.
fn rt_bytes_copy(o: i64) -> i64 {
    let n = wasm_load32(o + 4)
    let p = rt_bytes_new(n)
    rt_copy(p + 16, o + 16, n)
    wasm_store32(p + 4, n)
    p
}

// The digits of the 64 bits of v read as an unsigned number.
fn rt_str_u64(v: i64) -> str {
    if v >= 0 { return str(v) }
    let q = rt_udiv(v, 10)
    str(q) + str(rt_umod10(v, q))
}

// The text itself (for a message that shows it).
fn rt_str_same(s: str) -> str {
    s
}

// ------------------------------------------------------------------ more on texts

// Is c white space for Unicode (Rust's char::is_whitespace)?
fn rt_ws(c: i64) -> bool {
    (c >= 9 and c <= 13) or c == 32 or c == 133 or c == 160 or c == 5760 or (c >= 8192 and c <= 8202) or c == 8232 or c == 8233 or c == 8239 or c == 8287 or c == 12288
}

// The code point at byte i of the text at p, and its length in bytes.
fn rt_code_at(p: i64, i: i64) -> (i64, i64) {
    let b = wasm_load8(p + 8 + i)
    if b < 128 { return (b, 1) }
    if b < 224 { return (bit_or(shl(bit_and(b, 31), 6), bit_and(wasm_load8(p + 9 + i), 63)), 2) }
    if b < 240 { return (bit_or(bit_or(shl(bit_and(b, 15), 12), shl(bit_and(wasm_load8(p + 9 + i), 63), 6)), bit_and(wasm_load8(p + 10 + i), 63)), 3) }
    let c = bit_or(shl(bit_and(b, 7), 18), shl(bit_and(wasm_load8(p + 9 + i), 63), 12))
    (bit_or(bit_or(c, shl(bit_and(wasm_load8(p + 10 + i), 63), 6)), bit_and(wasm_load8(p + 11 + i), 63)), 4)
}

// The bytes (from, to) of the text at p without the white space at its ends.
fn rt_trim_ends(p: i64) -> (i64, i64) {
    let n = wasm_load32(p + 4)
    var a = 0
    while a < n {
        let c = rt_code_at(p, a)
        if not rt_ws(c.0) { break }
        a += c.1
    }
    var z = n
    while z > a {
        var k = z - 1
        while k > a and bit_and(wasm_load8(p + 8 + k), 192) == 128 { k -= 1 }
        if not rt_ws(rt_code_at(p, k).0) { break }
        z = k
    }
    (a, z)
}

fn rt_trim(s: str) -> str {
    let p = wasm_str_addr(s)
    let r = rt_trim_ends(p)
    rt_bytes_str(p, r.0, r.1)
}

// parse_int: the text without the white space at its ends, as Rust reads an i64: (it is one,
// its value)
fn rt_parse_int(s: str) -> (bool, i64) {
    let p = wasm_str_addr(s)
    let r = rt_trim_ends(p)
    var i = r.0
    let z = r.1
    var neg = false
    if i < z and (wasm_load8(p + 8 + i) == 43 or wasm_load8(p + 8 + i) == 45) {
        neg = wasm_load8(p + 8 + i) == 45
        i += 1
    }
    if i >= z { return (false, 0) }
    var v = 0
    while i < z {
        let d = wasm_load8(p + 8 + i) - 48
        if d < 0 or d > 9 { return (false, 0) }
        // negative numbers are built below 0, so the smallest i64 fits
        if neg {
            if v < (-9223372036854775807 - 1 + d) / 10 { return (false, 0) }
            v = v * 10 - d
        } else {
            if v > (9223372036854775807 - d) / 10 { return (false, 0) }
            v = v * 10 + d
        }
        i += 1
    }
    (true, v)
}

// replace(s, a, b): each `a` in s, from the left and without overlaps, becomes `b` (with an empty
// `a`, b goes before each character and at the end, as in Rust)
fn rt_replace(s: str, a: str, b: str) -> str {
    let p = wasm_str_addr(s)
    let q = wasm_str_addr(a)
    let n = wasm_load32(p + 4)
    let m = wasm_load32(q + 4)
    var parts: List[str] = []
    if m == 0 {
        var i = 0
        while i < n {
            parts.push(b)
            let k = rt_code_at(p, i).1
            parts.push(rt_bytes_str(p, i, i + k))
            i += k
        }
        parts.push(b)
        return rt_join(parts, "")
    }
    var start = 0
    var i = 0
    while i + m <= n {
        if rt_bytes_at(p, i, q) {
            parts.push(rt_bytes_str(p, start, i))
            parts.push(b)
            i += m
            start = i
        } else {
            i += 1
        }
    }
    parts.push(rt_bytes_str(p, start, n))
    rt_join(parts, "")
}

// to_hex(x, width): the 64 bits of x in lowercase hexadecimal, with zeros to the width (0 to 64)
fn rt_to_hex(x: i64, w0: i64) -> str {
    let w = if w0 < 0 { 0 } else if w0 > 64 { 64 } else { w0 }
    var digits: List[i64] = []
    var v = x
    while true {
        digits.push(bit_and(v, 15))
        v = shr(v, 4)
        if v == 0 { break }
    }
    let n = if len(digits) > w { len(digits) } else { w }
    let q = rt_new_str(n)
    for i in 0..n {
        let d = if n - 1 - i < len(digits) { digits[n - 1 - i] } else { 0 }
        wasm_store8(q + 8 + i, rt_hex_digit(d))
    }
    wasm_str_at(q)
}

// -1, 0 or 1: the texts at two addresses in byte order
fn rt_addr_cmp(pa: i64, pb: i64) -> i64 {
    let na = wasm_load32(pa + 4)
    let nb = wasm_load32(pb + 4)
    let n = if na < nb { na } else { nb }
    for i in 0..n {
        let x = wasm_load8(pa + 8 + i)
        let y = wasm_load8(pb + 8 + i)
        if x < y { return -1 }
        if x > y { return 1 }
    }
    if na < nb { -1 } else if na > nb { 1 } else { 0 }
}

// ------------------------------------------------------------------ sorting
//
// sort(inout xs) for numbers, booleans and texts (kind 0 i64, 1 f64, 2 bool, 3 text): stable,
// in the interpreter's order (floats in their total order, as Rust's total_cmp).

fn rt_slot(base: i64, i: i64, kind: i64) -> i64 {
    if kind >= 2 { wasm_load32(base + 8 * i) } else { wasm_load64(base + 8 * i) }
}

fn rt_less(a: i64, b: i64, kind: i64) -> bool {
    if kind == 3 { return rt_addr_cmp(a, b) < 0 }
    if kind == 1 {
        let x = if a < 0 { bit_xor(a, 9223372036854775807) } else { a }
        let y = if b < 0 { bit_xor(b, 9223372036854775807) } else { b }
        return x < y
    }
    a < b
}

// merge sort, bottom up, through a buffer of the same size
fn rt_sort(o: i64, kind: i64) {
    let n = wasm_load32(o + 4)
    if n < 2 { return }
    let tmp = rt_alloc(8 * n)
    var src = o + 16
    var dst = tmp
    var width = 1
    while width < n {
        var lo = 0
        while lo < n {
            let mid = if lo + width < n { lo + width } else { n }
            let hi = if lo + 2 * width < n { lo + 2 * width } else { n }
            var i = lo
            var j = mid
            for k in lo..hi {
                // the left one, unless the right one is smaller (so equal ones keep their order)
                var right = i >= mid
                if not right and j < hi { right = rt_less(rt_slot(src, j, kind), rt_slot(src, i, kind), kind) }
                if right {
                    wasm_store64(dst + 8 * k, wasm_load64(src + 8 * j))
                    j += 1
                } else {
                    wasm_store64(dst + 8 * k, wasm_load64(src + 8 * i))
                    i += 1
                }
            }
            lo = hi
        }
        let t = src
        src = dst
        dst = t
        width = 2 * width
    }
    if src != o + 16 { rt_copy(o + 16, src, 8 * n) }
    rt_free(tmp, 8 * n)
}

fn rt_reverse(o: i64) {
    let n = wasm_load32(o + 4)
    for i in 0..n / 2 {
        let a = o + 16 + 8 * i
        let b = o + 16 + 8 * (n - 1 - i)
        let t = wasm_load64(a)
        wasm_store64(a, wasm_load64(b))
        wasm_store64(b, t)
    }
}

// ------------------------------------------------------------------ classes of characters
//
// The tables of rt_unicode.krs: boundaries in base 64, 4 digits each; c is in the class when an
// odd number of them are at or below it.

fn rt_b64(ch: i64) -> i64 {
    if ch >= 97 { return ch - 71 }
    if ch >= 65 { return ch - 65 }
    if ch >= 48 { return ch + 4 }
    if ch == 43 { 62 } else { 63 }
}

fn rt_uni_at(p: i64, k: i64) -> i64 {
    var v = 0
    for i in 0..4 { v = v * 64 + rt_b64(wasm_load8(p + 8 + 4 * k + i)) }
    v
}

// which: 0 alphabetic, 1 alphanumeric, 2 uppercase, 3 white space
fn rt_uni_in(c: i64, which: i64) -> bool {
    // not a character: negative, a surrogate, beyond U+10FFFF
    if c < 0 or c > 1114111 or (c >= 55296 and c <= 57343) { return false }
    let t = if which == 0 { rt_uni_alphabetic() } else if which == 1 { rt_uni_alphanumeric() } else if which == 2 { rt_uni_uppercase() } else { rt_uni_whitespace() }
    let p = wasm_str_addr(t)
    var lo = 0
    var hi = wasm_load32(p + 4) / 4
    while lo < hi {
        let mid = (lo + hi) / 2
        if rt_uni_at(p, mid) <= c { lo = mid + 1 } else { hi = mid }
    }
    lo % 2 == 1
}

// ------------------------------------------------------------------ floats as text
//
// `str(x)` and `print(x)` of a float, as Rust's `{:?}`: the shortest digits that read back as
// the same float (Ryu, by Ulf Adams: d2s.c with its full tables, in rt_ryu.krs), as a decimal
// from 1e-4 to 1e16 and with an exponent beyond. These functions use the language itself
// (`str`, `len`, `substr`), so they run in the interpreter too, where they are checked against
// the formatting of Rust. 64-bit unsigned numbers are i64 with the same bits.

fn rt_min64() -> i64 {
    -9223372036854775807 - 1
}

// a < b as unsigned numbers
fn rt_ult(a: i64, b: i64) -> bool {
    bit_xor(a, rt_min64()) < bit_xor(b, rt_min64())
}

// the high 64 bits of the 128-bit product of a and b, unsigned (by 32-bit halves)
fn rt_umulhi(a: i64, b: i64) -> i64 {
    let m32 = 4294967295
    let a_lo = bit_and(a, m32)
    let a_hi = shr(a, 32)
    let b_lo = bit_and(b, m32)
    let b_hi = shr(b, 32)
    let b00 = wrapping_mul(a_lo, b_lo)
    let b01 = wrapping_mul(a_lo, b_hi)
    let b10 = wrapping_mul(a_hi, b_lo)
    let b11 = wrapping_mul(a_hi, b_hi)
    let mid1 = wrapping_add(b10, shr(b00, 32))
    let mid2 = wrapping_add(b01, bit_and(mid1, m32))
    wrapping_add(wrapping_add(b11, shr(mid1, 32)), shr(mid2, 32))
}

// x / d, unsigned, for a small d
fn rt_udiv(x: i64, d: i64) -> i64 {
    if x >= 0 { return x / d }
    var q = shr(x, 1) / d * 2
    let r = wrapping_add(x, wrapping_mul(q, -d))
    if r >= d { q += 1 }
    q
}

// x - 10 * q10, unsigned
fn rt_umod10(x: i64, q10: i64) -> i64 {
    wrapping_add(x, wrapping_mul(q10, -10))
}

// (m * mul) >> j for a 128-bit `mul` (lo, hi) and 64 < j < 128
fn rt_mul_shift(m: i64, lo: i64, hi: i64, j: i64) -> i64 {
    let low1 = wrapping_mul(m, hi)
    var high1 = rt_umulhi(m, hi)
    let high0 = rt_umulhi(m, lo)
    let sum = wrapping_add(high0, low1)
    if rt_ult(sum, high0) { high1 = wrapping_add(high1, 1) }
    let d = j - 64
    bit_or(shl(high1, 64 - d), shr(sum, d))
}

fn rt_pow5bits(e: i64) -> i64 {
    shr(e * 1217359, 19) + 1
}

fn rt_log10_pow2(e: i64) -> i64 {
    shr(e * 78913, 18)
}

fn rt_log10_pow5(e: i64) -> i64 {
    shr(e * 732923, 20)
}

// how many times 5 divides v (v > 0)
fn rt_pow5_factor(v: i64) -> i64 {
    var x = v
    var count = 0
    while x % 5 == 0 {
        x = x / 5
        count += 1
    }
    count
}

fn rt_zeros(n: i64) -> str {
    var s = ""
    for i in 0..n { s = s + "0" }
    s
}

fn rt_fmt_f64(x: f64) -> str {
    let bits = to_bits(x)
    let neg = bits < 0
    let ieee_m = bit_and(bits, 4503599627370495)
    let ieee_e = bit_and(shr(bits, 52), 2047)
    if ieee_e == 2047 {
        if ieee_m != 0 { return "NaN" }
        return if neg { "-inf" } else { "inf" }
    }
    let sign = if neg { "-" } else { "" }
    if ieee_e == 0 and ieee_m == 0 { return sign + "0.0" }
    // the value is m2 * 2^e2 (e2 two below the true exponent, to fit the bounds)
    var e2 = 1 - 1023 - 52 - 2
    var m2 = ieee_m
    if ieee_e != 0 {
        e2 = ieee_e - 1023 - 52 - 2
        m2 = bit_or(4503599627370496, ieee_m)
    }
    let accept = bit_and(m2, 1) == 0
    let mv = 4 * m2
    let mm_shift = if ieee_m != 0 or ieee_e <= 1 { 1 } else { 0 }
    // the decimals that read back as x lie in (vm, vp), and x is vr, all times 10^-e10
    var vr = 0
    var vp = 0
    var vm = 0
    var e10 = 0
    var vm_tz = false
    var vr_tz = false
    if e2 >= 0 {
        let q = rt_log10_pow2(e2) - (if e2 > 3 { 1 } else { 0 })
        e10 = q
        let k = 125 + rt_pow5bits(q) - 1
        let i = -e2 + q + k
        let lo = rt_ryu_inv_lo(q)
        let hi = rt_ryu_inv_hi(q)
        vr = rt_mul_shift(mv, lo, hi, i)
        vp = rt_mul_shift(mv + 2, lo, hi, i)
        vm = rt_mul_shift(mv - 1 - mm_shift, lo, hi, i)
        if q <= 21 {
            if mv % 5 == 0 {
                vr_tz = rt_pow5_factor(mv) >= q
            } else if accept {
                vm_tz = rt_pow5_factor(mv - 1 - mm_shift) >= q
            } else if rt_pow5_factor(mv + 2) >= q {
                vp = wrapping_add(vp, -1)
            }
        }
    } else {
        let q = rt_log10_pow5(-e2) - (if -e2 > 1 { 1 } else { 0 })
        e10 = q + e2
        let i = -e2 - q
        let k = rt_pow5bits(i) - 125
        let j = q - k
        let lo = rt_ryu_pow5_lo(i)
        let hi = rt_ryu_pow5_hi(i)
        vr = rt_mul_shift(mv, lo, hi, j)
        vp = rt_mul_shift(mv + 2, lo, hi, j)
        vm = rt_mul_shift(mv - 1 - mm_shift, lo, hi, j)
        if q <= 1 {
            vr_tz = true
            if accept {
                vm_tz = mm_shift == 1
            } else {
                vp = wrapping_add(vp, -1)
            }
        } else if q < 63 {
            vr_tz = bit_and(mv, shl(1, q) - 1) == 0
        }
    }
    // the shortest decimal in the interval
    var removed = 0
    var last = 0
    var output = 0
    if vm_tz or vr_tz {
        while true {
            let vp10 = rt_udiv(vp, 10)
            let vm10 = rt_udiv(vm, 10)
            if vp10 <= vm10 { break }
            let vm_mod = rt_umod10(vm, vm10)
            let vr10 = rt_udiv(vr, 10)
            let vr_mod = rt_umod10(vr, vr10)
            vm_tz = vm_tz and vm_mod == 0
            vr_tz = vr_tz and last == 0
            last = vr_mod
            vr = vr10
            vp = vp10
            vm = vm10
            removed += 1
        }
        if vm_tz {
            while true {
                let vm10 = rt_udiv(vm, 10)
                if rt_umod10(vm, vm10) != 0 { break }
                let vp10 = rt_udiv(vp, 10)
                let vr10 = rt_udiv(vr, 10)
                let vr_mod = rt_umod10(vr, vr10)
                vr_tz = vr_tz and last == 0
                last = vr_mod
                vr = vr10
                vp = vp10
                vm = vm10
                removed += 1
            }
        }
        // exactly halfway: up, as Rust (Ryu rounds to even here)
        let up = (vr == vm and (not accept or not vm_tz)) or last >= 5
        output = if up { wrapping_add(vr, 1) } else { vr }
    } else {
        var round_up = false
        let vp100 = rt_udiv(vp, 100)
        let vm100 = rt_udiv(vm, 100)
        if vp100 > vm100 {
            let vr100 = rt_udiv(vr, 100)
            round_up = wrapping_add(vr, wrapping_mul(vr100, -100)) >= 50
            vr = vr100
            vp = vp100
            vm = vm100
            removed += 2
        }
        while true {
            let vp10 = rt_udiv(vp, 10)
            let vm10 = rt_udiv(vm, 10)
            if vp10 <= vm10 { break }
            let vr10 = rt_udiv(vr, 10)
            round_up = rt_umod10(vr, vr10) >= 5
            vr = vr10
            vp = vp10
            vm = vm10
            removed += 1
        }
        output = if vr == vm or round_up { wrapping_add(vr, 1) } else { vr }
    }
    // the digits d1..dn of x = 0.d1..dn * 10^k
    let digits = str(output)
    let n = len(digits)
    let k = e10 + removed + n
    let ax = if neg { -x } else { x }
    if ax < 0.0001 or ax >= 10000000000000000.0 {
        var s = sign + substr(digits, 0, 1)
        if n > 1 { s = s + "." + substr(digits, 1, n - 1) }
        return s + "e" + str(k - 1)
    }
    if k <= 0 { return sign + "0." + rt_zeros(-k) + digits }
    if k < n { return sign + substr(digits, 0, k) + "." + substr(digits, k, n - k) }
    sign + digits + rt_zeros(k - n) + ".0"
}

// ------------------------------------------------------------------ the rest of a division
//
// x % y on floats, exactly, with the sign of x (C's fmod, as musl writes it): the mantissas
// are subtracted bit by bit, so the result is exact.
fn rt_fmod(x: f64, y: f64) -> f64 {
    let xb = to_bits(x)
    let yb = to_bits(y)
    var ex = bit_and(shr(xb, 52), 2047)
    var ey = bit_and(shr(yb, 52), 2047)
    let sx = shr(xb, 63)
    if shl(yb, 1) == 0 or y != y or ex == 2047 { return (x * y) / (x * y) }
    let ax = shl(xb, 1)
    let ay = shl(yb, 1)
    if not rt_ult(ay, ax) {
        if ax == ay { return 0.0 * x }
        return x
    }
    // the mantissas with their leading 1 (subnormals shifted up)
    var mx = xb
    if ex == 0 {
        var i = shl(mx, 12)
        while i >= 0 {
            ex -= 1
            i = shl(i, 1)
        }
        mx = shl(mx, 1 - ex)
    } else {
        mx = bit_or(bit_and(mx, 4503599627370495), 4503599627370496)
    }
    var my = yb
    if ey == 0 {
        var i = shl(my, 12)
        while i >= 0 {
            ey -= 1
            i = shl(i, 1)
        }
        my = shl(my, 1 - ey)
    } else {
        my = bit_or(bit_and(my, 4503599627370495), 4503599627370496)
    }
    while ex > ey {
        let i = mx - my
        if i >= 0 {
            if i == 0 { return 0.0 * x }
            mx = i
        }
        mx = shl(mx, 1)
        ex -= 1
    }
    let i = mx - my
    if i >= 0 {
        if i == 0 { return 0.0 * x }
        mx = i
    }
    while shr(mx, 52) == 0 {
        mx = shl(mx, 1)
        ex -= 1
    }
    if ex > 0 {
        mx = bit_or(mx - 4503599627370496, shl(ex, 52))
    } else {
        mx = shr(mx, 1 - ex)
    }
    from_bits(bit_or(mx, shl(sx, 63)))
}
