// The WebAssembly back end of Kairós (M13), written in Kairós: the checked HIR of a program
// becomes a WebAssembly module that runs under WASI (wasmtime, node, a browser...). It compiles
// integers, floats, booleans, texts, tuples, structs, functions and control flow with the
// interpreter's semantics: the same output, and the same runtime errors with the same messages
// (checked arithmetic: R0006 overflow, R0002 division by zero, R0007 negative exponent; R0003
// assertions...). What it does not compile yet stops with the code W0001.
//
// The module imports `fd_write` and `proc_exit` from WASI and exports `_start` and `memory`.
// Memory: an iovec at 0, the byte count at 8, 32 bytes of scratch for numbers at 16, the lists
// of free blocks at 64 (rt.krs), the constant data from 1024 (the program's texts, and every
// runtime error message, rendered when compiling), then the heap (global 0 is its next free
// byte). The functions of the runtime (rt.krs, written in Kairós) are compiled with the program,
// as it uses them.
//
// Values in the heap (texts, tuples, structs) are addresses of objects that count their
// references (rt.krs). A value an expression gives is owned: whoever takes it keeps the
// reference or drops it. Variables own their values and drop them when they change and when
// the function returns; a function borrows its arguments; a value is copied before it changes
// when others share it. Each type gets its own functions to drop, copy and write its values
// (the glue, made as the program uses them).
import "wasm.krs"
import "front.krs"

struct WGen {
    m: WMod,
    ck: Checker,
    srcs: List[str],                // the source of each file (for messages)
    fidx: Map[i64, i64],            // Kairós function -> WebAssembly function
    order: List[i64],               // the functions to compile, in their order (glue: -1 - k)
    glue: List[(str, Ty)],          // the glue functions: what each does, for which type
    glue_idx: Map[str, i64],        // "what type" -> its function
    strs: Map[str, (i64, i64)],     // a constant text -> (address, byte length)
    objs: Map[str, i64],            // a constant text -> the address of its object
    vobjs: Map[str, i64],           // "enum variant" -> the constant of a variant without fields
    // the function being generated
    code: List[i64],
    ltypes: List[i64],              // the type of each local (the parameters first)
    nparams: i64,
    slot_local: List[i64],          // Kairós slot -> local (-1: no value)
    slot_ty: List[Ty],              // the type of each slot
    inout_slots: List[i64],         // the slots of the `inout` parameters (given back at the end)
    depth: i64,                     // blocks, loops and ifs open
    loops: List[(i64, i64)],        // the levels of a loop's exit and continue blocks
    unchecked: bool,                // the runtime's own arithmetic is not checked
    failed: bool,
    msg: str,
    efile: i64,
    elo: i64,
    ehi: i64,
}

// imports and the runtime's functions
fn f_fd_write() -> i64 {
    0
}

fn f_proc_exit() -> i64 {
    1
}

fn f_write() -> i64 {
    2
}

fn f_fail() -> i64 {
    3
}

fn f_print_i64() -> i64 {
    4
}

fn f_alloc() -> i64 {
    5
}

fn f_print_str() -> i64 {
    6
}

fn f_incref() -> i64 {
    7
}

fn f_start() -> i64 {
    8
}

fn first_user_fn() -> i64 {
    9
}

// The function index of a Kairós function, which is compiled once its index is asked for.
fn fn_index(inout g: WGen, id: i64) -> i64 {
    if contains(g.fidx, id) { return g.fidx[id] }
    let i = first_user_fn() + len(g.order)
    g.fidx[id] = i
    g.order.push(id)
    i
}

// A function of the runtime (rt.krs), by name.
fn rt_fn(inout g: WGen, name: str) -> i64 {
    fn_index(inout g, g.ck.fn_ids[name])
}

// The glue function that does `what` (drop, unique, show) for values of type `t`.
fn glue_fn(inout g: WGen, what: str, t: Ty) -> i64 {
    let key = what + " " + show(g.ck, t)
    if contains(g.glue_idx, key) { return g.glue_idx[key] }
    let i = first_user_fn() + len(g.order)
    g.glue_idx[key] = i
    g.order.push(-1 - len(g.glue))
    g.glue.push((what, t))
    i
}

fn wg_fail(inout g: WGen, e: H, what: str) {
    if g.failed { return }
    g.failed = true
    g.msg = "not in the WebAssembly back end yet: " + what
    g.efile = e.f
    g.elo = e.lo
    g.ehi = e.hi
}

// ------------------------------------------------------------------ instructions

fn op(inout g: WGen, b: i64) {
    g.code.push(b)
}

fn op_u(inout g: WGen, b: i64, x: i64) {
    g.code.push(b)
    uleb(inout g.code, x)
}

fn lget(inout g: WGen, i: i64) {
    op_u(inout g, 32, i)
}

fn lset(inout g: WGen, i: i64) {
    op_u(inout g, 33, i)
}

fn i64c(inout g: WGen, v: i64) {
    g.code.push(66)
    sleb(inout g.code, v)
}

fn i32c(inout g: WGen, v: i64) {
    g.code.push(65)
    sleb(inout g.code, v)
}

// f64.const: the float's 8 bytes, little-endian
fn f64c(inout g: WGen, v: f64) {
    g.code.push(68)
    let b = to_bits(v)
    for i in 0..8 { g.code.push(bit_and(shr(b, 8 * i), 255)) }
}

fn call_f(inout g: WGen, f: i64) {
    op_u(inout g, 16, f)
}

// block (2), loop (3) or if (4), with its type (64: none)
fn open(inout g: WGen, kind: i64, bt: i64) {
    g.code.push(kind)
    g.code.push(if bt == 0 { 64 } else { bt })
    g.depth += 1
}

fn else_(inout g: WGen) {
    g.code.push(5)
}

fn close(inout g: WGen) {
    g.code.push(11)
    g.depth -= 1
}

// a branch to the block opened at `level`
fn br_to(inout g: WGen, level: i64, cond: bool) {
    op_u(inout g, if cond { 13 } else { 12 }, g.depth - level)
}

fn new_local(inout g: WGen, t: i64) -> i64 {
    g.ltypes.push(t)
    len(g.ltypes) - 1
}

// ------------------------------------------------------------------ texts and messages

// A constant text in memory: (address, byte length).
fn intern(inout g: WGen, s: str) -> (i64, i64) {
    if contains(g.strs, s) { return g.strs[s] }
    let b = utf8_bytes(s)
    let at = g.m.data_at + len(g.m.data)
    append(inout g.m.data, b)
    g.strs[s] = (at, len(b))
    (at, len(b))
}

fn emit_text(inout g: WGen, fd: i64, s: str) {
    let t = intern(inout g, s)
    i32c(inout g, fd)
    i32c(inout g, t.0)
    i32c(inout g, t.1)
    call_f(inout g, f_write())
}

// A constant text as a value: the address of its object (a count of 0: never freed; the length,
// then the bytes), at a multiple of 8.
fn intern_obj(inout g: WGen, s: str) -> i64 {
    if contains(g.objs, s) { return g.objs[s] }
    while len(g.m.data) % 8 != 0 { g.m.data.push(0) }
    let b = utf8_bytes(s)
    let at = g.m.data_at + len(g.m.data)
    let n = len(b)
    for i in 0..4 { g.m.data.push(0) }
    g.m.data.push(bit_and(n, 255))
    g.m.data.push(bit_and(shr(n, 8), 255))
    g.m.data.push(bit_and(shr(n, 16), 255))
    g.m.data.push(bit_and(shr(n, 24), 255))
    append(inout g.m.data, b)
    g.objs[s] = at
    at
}

// A text's value from a literal `str s(...)`.
fn lit_text(t: str) -> str {
    unhex(substr(t, 4, len(t)))
}

// A diagnostic as `kairos` prints it (src/diag.rs `render`).
fn render_diag(code: str, msg: str, hint: str, src: str, file: str, lo0: i64, hi0: i64) -> str {
    let cs = codes(src)
    var boff = [0]
    for k in 0..len(cs) { boff.push(boff[k] + lx_utf8_len(cs[k])) }
    let nb = boff[len(cs)]
    let lo = min(max(lo0, 0), nb)
    let hi = min(max(hi0, lo), nb)
    // the characters at those bytes
    var ci = 0
    while ci < len(cs) and boff[ci] < lo { ci += 1 }
    var cj = ci
    while cj < len(cs) and boff[cj] < hi { cj += 1 }
    var start = ci
    while start > 0 and cs[start - 1] != 10 { start -= 1 }
    var stop = ci
    while stop < len(cs) and cs[stop] != 10 { stop += 1 }
    var line_no = 1
    for k in 0..ci {
        if cs[k] == 10 { line_no += 1 }
    }
    let col = ci - start + 1
    var text_end = stop
    while text_end > start and cs[text_end - 1] == 13 { text_end -= 1 }
    var text = []
    for k in start..text_end { text.push(cs[k]) }
    let width = max(min(cj, stop) - ci, 1)
    var pad = []
    for k in 0..len(str(line_no)) { pad.push(" ") }
    let p = join(pad, "")
    var sp = []
    for k in 0..col - 1 { sp.push(" ") }
    var carets = []
    for k in 0..width { carets.push("^") }
    let nl = from_codes([10])
    let kind = if starts_with(code, "R") { "runtime error" } else if starts_with(code, "W") { "warning" } else { "error" }
    var s = kind + "[" + code + "]: " + msg + nl + p + "--> " + file + ":" + str(line_no) + ":" + str(col) + nl
    s = s + p + " |" + nl + str(line_no) + " | " + from_codes(text) + nl + p + " | " + join(sp, "") + join(carets, "") + nl
    if hint != "" { s = s + p + " = hint: " + hint + nl }
    s
}

// Stops the program with a runtime error at `e`, as the interpreter would.
fn fail_at_rt(inout g: WGen, e: H, code: str, msg: str, hint: str) {
    let f = if e.f >= 0 and e.f < len(g.srcs) { e.f } else { 0 }
    let text = render_diag(code, msg, hint, g.srcs[f], g.ck.files[f], e.lo, e.hi)
    let t = intern(inout g, text)
    i32c(inout g, t.0)
    i32c(inout g, t.1)
    call_f(inout g, f_fail())
    op(inout g, 0)
}

fn overflow_at(inout g: WGen, e: H) {
    fail_at_rt(inout g, e, "R0006", "integer overflow", "i64 arithmetic is checked; use f64 for very large values")
}

// The text at address p (in local `p`) to the file descriptor `fd`.
fn write_obj(inout g: WGen, fd: i64, p: i64) {
    i32c(inout g, fd)
    lget(inout g, p)
    i32c(inout g, 8)
    op(inout g, 106)
    lget(inout g, p)
    load_at(inout g, wt_i32(), 4)
    call_f(inout g, f_write())
}

// A runtime error whose message shows a value: `before`, the value in local `v` as the runtime
// function `fmt` writes it (`rt_str_i64`, `rt_fmt_f64`), then `after`.
fn fail_dyn(inout g: WGen, e: H, code: str, before: str, after: str, v: i64, fmt: str) {
    fail_dyn2(inout g, e, code, [before, after], [(v, fmt)])
}

// The same with several values: pieces[0], the first value, pieces[1], the second...
fn fail_dyn2(inout g: WGen, e: H, code: str, pieces: List[str], vals: List[(i64, str)]) {
    let f = if e.f >= 0 and e.f < len(g.srcs) { e.f } else { 0 }
    let mark = from_codes([1])
    var msg = pieces[0]
    for k in 0..len(vals) { msg = msg + mark + pieces[k + 1] }
    let parts = split(render_diag(code, msg, "", g.srcs[f], g.ck.files[f], e.lo, e.hi), mark)
    for k in 0..len(vals) {
        emit_text(inout g, 2, parts[k])
        lget(inout g, vals[k].0)
        call_f(inout g, rt_fn(inout g, vals[k].1))
        let p = new_local(inout g, wt_i32())
        lset(inout g, p)
        write_obj(inout g, 2, p)
    }
    let t = intern(inout g, parts[len(vals)])
    i32c(inout g, t.0)
    i32c(inout g, t.1)
    call_f(inout g, f_fail())
    op(inout g, 0)
}

// ------------------------------------------------------------------ types

// The WebAssembly type of a value of type `t`: 0 none (`()`, `!`), -1 not compiled yet.
fn vt(t: Ty) -> i64 {
    match t {
        TInt => wt_i64(),
        TFloat => wt_f64(),
        TBool => wt_i32(),
        TStr => wt_i32(),
        TTuple(_) => wt_i32(),
        TStruct(_) => wt_i32(),
        TList(_) => wt_i32(),
        TEnum(_) => wt_i32(),
        TMap(_, _) => wt_i32(),
        TUnit => 0,
        TNever => 0,
        _ => -1,
    }
}

// Values whose WebAssembly value is the address of an object that counts its references.
fn heap(t: Ty) -> bool {
    match t {
        TStr => true,
        TTuple(_) => true,
        TStruct(_) => true,
        TList(_) => true,
        TEnum(_) => true,
        TMap(_, _) => true,
        _ => false,
    }
}

// The types of the fields of a tuple or a struct.
fn field_tys(g: WGen, t: Ty) -> List[Ty] {
    match t {
        TTuple(ts) => {
            var out: List[Ty] = []
            for x in ts { out.push(fin_ty(g.ck, x)) }
            out
        },
        TStruct(id) => {
            var out: List[Ty] = []
            for f in g.ck.structs[id].fields { out.push(fin_ty(g.ck, f.1)) }
            out
        },
        _ => [],
    }
}

// A value of WebAssembly type `w` from memory at the address on the stack plus `off`, and to
// memory (the address, then the value, on the stack).
fn load_at(inout g: WGen, w: i64, off: i64) {
    if w == wt_i64() {
        op_u(inout g, 41, 3)
    } else if w == wt_f64() {
        op_u(inout g, 43, 3)
    } else {
        op_u(inout g, 40, 2)
    }
    uleb(inout g.code, off)
}

fn store_at(inout g: WGen, w: i64, off: i64) {
    if w == wt_i64() {
        op_u(inout g, 55, 3)
    } else if w == wt_f64() {
        op_u(inout g, 57, 3)
    } else {
        op_u(inout g, 54, 2)
    }
    uleb(inout g.code, off)
}

fn vt_of(inout g: WGen, e: H) -> i64 {
    let v = vt(e.t)
    if v < 0 { wg_fail(inout g, e, "values of type `" + show(g.ck, e.t) + "`") }
    max(v, 0)
}

// ------------------------------------------------------------------ references

// One more reference to the value on the stack, which stays there.
fn incref(inout g: WGen, t: Ty) {
    if heap(t) { call_f(inout g, f_incref()) }
}

// Drops the value on the stack (a reference less, for a value in the heap).
fn drop_v(inout g: WGen, t: Ty) {
    if heap(t) {
        call_f(inout g, glue_fn(inout g, "drop", t))
    } else if vt(t) > 0 {
        op(inout g, 26)
    }
}

// The value of `e` on the stack, borrowed from its variable when nothing can change that
// variable before the value is used (`safe`). The result is the local of an owned value, to
// drop once used, or -1.
fn gen_borrow(inout g: WGen, e: H, safe: bool) -> i64 {
    if heap(e.t) and safe and e.kind == "local" {
        let l = g.slot_local[e.n]
        if l >= 0 { lget(inout g, l) }
        return -1
    }
    gen(inout g, e)
    // constants are never freed
    if g.failed or not heap(e.t) or e.kind == "lit" { return -1 }
    let t = new_local(inout g, wt_i32())
    op_u(inout g, 34, t)
    t
}

fn drop_tmp(inout g: WGen, l: i64, t: Ty) {
    if l >= 0 {
        lget(inout g, l)
        drop_v(inout g, t)
    }
}

// Can `e` change a variable (an assignment, an `inout` argument)?
fn changes(e: H) -> bool {
    if e.kind == "assign" or e.kind == "opassign" or e.kind == "tassign" or e.kind == "inout" { return true }
    for k in e.kids {
        if changes(k) { return true }
    }
    false
}

// Stores the owned value on the stack in variable `n`, dropping the value it had.
fn set_slot(inout g: WGen, n: i64) {
    let l = g.slot_local[n]
    if l < 0 { return }
    if heap(g.slot_ty[n]) {
        lget(inout g, l)
        drop_v(inout g, g.slot_ty[n])
    }
    lset(inout g, l)
}

// Drops the values the function's variables own (not its arguments: borrowed).
fn epilogue(inout g: WGen) {
    for n in g.nparams..len(g.slot_local) {
        let l = g.slot_local[n]
        if l >= 0 and heap(g.slot_ty[n]) {
            lget(inout g, l)
            drop_v(inout g, g.slot_ty[n])
        }
    }
}

// The cell of a place: a variable's local, or a field in memory (a local with the object's
// address, and the field's offset). Its type.
struct Cell {
    local: bool,
    at: i64,
    off: i64,
    ty: Ty,
}

fn cell_load(inout g: WGen, c: Cell) {
    let w = vt(c.ty)
    if w <= 0 { return }
    lget(inout g, c.at)
    if not c.local { load_at(inout g, w, c.off) }
}

// Stores the value on the stack in the cell (what it had is not dropped).
fn cell_store(inout g: WGen, c: Cell) {
    let w = vt(c.ty)
    if w <= 0 { return }
    if c.local {
        lset(inout g, c.at)
        return
    }
    let v = new_local(inout g, w)
    lset(inout g, v)
    lget(inout g, c.at)
    lget(inout g, v)
    store_at(inout g, w, c.off)
}

// The cell of a place. Each object on the way is made unique first (copied when shared), so
// changing the cell changes no other value. With `insert`, a map at the end gets the key when it
// does not have it (an assignment: `m[k] = v`).
fn place_cell(inout g: WGen, p: H, insert: bool) -> Cell {
    if p.kind == "plocal" { return Cell { local: true, at: g.slot_local[p.n], off: 0, ty: g.slot_ty[p.n] } }
    if p.kind == "pfield" {
        let b = place_cell(inout g, p.kids[0], false)
        cell_load(inout g, b)
        call_f(inout g, glue_fn(inout g, "unique", b.ty))
        cell_store(inout g, b)
        cell_load(inout g, b)
        let a = new_local(inout g, wt_i32())
        lset(inout g, a)
        return Cell { local: false, at: a, off: 8 + 8 * p.n, ty: field_tys(g, b.ty)[p.n] }
    }
    if p.kind == "pindex" {
        let b = place_cell(inout g, p.kids[0], false)
        cell_load(inout g, b)
        call_f(inout g, glue_fn(inout g, "unique", b.ty))
        cell_store(inout g, b)
        if is_map(b.ty) { return map_cell(inout g, p, b, insert) }
        let o = new_local(inout g, wt_i32())
        cell_load(inout g, b)
        lset(inout g, o)
        gen(inout g, p.kids[1])
        let i = new_local(inout g, wt_i64())
        lset(inout g, i)
        check_index(inout g, p, o, i)
        elem_addr(inout g, o, i)
        let a = new_local(inout g, wt_i32())
        lset(inout g, a)
        return Cell { local: false, at: a, off: 16, ty: elem_ty(g, b.ty) }
    }
    wg_fail(inout g, p, "changing this part of a value")
    Cell { local: true, at: 0, off: 0, ty: Ty.TUnit }
}

// Binds pattern `p` to the value of type `t` in local `s` (borrowed: a variable it binds takes a
// reference of its own).
fn bind_from(inout g: WGen, p: H, s: i64, t: Ty) {
    if p.kind == "pbind" {
        if g.slot_local[p.n] >= 0 {
            lget(inout g, s)
            incref(inout g, t)
            set_slot(inout g, p.n)
        }
        return
    }
    if p.kind == "pvariant" { return bind_variant(inout g, p, s) }
    if p.kind == "ptuple" {
        let fts = field_tys(g, t)
        for i in 0..len(p.kids) {
            let sub = p.kids[i]
            let w = vt(fts[i])
            if sub.kind == "pwild" or sub.kind == "plit" or w <= 0 { continue }
            let f = new_local(inout g, w)
            lget(inout g, s)
            load_at(inout g, w, 8 + 8 * i)
            lset(inout g, f)
            bind_from(inout g, sub, f, fts[i])
        }
        return
    }
    if p.kind != "pwild" and p.kind != "plit" { wg_fail(inout g, p, "this pattern") }
}

// ------------------------------------------------------------------ expressions

fn gen_stmt(inout g: WGen, e: H) {
    gen(inout g, e)
    drop_v(inout g, e.t)
}

fn gen(inout g: WGen, e: H) {
    if g.failed { return }
    let k = e.kind
    let t = vt_of(inout g, e)
    if g.failed { return }
    if k == "lit" {
        if starts_with(e.text, "i64 ") {
            i64c(inout g, parse_int(substr(e.text, 4, len(e.text))))
        } else if starts_with(e.text, "f64 ") {
            f64c(inout g, parse_float(substr(e.text, 4, len(e.text))))
        } else if e.text == "bool true" {
            i32c(inout g, 1)
        } else if e.text == "bool false" {
            i32c(inout g, 0)
        } else if starts_with(e.text, "str ") {
            i32c(inout g, intern_obj(inout g, lit_text(e.text)))
        } else if e.text != "unit" {
            wg_fail(inout g, e, "the literal `" + e.text + "`")
        }
        return
    }
    if k == "local" {
        let l = g.slot_local[e.n]
        if l >= 0 {
            lget(inout g, l)
            incref(inout g, e.t)
        }
        return
    }
    if k == "block" {
        let n = len(e.kids)
        for i in 0..n - 1 { gen_stmt(inout g, e.kids[i]) }
        if e.kids[n - 1].kind != "-" { gen(inout g, e.kids[n - 1]) }
        return
    }
    if k == "let" {
        let p = e.kids[0]
        let v = e.kids[1]
        gen(inout g, v)
        if p.kind == "pbind" { return set_slot(inout g, p.n) }
        if p.kind == "pwild" { return drop_v(inout g, v.t) }
        // a pattern takes the value apart: its variables take references of their own
        let w = vt_of(inout g, v)
        let s = new_local(inout g, if w > 0 { w } else { wt_i32() })
        if w > 0 { lset(inout g, s) }
        bind_from(inout g, p, s, v.t)
        if heap(v.t) {
            lget(inout g, s)
            drop_v(inout g, v.t)
        }
        return
    }
    if k == "assign" or k == "opassign" {
        let p = e.kids[0]
        let v = e.kids[1]
        let w = vt_of(inout g, v)
        // the value first, then the place
        gen(inout g, v)
        if k == "assign" and p.kind == "plocal" { return set_slot(inout g, p.n) }
        let tv = new_local(inout g, if w > 0 { w } else { wt_i32() })
        if w > 0 { lset(inout g, tv) }
        let c = place_cell(inout g, p, k == "assign")
        if g.failed { return }
        if k == "assign" {
            if heap(c.ty) {
                cell_load(inout g, c)
                drop_v(inout g, c.ty)
            }
            if w > 0 { lget(inout g, tv) }
            return cell_store(inout g, c)
        }
        // `x op= v`: the current value (borrowed) op the value
        cell_load(inout g, c)
        if w > 0 { lget(inout g, tv) }
        op_on(inout g, e.text, v.t, e)
        if heap(c.ty) {
            drop_tmp(inout g, tv, v.t)
            let nv = new_local(inout g, wt_i32())
            lset(inout g, nv)
            cell_load(inout g, c)
            drop_v(inout g, c.ty)
            lget(inout g, nv)
        }
        return cell_store(inout g, c)
    }
    if k == "field" {
        let b = e.kids[0]
        let tb = gen_borrow(inout g, b, true)
        if t > 0 {
            load_at(inout g, t, 8 + 8 * e.n)
        } else {
            op(inout g, 26)
        }
        incref(inout g, e.t)
        drop_tmp(inout g, tb, b.t)
        return
    }
    if k == "list" { return list_lit(inout g, e) }
    if k == "variant" { return variant_lit(inout g, e) }
    if k == "map" { return map_lit(inout g, e) }
    if k == "index" {
        if is_list(e.kids[0].t) { return index_list(inout g, e) }
        return index_map(inout g, e)
    }
    if k == "forlist" { return for_list(inout g, e) }
    if k == "struct" or k == "tuple" {
        let fts = field_tys(g, e.t)
        let n = len(e.kids)
        i64c(inout g, 8 + 8 * n)
        call_f(inout g, rt_fn(inout g, "rt_alloc"))
        op(inout g, 167)
        let o = new_local(inout g, wt_i32())
        lset(inout g, o)
        lget(inout g, o)
        i32c(inout g, 1)
        store_at(inout g, wt_i32(), 0)
        // each field takes the value its expression gives
        for i in 0..n {
            let w = vt(fts[i])
            if w > 0 { lget(inout g, o) }
            gen(inout g, e.kids[i])
            if w > 0 { store_at(inout g, w, 8 + 8 * i) }
        }
        lget(inout g, o)
        return
    }
    if k == "binary" { return binary_w(inout g, e) }
    if k == "unary" {
        gen(inout g, e.kids[0])
        if e.text == "not" {
            op(inout g, 69)
            return
        }
        if t == wt_f64() {
            op(inout g, 154)
            return
        }
        // -x: 0 - x, checked
        let x = new_local(inout g, wt_i64())
        lset(inout g, x)
        lget(inout g, x)
        i64c(inout g, imin())
        op(inout g, 81)
        open(inout g, 4, 0)
        overflow_at(inout g, e)
        close(inout g)
        i64c(inout g, 0)
        lget(inout g, x)
        op(inout g, 125)
        return
    }
    if k == "and" or k == "or" {
        gen(inout g, e.kids[0])
        open(inout g, 4, wt_i32())
        if k == "and" {
            gen(inout g, e.kids[1])
            else_(inout g)
            i32c(inout g, 0)
        } else {
            i32c(inout g, 1)
            else_(inout g)
            gen(inout g, e.kids[1])
        }
        close(inout g)
        return
    }
    if k == "if" {
        gen(inout g, e.kids[0])
        open(inout g, 4, t)
        // an `if` of no value drops what its branches give
        if t == 0 { gen_stmt(inout g, e.kids[1]) } else { gen(inout g, e.kids[1]) }
        if e.kids[2].kind != "-" {
            else_(inout g)
            if t == 0 { gen_stmt(inout g, e.kids[2]) } else { gen(inout g, e.kids[2]) }
        }
        close(inout g)
        return
    }
    if k == "while" {
        open(inout g, 2, 0)
        let exit = g.depth
        open(inout g, 3, 0)
        let top = g.depth
        gen(inout g, e.kids[0])
        op(inout g, 69)
        br_to(inout g, exit, true)
        g.loops.push((exit, top))
        gen_stmt(inout g, e.kids[1])
        let _ = g.loops.pop()
        br_to(inout g, top, false)
        close(inout g)
        close(inout g)
        return
    }
    if k == "forrange" { return for_range_w(inout g, e) }
    if k == "break" or k == "continue" {
        let lp = g.loops[len(g.loops) - 1]
        br_to(inout g, if k == "break" { lp.0 } else { lp.1 }, false)
        return
    }
    if k == "return" {
        if e.kids[0].kind != "-" { gen(inout g, e.kids[0]) }
        epilogue(inout g)
        exit_values(inout g)
        op(inout g, 15)
        return
    }
    if k == "match" { return match_w(inout g, e) }
    if k == "call" {
        for a in e.kids {
            if a.kind == "inout" { return call_inout(inout g, e) }
        }
        // the arguments are borrowed: what the call made for them is dropped after it
        var tmps: List[(i64, Ty)] = []
        for i in 0..len(e.kids) {
            let a = e.kids[i]
            if a.kind != "val" { return wg_fail(inout g, a, "`inout` arguments") }
            var safe = true
            for j in i + 1..len(e.kids) {
                if changes(e.kids[j]) { safe = false }
            }
            tmps.push((gen_borrow(inout g, a.kids[0], safe), a.kids[0].t))
        }
        let name = g.ck.sigs[e.n].name
        if starts_with(name, "wasm_") {
            intrinsic(inout g, name, e)
        } else {
            call_f(inout g, fn_index(inout g, e.n))
        }
        for x in tmps { drop_tmp(inout g, x.0, x.1) }
        return
    }
    if k == "builtin" { return builtin_w(inout g, e) }
    wg_fail(inout g, e, "`" + k + "`")
}

// `x op y` on integers (both on the stack): the interpreter's checked arithmetic.
fn arith(inout g: WGen, o: str, e: H) {
    // the runtime's own arithmetic (addresses, lengths) cannot overflow
    if g.unchecked and o != "^" {
        if o == "+" { return op(inout g, 124) }
        if o == "-" { return op(inout g, 125) }
        if o == "*" { return op(inout g, 126) }
        if o == "/" { return op(inout g, 127) }
        if o == "%" { return op(inout g, 129) }
    }
    let y = new_local(inout g, wt_i64())
    let x = new_local(inout g, wt_i64())
    lset(inout g, y)
    lset(inout g, x)
    if o == "+" or o == "-" {
        let r = new_local(inout g, wt_i64())
        lget(inout g, x)
        lget(inout g, y)
        op(inout g, if o == "+" { 124 } else { 125 })
        lset(inout g, r)
        // + overflows when x and y have the sign the result lacks; - when x and y differ in
        // sign and the result differs from x
        if o == "+" {
            lget(inout g, x)
            lget(inout g, r)
            op(inout g, 133)
            lget(inout g, y)
            lget(inout g, r)
            op(inout g, 133)
        } else {
            lget(inout g, x)
            lget(inout g, y)
            op(inout g, 133)
            lget(inout g, x)
            lget(inout g, r)
            op(inout g, 133)
        }
        op(inout g, 131)
        i64c(inout g, 0)
        op(inout g, 83)
        open(inout g, 4, 0)
        overflow_at(inout g, e)
        close(inout g)
        lget(inout g, r)
        return
    }
    if o == "*" {
        let r = new_local(inout g, wt_i64())
        lget(inout g, x)
        lget(inout g, y)
        op(inout g, 126)
        lset(inout g, r)
        // overflow: x = -1 and y = MIN, or x not 0 nor -1 and r / x != y
        lget(inout g, x)
        i64c(inout g, -1)
        op(inout g, 81)
        open(inout g, 4, wt_i32())
        lget(inout g, y)
        i64c(inout g, imin())
        op(inout g, 81)
        else_(inout g)
        lget(inout g, x)
        op(inout g, 80)
        open(inout g, 4, wt_i32())
        i32c(inout g, 0)
        else_(inout g)
        lget(inout g, r)
        lget(inout g, x)
        op(inout g, 127)
        lget(inout g, y)
        op(inout g, 82)
        close(inout g)
        close(inout g)
        open(inout g, 4, 0)
        overflow_at(inout g, e)
        close(inout g)
        lget(inout g, r)
        return
    }
    if o == "/" or o == "%" {
        lget(inout g, y)
        op(inout g, 80)
        open(inout g, 4, 0)
        fail_at_rt(inout g, e, "R0002", "division by zero", "")
        close(inout g)
        lget(inout g, x)
        i64c(inout g, imin())
        op(inout g, 81)
        lget(inout g, y)
        i64c(inout g, -1)
        op(inout g, 81)
        op(inout g, 113)
        open(inout g, 4, 0)
        overflow_at(inout g, e)
        close(inout g)
        lget(inout g, x)
        lget(inout g, y)
        op(inout g, if o == "/" { 127 } else { 129 })
        return
    }
    if o == "^" { return pow_w(inout g, x, y, e) }
    wg_fail(inout g, e, "the operator `" + o + "`")
}

// x ^ y on integers as Rust's `checked_pow` computes it: by squaring, every product checked.
fn pow_w(inout g: WGen, x: i64, y: i64, e: H) {
    lget(inout g, y)
    i64c(inout g, 0)
    op(inout g, 83)
    open(inout g, 4, 0)
    fail_at_rt(inout g, e, "R0007", "negative exponent in integer power", "use floats: `float(x) ^ float(y)`")
    close(inout g)
    // an exponent beyond u32 does not fit
    lget(inout g, y)
    i64c(inout g, 4294967295)
    op(inout g, 85)
    open(inout g, 4, 0)
    overflow_at(inout g, e)
    close(inout g)
    let acc = new_local(inout g, wt_i64())
    let base = new_local(inout g, wt_i64())
    let ex = new_local(inout g, wt_i64())
    i64c(inout g, 1)
    lset(inout g, acc)
    lget(inout g, x)
    lset(inout g, base)
    lget(inout g, y)
    lset(inout g, ex)
    open(inout g, 2, 0)
    let done = g.depth
    lget(inout g, ex)
    op(inout g, 80)
    br_to(inout g, done, true)
    open(inout g, 3, 0)
    let top = g.depth
    // if the exponent is odd: acc = acc * base; with exponent 1, done
    lget(inout g, ex)
    i64c(inout g, 1)
    op(inout g, 131)
    op(inout g, 80)
    op(inout g, 69)
    open(inout g, 4, 0)
    lget(inout g, acc)
    lget(inout g, base)
    arith(inout g, "*", e)
    lset(inout g, acc)
    lget(inout g, ex)
    i64c(inout g, 1)
    op(inout g, 81)
    br_to(inout g, done, true)
    close(inout g)
    lget(inout g, ex)
    i64c(inout g, 1)
    op(inout g, 136)
    lset(inout g, ex)
    lget(inout g, base)
    lget(inout g, base)
    arith(inout g, "*", e)
    lset(inout g, base)
    br_to(inout g, top, false)
    close(inout g)
    close(inout g)
    lget(inout g, acc)
}

// `x op y` on floats (both on the stack): IEEE 754, as Rust's f64.
fn float_op(inout g: WGen, o: str, e: H) {
    if o == "+" { return op(inout g, 160) }
    if o == "-" { return op(inout g, 161) }
    if o == "*" { return op(inout g, 162) }
    if o == "/" { return op(inout g, 163) }
    if o == "==" { return op(inout g, 97) }
    if o == "!=" { return op(inout g, 98) }
    if o == "<" { return op(inout g, 99) }
    if o == ">" { return op(inout g, 100) }
    if o == "<=" { return op(inout g, 101) }
    if o == ">=" { return op(inout g, 102) }
    if o == "%" { return call_f(inout g, rt_fn(inout g, "rt_fmod")) }
    if o == "^" { return call_f(inout g, rt_fn(inout g, "rt_pow")) }
    wg_fail(inout g, e, "the operator `" + o + "` on floats")
}

fn binary_w(inout g: WGen, e: H) {
    let a = e.kids[0]
    let b = e.kids[1]
    if heap(a.t) {
        // values in the heap are borrowed by the operation
        let ta = gen_borrow(inout g, a, not changes(b))
        let tb = gen_borrow(inout g, b, true)
        if g.failed { return }
        op_on(inout g, e.text, a.t, e)
        drop_tmp(inout g, ta, a.t)
        drop_tmp(inout g, tb, b.t)
        return
    }
    gen(inout g, a)
    gen(inout g, b)
    if g.failed { return }
    op_on(inout g, e.text, a.t, e)
}

// `x op y` with both on the stack, x of type `t`.
fn op_on(inout g: WGen, o: str, t: Ty, e: H) {
    let at = vt(t)
    if at == wt_f64() { return float_op(inout g, o, e) }
    if at == wt_i64() {
        if o == "==" { return op(inout g, 81) }
        if o == "!=" { return op(inout g, 82) }
        if o == "<" { return op(inout g, 83) }
        if o == ">" { return op(inout g, 85) }
        if o == "<=" { return op(inout g, 87) }
        if o == ">=" { return op(inout g, 89) }
        return arith(inout g, o, e)
    }
    if heap(t) and t != Ty.TStr and (o == "==" or o == "!=") {
        call_f(inout g, glue_fn(inout g, "eq", t))
        if o == "!=" { op(inout g, 69) }
        return
    }
    if t == Ty.TStr {
        if o == "+" { return call_f(inout g, rt_fn(inout g, "rt_concat")) }
        if o == "==" or o == "!=" {
            call_f(inout g, rt_fn(inout g, "rt_str_eq"))
            if o == "!=" { op(inout g, 69) }
            return
        }
        // an ordering: the comparison of rt_str_cmp's -1, 0 or 1 with 0
        call_f(inout g, rt_fn(inout g, "rt_str_cmp"))
        i64c(inout g, 0)
        if o == "<" { return op(inout g, 83) }
        if o == ">" { return op(inout g, 85) }
        if o == "<=" { return op(inout g, 87) }
        return op(inout g, 89)
    }
    if at == wt_i32() {
        if o == "==" { return op(inout g, 70) }
        if o == "!=" { return op(inout g, 71) }
        return wg_fail(inout g, e, "ordering booleans")
    }
    if at == 0 and (o == "==" or o == "!=") {
        i32c(inout g, if o == "==" { 1 } else { 0 })
        return
    }
    wg_fail(inout g, e, "`" + o + "` on these values")
}

fn for_range_w(inout g: WGen, e: H) {
    let i = new_local(inout g, wt_i64())
    let hi = new_local(inout g, wt_i64())
    gen(inout g, e.kids[0])
    lset(inout g, i)
    gen(inout g, e.kids[1])
    lset(inout g, hi)
    open(inout g, 2, 0)
    let exit = g.depth
    open(inout g, 3, 0)
    let top = g.depth
    lget(inout g, i)
    lget(inout g, hi)
    op(inout g, if e.m == 1 { 85 } else { 89 })
    br_to(inout g, exit, true)
    let l = g.slot_local[e.n]
    if l >= 0 {
        lget(inout g, i)
        lset(inout g, l)
    }
    open(inout g, 2, 0)
    let cont = g.depth
    g.loops.push((exit, cont))
    gen_stmt(inout g, e.kids[2])
    let _ = g.loops.pop()
    close(inout g)
    // the next value; the loop stops instead of overflowing
    lget(inout g, i)
    i64c(inout g, imax())
    op(inout g, 81)
    br_to(inout g, exit, true)
    lget(inout g, i)
    i64c(inout g, 1)
    op(inout g, 124)
    lset(inout g, i)
    br_to(inout g, top, false)
    close(inout g)
    close(inout g)
}

// A pattern's test on the scrutinee in local `s` (pushes an i32), or none when it always
// matches.
fn pat_test(inout g: WGen, p: H, s: i64, t: Ty) -> bool {
    if p.kind == "pwild" or p.kind == "pbind" { return false }
    if p.kind == "pvariant" { return variant_test(inout g, p, s) }
    if p.kind == "ptuple" {
        // each field that is tested, in a local of its own; the tests joined by `and`
        let fts = field_tys(g, t)
        var n = 0
        for i in 0..len(p.kids) {
            let sub = p.kids[i]
            let w = vt(fts[i])
            if sub.kind == "pwild" or sub.kind == "pbind" or w <= 0 { continue }
            let f = new_local(inout g, w)
            lget(inout g, s)
            load_at(inout g, w, 8 + 8 * i)
            lset(inout g, f)
            if pat_test(inout g, sub, f, fts[i]) {
                if n > 0 { op(inout g, 113) }
                n += 1
            }
        }
        return n > 0
    }
    if p.kind == "plit" {
        lget(inout g, s)
        if starts_with(p.text, "i64 ") {
            i64c(inout g, parse_int(substr(p.text, 4, len(p.text))))
            op(inout g, 81)
        } else if p.text == "bool false" {
            op(inout g, 69)
        } else if starts_with(p.text, "str ") {
            i32c(inout g, intern_obj(inout g, lit_text(p.text)))
            call_f(inout g, rt_fn(inout g, "rt_str_eq"))
        } else if p.text != "bool true" {
            wg_fail(inout g, p, "the pattern `" + p.text + "`")
        }
        return true
    }
    wg_fail(inout g, p, "this pattern")
    false
}

fn match_w(inout g: WGen, e: H) {
    let scrut = e.kids[0]
    let st = vt_of(inout g, scrut)
    gen(inout g, scrut)
    if g.failed { return }
    let s = new_local(inout g, if st > 0 { st } else { wt_i32() })
    if st > 0 { lset(inout g, s) }
    let bt = vt(e.t)
    var opened = 0
    var closed_all = false
    for i in 1..len(e.kids) {
        let arm = e.kids[i]
        let p = arm.kids[0]
        let tested = pat_test(inout g, p, s, scrut.t)
        if g.failed { return }
        if tested {
            open(inout g, 4, bt)
            opened += 1
        }
        bind_from(inout g, p, s, scrut.t)
        // a `match` of no value drops what its arms give
        if bt == 0 { gen_stmt(inout g, arm.kids[1]) } else { gen(inout g, arm.kids[1]) }
        if not tested {
            closed_all = true
            break
        }
        else_(inout g)
    }
    if not closed_all { fail_at_rt(inout g, e, "R0008", "no match arm matched", "") }
    for i in 0..opened { close(inout g) }
    // the value matched is dropped (the variables the arms bound have their own references)
    if heap(scrut.t) {
        lget(inout g, s)
        drop_v(inout g, scrut.t)
    }
}

fn builtin_w(inout g: WGen, e: H) {
    let b = e.text
    let args = e.kids
    if b == "push" { return push_w(inout g, e) }
    if b == "pop" { return pop_w(inout g, e) }
    if b == "remove" { return remove_w(inout g, e) }
    for a in args {
        if a.kind != "val" { return wg_fail(inout g, a, "`inout` arguments") }
    }
    if b == "print" {
        for i in 0..len(args) {
            if i > 0 { emit_text(inout g, 1, " ") }
            let x = args[i].kids[0]
            let xt = vt(x.t)
            if x.kind == "lit" and starts_with(x.text, "str ") {
                emit_text(inout g, 1, lit_text(x.text))
            } else if x.t == Ty.TStr {
                let tx = gen_borrow(inout g, x, true)
                call_f(inout g, f_print_str())
                drop_tmp(inout g, tx, x.t)
            } else if heap(x.t) {
                // a tuple or a struct: its text, as the interpreter writes it
                let tx = gen_borrow(inout g, x, true)
                call_f(inout g, glue_fn(inout g, "show", x.t))
                let st = new_local(inout g, wt_i32())
                op_u(inout g, 34, st)
                call_f(inout g, f_print_str())
                drop_tmp(inout g, st, Ty.TStr)
                drop_tmp(inout g, tx, x.t)
            } else if xt == wt_i64() {
                gen(inout g, x)
                call_f(inout g, f_print_i64())
            } else if xt == wt_f64() {
                gen(inout g, x)
                call_f(inout g, rt_fn(inout g, "rt_fmt_f64"))
                call_f(inout g, f_print_str())
            } else if xt == wt_i32() {
                gen(inout g, x)
                open(inout g, 4, 0)
                emit_text(inout g, 1, "true")
                else_(inout g)
                emit_text(inout g, 1, "false")
                close(inout g)
            } else if x.t == Ty.TUnit {
                gen(inout g, x)
                emit_text(inout g, 1, "()")
            } else {
                return wg_fail(inout g, x, "printing values of type `" + show(g.ck, x.t) + "`")
            }
        }
        emit_text(inout g, 1, from_codes([10]))
        return
    }
    if b == "assert" {
        gen(inout g, args[0].kids[0])
        var msg = "assertion failed"
        if len(args) == 2 {
            let m = args[1].kids[0]
            if not (m.kind == "lit" and starts_with(m.text, "str ")) { return wg_fail(inout g, m, "an assertion message that is not a literal") }
            msg = unhex(substr(m.text, 4, len(m.text)))
        }
        op(inout g, 69)
        open(inout g, 4, 0)
        fail_at_rt(inout g, e, "R0003", msg, "")
        close(inout g)
        return
    }
    if len(args) > 0 and vt(args[0].kids[0].t) == wt_f64() { return float_builtin(inout g, b, args, e) }
    if b == "float" {
        gen(inout g, args[0].kids[0])
        return op(inout g, 185)
    }
    if b == "from_bits" {
        gen(inout g, args[0].kids[0])
        return op(inout g, 191)
    }
    if b == "wrapping_add" or b == "wrapping_mul" {
        gen(inout g, args[0].kids[0])
        gen(inout g, args[1].kids[0])
        return op(inout g, if b == "wrapping_add" { 124 } else { 126 })
    }
    if b == "shl" or b == "shr" {
        gen(inout g, args[0].kids[0])
        gen(inout g, args[1].kids[0])
        let o = if b == "shl" { 134 } else { 136 }
        if g.unchecked { return op(inout g, o) }
        let n = new_local(inout g, wt_i64())
        let a = new_local(inout g, wt_i64())
        lset(inout g, n)
        lset(inout g, a)
        lget(inout g, n)
        i64c(inout g, 63)
        op(inout g, 86)
        open(inout g, 4, 0)
        fail_dyn(inout g, e, "R0014", "shift by ", ": it must be from 0 to 63", n, "rt_str_i64")
        close(inout g)
        lget(inout g, a)
        lget(inout g, n)
        return op(inout g, o)
    }
    if b == "abs" and vt(args[0].kids[0].t) == wt_i64() {
        gen(inout g, args[0].kids[0])
        let x = new_local(inout g, wt_i64())
        lset(inout g, x)
        lget(inout g, x)
        i64c(inout g, imin())
        op(inout g, 81)
        open(inout g, 4, 0)
        overflow_at(inout g, e)
        close(inout g)
        i64c(inout g, 0)
        lget(inout g, x)
        op(inout g, 125)
        lget(inout g, x)
        lget(inout g, x)
        i64c(inout g, 0)
        op(inout g, 83)
        op(inout g, 27)
        return
    }
    if (b == "max" or b == "min") and len(args) == 2 and vt(args[0].kids[0].t) == wt_i64() {
        gen(inout g, args[0].kids[0])
        gen(inout g, args[1].kids[0])
        let y = new_local(inout g, wt_i64())
        let x = new_local(inout g, wt_i64())
        lset(inout g, y)
        lset(inout g, x)
        // max: y when x < y; min: x when x < y
        if b == "max" {
            lget(inout g, y)
            lget(inout g, x)
        } else {
            lget(inout g, x)
            lget(inout g, y)
        }
        lget(inout g, x)
        lget(inout g, y)
        op(inout g, 83)
        op(inout g, 27)
        return
    }
    if b == "int" and vt(args[0].kids[0].t) == wt_i64() { return gen(inout g, args[0].kids[0]) }
    if b == "str" {
        let x = args[0].kids[0]
        if x.t == Ty.TStr { return gen(inout g, x) }
        if heap(x.t) {
            let tx = gen_borrow(inout g, x, true)
            call_f(inout g, glue_fn(inout g, "show", x.t))
            return drop_tmp(inout g, tx, x.t)
        }
        gen(inout g, x)
        if x.t == Ty.TInt { return call_f(inout g, rt_fn(inout g, "rt_str_i64")) }
        if x.t == Ty.TBool {
            let t = intern_obj(inout g, "true")
            let f = intern_obj(inout g, "false")
            let c = new_local(inout g, wt_i32())
            lset(inout g, c)
            i32c(inout g, t)
            i32c(inout g, f)
            lget(inout g, c)
            return op(inout g, 27)
        }
        if x.t == Ty.TUnit {
            i32c(inout g, intern_obj(inout g, "()"))
            return
        }
        return wg_fail(inout g, x, "`str` of values of type `" + show(g.ck, x.t) + "`")
    }
    if b == "keys" or b == "values" or b == "items" { return map_list(inout g, e, b) }
    if b == "get" { return get_w(inout g, e) }
    if b == "len" and (is_list(args[0].kids[0].t) or is_map(args[0].kids[0].t)) {
        let tl = gen_borrow(inout g, args[0].kids[0], true)
        load_at(inout g, wt_i32(), 4)
        op(inout g, 173)
        return drop_tmp(inout g, tl, args[0].kids[0].t)
    }
    // functions of the runtime on texts and lists, which borrow their arguments
    let on_rt = [("join", "rt_join"), ("codes", "rt_codes"), ("starts_with", "rt_starts_with"), ("ends_with", "rt_ends_with"),
        ("find", "rt_find")]
    for r in on_rt {
        if b == r.0 { return call_rt_borrowing(inout g, r.1, args) }
    }
    if b == "contains" {
        let a0 = args[0].kids[0]
        if a0.t == Ty.TStr { return call_rt_borrowing(inout g, "rt_str_contains", args) }
        if is_list(a0.t) {
            let a1 = args[1].kids[0]
            let t0 = gen_borrow(inout g, a0, not changes(a1))
            let t1 = gen_borrow(inout g, a1, true)
            call_f(inout g, glue_fn(inout g, "has", a0.t))
            drop_tmp(inout g, t0, a0.t)
            return drop_tmp(inout g, t1, a1.t)
        }
        // a key of a map
        let a1 = args[1].kids[0]
        let kt = map_kv(g, a0.t).0
        let t0 = gen_borrow(inout g, a0, not changes(a1))
        let o = new_local(inout g, wt_i32())
        lset(inout g, o)
        let t1 = gen_borrow(inout g, a1, true)
        let k = new_local(inout g, vt(kt))
        lset(inout g, k)
        let i = map_find(inout g, o, k, kt)
        lget(inout g, i)
        i64c(inout g, 0)
        op(inout g, 89)
        drop_tmp(inout g, t0, a0.t)
        return drop_tmp(inout g, t1, a1.t)
    }
    if b == "split" {
        let a0 = args[0].kids[0]
        let a1 = args[1].kids[0]
        let t0 = gen_borrow(inout g, a0, not changes(a1))
        let t1 = gen_borrow(inout g, a1, true)
        let sp = new_local(inout g, wt_i32())
        op_u(inout g, 34, sp)
        lget(inout g, sp)
        load_at(inout g, wt_i32(), 4)
        op(inout g, 69)
        open(inout g, 4, 0)
        fail_at_rt(inout g, e, "R0010", "`split` needs a separator that is not empty", "")
        close(inout g)
        call_f(inout g, rt_fn(inout g, "rt_split"))
        drop_tmp(inout g, t0, a0.t)
        return drop_tmp(inout g, t1, a1.t)
    }
    if b == "from_codes" {
        // R0010 for a code that is not a Unicode code point
        let a0 = args[0].kids[0]
        let t0 = gen_borrow(inout g, a0, true)
        let o = new_local(inout g, wt_i32())
        lset(inout g, o)
        lget(inout g, o)
        call_f(inout g, rt_fn(inout g, "rt_bad_code"))
        let k = new_local(inout g, wt_i64())
        op_u(inout g, 34, k)
        list_len(inout g, o)
        op(inout g, 83)
        open(inout g, 4, 0)
        let c = new_local(inout g, wt_i64())
        elem_addr(inout g, o, k)
        load_at(inout g, wt_i64(), 16)
        lset(inout g, c)
        fail_dyn(inout g, e, "R0010", "", " is not a Unicode code point", c, "rt_str_i64")
        close(inout g)
        lget(inout g, o)
        call_f(inout g, rt_fn(inout g, "rt_from_codes"))
        return drop_tmp(inout g, t0, a0.t)
    }
    if b == "len" and args[0].kids[0].t == Ty.TStr {
        let ts = gen_borrow(inout g, args[0].kids[0], true)
        call_f(inout g, rt_fn(inout g, "rt_str_len"))
        return drop_tmp(inout g, ts, Ty.TStr)
    }
    if b == "substr" {
        let ts = gen_borrow(inout g, args[0].kids[0], not changes(args[1]) and not changes(args[2]))
        gen(inout g, args[1].kids[0])
        gen(inout g, args[2].kids[0])
        call_f(inout g, rt_fn(inout g, "rt_substr"))
        return drop_tmp(inout g, ts, Ty.TStr)
    }
    if b == "bit_and" or b == "bit_or" or b == "bit_xor" {
        gen(inout g, args[0].kids[0])
        gen(inout g, args[1].kids[0])
        return op(inout g, if b == "bit_and" { 131 } else if b == "bit_or" { 132 } else { 133 })
    }
    wg_fail(inout g, e, "`" + b + "`")
}

// The builtins whose first argument is a float, as Rust's f64 computes them.
fn float_builtin(inout g: WGen, b: str, args: List[H], e: H) {
    // one instruction
    let simple = [("abs", 153), ("sqrt", 159), ("floor", 156), ("ceil", 155), ("to_bits", 189), ("float", -1)]
    for s in simple {
        if b == s.0 {
            gen(inout g, args[0].kids[0])
            if s.1 > 0 { op(inout g, s.1) }
            return
        }
    }
    // a function of the runtime (the mathematics of rt_math.krs: libm, in Kairós)
    let in_rt = [("str", "rt_fmt_f64"), ("exp", "rt_exp"), ("ln", "rt_log"), ("tanh", "rt_tanh"), ("sigmoid", "rt_sigmoid"),
        ("softplus", "rt_softplus")]
    for s in in_rt {
        if b == s.0 {
            gen(inout g, args[0].kids[0])
            return call_f(inout g, rt_fn(inout g, s.1))
        }
    }
    // the others use the float twice: it goes to a local
    gen(inout g, args[0].kids[0])
    let x = new_local(inout g, wt_f64())
    lset(inout g, x)
    if b == "int" {
        // NaN, the infinities and what does not fit stop the program
        lget(inout g, x)
        op(inout g, 153)
        f64c(inout g, 9.2e18)
        op(inout g, 99)
        op(inout g, 69)
        open(inout g, 4, 0)
        fail_dyn(inout g, e, "R0009", "cannot convert ", " to i64", x, "rt_fmt_f64")
        close(inout g)
        lget(inout g, x)
        return op(inout g, 176)
    }
    if b == "round" {
        // half away from zero: the integer part, plus or minus 1 when the rest is 0.5 or more
        let t = new_local(inout g, wt_f64())
        lget(inout g, x)
        op(inout g, 157)
        lset(inout g, t)
        lget(inout g, x)
        lget(inout g, t)
        op(inout g, 161)
        op(inout g, 153)
        f64c(inout g, 0.5)
        op(inout g, 102)
        open(inout g, 4, wt_f64())
        lget(inout g, t)
        f64c(inout g, 1.0)
        lget(inout g, x)
        op(inout g, 166)
        op(inout g, 160)
        else_(inout g)
        lget(inout g, t)
        close(inout g)
        return
    }
    if b == "is_nan" {
        lget(inout g, x)
        lget(inout g, x)
        return op(inout g, 98)
    }
    if b == "relu" {
        // x when x > 0, else 0.0 (for NaN and -0.0 too)
        lget(inout g, x)
        f64c(inout g, 0.0)
        lget(inout g, x)
        f64c(inout g, 0.0)
        op(inout g, 100)
        return op(inout g, 27)
    }
    if b == "fill_nan" {
        gen(inout g, args[1].kids[0])
        let w = new_local(inout g, wt_f64())
        lset(inout g, w)
        lget(inout g, w)
        lget(inout g, x)
        lget(inout g, x)
        lget(inout g, x)
        op(inout g, 98)
        return op(inout g, 27)
    }
    if (b == "max" or b == "min") and len(args) == 2 {
        gen(inout g, args[1].kids[0])
        let y = new_local(inout g, wt_f64())
        lset(inout g, y)
        // NaN when either is NaN; otherwise as on integers
        lget(inout g, x)
        lget(inout g, x)
        op(inout g, 98)
        lget(inout g, y)
        lget(inout g, y)
        op(inout g, 98)
        op(inout g, 114)
        open(inout g, 4, wt_f64())
        f64c(inout g, nan)
        else_(inout g)
        if b == "max" {
            lget(inout g, y)
            lget(inout g, x)
        } else {
            lget(inout g, x)
            lget(inout g, y)
        }
        lget(inout g, x)
        lget(inout g, y)
        op(inout g, 99)
        op(inout g, 27)
        close(inout g)
        return
    }
    wg_fail(inout g, e, "`" + b + "` on floats")
}

// A function of the runtime called with the builtin's arguments, borrowed (dropped after the call
// when they were made for it).
fn call_rt_borrowing(inout g: WGen, name: str, args: List[H]) {
    var tmps: List[(i64, Ty)] = []
    for i in 0..len(args) {
        var safe = true
        for j in i + 1..len(args) {
            if changes(args[j]) { safe = false }
        }
        tmps.push((gen_borrow(inout g, args[i].kids[0], safe), args[i].kids[0].t))
    }
    call_f(inout g, rt_fn(inout g, name))
    for x in tmps { drop_tmp(inout g, x.0, x.1) }
}

// The instructions behind the runtime's `wasm_*` functions (their arguments are on the stack).
fn intrinsic(inout g: WGen, name: str, e: H) {
    if name == "wasm_load64" {
        op(inout g, 167)
        return load_at(inout g, wt_i64(), 0)
    }
    if name == "wasm_store64" {
        let v = new_local(inout g, wt_i64())
        lset(inout g, v)
        op(inout g, 167)
        lget(inout g, v)
        return store_at(inout g, wt_i64(), 0)
    }
    // the address (an i64 under the value) becomes an i32 for the memory instruction
    if name == "wasm_store8" or name == "wasm_store32" {
        let v = new_local(inout g, wt_i64())
        lset(inout g, v)
        op(inout g, 167)
        lget(inout g, v)
        if name == "wasm_store8" {
            op_u(inout g, 60, 0)
        } else {
            op_u(inout g, 62, 2)
        }
        uleb(inout g.code, 0)
        return
    }
    if name == "wasm_load8" or name == "wasm_load32" {
        op(inout g, 167)
        if name == "wasm_load8" {
            op_u(inout g, 49, 0)
        } else {
            op_u(inout g, 53, 2)
        }
        uleb(inout g.code, 0)
        return
    }
    if name == "wasm_alloc" {
        op(inout g, 167)
        call_f(inout g, f_alloc())
        return op(inout g, 173)
    }
    if name == "wasm_str_addr" { return op(inout g, 173) }
    if name == "wasm_str_at" { return op(inout g, 167) }
    wg_fail(inout g, e, "the instruction `" + name + "`")
}

// ------------------------------------------------------------------ lists

// The type of a list's elements.
fn elem_ty(g: WGen, t: Ty) -> Ty {
    match t {
        TList(x) => fin_ty(g.ck, x),
        _ => Ty.TUnit,
    }
}

// The address of element i (an i64 in local `i`) of the list in local `o`, on the stack.
fn elem_addr(inout g: WGen, o: i64, i: i64) {
    lget(inout g, o)
    lget(inout g, i)
    op(inout g, 167)
    i32c(inout g, 3)
    op(inout g, 116)
    op(inout g, 106)
}

// The length of the list in local `o`, as an i64, on the stack.
fn list_len(inout g: WGen, o: i64) {
    lget(inout g, o)
    load_at(inout g, wt_i32(), 4)
    op(inout g, 173)
}

// Stops the program (R0001) unless 0 <= i < the length of the list in local `o`.
fn check_index(inout g: WGen, e: H, o: i64, i: i64) {
    lget(inout g, i)
    list_len(inout g, o)
    op(inout g, 84)
    op(inout g, 69)
    open(inout g, 4, 0)
    let n = new_local(inout g, wt_i64())
    list_len(inout g, o)
    lset(inout g, n)
    fail_dyn2(inout g, e, "R0001", ["index ", " out of bounds for a list of length ", ""], [(i, "rt_str_i64"), (n, "rt_str_i64")])
    close(inout g)
}

// A new list of `n` elements (its count 1, its length and capacity n) in a new local.
fn new_list(inout g: WGen, n: i64) -> i64 {
    i64c(inout g, n)
    call_f(inout g, rt_fn(inout g, "rt_list_new"))
    op(inout g, 167)
    let o = new_local(inout g, wt_i32())
    lset(inout g, o)
    o
}

// `[a, b, ...]`
fn list_lit(inout g: WGen, e: H) {
    let et = elem_ty(g, e.t)
    let w = vt(et)
    let o = new_list(inout g, len(e.kids))
    for i in 0..len(e.kids) {
        if w > 0 { lget(inout g, o) }
        gen(inout g, e.kids[i])
        if w > 0 { store_at(inout g, w, 16 + 8 * i) }
    }
    lget(inout g, o)
}

// `xs[i]` on a list
fn index_list(inout g: WGen, e: H) {
    let xs = e.kids[0]
    let ix = e.kids[1]
    let et = e.t
    let w = vt(et)
    let tb = gen_borrow(inout g, xs, not changes(ix))
    let o = new_local(inout g, wt_i32())
    lset(inout g, o)
    gen(inout g, ix)
    let i = new_local(inout g, wt_i64())
    lset(inout g, i)
    check_index(inout g, e, o, i)
    if w > 0 {
        elem_addr(inout g, o, i)
        load_at(inout g, w, 16)
        incref(inout g, et)
    }
    drop_tmp(inout g, tb, xs.t)
}

// `for x in xs`: the list as it is when the loop starts (the loop keeps a reference to it)
fn for_list(inout g: WGen, e: H) {
    let p = e.kids[0]
    let xs = e.kids[1]
    let et = elem_ty(g, xs.t)
    let w = vt(et)
    gen(inout g, xs)
    let o = new_local(inout g, wt_i32())
    lset(inout g, o)
    let i = new_local(inout g, wt_i64())
    let x = new_local(inout g, if w > 0 { w } else { wt_i32() })
    open(inout g, 2, 0)
    let exit = g.depth
    open(inout g, 3, 0)
    let top = g.depth
    lget(inout g, i)
    list_len(inout g, o)
    op(inout g, 89)
    br_to(inout g, exit, true)
    if w > 0 {
        elem_addr(inout g, o, i)
        load_at(inout g, w, 16)
        lset(inout g, x)
    }
    bind_from(inout g, p, x, et)
    open(inout g, 2, 0)
    let cont = g.depth
    g.loops.push((exit, cont))
    gen_stmt(inout g, e.kids[2])
    let _ = g.loops.pop()
    close(inout g)
    lget(inout g, i)
    i64c(inout g, 1)
    op(inout g, 124)
    lset(inout g, i)
    br_to(inout g, top, false)
    close(inout g)
    close(inout g)
    lget(inout g, o)
    drop_v(inout g, xs.t)
}

// `xs.push(v)`: the value first, then the list (made unique, with room for one more)
fn push_w(inout g: WGen, e: H) {
    let v = e.kids[1].kids[0]
    let w = vt_of(inout g, v)
    gen(inout g, v)
    let tv = new_local(inout g, if w > 0 { w } else { wt_i32() })
    if w > 0 { lset(inout g, tv) }
    let c = place_cell(inout g, e.kids[0].kids[0], false)
    if g.failed { return }
    cell_load(inout g, c)
    call_f(inout g, glue_fn(inout g, "unique", c.ty))
    op(inout g, 173)
    call_f(inout g, rt_fn(inout g, "rt_list_room"))
    op(inout g, 167)
    let o = new_local(inout g, wt_i32())
    op_u(inout g, 34, o)
    cell_store(inout g, c)
    // the element goes at the end, and the length grows
    let n = new_local(inout g, wt_i64())
    list_len(inout g, o)
    lset(inout g, n)
    if w > 0 {
        elem_addr(inout g, o, n)
        lget(inout g, tv)
        store_at(inout g, w, 16)
    }
    lget(inout g, o)
    lget(inout g, n)
    op(inout g, 167)
    i32c(inout g, 1)
    op(inout g, 106)
    store_at(inout g, wt_i32(), 4)
}

// `xs.pop()`: the last element (it moves out of the list); R0004 on an empty list
fn pop_w(inout g: WGen, e: H) {
    let c = place_cell(inout g, e.kids[0].kids[0], false)
    if g.failed { return }
    cell_load(inout g, c)
    call_f(inout g, glue_fn(inout g, "unique", c.ty))
    let o = new_local(inout g, wt_i32())
    op_u(inout g, 34, o)
    cell_store(inout g, c)
    let n = new_local(inout g, wt_i64())
    list_len(inout g, o)
    lset(inout g, n)
    lget(inout g, n)
    op(inout g, 80)
    open(inout g, 4, 0)
    fail_at_rt(inout g, e, "R0004", "`pop` from an empty list", "")
    close(inout g)
    lget(inout g, n)
    i64c(inout g, 1)
    op(inout g, 125)
    lset(inout g, n)
    lget(inout g, o)
    lget(inout g, n)
    op(inout g, 167)
    store_at(inout g, wt_i32(), 4)
    let w = vt(e.t)
    if w > 0 {
        elem_addr(inout g, o, n)
        load_at(inout g, w, 16)
    }
}

// ------------------------------------------------------------------ enums
//
// An enum value: the count, the index of its variant, then the variant's fields from offset 8.
// A variant without fields is a constant in the data (one per variant, never freed).

fn is_enum(t: Ty) -> bool {
    match t {
        TEnum(_) => true,
        _ => false,
    }
}

fn enum_id(t: Ty) -> i64 {
    match t {
        TEnum(id) => id,
        _ => -1,
    }
}

// The types of the fields of variant vi of enum eid.
fn variant_tys(g: WGen, eid: i64, vi: i64) -> List[Ty] {
    var out: List[Ty] = []
    for x in g.ck.enums[eid].variants[vi].1 { out.push(fin_ty(g.ck, x)) }
    out
}

// The constant of a variant without fields: its address.
fn variant_const(inout g: WGen, eid: i64, vi: i64) -> i64 {
    let key = str(eid) + " " + str(vi)
    if contains(g.vobjs, key) { return g.vobjs[key] }
    while len(g.m.data) % 8 != 0 { g.m.data.push(0) }
    let at = g.m.data_at + len(g.m.data)
    for i in 0..4 { g.m.data.push(0) }
    g.m.data.push(bit_and(vi, 255))
    g.m.data.push(bit_and(shr(vi, 8), 255))
    g.m.data.push(0)
    g.m.data.push(0)
    g.vobjs[key] = at
    at
}

fn variant_lit(inout g: WGen, e: H) {
    let n = len(e.kids)
    if n == 0 { return i32c(inout g, variant_const(inout g, e.n, e.m)) }
    let fts = variant_tys(g, e.n, e.m)
    i64c(inout g, 8 + 8 * n)
    call_f(inout g, rt_fn(inout g, "rt_alloc"))
    op(inout g, 167)
    let o = new_local(inout g, wt_i32())
    lset(inout g, o)
    lget(inout g, o)
    i32c(inout g, 1)
    store_at(inout g, wt_i32(), 0)
    lget(inout g, o)
    i32c(inout g, e.m)
    store_at(inout g, wt_i32(), 4)
    for i in 0..n {
        let w = vt(fts[i])
        if w > 0 { lget(inout g, o) }
        gen(inout g, e.kids[i])
        if w > 0 { store_at(inout g, w, 8 + 8 * i) }
    }
    lget(inout g, o)
}

// Is the value in local `s` of variant vi? (an i32 on the stack)
fn tag_is(inout g: WGen, s: i64, vi: i64) {
    lget(inout g, s)
    load_at(inout g, wt_i32(), 4)
    i32c(inout g, vi)
    op(inout g, 70)
}

// The test of a variant pattern: its variant, then (only then) its fields.
fn variant_test(inout g: WGen, p: H, s: i64) -> bool {
    tag_is(inout g, s, p.m)
    let fts = variant_tys(g, p.n, p.m)
    var needs = false
    for i in 0..len(p.kids) {
        let k = p.kids[i].kind
        if k != "pwild" and k != "pbind" and vt(fts[i]) > 0 { needs = true }
    }
    if not needs { return true }
    open(inout g, 4, wt_i32())
    var n = 0
    for i in 0..len(p.kids) {
        let sub = p.kids[i]
        let w = vt(fts[i])
        if sub.kind == "pwild" or sub.kind == "pbind" or w <= 0 { continue }
        let f = new_local(inout g, w)
        lget(inout g, s)
        load_at(inout g, w, 8 + 8 * i)
        lset(inout g, f)
        if pat_test(inout g, sub, f, fts[i]) {
            if n > 0 { op(inout g, 113) }
            n += 1
        }
    }
    if n == 0 { i32c(inout g, 1) }
    else_(inout g)
    i32c(inout g, 0)
    close(inout g)
    true
}

fn bind_variant(inout g: WGen, p: H, s: i64) {
    let fts = variant_tys(g, p.n, p.m)
    for i in 0..len(p.kids) {
        let sub = p.kids[i]
        let w = vt(fts[i])
        if sub.kind == "pwild" or sub.kind == "plit" or w <= 0 { continue }
        let f = new_local(inout g, w)
        lget(inout g, s)
        load_at(inout g, w, 8 + 8 * i)
        lset(inout g, f)
        bind_from(inout g, sub, f, fts[i])
    }
}

// The glue of enums: for each variant, what its fields need.
fn glue_drop_enum(inout g: WGen, t: Ty) {
    let eid = enum_id(t)
    for vi in 0..len(g.ck.enums[eid].variants) {
        let fts = variant_tys(g, eid, vi)
        tag_is(inout g, 0, vi)
        open(inout g, 4, 0)
        for i in 0..len(fts) {
            if heap(fts[i]) {
                lget(inout g, 0)
                load_at(inout g, wt_i32(), 8 + 8 * i)
                drop_v(inout g, fts[i])
            }
        }
        lget(inout g, 0)
        op(inout g, 173)
        i64c(inout g, 8 + 8 * len(fts))
        call_f(inout g, rt_fn(inout g, "rt_free"))
        op(inout g, 15)
        close(inout g)
    }
}

fn glue_show_enum(inout g: WGen, t: Ty) {
    let eid = enum_id(t)
    let acc = new_local(inout g, wt_i32())
    for vi in 0..len(g.ck.enums[eid].variants) {
        let name = g.ck.enums[eid].variants[vi].0
        let fts = variant_tys(g, eid, vi)
        tag_is(inout g, 0, vi)
        open(inout g, 4, 0)
        if len(fts) == 0 {
            i32c(inout g, intern_obj(inout g, name))
        } else {
            i32c(inout g, intern_obj(inout g, name + "("))
            lset(inout g, acc)
            for i in 0..len(fts) {
                if i > 0 { acc_text(inout g, acc, ", ") }
                show_inner(inout g, 0, 8 + 8 * i, fts[i])
                acc_owned(inout g, acc)
            }
            acc_text(inout g, acc, ")")
            lget(inout g, acc)
        }
        op(inout g, 15)
        close(inout g)
    }
    op(inout g, 0)
}

fn glue_eq_enum(inout g: WGen, t: Ty) {
    let eid = enum_id(t)
    // the same variant
    lget(inout g, 0)
    load_at(inout g, wt_i32(), 4)
    lget(inout g, 1)
    load_at(inout g, wt_i32(), 4)
    op(inout g, 71)
    open(inout g, 4, 0)
    i32c(inout g, 0)
    op(inout g, 15)
    close(inout g)
    // and the same fields
    for vi in 0..len(g.ck.enums[eid].variants) {
        let fts = variant_tys(g, eid, vi)
        if len(fts) == 0 { continue }
        tag_is(inout g, 0, vi)
        open(inout g, 4, 0)
        for i in 0..len(fts) {
            let w = vt(fts[i])
            if w <= 0 { continue }
            lget(inout g, 0)
            load_at(inout g, w, 8 + 8 * i)
            lget(inout g, 1)
            load_at(inout g, w, 8 + 8 * i)
            eq_values(inout g, fts[i])
            op(inout g, 69)
            open(inout g, 4, 0)
            i32c(inout g, 0)
            op(inout g, 15)
            close(inout g)
        }
        close(inout g)
    }
    i32c(inout g, 1)
}

// ------------------------------------------------------------------ inout

// A call with `inout` arguments, as the interpreter makes it: the values first (owned, since a
// variable passed as `inout` can change in the call), then the places move into the call; their
// values come back after the call's result (WebAssembly functions return several values).
fn call_inout(inout g: WGen, e: H) {
    var locs: List[i64] = []
    var tys: List[Ty] = []
    for a in e.kids {
        if a.kind == "val" {
            let x = a.kids[0]
            let w = vt_of(inout g, x)
            gen(inout g, x)
            if w > 0 {
                let l = new_local(inout g, w)
                lset(inout g, l)
                locs.push(l)
            } else {
                locs.push(-1)
            }
            tys.push(x.t)
        } else {
            locs.push(-1)
            tys.push(Ty.TUnit)
        }
    }
    var cells: List[Cell] = []
    for i in 0..len(e.kids) {
        let a = e.kids[i]
        if a.kind == "inout" {
            let c = place_cell(inout g, a.kids[0], false)
            if g.failed { return }
            cells.push(c)
            let w = vt(c.ty)
            if w > 0 {
                let l = new_local(inout g, w)
                cell_load(inout g, c)
                lset(inout g, l)
                locs[i] = l
            }
        }
    }
    for l in locs {
        if l >= 0 { lget(inout g, l) }
    }
    call_f(inout g, fn_index(inout g, e.n))
    // the places get their values back: the last one is on top
    var k = len(cells) - 1
    while k >= 0 {
        cell_store(inout g, cells[k])
        k -= 1
    }
    for i in 0..len(e.kids) {
        if e.kids[i].kind == "val" and heap(tys[i]) {
            lget(inout g, locs[i])
            drop_v(inout g, tys[i])
        }
    }
}

// What a function gives back besides its result: the values of its `inout` parameters.
fn exit_values(inout g: WGen) {
    for n in g.inout_slots {
        let l = g.slot_local[n]
        if l >= 0 { lget(inout g, l) }
    }
}

// ------------------------------------------------------------------ maps
//
// The runtime keeps the entries and their table (rt.krs); the back end moves the keys and values
// in and out, with their references.

fn is_map(t: Ty) -> bool {
    match t {
        TMap(_, _) => true,
        _ => false,
    }
}

fn map_kv(g: WGen, t: Ty) -> (Ty, Ty) {
    match t {
        TMap(k, v) => (fin_ty(g.ck, k), fin_ty(g.ck, v)),
        _ => (Ty.TUnit, Ty.TUnit),
    }
}

// The arguments the runtime takes for a key: the map (local o), the key (local k) as 64 bits, and
// whether keys are texts.
fn map_args(inout g: WGen, o: i64, k: i64, kt: Ty) {
    lget(inout g, o)
    op(inout g, 173)
    lget(inout g, k)
    if kt == Ty.TStr { op(inout g, 173) }
    i32c(inout g, if kt == Ty.TStr { 1 } else { 0 })
}

// The address of entry i (an i64 in local `i`) of the map in local `o`, minus 16 (the key is at
// offset 16 from it, the value at 24).
fn entry_addr(inout g: WGen, o: i64, i: i64) {
    lget(inout g, o)
    lget(inout g, i)
    op(inout g, 167)
    i32c(inout g, 4)
    op(inout g, 116)
    op(inout g, 106)
}

// The index of key k (local) in the map o (local), in a new local (-1: not there).
fn map_find(inout g: WGen, o: i64, k: i64, kt: Ty) -> i64 {
    map_args(inout g, o, k, kt)
    call_f(inout g, rt_fn(inout g, "rt_map_find"))
    let i = new_local(inout g, wt_i64())
    lset(inout g, i)
    i
}

// R0012 unless the index in local i was found.
fn check_key(inout g: WGen, e: H, i: i64, k: i64, kt: Ty) {
    lget(inout g, i)
    i64c(inout g, 0)
    op(inout g, 83)
    open(inout g, 4, 0)
    fail_dyn2(inout g, e, "R0012", ["no key ", " in the map"], [(k, if kt == Ty.TStr { "rt_str_debug" } else { "rt_str_i64" })])
    close(inout g)
}

// `[k: v, ...]`: a later value of the same key replaces the earlier one, at its place
fn map_lit(inout g: WGen, e: H) {
    let kv = map_kv(g, e.t)
    let kw = vt(kv.0)
    let w = vt(kv.1)
    let n = len(e.kids) / 2
    i64c(inout g, n)
    call_f(inout g, rt_fn(inout g, "rt_map_new"))
    op(inout g, 167)
    let o = new_local(inout g, wt_i32())
    lset(inout g, o)
    for j in 0..n {
        gen(inout g, e.kids[2 * j])
        let k = new_local(inout g, kw)
        lset(inout g, k)
        gen(inout g, e.kids[2 * j + 1])
        let v = new_local(inout g, if w > 0 { w } else { wt_i32() })
        if w > 0 { lset(inout g, v) }
        let i = map_find(inout g, o, k, kv.0)
        lget(inout g, i)
        i64c(inout g, 0)
        op(inout g, 83)
        open(inout g, 4, 0)
        // a new key: it moves into the map
        map_args(inout g, o, k, kv.0)
        call_f(inout g, rt_fn(inout g, "rt_map_add"))
        lset(inout g, i)
        else_(inout g)
        // the same key again: the map keeps its own; the old value goes
        lget(inout g, k)
        drop_v(inout g, kv.0)
        if heap(kv.1) {
            entry_addr(inout g, o, i)
            load_at(inout g, wt_i32(), 24)
            drop_v(inout g, kv.1)
        }
        close(inout g)
        if w > 0 {
            entry_addr(inout g, o, i)
            lget(inout g, v)
            store_at(inout g, w, 24)
        }
    }
    lget(inout g, o)
}

// `m[k]` (R0012 when the key is not there)
fn index_map(inout g: WGen, e: H) {
    let m = e.kids[0]
    let kx = e.kids[1]
    let kv = map_kv(g, m.t)
    let w = vt(kv.1)
    let tm = gen_borrow(inout g, m, not changes(kx))
    let o = new_local(inout g, wt_i32())
    lset(inout g, o)
    let tk = gen_borrow(inout g, kx, true)
    let k = new_local(inout g, vt(kv.0))
    lset(inout g, k)
    let i = map_find(inout g, o, k, kv.0)
    check_key(inout g, e, i, k, kv.0)
    if w > 0 {
        entry_addr(inout g, o, i)
        load_at(inout g, w, 24)
        incref(inout g, kv.1)
    }
    drop_tmp(inout g, tm, m.t)
    drop_tmp(inout g, tk, kx.t)
}

// The cell of `m[k]` (the map in cell b, made unique): with `insert`, a new key is added (with
// room made for it), otherwise R0012.
fn map_cell(inout g: WGen, p: H, b: Cell, insert: bool) -> Cell {
    let kv = map_kv(g, b.ty)
    let o = new_local(inout g, wt_i32())
    cell_load(inout g, b)
    lset(inout g, o)
    gen(inout g, p.kids[1])
    let k = new_local(inout g, vt(kv.0))
    lset(inout g, k)
    let i = map_find(inout g, o, k, kv.0)
    if insert {
        lget(inout g, i)
        i64c(inout g, 0)
        op(inout g, 83)
        open(inout g, 4, 0)
        lget(inout g, o)
        op(inout g, 173)
        i32c(inout g, if kv.0 == Ty.TStr { 1 } else { 0 })
        call_f(inout g, rt_fn(inout g, "rt_map_room"))
        op(inout g, 167)
        op_u(inout g, 34, o)
        cell_store(inout g, b)
        map_args(inout g, o, k, kv.0)
        call_f(inout g, rt_fn(inout g, "rt_map_add"))
        lset(inout g, i)
        else_(inout g)
        lget(inout g, k)
        drop_v(inout g, kv.0)
        close(inout g)
    } else {
        check_key(inout g, p, i, k, kv.0)
        lget(inout g, k)
        drop_v(inout g, kv.0)
    }
    entry_addr(inout g, o, i)
    let a = new_local(inout g, wt_i32())
    lset(inout g, a)
    Cell { local: false, at: a, off: 24, ty: kv.1 }
}

// `remove(inout m, k)`: the key first, then the map
fn remove_w(inout g: WGen, e: H) {
    let kx = e.kids[1].kids[0]
    gen(inout g, kx)
    let k = new_local(inout g, vt_of(inout g, kx))
    lset(inout g, k)
    let c = place_cell(inout g, e.kids[0].kids[0], false)
    if g.failed { return }
    let kv = map_kv(g, c.ty)
    cell_load(inout g, c)
    call_f(inout g, glue_fn(inout g, "unique", c.ty))
    let o = new_local(inout g, wt_i32())
    op_u(inout g, 34, o)
    cell_store(inout g, c)
    let i = map_find(inout g, o, k, kv.0)
    lget(inout g, i)
    i64c(inout g, 0)
    op(inout g, 89)
    open(inout g, 4, 0)
    if heap(kv.0) {
        entry_addr(inout g, o, i)
        load_at(inout g, wt_i32(), 16)
        drop_v(inout g, kv.0)
    }
    if heap(kv.1) {
        entry_addr(inout g, o, i)
        load_at(inout g, wt_i32(), 24)
        drop_v(inout g, kv.1)
    }
    lget(inout g, o)
    op(inout g, 173)
    lget(inout g, i)
    i32c(inout g, if kv.0 == Ty.TStr { 1 } else { 0 })
    call_f(inout g, rt_fn(inout g, "rt_map_remove"))
    close(inout g)
    lget(inout g, k)
    drop_v(inout g, kx.t)
}

// keys(m), values(m), items(m): a new list
fn map_list(inout g: WGen, e: H, what: str) {
    let m = e.kids[0].kids[0]
    let kv = map_kv(g, m.t)
    let tm = gen_borrow(inout g, m, true)
    let o = new_local(inout g, wt_i32())
    lset(inout g, o)
    list_len(inout g, o)
    call_f(inout g, rt_fn(inout g, "rt_list_new"))
    op(inout g, 167)
    let q = new_local(inout g, wt_i32())
    lset(inout g, q)
    let lp = loop_begin(inout g, o)
    let et = elem_ty(g, e.t)
    let w = vt(et)
    if w > 0 { elem_addr(inout g, q, lp.0) }
    if what == "keys" or what == "values" {
        let t = if what == "keys" { kv.0 } else { kv.1 }
        if w > 0 {
            entry_addr(inout g, o, lp.0)
            load_at(inout g, w, if what == "keys" { 16 } else { 24 })
            incref(inout g, t)
        }
    } else {
        // a tuple (key, value) for each entry
        i64c(inout g, 24)
        call_f(inout g, rt_fn(inout g, "rt_alloc"))
        op(inout g, 167)
        let tu = new_local(inout g, wt_i32())
        lset(inout g, tu)
        lget(inout g, tu)
        i32c(inout g, 1)
        store_at(inout g, wt_i32(), 0)
        let kw = vt(kv.0)
        lget(inout g, tu)
        entry_addr(inout g, o, lp.0)
        load_at(inout g, kw, 16)
        incref(inout g, kv.0)
        store_at(inout g, kw, 8)
        let vw = vt(kv.1)
        if vw > 0 {
            lget(inout g, tu)
            entry_addr(inout g, o, lp.0)
            load_at(inout g, vw, 24)
            incref(inout g, kv.1)
            store_at(inout g, vw, 16)
        }
        lget(inout g, tu)
    }
    if w > 0 { store_at(inout g, w, 16) }
    loop_end(inout g, lp)
    lget(inout g, q)
    drop_tmp(inout g, tm, m.t)
}

// get(m, k, default): the value of k, or the default
fn get_w(inout g: WGen, e: H) {
    let m = e.kids[0].kids[0]
    let kx = e.kids[1].kids[0]
    let dx = e.kids[2].kids[0]
    let kv = map_kv(g, m.t)
    let w = vt(kv.1)
    let tm = gen_borrow(inout g, m, not changes(kx) and not changes(dx))
    let o = new_local(inout g, wt_i32())
    lset(inout g, o)
    let tk = gen_borrow(inout g, kx, not changes(dx))
    let k = new_local(inout g, vt(kv.0))
    lset(inout g, k)
    gen(inout g, dx)
    let d = new_local(inout g, if w > 0 { w } else { wt_i32() })
    if w > 0 { lset(inout g, d) }
    let i = map_find(inout g, o, k, kv.0)
    lget(inout g, i)
    i64c(inout g, 0)
    op(inout g, 83)
    open(inout g, 4, w)
    if w > 0 { lget(inout g, d) }
    else_(inout g)
    if heap(kv.1) {
        lget(inout g, d)
        drop_v(inout g, kv.1)
    }
    if w > 0 {
        entry_addr(inout g, o, i)
        load_at(inout g, w, 24)
        incref(inout g, kv.1)
    }
    close(inout g)
    drop_tmp(inout g, tm, m.t)
    drop_tmp(inout g, tk, kx.t)
}

fn glue_drop_map(inout g: WGen, t: Ty) {
    let kv = map_kv(g, t)
    if heap(kv.0) or heap(kv.1) {
        let lp = loop_begin(inout g, 0)
        if heap(kv.0) {
            entry_addr(inout g, 0, lp.0)
            load_at(inout g, wt_i32(), 16)
            drop_v(inout g, kv.0)
        }
        if heap(kv.1) {
            entry_addr(inout g, 0, lp.0)
            load_at(inout g, wt_i32(), 24)
            drop_v(inout g, kv.1)
        }
        loop_end(inout g, lp)
    }
    lget(inout g, 0)
    op(inout g, 173)
    map_size(inout g, 0)
    call_f(inout g, rt_fn(inout g, "rt_free"))
}

// The bytes of the map in local o, as an i64: 16 + 16 cap + 4 tsize.
fn map_size(inout g: WGen, o: i64) {
    lget(inout g, o)
    load_at(inout g, wt_i32(), 8)
    i32c(inout g, 4)
    op(inout g, 116)
    lget(inout g, o)
    load_at(inout g, wt_i32(), 12)
    i32c(inout g, 2)
    op(inout g, 116)
    op(inout g, 106)
    i32c(inout g, 16)
    op(inout g, 106)
    op(inout g, 173)
}

fn glue_unique_map(inout g: WGen, t: Ty) {
    let kv = map_kv(g, t)
    let q = new_local(inout g, wt_i32())
    let n = new_local(inout g, wt_i64())
    map_size(inout g, 0)
    lset(inout g, n)
    lget(inout g, n)
    call_f(inout g, rt_fn(inout g, "rt_alloc"))
    op(inout g, 167)
    lset(inout g, q)
    // the same bytes (entries and table), then a count of 1 and a reference more for each child
    let i = new_local(inout g, wt_i64())
    open(inout g, 2, 0)
    let exit = g.depth
    open(inout g, 3, 0)
    let top = g.depth
    lget(inout g, i)
    lget(inout g, n)
    op(inout g, 89)
    br_to(inout g, exit, true)
    lget(inout g, q)
    lget(inout g, i)
    op(inout g, 167)
    op(inout g, 106)
    lget(inout g, 0)
    lget(inout g, i)
    op(inout g, 167)
    op(inout g, 106)
    load_at(inout g, wt_i64(), 0)
    store_at(inout g, wt_i64(), 0)
    lget(inout g, i)
    i64c(inout g, 8)
    op(inout g, 124)
    lset(inout g, i)
    br_to(inout g, top, false)
    close(inout g)
    close(inout g)
    lget(inout g, q)
    i32c(inout g, 1)
    store_at(inout g, wt_i32(), 0)
    if heap(kv.0) or heap(kv.1) {
        let lp = loop_begin(inout g, q)
        if heap(kv.0) {
            entry_addr(inout g, q, lp.0)
            load_at(inout g, wt_i32(), 16)
            incref(inout g, kv.0)
            op(inout g, 26)
        }
        if heap(kv.1) {
            entry_addr(inout g, q, lp.0)
            load_at(inout g, wt_i32(), 24)
            incref(inout g, kv.1)
            op(inout g, 26)
        }
        loop_end(inout g, lp)
    }
    lget(inout g, 0)
    drop_v(inout g, t)
    lget(inout g, q)
}

fn glue_show_map(inout g: WGen, t: Ty) {
    let kv = map_kv(g, t)
    let acc = new_local(inout g, wt_i32())
    let a = new_local(inout g, wt_i32())
    // [:] when empty
    list_len(inout g, 0)
    op(inout g, 80)
    open(inout g, 4, 0)
    i32c(inout g, intern_obj(inout g, "[:]"))
    op(inout g, 15)
    close(inout g)
    i32c(inout g, intern_obj(inout g, "["))
    lset(inout g, acc)
    let lp = loop_begin(inout g, 0)
    lget(inout g, lp.0)
    op(inout g, 80)
    op(inout g, 69)
    open(inout g, 4, 0)
    acc_text(inout g, acc, ", ")
    close(inout g)
    entry_addr(inout g, 0, lp.0)
    lset(inout g, a)
    show_inner(inout g, a, 16, kv.0)
    acc_owned(inout g, acc)
    acc_text(inout g, acc, ": ")
    show_inner(inout g, a, 24, kv.1)
    acc_owned(inout g, acc)
    loop_end(inout g, lp)
    acc_text(inout g, acc, "]")
    lget(inout g, acc)
}

// Maps are equal with the same keys, each with equal values, in any order.
fn glue_eq_map(inout g: WGen, t: Ty) {
    let kv = map_kv(g, t)
    list_len(inout g, 0)
    list_len(inout g, 1)
    op(inout g, 82)
    open(inout g, 4, 0)
    i32c(inout g, 0)
    op(inout g, 15)
    close(inout g)
    let k = new_local(inout g, vt(kv.0))
    let lp = loop_begin(inout g, 0)
    entry_addr(inout g, 0, lp.0)
    load_at(inout g, vt(kv.0), 16)
    lset(inout g, k)
    let j = map_find(inout g, 1, k, kv.0)
    lget(inout g, j)
    i64c(inout g, 0)
    op(inout g, 83)
    open(inout g, 4, 0)
    i32c(inout g, 0)
    op(inout g, 15)
    close(inout g)
    let w = vt(kv.1)
    if w > 0 {
        entry_addr(inout g, 0, lp.0)
        load_at(inout g, w, 24)
        entry_addr(inout g, 1, j)
        load_at(inout g, w, 24)
        eq_values(inout g, kv.1)
        op(inout g, 69)
        open(inout g, 4, 0)
        i32c(inout g, 0)
        op(inout g, 15)
        close(inout g)
    }
    loop_end(inout g, lp)
    i32c(inout g, 1)
}

// ------------------------------------------------------------------ glue
//
// The functions each type of value in the heap gets: `drop` (a reference less; at the last one,
// the children are dropped and the block freed), `unique` (the object itself when no one else
// has it, a copy otherwise), `show` (its text, as the interpreter writes it) and `eq`.

fn gen_glue(inout g: WGen, j: i64) {
    let what = g.glue[j].0
    let t = g.glue[j].1
    g.code = []
    g.ltypes = []
    g.slot_local = []
    g.slot_ty = []
    g.inout_slots = []
    g.nparams = 0
    g.depth = 0
    g.loops = []
    g.unchecked = true
    let i32t = wt_i32()
    let p = new_local(inout g, i32t)
    if what == "drop" {
        glue_drop(inout g, t)
        g.m.funcs.push(finish(inout g, 1, wtype(inout g.m, [i32t], [])))
    } else if what == "unique" {
        glue_unique(inout g, t)
        g.m.funcs.push(finish(inout g, 1, wtype(inout g.m, [i32t], [i32t])))
    } else if what == "show" {
        if is_list(t) {
            glue_show_list(inout g, t)
        } else if is_map(t) {
            glue_show_map(inout g, t)
        } else if is_enum(t) {
            glue_show_enum(inout g, t)
        } else {
            glue_show(inout g, t)
        }
        g.m.funcs.push(finish(inout g, 1, wtype(inout g.m, [i32t], [i32t])))
    } else if what == "has" {
        // the element compared, of its own type
        let w = vt(elem_ty(g, t))
        let q = new_local(inout g, if w > 0 { w } else { i32t })
        glue_has(inout g, t)
        g.m.funcs.push(finish(inout g, 2, wtype(inout g.m, [i32t, if w > 0 { w } else { i32t }], [i32t])))
    } else {
        let q = new_local(inout g, i32t)
        if is_list(t) {
            glue_eq_list(inout g, t)
        } else if is_map(t) {
            glue_eq_map(inout g, t)
        } else if is_enum(t) {
            glue_eq_enum(inout g, t)
        } else {
            glue_eq(inout g, t)
        }
        g.m.funcs.push(finish(inout g, 2, wtype(inout g.m, [i32t, i32t], [i32t])))
    }
}

fn is_list(t: Ty) -> bool {
    match t {
        TList(_) => true,
        _ => false,
    }
}

// Opens a loop over the elements of the list in local `o`: the index (an i64) in the result;
// the body follows, then `loop_end`.
fn loop_begin(inout g: WGen, o: i64) -> (i64, i64, i64) {
    let i = new_local(inout g, wt_i64())
    i64c(inout g, 0)
    lset(inout g, i)
    open(inout g, 2, 0)
    let exit = g.depth
    open(inout g, 3, 0)
    let top = g.depth
    lget(inout g, i)
    list_len(inout g, o)
    op(inout g, 89)
    br_to(inout g, exit, true)
    (i, exit, top)
}

fn loop_end(inout g: WGen, lp: (i64, i64, i64)) {
    lget(inout g, lp.0)
    i64c(inout g, 1)
    op(inout g, 124)
    lset(inout g, lp.0)
    br_to(inout g, lp.2, false)
    close(inout g)
    close(inout g)
}

// The two values of type t on the stack: are they equal? (an i32)
fn eq_values(inout g: WGen, t: Ty) {
    if t == Ty.TInt { return op(inout g, 81) }
    if t == Ty.TFloat { return op(inout g, 97) }
    if t == Ty.TBool { return op(inout g, 70) }
    if t == Ty.TStr { return call_f(inout g, rt_fn(inout g, "rt_str_eq")) }
    if heap(t) { return call_f(inout g, glue_fn(inout g, "eq", t)) }
    if vt(t) == 0 { return i32c(inout g, 1) }
    wg_fail(inout g, h_none(), "comparing values of type `" + show(g.ck, t) + "`")
}

fn glue_drop_list(inout g: WGen, t: Ty) {
    let et = elem_ty(g, t)
    if heap(et) {
        let lp = loop_begin(inout g, 0)
        elem_addr(inout g, 0, lp.0)
        load_at(inout g, wt_i32(), 16)
        drop_v(inout g, et)
        loop_end(inout g, lp)
    }
    lget(inout g, 0)
    op(inout g, 173)
    lget(inout g, 0)
    load_at(inout g, wt_i32(), 8)
    i32c(inout g, 3)
    op(inout g, 116)
    i32c(inout g, 16)
    op(inout g, 106)
    op(inout g, 173)
    call_f(inout g, rt_fn(inout g, "rt_free"))
}

fn glue_unique_list(inout g: WGen, t: Ty) {
    let et = elem_ty(g, t)
    let w = vt(et)
    list_len(inout g, 0)
    call_f(inout g, rt_fn(inout g, "rt_list_new"))
    op(inout g, 167)
    let q = new_local(inout g, wt_i32())
    lset(inout g, q)
    if w > 0 {
        let lp = loop_begin(inout g, 0)
        elem_addr(inout g, q, lp.0)
        elem_addr(inout g, 0, lp.0)
        load_at(inout g, w, 16)
        incref(inout g, et)
        store_at(inout g, w, 16)
        loop_end(inout g, lp)
    }
    lget(inout g, 0)
    drop_v(inout g, t)
    lget(inout g, q)
}

fn glue_show_list(inout g: WGen, t: Ty) {
    let et = elem_ty(g, t)
    let acc = new_local(inout g, wt_i32())
    let a = new_local(inout g, wt_i32())
    i32c(inout g, intern_obj(inout g, "["))
    lset(inout g, acc)
    let lp = loop_begin(inout g, 0)
    lget(inout g, lp.0)
    op(inout g, 80)
    op(inout g, 69)
    open(inout g, 4, 0)
    acc_text(inout g, acc, ", ")
    close(inout g)
    elem_addr(inout g, 0, lp.0)
    lset(inout g, a)
    show_inner(inout g, a, 16, et)
    acc_owned(inout g, acc)
    loop_end(inout g, lp)
    acc_text(inout g, acc, "]")
    lget(inout g, acc)
}

fn glue_eq_list(inout g: WGen, t: Ty) {
    let et = elem_ty(g, t)
    let w = vt(et)
    // the same length, then the same elements
    list_len(inout g, 0)
    list_len(inout g, 1)
    op(inout g, 82)
    open(inout g, 4, 0)
    i32c(inout g, 0)
    op(inout g, 15)
    close(inout g)
    if w > 0 {
        let lp = loop_begin(inout g, 0)
        elem_addr(inout g, 0, lp.0)
        load_at(inout g, w, 16)
        elem_addr(inout g, 1, lp.0)
        load_at(inout g, w, 16)
        eq_values(inout g, et)
        op(inout g, 69)
        open(inout g, 4, 0)
        i32c(inout g, 0)
        op(inout g, 15)
        close(inout g)
        loop_end(inout g, lp)
    }
    i32c(inout g, 1)
}

// contains(xs, x): is x one of the elements of xs?
fn glue_has(inout g: WGen, t: Ty) {
    let et = elem_ty(g, t)
    let w = vt(et)
    let lp = loop_begin(inout g, 0)
    if w > 0 {
        elem_addr(inout g, 0, lp.0)
        load_at(inout g, w, 16)
        lget(inout g, 1)
        eq_values(inout g, et)
    } else {
        i32c(inout g, 1)
    }
    open(inout g, 4, 0)
    i32c(inout g, 1)
    op(inout g, 15)
    close(inout g)
    loop_end(inout g, lp)
    i32c(inout g, 0)
}

fn glue_drop(inout g: WGen, t: Ty) {
    let rc = new_local(inout g, wt_i32())
    // nothing for 0
    lget(inout g, 0)
    op(inout g, 69)
    open(inout g, 4, 0)
    op(inout g, 15)
    close(inout g)
    // shared: one reference less; a constant (0): nothing
    lget(inout g, 0)
    load_at(inout g, wt_i32(), 0)
    lset(inout g, rc)
    lget(inout g, rc)
    i32c(inout g, 1)
    op(inout g, 71)
    open(inout g, 4, 0)
    lget(inout g, rc)
    i32c(inout g, 1)
    op(inout g, 74)
    open(inout g, 4, 0)
    lget(inout g, 0)
    lget(inout g, rc)
    i32c(inout g, 1)
    op(inout g, 107)
    store_at(inout g, wt_i32(), 0)
    close(inout g)
    op(inout g, 15)
    close(inout g)
    // the last reference: the children, then the block
    if is_list(t) { return glue_drop_list(inout g, t) }
    if is_map(t) { return glue_drop_map(inout g, t) }
    if is_enum(t) {
        glue_drop_enum(inout g, t)
        return op(inout g, 0)
    }
    let fts = field_tys(g, t)
    for i in 0..len(fts) {
        if heap(fts[i]) {
            lget(inout g, 0)
            load_at(inout g, wt_i32(), 8 + 8 * i)
            drop_v(inout g, fts[i])
        }
    }
    lget(inout g, 0)
    op(inout g, 173)
    if t == Ty.TStr {
        lget(inout g, 0)
        load_at(inout g, wt_i32(), 4)
        i32c(inout g, 8)
        op(inout g, 106)
        op(inout g, 173)
    } else {
        i64c(inout g, 8 + 8 * len(fts))
    }
    call_f(inout g, rt_fn(inout g, "rt_free"))
}

fn glue_unique(inout g: WGen, t: Ty) {
    // no one else has it: itself
    lget(inout g, 0)
    load_at(inout g, wt_i32(), 0)
    i32c(inout g, 1)
    op(inout g, 70)
    open(inout g, 4, 0)
    lget(inout g, 0)
    op(inout g, 15)
    close(inout g)
    if is_list(t) { return glue_unique_list(inout g, t) }
    if is_map(t) { return glue_unique_map(inout g, t) }
    // a copy: the same fields, each child with one more reference
    let fts = field_tys(g, t)
    let q = new_local(inout g, wt_i32())
    i64c(inout g, 8 + 8 * len(fts))
    call_f(inout g, rt_fn(inout g, "rt_alloc"))
    op(inout g, 167)
    lset(inout g, q)
    lget(inout g, q)
    i32c(inout g, 1)
    store_at(inout g, wt_i32(), 0)
    for i in 0..len(fts) {
        let w = vt(fts[i])
        if w > 0 {
            lget(inout g, q)
            lget(inout g, 0)
            load_at(inout g, w, 8 + 8 * i)
            incref(inout g, fts[i])
            store_at(inout g, w, 8 + 8 * i)
        }
    }
    // the original has one reference less (it is shared, or a constant)
    lget(inout g, 0)
    drop_v(inout g, t)
    lget(inout g, q)
}

// acc = acc + the constant text s
fn acc_text(inout g: WGen, acc: i64, s: str) {
    lget(inout g, acc)
    i32c(inout g, intern_obj(inout g, s))
    call_f(inout g, rt_fn(inout g, "rt_concat"))
    lget(inout g, acc)
    drop_v(inout g, Ty.TStr)
    lset(inout g, acc)
}

// acc = acc + the owned text on the stack (dropped after)
fn acc_owned(inout g: WGen, acc: i64) {
    let pc = new_local(inout g, wt_i32())
    lset(inout g, pc)
    lget(inout g, acc)
    lget(inout g, pc)
    call_f(inout g, rt_fn(inout g, "rt_concat"))
    lget(inout g, acc)
    drop_v(inout g, Ty.TStr)
    lget(inout g, pc)
    drop_v(inout g, Ty.TStr)
    lset(inout g, acc)
}

// The text of the value of type t at offset `off` of the object in local `o`, inside another value
// (texts between quotes): an owned text on the stack.
fn show_inner(inout g: WGen, o: i64, off: i64, t: Ty) {
    let w = vt(t)
    if w <= 0 {
        i32c(inout g, intern_obj(inout g, "()"))
        return
    }
    lget(inout g, o)
    load_at(inout g, w, off)
    if t == Ty.TInt { return call_f(inout g, rt_fn(inout g, "rt_str_i64")) }
    if t == Ty.TFloat { return call_f(inout g, rt_fn(inout g, "rt_fmt_f64")) }
    if t == Ty.TStr { return call_f(inout g, rt_fn(inout g, "rt_str_debug")) }
    if t == Ty.TBool {
        let c = new_local(inout g, wt_i32())
        lset(inout g, c)
        i32c(inout g, intern_obj(inout g, "true"))
        i32c(inout g, intern_obj(inout g, "false"))
        lget(inout g, c)
        return op(inout g, 27)
    }
    if heap(t) { return call_f(inout g, glue_fn(inout g, "show", t)) }
    wg_fail(inout g, h_none(), "writing values of type `" + show(g.ck, t) + "`")
}

fn glue_show(inout g: WGen, t: Ty) {
    let acc = new_local(inout g, wt_i32())
    let fts = field_tys(g, t)
    let n = len(fts)
    var names: List[str] = []
    var head = "("
    match t {
        TStruct(id) => {
            for f in g.ck.structs[id].fields { names.push(f.0) }
            head = g.ck.structs[id].name + " { "
        },
        _ => {},
    }
    let is_struct = len(names) > 0 or head != "("
    i32c(inout g, intern_obj(inout g, head))
    lset(inout g, acc)
    for i in 0..n {
        var sep = if i > 0 { ", " } else { "" }
        if is_struct { sep = sep + names[i] + ": " }
        if sep != "" { acc_text(inout g, acc, sep) }
        show_inner(inout g, 0, 8 + 8 * i, fts[i])
        acc_owned(inout g, acc)
    }
    acc_text(inout g, acc, if is_struct { " }" } else if n == 1 { ",)" } else { ")" })
    lget(inout g, acc)
}

fn glue_eq(inout g: WGen, t: Ty) {
    let fts = field_tys(g, t)
    for i in 0..len(fts) {
        let ft = fts[i]
        let w = vt(ft)
        if w <= 0 { continue }
        lget(inout g, 0)
        load_at(inout g, w, 8 + 8 * i)
        lget(inout g, 1)
        load_at(inout g, w, 8 + 8 * i)
        if ft == Ty.TInt {
            op(inout g, 81)
        } else if ft == Ty.TFloat {
            op(inout g, 97)
        } else if ft == Ty.TBool {
            op(inout g, 70)
        } else if ft == Ty.TStr {
            call_f(inout g, rt_fn(inout g, "rt_str_eq"))
        } else if heap(ft) {
            call_f(inout g, glue_fn(inout g, "eq", ft))
        } else {
            return wg_fail(inout g, h_none(), "comparing values of type `" + show(g.ck, ft) + "`")
        }
        // a field that differs: not equal
        op(inout g, 69)
        open(inout g, 4, 0)
        i32c(inout g, 0)
        op(inout g, 15)
        close(inout g)
    }
    i32c(inout g, 1)
}

// ------------------------------------------------------------------ functions and the module

// Sets up the locals of a frame: the slots' types, the first `np` of them parameters.
fn frame(inout g: WGen, tys: List[Ty], np: i64, at: H) -> List[i64] {
    g.code = []
    g.ltypes = []
    g.slot_local = []
    g.slot_ty = []
    g.inout_slots = []
    g.nparams = np
    g.depth = 0
    g.loops = []
    var params: List[i64] = []
    for i in 0..len(tys) {
        let ti = fin_ty(g.ck, tys[i])
        g.slot_ty.push(ti)
        let v = vt(ti)
        if v < 0 {
            wg_fail(inout g, at, "variables of type `" + show(g.ck, ti) + "`")
            return params
        }
        if v == 0 {
            g.slot_local.push(-1)
        } else {
            g.slot_local.push(new_local(inout g, v))
            if i < np { params.push(v) }
        }
    }
    params
}

// The function just generated: its code ends, its locals follow its `np` parameters.
fn finish(inout g: WGen, np: i64, tidx: i64) -> WFunc {
    op(inout g, 11)
    var locals: List[i64] = []
    for i in np..len(g.ltypes) { locals.push(g.ltypes[i]) }
    WFunc { tidx: tidx, locals: locals, code: g.code }
}

fn gen_fn(inout g: WGen, id: i64) {
    let sig = g.ck.sigs[id]
    let body = g.ck.fn_hir[id]
    g.unchecked = starts_with(sig.name, "rt_")
    let np = len(sig.params)
    let params = frame(inout g, g.ck.bodies[id], np, body)
    if g.failed { return }
    // the `inout` parameters come back after the result
    var outs: List[i64] = []
    for i in 0..np {
        if sig.params[i].2 {
            g.inout_slots.push(i)
            let w = vt(g.slot_ty[i])
            if w > 0 { outs.push(w) }
        }
    }
    // parameters of no value take no local: the others keep their order
    var wparams = 0
    for i in 0..np {
        if g.slot_local[i] >= 0 { wparams += 1 }
    }
    let r = vt(sig.ret)
    if r < 0 { return wg_fail(inout g, body, "functions returning `" + show(g.ck, sig.ret) + "`") }
    var results: List[i64] = if r > 0 { [r] } else { [] }
    for w in outs { results.push(w) }
    let tidx = wtype(inout g.m, params, results)
    gen(inout g, body)
    epilogue(inout g)
    exit_values(inout g)
    let f = finish(inout g, wparams, tidx)
    g.m.funcs.push(f)
}

// The runtime's functions: write(fd, ptr, len), fail(ptr, len), print_i64(v).
fn runtime_fns(inout g: WGen) {
    let i32t = wt_i32()
    let i64t = wt_i64()
    // write: an iovec at 0, fd_write(fd, 0, 1, 8)
    g.code = []
    g.depth = 0
    i32c(inout g, 0)
    lget(inout g, 1)
    op_u(inout g, 54, 2)
    uleb(inout g.code, 0)
    i32c(inout g, 4)
    lget(inout g, 2)
    op_u(inout g, 54, 2)
    uleb(inout g.code, 0)
    lget(inout g, 0)
    i32c(inout g, 0)
    i32c(inout g, 1)
    i32c(inout g, 8)
    call_f(inout g, f_fd_write())
    op(inout g, 26)
    op(inout g, 11)
    g.m.funcs.push(WFunc { tidx: wtype(inout g.m, [i32t, i32t, i32t], []), locals: [], code: g.code })
    // fail: the message to stderr, exit code 1
    g.code = []
    i32c(inout g, 2)
    lget(inout g, 0)
    lget(inout g, 1)
    call_f(inout g, f_write())
    i32c(inout g, 1)
    call_f(inout g, f_proc_exit())
    op(inout g, 0)
    op(inout g, 11)
    g.m.funcs.push(WFunc { tidx: wtype(inout g.m, [i32t, i32t], []), locals: [], code: g.code })
    // print_i64: the decimal digits, from the end of the scratch (16..48) backwards
    g.code = []
    // locals: 1 position (i32), 2 magnitude (i64), 3 negative (i32)
    lget(inout g, 0)
    i64c(inout g, 0)
    op(inout g, 83)
    lset(inout g, 3)
    lget(inout g, 3)
    open(inout g, 4, i64t)
    i64c(inout g, 0)
    lget(inout g, 0)
    op(inout g, 125)
    else_(inout g)
    lget(inout g, 0)
    close(inout g)
    lset(inout g, 2)
    i32c(inout g, 48)
    lset(inout g, 1)
    open(inout g, 3, 0)
    lget(inout g, 1)
    i32c(inout g, 1)
    op(inout g, 107)
    lset(inout g, 1)
    lget(inout g, 1)
    lget(inout g, 2)
    i64c(inout g, 10)
    op(inout g, 130)
    i64c(inout g, 48)
    op(inout g, 124)
    op(inout g, 167)
    op_u(inout g, 58, 0)
    uleb(inout g.code, 0)
    lget(inout g, 2)
    i64c(inout g, 10)
    op(inout g, 128)
    op_u(inout g, 34, 2)
    i64c(inout g, 0)
    op(inout g, 82)
    op_u(inout g, 13, 0)
    close(inout g)
    lget(inout g, 3)
    open(inout g, 4, 0)
    lget(inout g, 1)
    i32c(inout g, 1)
    op(inout g, 107)
    op_u(inout g, 34, 1)
    i32c(inout g, 45)
    op_u(inout g, 58, 0)
    uleb(inout g.code, 0)
    close(inout g)
    i32c(inout g, 1)
    lget(inout g, 1)
    i32c(inout g, 48)
    lget(inout g, 1)
    op(inout g, 107)
    call_f(inout g, f_write())
    op(inout g, 11)
    g.m.funcs.push(WFunc { tidx: wtype(inout g.m, [i64t], []), locals: [i32t, i64t, i32t], code: g.code })
    // alloc(n): the heap's next free byte (global 0), then rounded up to 8; the memory grows a
    // page at a time when the heap passes its end
    g.code = []
    op_u(inout g, 35, 0)
    lset(inout g, 1)
    op_u(inout g, 35, 0)
    lget(inout g, 0)
    op(inout g, 106)
    i32c(inout g, 7)
    op(inout g, 106)
    i32c(inout g, -8)
    op(inout g, 113)
    op_u(inout g, 36, 0)
    open(inout g, 2, 0)
    open(inout g, 3, 0)
    op_u(inout g, 35, 0)
    op_u(inout g, 63, 0)
    i32c(inout g, 16)
    op(inout g, 116)
    op(inout g, 77)
    op_u(inout g, 13, 1)
    i32c(inout g, 1)
    op_u(inout g, 64, 0)
    op(inout g, 26)
    op_u(inout g, 12, 0)
    close(inout g)
    close(inout g)
    lget(inout g, 1)
    op(inout g, 11)
    g.m.funcs.push(WFunc { tidx: wtype(inout g.m, [i32t], [i32t]), locals: [i32t], code: g.code })
    // print_str(p): the bytes of the text at p
    g.code = []
    write_obj(inout g, 1, 0)
    op(inout g, 11)
    g.m.funcs.push(WFunc { tidx: wtype(inout g.m, [i32t], []), locals: [], code: g.code })
    // incref(p) -> p: one more reference (none for 0 and for constants, whose count is 0)
    g.code = []
    lget(inout g, 0)
    open(inout g, 4, 0)
    lget(inout g, 0)
    load_at(inout g, i32t, 0)
    lset(inout g, 1)
    lget(inout g, 1)
    i32c(inout g, 0)
    op(inout g, 74)
    open(inout g, 4, 0)
    lget(inout g, 0)
    lget(inout g, 1)
    i32c(inout g, 1)
    op(inout g, 106)
    store_at(inout g, i32t, 0)
    close(inout g)
    close(inout g)
    lget(inout g, 0)
    op(inout g, 11)
    g.m.funcs.push(WFunc { tidx: wtype(inout g.m, [i32t], [i32t]), locals: [i32t], code: g.code })
}

// The module of a checked program: (it compiled, the module, the error: file lo hi message).
fn wasm_module(ck: Checker, srcs: List[str]) -> (bool, Bytes, str) {
    var g = WGen {
        m: wmod_new(1024), ck: ck, srcs: srcs, fidx: [:], order: [], glue: [], glue_idx: [:], strs: [:], objs: [:], vobjs: [:],
        code: [], ltypes: [], nparams: 0, slot_local: [], slot_ty: [], inout_slots: [], depth: 0, loops: [], unchecked: false, failed: false, msg: "",
        efile: 0, elo: 0, ehi: 0,
    }
    let i32t = wt_i32()
    g.m.imports.push(("wasi_snapshot_preview1", "fd_write", wtype(inout g.m, [i32t, i32t, i32t, i32t], [i32t])))
    g.m.imports.push(("wasi_snapshot_preview1", "proc_exit", wtype(inout g.m, [i32t], [])))
    runtime_fns(inout g)
    // _start: the top-level statements, the top-level variables as its locals; the functions
    // they call are compiled after it, each one when first called
    let none: List[H] = []
    let params = frame(inout g, ck.main.slot_tys, 0, if len(ck.all_tops) > 0 { ck.all_tops[0] } else { hk("-", none) })
    for t in ck.all_tops { gen_stmt(inout g, t) }
    let empty: List[i64] = []
    let start = finish(inout g, 0, wtype(inout g.m, params, empty))
    g.m.funcs.push(start)
    var k = 0
    while k < len(g.order) and not g.failed {
        let id = g.order[k]
        if id >= 0 { gen_fn(inout g, id) } else { gen_glue(inout g, -1 - id) }
        k += 1
    }
    if g.failed {
        return (false, bytes(), str(g.efile) + " " + str(g.elo) + " " + str(g.ehi) + " " + g.msg)
    }
    g.m.exports.push(("_start", 0, f_start()))
    g.m.exports.push(("memory", 2, 0))
    // the heap starts after the data, at a multiple of 8
    let heap_at = (g.m.data_at + len(g.m.data) + 7) / 8 * 8
    g.m.globals.push((i32t, heap_at))
    g.m.pages = 1 + heap_at / 65536
    (true, module_bytes(g.m), "")
}
