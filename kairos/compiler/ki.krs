// ki: the interpreter written in Kairós (M15), as `kairos run` does it: the program is checked by
// the front end written in Kairós, then its top-level statements run. An error (of the program
// or while it runs) goes to the standard error, written as `kairos` writes it, with exit code 1.
//
//   kairos run kairos/compiler/ki.krs <std folder> program.krs [arguments...]
//
// Compiled to WebAssembly (`kw.krs`), it runs Kairós programs with no Rust at all. kairos.krs is
// the whole command, with the standard library carried in it.
import "cli.krs"

var prog_args: List[str] = []
for i in 2..len(args()) { prog_args.push(args()[i]) }
let none: Map[str, str] = [:]
let code = cli_file(cli_checker(args()[0], none), args()[1], prog_args, true)
if code != 0 { exit(code) }
