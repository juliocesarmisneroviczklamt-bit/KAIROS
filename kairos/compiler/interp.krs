// The interpreter written in Kairós (M15). It runs the HIR the front end in Kairós makes
// (front.krs), as the interpreter written in Rust (src/interp.rs) runs its own: the same output,
// the same runtime errors with the same messages, the same numbers.
//
// A value is a struct, not an enum: a list, a map or a struct in a variable then changes in place
// (`f[s].xs[i] = v`, an `inout` argument moves it), copied first only when another value shares
// it, which is the language's own value semantics.
import "front.krs"
import "rt.krs"
import "rt_b3.krs"

// A value of the program. `k`: 0 (), 1 i64 (n), 2 f64 (x), 3 bool (n: 1 true), 4 str (s), 5 a list
// (xs), 6 a tuple (xs), 7 a struct (n: which, xs: its fields), 8 an enum (n: which, m: the variant,
// xs: what it holds), 9 a function (n: 0 named, 1 a lambda, 2 grad, 3 value_and_grad; m: the
// function, the lambda, or the argument differentiated; xs: what a lambda captured, or grad's
// function; x: its identity), 10 a map (m: 1 when its keys are i64; e.mp: the values by the text of
// their keys, in order), 11 Bytes (e.by), 12 a tensor (e.t), 13 a holdout (n: the protocol), 14 a
// node of grad's tape (n), 15 a t3 (n: -1, 0 or 1; M18)
struct KV {
    k: i64,
    n: i64,
    m: i64,
    x: f64,
    s: str,
    xs: List[KV],
    e: KE,
}

// what few values have (the others share one empty)
struct KE {
    mp: Map[str, KV],
    by: Bytes,
    t: RtT,
}

// A step from a variable to a place: 0 a field (i), 1 an index of a list or a key of a map (key).
struct KStep {
    k: i64,
    i: i64,
    key: KV,
    at: H,
}

// The interpreter: the checked program, where the program is (ctl: 0 on, 1 returning, 2 breaking,
// 3 continuing, 4 stopped by a runtime error, which is code, msg, hint and the place), how deep.
struct KSt {
    ck: Checker,
    srcs: List[str],
    args: List[str],
    ctl: i64,
    ret: KV,
    code: str,
    msg: str,
    hint: str,
    lo: i64,
    hi: i64,
    file: i64,
    depth: i64,
    uid: i64,
    e0: KE,
    no: List[KV],
    unit: KV,
    tape: RtDTape,
    tracking: bool,
    prog: str,          // the program's name (its file, without .krs): the registry's and the ledger's
    b3: B3State,        // the bridge to the lab (rt_b3.krs), made at the first `b3` call
    b3_ready: bool,
}

fn ki_new(ck: Checker, srcs: List[str], prog_args: List[str]) -> KSt {
    let e0 = KE { mp: [:], by: bytes(), t: RtT { axes: [], shape: [], data: [], boolean: false, trit: false } }
    let no: List[KV] = []
    let unit = KV { k: 0, n: 0, m: 0, x: 0.0, s: "", xs: no, e: e0 }
    KSt { ck: ck, srcs: srcs, args: prog_args, ctl: 0, ret: unit, code: "", msg: "", hint: "", lo: 0, hi: 0, file: 0,
        depth: 0, uid: 0, e0: e0, no: no, unit: unit, tape: rt_d_new(), tracking: false,
        prog: "", b3: rt_b3_new("", [], ""), b3_ready: false }
}

// ------------------------------------------------------------------ values

fn kv_i(st: KSt, n: i64) -> KV {
    KV { k: 1, n: n, m: 0, x: 0.0, s: "", xs: st.no, e: st.e0 }
}

fn kv_f(st: KSt, x: f64) -> KV {
    KV { k: 2, n: 0, m: 0, x: x, s: "", xs: st.no, e: st.e0 }
}

fn kv_b(st: KSt, b: bool) -> KV {
    KV { k: 3, n: if b { 1 } else { 0 }, m: 0, x: 0.0, s: "", xs: st.no, e: st.e0 }
}

fn kv_trit(st: KSt, n: i64) -> KV {
    KV { k: 15, n: n, m: 0, x: 0.0, s: "", xs: st.no, e: st.e0 }
}

fn kv_s(st: KSt, s: str) -> KV {
    KV { k: 4, n: 0, m: 0, x: 0.0, s: s, xs: st.no, e: st.e0 }
}

// a list (5), a tuple (6)
fn kv_l(st: KSt, k: i64, xs: List[KV]) -> KV {
    KV { k: k, n: 0, m: 0, x: 0.0, s: "", xs: xs, e: st.e0 }
}

fn kv_str_list(st: KSt, ss: List[str]) -> KV {
    var xs: List[KV] = []
    for s in ss { xs.push(kv_s(st, s)) }
    kv_l(st, 5, xs)
}

fn kv_fn(inout st: KSt, kind: i64, id: i64, caps: List[KV]) -> KV {
    st.uid += 1
    KV { k: 9, n: kind, m: id, x: float(st.uid), s: "", xs: caps, e: st.e0 }
}

fn kv_map(st: KSt, int_keys: bool) -> KV {
    let mp: Map[str, KV] = [:]
    KV { k: 10, n: 0, m: if int_keys { 1 } else { 0 }, x: 0.0, s: "", xs: st.no, e: KE { mp: mp, by: st.e0.by, t: st.e0.t } }
}

// the text a map keeps a key by
fn ki_key(v: KV) -> str {
    if v.k == 1 { str(v.n) } else { v.s }
}

// a key of a map back from its text
fn ki_unkey(st: KSt, m: KV, key: str) -> KV {
    if m.m == 1 { kv_i(st, parse_int(key)) } else { kv_s(st, key) }
}

// A frame of n variables, each ().
fn ki_frame(st: KSt, n: i64) -> List[KV] {
    var f: List[KV] = []
    for i in 0..n { f.push(st.unit) }
    f
}

// ------------------------------------------------------------------ errors

// The program stops with a runtime error at `at` (the first one stays).
fn ki_fail(inout st: KSt, at: H, code: str, msg: str, hint: str) -> KV {
    if st.ctl != 4 {
        st.ctl = 4
        st.code = code
        st.msg = msg
        st.hint = hint
        st.lo = at.lo
        st.hi = at.hi
        st.file = at.f
    }
    st.unit
}

fn ki_overflow(inout st: KSt, at: H) -> KV {
    ki_fail(inout st, at, "R0006", "integer overflow", "i64 arithmetic is checked; use f64 for very large values")
}

// The error as `kairos` writes it.
fn ki_render(st: KSt) -> str {
    let f = if st.file >= 0 and st.file < len(st.srcs) { st.file } else { 0 }
    render_diag(st.code, st.msg, st.hint, st.srcs[f], st.ck.files[f], st.lo, st.hi)
}

// ------------------------------------------------------------------ text

// a string as Rust's {:?} writes it
fn ki_debug_str(s: str) -> str {
    let d = str([s])
    substr(d, 1, len(d) - 2)
}

fn ki_show_key(v: KV) -> str {
    if v.k == 4 { ki_debug_str(v.s) } else { str(v.n) }
}

// The text of a value, as the interpreter's `display`: texts quoted when they are inside another
// value (`top` false).
fn ki_show(st: KSt, v: KV, top: bool) -> str {
    let k = v.k
    if k == 1 or k == 15 { return str(v.n) }
    if k == 2 { return str(v.x) }
    if k == 4 { return if top { v.s } else { ki_debug_str(v.s) } }
    if k == 3 { return if v.n == 1 { "true" } else { "false" } }
    if k == 0 { return "()" }
    if k == 5 { return "[" + ki_show_all(st, v.xs) + "]" }
    if k == 6 { return if len(v.xs) == 1 { "(" + ki_show_all(st, v.xs) + ",)" } else { "(" + ki_show_all(st, v.xs) + ")" } }
    if k == 7 {
        let def = st.ck.structs[v.n]
        var parts: List[str] = []
        for i in 0..len(def.fields) { parts.push(def.fields[i].0 + ": " + ki_show(st, v.xs[i], false)) }
        return def.name + " { " + join(parts, ", ") + " }"
    }
    if k == 8 {
        let name = st.ck.enums[v.n].variants[v.m].0
        return if len(v.xs) == 0 { name } else { name + "(" + ki_show_all(st, v.xs) + ")" }
    }
    if k == 10 {
        if len(v.e.mp) == 0 { return "[:]" }
        var parts: List[str] = []
        for key in keys(v.e.mp) { parts.push(ki_show(st, ki_unkey(st, v, key), false) + ": " + ki_show(st, v.e.mp[key], false)) }
        return "[" + join(parts, ", ") + "]"
    }
    if k == 9 {
        if v.n == 0 { return "<fn " + st.ck.sigs[v.m].name + ">" }
        if v.n == 1 { return "<closure>" }
        return if v.n == 3 { "<value_and_grad>" } else { "<grad>" }
    }
    if k == 11 { return "<" + str(len(v.e.by)) + " bytes>" }
    if k == 12 { return rt_t_show(v.e.t, ki_axis_names(st)) }
    if k == 14 { return ki_show(st, ki_fwd(st, v), top) }
    if k == 13 { return "<holdout of protocol " + ki_debug_str(st.ck.protocols[v.n].name) + ">" }
    "<value>"
}

fn ki_show_all(st: KSt, xs: List[KV]) -> str {
    var parts: List[str] = []
    for x in xs { parts.push(ki_show(st, x, false)) }
    join(parts, ", ")
}

// ------------------------------------------------------------------ equality and order

fn ki_eq(a: KV, b: KV) -> bool {
    if a.k != b.k { return false }
    let k = a.k
    if k == 1 or k == 3 or k == 13 or k == 14 or k == 15 { return a.n == b.n }
    if k == 2 { return a.x == b.x }
    if k == 4 { return a.s == b.s }
    if k == 0 { return true }
    if k == 5 or k == 6 or k == 7 or k == 8 {
        if a.n != b.n or a.m != b.m or len(a.xs) != len(b.xs) { return false }
        for i in 0..len(a.xs) {
            if not ki_eq(a.xs[i], b.xs[i]) { return false }
        }
        return true
    }
    if k == 9 { return a.x == b.x }
    if k == 10 {
        if len(a.e.mp) != len(b.e.mp) { return false }
        for key in keys(a.e.mp) {
            if not contains(b.e.mp, key) { return false }
            if not ki_eq(a.e.mp[key], b.e.mp[key]) { return false }
        }
        return true
    }
    if k == 11 { return a.e.by == b.e.by }
    if k == 12 {
        let x = a.e.t
        let y = b.e.t
        if x.boolean != y.boolean or x.axes != y.axes or x.shape != y.shape or len(x.data) != len(y.data) { return false }
        for i in 0..len(x.data) {
            if x.data[i] != y.data[i] { return false }
        }
        return true
    }
    false
}

// f64::total_cmp: the bits as a signed integer, the negative ones turned around
fn ki_total_bits(x: f64) -> i64 {
    let b = to_bits(x)
    if b < 0 { bit_xor(b, 9223372036854775807) } else { b }
}

// The order of `sort` (src/value.rs total_cmp): -1, 0 or 1.
fn ki_cmp(a: KV, b: KV) -> i64 {
    if (a.k == 1 and b.k == 1) or (a.k == 15 and b.k == 15) { return if a.n < b.n { -1 } else if a.n > b.n { 1 } else { 0 } }
    if a.k == 2 and b.k == 2 {
        let x = ki_total_bits(a.x)
        let y = ki_total_bits(b.x)
        return if x < y { -1 } else if x > y { 1 } else { 0 }
    }
    if a.k == 3 and b.k == 3 { return if a.n < b.n { -1 } else if a.n > b.n { 1 } else { 0 } }
    if a.k == 4 and b.k == 4 { return if a.s < b.s { -1 } else if a.s > b.s { 1 } else { 0 } }
    if (a.k == 5 and b.k == 5) or (a.k == 6 and b.k == 6) {
        let n = min(len(a.xs), len(b.xs))
        for i in 0..n {
            let c = ki_cmp(a.xs[i], b.xs[i])
            if c != 0 { return c }
        }
        return if len(a.xs) < len(b.xs) { -1 } else if len(a.xs) > len(b.xs) { 1 } else { 0 }
    }
    0
}

// A stable sort (merge sort): the order Rust's sort_by gives.
fn ki_sort(xs: List[KV]) -> List[KV] {
    let n = len(xs)
    if n < 2 { return xs }
    var a = xs
    var b = xs
    var w = 1
    while w < n {
        var i = 0
        while i < n {
            let mid = min(i + w, n)
            let hi = min(i + 2 * w, n)
            var p = i
            var q = mid
            var o = i
            while p < mid and q < hi {
                if ki_cmp(a[q], a[p]) < 0 {
                    b[o] = a[q]
                    q += 1
                } else {
                    b[o] = a[p]
                    p += 1
                }
                o += 1
            }
            while p < mid {
                b[o] = a[p]
                p += 1
                o += 1
            }
            while q < hi {
                b[o] = a[q]
                q += 1
                o += 1
            }
            i += 2 * w
        }
        let t = a
        a = b
        b = t
        w *= 2
    }
    a
}

// ------------------------------------------------------------------ integers, checked

fn ki_add_ok(a: i64, b: i64) -> bool {
    let r = wrapping_add(a, b)
    bit_and(bit_xor(a, r), bit_xor(b, r)) >= 0
}

fn ki_sub_ok(a: i64, b: i64) -> bool {
    let r = wrapping_add(a, wrapping_mul(b, -1))
    bit_and(bit_xor(a, b), bit_xor(a, r)) >= 0
}

fn ki_mul_ok(a: i64, b: i64) -> bool {
    if a == 0 or b == 0 { return true }
    if a == -1 { return b != -9223372036854775807 - 1 }
    if b == -1 { return a != -9223372036854775807 - 1 }
    wrapping_mul(a, b) / a == b
}

// i64::checked_pow (its loop, so it overflows where Rust's does): (fits, value)
fn ki_pow(x: i64, e: i64) -> (bool, i64) {
    if e == 0 { return (true, 1) }
    var base = x
    var acc = 1
    var ex = e
    while true {
        if ex % 2 == 1 {
            if not ki_mul_ok(acc, base) { return (false, 0) }
            acc = acc * base
            if ex == 1 { return (true, acc) }
        }
        ex = ex / 2
        if not ki_mul_ok(base, base) { return (false, 0) }
        base = base * base
    }
    (true, acc)
}

// ------------------------------------------------------------------ operators

fn ki_bin(inout st: KSt, op: str, a: KV, b: KV, at: H) -> KV {
    if (a.k == 6 or a.k == 7 or b.k == 6 or b.k == 7) and contains(["+", "-", "*", "/", "^", "%"], op) { return ki_bin_fields(inout st, op, a, b, at) }
    if a.k == 14 or b.k == 14 { return ki_bin_diff(inout st, op, a, b, at) }
    if a.k == 12 or b.k == 12 { return ki_tbin(inout st, op, a, b, at) }
    if a.k == 1 and b.k == 1 {
        let x = a.n
        let y = b.n
        if op == "+" {
            if not ki_add_ok(x, y) { return ki_overflow(inout st, at) }
            return kv_i(st, x + y)
        }
        if op == "-" {
            if not ki_sub_ok(x, y) { return ki_overflow(inout st, at) }
            return kv_i(st, x - y)
        }
        if op == "*" {
            if not ki_mul_ok(x, y) { return ki_overflow(inout st, at) }
            return kv_i(st, x * y)
        }
        if op == "/" or op == "%" {
            if y == 0 { return ki_fail(inout st, at, "R0002", "division by zero", "") }
            if y == -1 and x == -9223372036854775807 - 1 { return ki_overflow(inout st, at) }
            return kv_i(st, if op == "/" { x / y } else { x % y })
        }
        if op == "^" {
            if y < 0 { return ki_fail(inout st, at, "R0007", "negative exponent in integer power", "use floats: `float(x) ^ float(y)`") }
            if y > 4294967295 { return ki_overflow(inout st, at) }
            let r = ki_pow(x, y)
            if not r.0 { return ki_overflow(inout st, at) }
            return kv_i(st, r.1)
        }
        if op == "==" { return kv_b(st, x == y) }
        if op == "!=" { return kv_b(st, x != y) }
        if op == "<" { return kv_b(st, x < y) }
        if op == ">" { return kv_b(st, x > y) }
        if op == "<=" { return kv_b(st, x <= y) }
        if op == ">=" { return kv_b(st, x >= y) }
    }
    if a.k == 2 and b.k == 2 {
        let x = a.x
        let y = b.x
        if op == "+" { return kv_f(st, x + y) }
        if op == "-" { return kv_f(st, x - y) }
        if op == "*" { return kv_f(st, x * y) }
        if op == "/" { return kv_f(st, x / y) }
        if op == "%" { return kv_f(st, x % y) }
        if op == "^" { return kv_f(st, x ^ y) }
        if op == "==" { return kv_b(st, x == y) }
        if op == "!=" { return kv_b(st, x != y) }
        if op == "<" { return kv_b(st, x < y) }
        if op == ">" { return kv_b(st, x > y) }
        if op == "<=" { return kv_b(st, x <= y) }
        if op == ">=" { return kv_b(st, x >= y) }
    }
    if a.k == 4 and b.k == 4 {
        if op == "+" { return kv_s(st, a.s + b.s) }
        if op == "<" { return kv_b(st, a.s < b.s) }
        if op == ">" { return kv_b(st, a.s > b.s) }
        if op == "<=" { return kv_b(st, a.s <= b.s) }
        if op == ">=" { return kv_b(st, a.s >= b.s) }
    }
    if op == "==" { return kv_b(st, ki_eq(a, b)) }
    if op == "!=" { return kv_b(st, not ki_eq(a, b)) }
    ki_fail(inout st, at, "K0001", "`" + op + "` on these values is not in the interpreter written in Kairós yet", "")
}

// ------------------------------------------------------------------ places

// The variable a place starts at; its steps (the indexes and keys evaluated now, in order) go to
// `steps`.
fn ki_place(inout st: KSt, inout f: List[KV], p: H, inout steps: List[KStep]) -> i64 {
    if p.kind == "plocal" { return p.n }
    let root = ki_place(inout st, inout f, p.kids[0], inout steps)
    if st.ctl != 0 { return root }
    if p.kind == "pfield" {
        steps.push(KStep { k: 0, i: p.n, key: st.unit, at: p })
        return root
    }
    let iv = ki_ev(inout st, inout f, p.kids[1])
    if st.ctl != 0 { return root }
    steps.push(KStep { k: 1, i: iv.n, key: iv, at: p })
    root
}

// Walks a place's steps from `v` and does `op` with what is there: 0 puts `arg` (an assignment: a
// missing key of a map at the end is added), 1 reads it, 2 takes it out (() is left), 3 pushes
// `arg`, 4 pops, 5 sorts, 6 reverses, 7 removes the key `arg` of a map, 8 puts `arg` back quietly
// (after an `inout` call: no error).
fn ki_at(inout st: KSt, inout v: KV, steps: List[KStep], k: i64, op: i64, arg: KV, at: H) -> KV {
    if k < len(steps) {
        let s = steps[k]
        if s.k == 0 { return ki_at(inout st, inout v.xs[s.i], steps, k + 1, op, arg, at) }
        if v.k == 10 {
            let key = ki_key(s.key)
            if not contains(v.e.mp, key) {
                if op == 8 { return st.unit }
                if op != 0 or k != len(steps) - 1 { return ki_fail(inout st, s.at, "R0012", "no key " + ki_show_key(s.key) + " in the map", "") }
                if len(v.e.mp) == 0 and s.key.k == 1 { v.m = 1 }
                v.e.mp[key] = st.unit
            }
            return ki_at(inout st, inout v.e.mp[key], steps, k + 1, op, arg, at)
        }
        let i = s.key.n
        let n = len(v.xs)
        if i < 0 or i >= n {
            if op == 8 { return st.unit }
            return ki_fail(inout st, s.at, "R0001", "index " + str(i) + " out of bounds for a list of length " + str(n), "")
        }
        return ki_at(inout st, inout v.xs[i], steps, k + 1, op, arg, at)
    }
    if op == 0 or op == 8 {
        v = arg
        return st.unit
    }
    if op == 1 { return v }
    if op == 2 {
        let old = v
        v = st.unit
        return old
    }
    if op == 3 {
        v.xs.push(arg)
        return st.unit
    }
    if op == 4 {
        if len(v.xs) == 0 { return ki_fail(inout st, at, "R0004", "`pop` from an empty list", "") }
        return v.xs.pop()
    }
    if op == 5 {
        v.xs = ki_sort(v.xs)
        return st.unit
    }
    if op == 6 {
        var r: List[KV] = []
        var i = len(v.xs) - 1
        while i >= 0 {
            r.push(v.xs[i])
            i -= 1
        }
        v.xs = r
        return st.unit
    }
    if op == 7 {
        remove(inout v.e.mp, ki_key(arg))
        return st.unit
    }
    if op >= 10 and op <= 12 {
        // the unsigned ones in their range (R0014)
        let n = arg.n
        let what = if op == 10 { "u8" } else if op == 11 { "u32" } else { "u64" }
        let top = if op == 10 { 255 } else if op == 11 { 4294967295 } else { 9223372036854775807 }
        if n < 0 or n > top { return ki_fail(inout st, at, "R0014", str(n) + " does not fit in " + what, "") }
        if op == 10 { put_u8(inout v.e.by, n) } else if op == 11 { put_u32(inout v.e.by, n) } else { put_u64(inout v.e.by, n) }
        return st.unit
    }
    if op == 13 { put_i64(inout v.e.by, arg.n) }
    if op == 14 { put_f64(inout v.e.by, arg.x) }
    if op == 15 { put_f32(inout v.e.by, arg.x) }
    if op == 16 { put_str(inout v.e.by, arg.s) }
    st.unit
}

// ------------------------------------------------------------------ patterns

// A literal of the HIR as a value.
fn ki_lit(st: KSt, t: str) -> KV {
    if starts_with(t, "i64 ") { return kv_i(st, parse_int(substr(t, 4, len(t)))) }
    if starts_with(t, "f64 ") { return kv_f(st, parse_float(substr(t, 4, len(t)))) }
    if t == "bool true" { return kv_b(st, true) }
    if t == "bool false" { return kv_b(st, false) }
    if starts_with(t, "str ") { return kv_s(st, unhex(substr(t, 4, len(t)))) }
    st.unit
}

// Does v match the pattern? What it binds goes to the frame (as the interpreter's matches_pat).
fn ki_pat(st: KSt, inout f: List[KV], p: H, v: KV) -> bool {
    let k = p.kind
    if k == "pbind" {
        f[p.n] = v
        return true
    }
    if k == "pwild" { return true }
    if k == "ptuple" {
        if v.k != 6 { return false }
        for i in 0..len(p.kids) {
            if i >= len(v.xs) { return true }
            if not ki_pat(st, inout f, p.kids[i], v.xs[i]) { return false }
        }
        return true
    }
    if k == "pvariant" {
        if v.k != 8 or v.m != p.m { return false }
        for i in 0..len(p.kids) {
            if i >= len(v.xs) { return true }
            if not ki_pat(st, inout f, p.kids[i], v.xs[i]) { return false }
        }
        return true
    }
    if k == "plit" { return ki_eq(ki_lit(st, p.text), v) }
    false
}

// ------------------------------------------------------------------ calls

fn ki_enter(inout st: KSt, inout fr: List[KV], body: H, at: H) -> KV {
    if st.depth >= 20000 { return ki_fail(inout st, at, "R0005", "stack overflow: too many nested calls", "") }
    st.depth += 1
    var r = ki_ev(inout st, inout fr, body)
    st.depth -= 1
    if st.ctl == 1 {
        st.ctl = 0
        r = st.ret
    }
    r
}

// f(a, inout b): the values first (they may read a variable passed as `inout`), then the `inout`
// places moved into the call, and back after it.
fn ki_call(inout st: KSt, inout f: List[KV], e: H) -> KV {
    let id = e.n
    var fr = ki_frame(st, len(st.ck.bodies[id]))
    for i in 0..len(e.kids) {
        let a = e.kids[i]
        if a.kind == "val" {
            fr[i] = ki_ev(inout st, inout f, a.kids[0])
            if st.ctl != 0 { return st.unit }
        }
    }
    var backs: List[(i64, i64, List[KStep])] = []
    for i in 0..len(e.kids) {
        let a = e.kids[i]
        if a.kind == "inout" {
            var steps: List[KStep] = []
            let root = ki_place(inout st, inout f, a.kids[0], inout steps)
            if st.ctl == 0 {
                let v = ki_at(inout st, inout f[root], steps, 0, 2, st.unit, e)
                if st.ctl == 0 {
                    fr[i] = v
                    backs.push((i, root, steps))
                }
            }
            if st.ctl != 0 {
                for bk in backs { let _ = ki_at(inout st, inout f[bk.1], bk.2, 0, 8, fr[bk.0], e) }
                return st.unit
            }
        }
    }
    let r = ki_enter(inout st, inout fr, st.ck.fn_hir[id], e)
    for bk in backs { let _ = ki_at(inout st, inout f[bk.1], bk.2, 0, 8, fr[bk.0], e) }
    r
}

fn ki_call_value(inout st: KSt, fv: KV, vs: List[KV], at: H) -> KV {
    if fv.n == 0 {
        var fr = ki_frame(st, len(st.ck.bodies[fv.m]))
        for i in 0..len(vs) { fr[i] = vs[i] }
        return ki_enter(inout st, inout fr, st.ck.fn_hir[fv.m], at)
    }
    if fv.n == 1 {
        let lb = st.ck.lambdas[fv.m]
        var fr = ki_frame(st, lb.n_slots)
        for i in 0..len(vs) { fr[i] = vs[i] }
        for j in 0..len(lb.caps) { fr[lb.caps[j]] = fv.xs[j] }
        return ki_enter(inout st, inout fr, lb.body, at)
    }
    ki_run_grad(inout st, fv, vs, at)
}

// ------------------------------------------------------------------ the evaluator

// The loop's body ran: false to leave the loop (break, return, an error).
fn ki_loop_on(inout st: KSt) -> bool {
    if st.ctl == 0 { return true }
    if st.ctl == 3 {
        st.ctl = 0
        return true
    }
    if st.ctl == 2 { st.ctl = 0 }
    false
}

fn ki_ev(inout st: KSt, inout f: List[KV], e: H) -> KV {
    let k = e.kind
    if k == "local" { return f[e.n] }
    if k == "lit" { return ki_lit(st, e.text) }
    if k == "binary" {
        let a = ki_ev(inout st, inout f, e.kids[0])
        if st.ctl != 0 { return st.unit }
        let b = ki_ev(inout st, inout f, e.kids[1])
        if st.ctl != 0 { return st.unit }
        return ki_bin(inout st, e.text, a, b, e)
    }
    if k == "call" { return ki_call(inout st, inout f, e) }
    if k == "builtin" { return ki_builtin(inout st, inout f, e) }
    if k == "block" {
        let n = len(e.kids)
        for i in 0..n - 1 {
            let _ = ki_ev(inout st, inout f, e.kids[i])
            if st.ctl != 0 { return st.unit }
        }
        if e.kids[n - 1].kind == "-" { return st.unit }
        return ki_ev(inout st, inout f, e.kids[n - 1])
    }
    if k == "if" {
        let c = ki_ev(inout st, inout f, e.kids[0])
        if st.ctl != 0 { return st.unit }
        if c.n == 1 { return ki_ev(inout st, inout f, e.kids[1]) }
        if e.kids[2].kind == "-" { return st.unit }
        return ki_ev(inout st, inout f, e.kids[2])
    }
    if k == "field" {
        let v = ki_ev(inout st, inout f, e.kids[0])
        if st.ctl != 0 { return st.unit }
        return v.xs[e.n]
    }
    if k == "index" {
        let o = ki_ev(inout st, inout f, e.kids[0])
        if st.ctl != 0 { return st.unit }
        let iv = ki_ev(inout st, inout f, e.kids[1])
        if st.ctl != 0 { return st.unit }
        if o.k == 10 {
            let key = ki_key(iv)
            if not contains(o.e.mp, key) { return ki_fail(inout st, e, "R0012", "no key " + ki_show_key(iv) + " in the map", "") }
            return o.e.mp[key]
        }
        let i = iv.n
        if i < 0 or i >= len(o.xs) { return ki_fail(inout st, e, "R0001", "index " + str(i) + " out of bounds for a list of length " + str(len(o.xs)), "") }
        return o.xs[i]
    }
    if k == "assign" {
        let v = ki_ev(inout st, inout f, e.kids[1])
        if st.ctl != 0 { return st.unit }
        let p = e.kids[0]
        if p.kind == "plocal" {
            f[p.n] = v
            return st.unit
        }
        var steps: List[KStep] = []
        let root = ki_place(inout st, inout f, p, inout steps)
        if st.ctl != 0 { return st.unit }
        return ki_at(inout st, inout f[root], steps, 0, 0, v, e)
    }
    if k == "opassign" {
        let rhs = ki_ev(inout st, inout f, e.kids[1])
        if st.ctl != 0 { return st.unit }
        var steps: List[KStep] = []
        let root = ki_place(inout st, inout f, e.kids[0], inout steps)
        if st.ctl != 0 { return st.unit }
        let cur = ki_at(inout st, inout f[root], steps, 0, 1, st.unit, e)
        if st.ctl != 0 { return st.unit }
        let nv = ki_bin(inout st, e.text, cur, rhs, e)
        if st.ctl != 0 { return st.unit }
        return ki_at(inout st, inout f[root], steps, 0, 0, nv, e)
    }
    if k == "let" {
        let v = ki_ev(inout st, inout f, e.kids[1])
        if st.ctl != 0 { return st.unit }
        let _ = ki_pat(st, inout f, e.kids[0], v)
        return st.unit
    }
    if k == "and" or k == "or" {
        let a = ki_ev(inout st, inout f, e.kids[0])
        if st.ctl != 0 { return st.unit }
        if (a.n == 1) == (k == "or") { return a }
        return ki_ev(inout st, inout f, e.kids[1])
    }
    if k == "unary" {
        let x = ki_ev(inout st, inout f, e.kids[0])
        if st.ctl != 0 { return st.unit }
        if e.text == "not" {
            if x.k == 12 { return kv_t(st, rt_t_map1(1, x.e.t)) }
            return kv_b(st, x.n != 1)
        }
        if x.k == 12 or x.k == 6 or x.k == 7 or x.k == 14 { return ki_neg(inout st, x, e) }
        if x.k == 1 {
            if x.n == -9223372036854775807 - 1 { return ki_overflow(inout st, e) }
            return kv_i(st, -x.n)
        }
        if x.k == 2 { return kv_f(st, -x.x) }
        if x.k == 15 { return kv_trit(st, -x.n) }
        return ki_fail(inout st, e, "K0001", "`-` on this value is not in the interpreter written in Kairós yet", "")
    }
    if k == "while" {
        while true {
            let c = ki_ev(inout st, inout f, e.kids[0])
            if st.ctl != 0 { return st.unit }
            if c.n != 1 { break }
            let _ = ki_ev(inout st, inout f, e.kids[1])
            if not ki_loop_on(inout st) { break }
        }
        return st.unit
    }
    if k == "forrange" {
        let lo = ki_ev(inout st, inout f, e.kids[0])
        if st.ctl != 0 { return st.unit }
        let hi = ki_ev(inout st, inout f, e.kids[1])
        if st.ctl != 0 { return st.unit }
        var i = lo.n
        let top = hi.n
        while (e.m == 1 and i <= top) or (e.m != 1 and i < top) {
            f[e.n] = kv_i(st, i)
            let _ = ki_ev(inout st, inout f, e.kids[2])
            if not ki_loop_on(inout st) { break }
            if i == 9223372036854775807 { break }
            i += 1
        }
        return st.unit
    }
    if k == "forlist" {
        let xs = ki_ev(inout st, inout f, e.kids[1])
        if st.ctl != 0 { return st.unit }
        for x in xs.xs {
            let _ = ki_pat(st, inout f, e.kids[0], x)
            let _ = ki_ev(inout st, inout f, e.kids[2])
            if not ki_loop_on(inout st) { break }
        }
        return st.unit
    }
    if k == "match" {
        let v = ki_ev(inout st, inout f, e.kids[0])
        if st.ctl != 0 { return st.unit }
        for i in 1..len(e.kids) {
            let arm = e.kids[i]
            if ki_pat(st, inout f, arm.kids[0], v) { return ki_ev(inout st, inout f, arm.kids[1]) }
        }
        return ki_fail(inout st, e, "R0008", "no match arm matched", "")
    }
    if k == "return" {
        var v = st.unit
        if e.kids[0].kind != "-" {
            v = ki_ev(inout st, inout f, e.kids[0])
            if st.ctl != 0 { return st.unit }
        }
        st.ret = v
        st.ctl = 1
        return st.unit
    }
    if k == "break" {
        st.ctl = 2
        return st.unit
    }
    if k == "continue" {
        st.ctl = 3
        return st.unit
    }
    if k == "list" or k == "tuple" {
        var xs: List[KV] = []
        for x in e.kids {
            xs.push(ki_ev(inout st, inout f, x))
            if st.ctl != 0 { return st.unit }
        }
        return kv_l(st, if k == "list" { 5 } else { 6 }, xs)
    }
    if k == "struct" or k == "variant" {
        var xs: List[KV] = []
        for x in e.kids {
            xs.push(ki_ev(inout st, inout f, x))
            if st.ctl != 0 { return st.unit }
        }
        var v = kv_l(st, if k == "struct" { 7 } else { 8 }, xs)
        v.n = e.n
        if k == "variant" { v.m = e.m }
        return v
    }
    if k == "map" {
        var int_keys = false
        match e.t {
            TMap(kt, vt) => { int_keys = kt == Ty.TInt },
            _ => {},
        }
        var m = kv_map(st, int_keys)
        var i = 0
        while i + 1 < len(e.kids) {
            let kv = ki_ev(inout st, inout f, e.kids[i])
            if st.ctl != 0 { return st.unit }
            let vv = ki_ev(inout st, inout f, e.kids[i + 1])
            if st.ctl != 0 { return st.unit }
            if kv.k == 1 { m.m = 1 }
            m.e.mp[ki_key(kv)] = vv
            i += 2
        }
        return m
    }
    if k == "fnref" { return kv_fn(inout st, 0, e.n, st.no) }
    if k == "lambda" {
        var caps: List[KV] = []
        if e.text != "" {
            for s in split(e.text, " ") { caps.push(f[parse_int(s)]) }
        }
        return kv_fn(inout st, 1, e.n, caps)
    }
    if k == "callv" {
        let fv = ki_ev(inout st, inout f, e.kids[0])
        if st.ctl != 0 { return st.unit }
        var vs: List[KV] = []
        for i in 1..len(e.kids) {
            vs.push(ki_ev(inout st, inout f, e.kids[i]))
            if st.ctl != 0 { return st.unit }
        }
        return ki_call_value(inout st, fv, vs, e)
    }
    if k == "host" { return ki_host(inout st, inout f, e) }
    if k == "tindex" { return ki_tindex(inout st, inout f, e) }
    if k == "tassign" { return ki_tassign(inout st, inout f, e) }
    if k == "-" { return st.unit }
    ki_fail(inout st, e, "K0001", "`" + k + "` is not in the interpreter written in Kairós yet", "")
}

// ------------------------------------------------------------------ tensors

// A tensor as a value: one with no axes left is a scalar (the interpreter's `wrap`).
fn kv_t(st: KSt, t: RtT) -> KV {
    if len(t.axes) == 0 {
        return if t.boolean { kv_b(st, t.data[0] != 0.0) } else if t.trit { kv_trit(st, int(t.data[0])) } else { kv_f(st, t.data[0]) }
    }
    KV { k: 12, n: 0, m: 0, x: 0.0, s: "", xs: st.no, e: KE { mp: st.e0.mp, by: st.e0.by, t: t } }
}

fn ki_axis_names(st: KSt) -> List[str] {
    var names: List[str] = []
    for a in st.ck.axes { names.push(a.name) }
    names
}

fn ki_axis(st: KSt, a: i64) -> str {
    st.ck.axes[a].name
}

// an operand of an element-wise operation: a tensor, or a scalar repeated everywhere
fn ki_op_t(v: KV) -> RtT {
    if v.k == 12 { return v.e.t }
    if v.k == 3 { return rt_t_scalar(if v.n == 1 { 1.0 } else { 0.0 }, true) }
    if v.k == 15 { return rt_t_trit(float(v.n)) }
    rt_t_scalar(ki_float(v), false)
}

fn ki_size_mismatch(inout st: KSt, at: H, ax: i64, a: i64, b: i64) -> KV {
    ki_fail(inout st, at, "R0201", "size mismatch on axis `" + ki_axis(st, ax) + "`: " + str(a) + " vs " + str(b), "")
}

// The frame of element-wise operands (src/tensor.rs frame): the first one with the most axes;
// every other tensor's axes are its own with the same sizes (R0201).
fn ki_frame_ok(inout st: KSt, ops: List[RtT], at: H) -> bool {
    var bi = -1
    for i in 0..len(ops) {
        if len(ops[i].axes) > 0 and (bi < 0 or len(ops[i].axes) > len(ops[bi].axes)) { bi = i }
    }
    if bi < 0 { return true }
    let b = ops[bi]
    for t in ops {
        for k in 0..len(t.axes) {
            let p = rt_t_pos(b, t.axes[k])
            if p >= 0 and b.shape[p] != t.shape[k] {
                let _ = ki_size_mismatch(inout st, at, t.axes[k], b.shape[p], t.shape[k])
                return false
            }
        }
    }
    true
}

fn ki_op_code(op: str) -> i64 {
    let ops = ["+", "-", "*", "/", "%", "^", "==", "!=", "<", ">", "<=", ">="]
    for i in 0..len(ops) {
        if ops[i] == op { return i }
    }
    -1
}

fn ki_tbin(inout st: KSt, op: str, a: KV, b: KV, at: H) -> KV {
    let ta = ki_op_t(a)
    let tb = ki_op_t(b)
    if not ki_frame_ok(inout st, [ta, tb], at) { return st.unit }
    kv_t(st, rt_t_map2(ki_op_code(op), ta, tb))
}

// a op b with a struct or a tuple: field by field (a value on the other side goes with each)
fn ki_bin_fields(inout st: KSt, op: str, a: KV, b: KV, at: H) -> KV {
    let fa = a.k == 6 or a.k == 7
    let fb = b.k == 6 or b.k == 7
    let n = if fa { len(a.xs) } else { len(b.xs) }
    var xs: List[KV] = []
    for i in 0..n {
        xs.push(ki_bin(inout st, op, if fa { a.xs[i] } else { a }, if fb { b.xs[i] } else { b }, at))
        if st.ctl != 0 { return st.unit }
    }
    var r = if fa { a } else { b }
    r.xs = xs
    r
}

fn ki_neg(inout st: KSt, v: KV, at: H) -> KV {
    if v.k == 14 {
        let r = ki_neg(inout st, ki_fwd(st, v), at)
        return kv_node(st, rt_d_map(inout st.tape, 0, v.n, ki_op_t(r)))
    }
    if v.k == 12 { return kv_t(st, rt_t_map1(0, v.e.t)) }
    if v.k == 6 or v.k == 7 {
        var xs: List[KV] = []
        for x in v.xs {
            xs.push(ki_neg(inout st, x, at))
            if st.ctl != 0 { return st.unit }
        }
        var r = v
        r.xs = xs
        return r
    }
    if v.k == 2 { return kv_f(st, -v.x) }
    if v.n == -9223372036854775807 - 1 { return ki_overflow(inout st, at) }
    kv_i(st, -v.n)
}

// f(x) for a float, a tensor, or a struct or tuple of them (rt_t_fn's codes: 2 abs, 3 sqrt,
// 4 exp, 5 ln, 9 tanh, 10 sigmoid, 11 relu, 12 softplus, 14 the step)
fn ki_map_any(inout st: KSt, code: i64, v: KV, at: H) -> KV {
    if v.k == 14 {
        let r = ki_map_any(inout st, code, ki_fwd(st, v), at)
        return kv_node(st, rt_d_map(inout st.tape, code, v.n, ki_op_t(r)))
    }
    if v.k == 12 { return kv_t(st, rt_t_map1(code, v.e.t)) }
    if v.k == 6 or v.k == 7 {
        var xs: List[KV] = []
        for x in v.xs { xs.push(ki_map_any(inout st, code, x, at)) }
        var r = v
        r.xs = xs
        return r
    }
    kv_f(st, rt_t_fn(code, ki_float(v)))
}

// the zero of the tangent space of v: the same shape, all zeros
fn ki_zero_of(st: KSt, v: KV) -> KV {
    if v.k == 14 { return ki_zero_of(st, ki_fwd(st, v)) }
    if v.k == 2 { return kv_f(st, 0.0) }
    if v.k == 12 { return kv_t(st, rt_t_full(v.e.t.axes, v.e.t.shape, 0.0, false)) }
    if v.k == 5 or v.k == 6 or v.k == 7 {
        var xs: List[KV] = []
        for x in v.xs { xs.push(ki_zero_of(st, x)) }
        var r = v
        r.xs = xs
        return r
    }
    v
}

// The selectors of x[...] (src/interp/tensors.rs eval_sels), in order: (axis, 0 an index / 1 a
// range, lo, hi past the end).
fn ki_sels(inout st: KSt, inout f: List[KV], e: H, first: i64, last: i64) -> List[(i64, i64, i64, i64)] {
    var out: List[(i64, i64, i64, i64)] = []
    for j in first..last {
        let s = e.kids[j]
        if s.kind == "at" {
            let i = ki_ev(inout st, inout f, s.kids[0])
            if st.ctl != 0 { return out }
            out.push((s.n, 0, i.n, wrapping_add(i.n, 1)))
        } else {
            let lo = ki_ev(inout st, inout f, s.kids[0])
            if st.ctl != 0 { return out }
            let hi = ki_ev(inout st, inout f, s.kids[1])
            if st.ctl != 0 { return out }
            var h = hi.n
            if s.m == 1 {
                if h == 9223372036854775807 {
                    let _ = ki_overflow(inout st, e)
                    return out
                }
                h += 1
            }
            out.push((s.n, 1, lo.n, h))
        }
    }
    out
}

// R0001 when a selector leaves the tensor (src/tensor.rs region), in order.
fn ki_sels_ok(inout st: KSt, t: RtT, sels: List[(i64, i64, i64, i64)], at: H) -> bool {
    for s in sels {
        let p = rt_t_pos(t, s.0)
        let n = t.shape[p]
        let name = ki_axis(st, s.0)
        if s.1 == 0 {
            if s.2 < 0 or s.2 >= n {
                let _ = ki_fail(inout st, at, "R0001", "index " + str(s.2) + " out of bounds for axis `" + name + "` of size " + str(n), "")
                return false
            }
        } else {
            if s.3 < s.2 {
                let _ = ki_fail(inout st, at, "R0001", "reversed range " + str(s.2) + ".." + str(s.3) + " on axis `" + name + "`", "")
                return false
            }
            if s.2 < 0 or s.3 > n {
                let bad = if s.2 < 0 { s.2 } else { s.3 - 1 }
                let _ = ki_fail(inout st, at, "R0001", "index " + str(bad) + " out of bounds for axis `" + name + "` of size " + str(n), "")
                return false
            }
        }
    }
    true
}

// x[sels] = v: the selectors, then the sizes of a tensor value over the axes left (R0201).
fn ki_assign_ok(inout st: KSt, t: RtT, sels: List[(i64, i64, i64, i64)], v: KV, at: H) -> bool {
    if not ki_sels_ok(inout st, t, sels, at) { return false }
    if v.k != 12 { return true }
    let r = rt_t_region(t, sels)
    let vt = v.e.t
    for k in 0..len(t.axes) {
        if r.2[k] {
            let p = rt_t_pos(vt, t.axes[k])
            if p >= 0 and vt.shape[p] != r.1[k] {
                let _ = ki_size_mismatch(inout st, at, t.axes[k], r.1[k], vt.shape[p])
                return false
            }
        }
    }
    true
}

fn ki_tindex(inout st: KSt, inout f: List[KV], e: H) -> KV {
    let x = ki_ev(inout st, inout f, e.kids[0])
    if st.ctl != 0 { return st.unit }
    let sels = ki_sels(inout st, inout f, e, 1, len(e.kids))
    if st.ctl != 0 { return st.unit }
    if x.k == 14 { return ki_select_diff(inout st, x, sels, e) }
    if not ki_sels_ok(inout st, x.e.t, sels, e) { return st.unit }
    kv_t(st, rt_t_select(x.e.t, sels))
}

// x[sels] op= v: the value first, then the selectors, then the place; the tensor changes in place.
fn ki_tassign(inout st: KSt, inout f: List[KV], e: H) -> KV {
    let n = len(e.kids)
    let rhs0 = ki_ev(inout st, inout f, e.kids[n - 1])
    if st.ctl != 0 { return st.unit }
    let sels = ki_sels(inout st, inout f, e, 1, n - 1)
    if st.ctl != 0 { return st.unit }
    var steps: List[KStep] = []
    let root = ki_place(inout st, inout f, e.kids[0], inout steps)
    if st.ctl != 0 { return st.unit }
    var tv = ki_at(inout st, inout f[root], steps, 0, 2, st.unit, e)
    if st.ctl != 0 { return st.unit }
    if tv.k == 14 or rhs0.k == 14 {
        // inside `grad`: the assignment is a node of the tape
        var rv = rhs0
        if e.text != "=" {
            var cur = st.unit
            if tv.k == 14 {
                cur = ki_select_diff(inout st, tv, sels, e)
            } else if ki_sels_ok(inout st, tv.e.t, sels, e) {
                cur = kv_t(st, rt_t_select(tv.e.t, sels))
            }
            if st.ctl == 0 { rv = ki_bin(inout st, e.text, cur, rhs0, e) }
        }
        var nv = tv
        if st.ctl == 0 { nv = ki_assign_diff(inout st, tv, sels, rv, e) }
        let _ = ki_at(inout st, inout f[root], steps, 0, 8, if st.ctl == 0 { nv } else { tv }, e)
        return st.unit
    }
    var rhs = rhs0
    if e.text != "=" {
        if ki_sels_ok(inout st, tv.e.t, sels, e) {
            let cur = kv_t(st, rt_t_select(tv.e.t, sels))
            rhs = ki_bin(inout st, e.text, cur, rhs0, e)
        }
    }
    if st.ctl == 0 and ki_assign_ok(inout st, tv.e.t, sels, rhs, e) {
        rt_t_assign(inout tv.e.t, sels, ki_op_t(rhs))
    }
    let _ = ki_at(inout st, inout f[root], steps, 0, 8, tv, e)
    st.unit
}

// the sizes of zeros/ones/full/randn: (axes, shape) from (axis, size) pairs, or an error
fn ki_dims(inout st: KSt, vs: List[KV], from: i64, randn: bool, at: H) -> (bool, List[i64], List[i64]) {
    var axes: List[i64] = []
    var shape: List[i64] = []
    var i = from
    while i + 1 < len(vs) {
        let a = vs[i].n
        let n = vs[i + 1].n
        if n < 0 {
            let msg = if randn { "invalid size " + str(n) + " for axis `" + ki_axis(st, a) + "`" } else { "negative size " + str(n) + " for axis `" + ki_axis(st, a) + "`" }
            let _ = ki_fail(inout st, at, "R0203", msg, "")
            return (false, axes, shape)
        }
        axes.push(a)
        shape.push(n)
        i += 2
    }
    if randn {
        if rt_t_too_large(shape) {
            let _ = ki_fail(inout st, at, "R0203", "tensor too large", "")
            return (false, axes, shape)
        }
        return (true, axes, shape)
    }
    // at most 2^28 values, the first axis that goes past it is named
    var total = 1
    for k in 0..len(shape) {
        let sz = shape[k]
        if sz != 0 and total > 268435456 / sz {
            let _ = ki_fail(inout st, at, "R0203", "tensor too large (axis `" + ki_axis(st, axes[k]) + "` of size " + str(sz) + ")", "")
            return (false, axes, shape)
        }
        total = total * sz
    }
    (true, axes, shape)
}

fn ki_red_kind(b: str) -> i64 {
    let names = ["sum", "mean", "prod", "max", "min", "nan_sum", "nan_mean", "nan_prod", "nan_count", "count"]
    for i in 0..len(names) {
        if names[i] == b { return i }
    }
    -1
}

// The builtins of tensors and of the AI engine (src/interp/tensors.rs, diff.rs): (handled, value).
fn ki_tensor_builtin(inout st: KSt, b: str, vs: List[KV], at: H) -> (bool, KV) {
    let n = len(vs)
    let t0 = n > 0 and vs[0].k == 12
    var any_t = false
    for v in vs {
        if v.k == 12 { any_t = true }
    }
    // reductions: [tensor, axis or -1]
    let rk = ki_red_kind(b)
    if rk >= 0 and t0 and n == 2 and vs[1].k == 1 { return (true, kv_t(st, rt_t_reduce(vs[0].e.t, vs[1].n, rk))) }
    if (b == "max" or b == "min") and any_t {
        let ta = ki_op_t(vs[0])
        let tb = ki_op_t(vs[1])
        if not ki_frame_ok(inout st, [ta, tb], at) { return (true, st.unit) }
        return (true, kv_t(st, rt_t_map2(if b == "max" { 14 } else { 15 }, ta, tb)))
    }
    if any_t and n == 1 {
        let maps = ["abs", "sqrt", "exp", "ln", "floor", "ceil", "round", "is_nan"]
        let codes_ = [2, 3, 4, 5, 6, 7, 8, 13]
        for i in 0..len(maps) {
            if b == maps[i] { return (true, kv_t(st, rt_t_map1(codes_[i], vs[0].e.t))) }
        }
    }
    if b == "fill_nan" {
        if t0 { return (true, kv_t(st, rt_t_fill_nan(vs[0].e.t, vs[1].x))) }
        return (true, kv_f(st, if is_nan(vs[0].x) { vs[1].x } else { vs[0].x }))
    }
    if b == "where" {
        if not any_t { return (true, if vs[0].n == 1 { vs[1] } else { vs[2] }) }
        let tc = ki_op_t(vs[0])
        let ta = ki_op_t(vs[1])
        let tb = ki_op_t(vs[2])
        if not ki_frame_ok(inout st, [tc, ta, tb], at) { return (true, st.unit) }
        return (true, kv_t(st, rt_t_where(tc, ta, tb)))
    }
    if b == "size" { return (true, kv_i(st, rt_t_size(vs[0].e.t, vs[1].n))) }
    if b == "zeros" or b == "ones" or b == "full" {
        let fill = if b == "zeros" { kv_f(st, 0.0) } else if b == "ones" { kv_f(st, 1.0) } else { vs[0] }
        let d = ki_dims(inout st, vs, if b == "full" { 1 } else { 0 }, false, at)
        if not d.0 { return (true, st.unit) }
        return (true, kv_t(st, rt_t_full(d.1, d.2, if fill.k == 3 { float(fill.n) } else { ki_float(fill) }, fill.k == 3)))
    }
    if (b == "zeros_like" or b == "full_like") and t0 {
        let fill = if b == "zeros_like" { kv_f(st, 0.0) } else { vs[1] }
        return (true, kv_t(st, rt_t_full(vs[0].e.t.axes, vs[0].e.t.shape, if fill.k == 3 { float(fill.n) } else { ki_float(fill) }, fill.k == 3)))
    }
    if b == "tensor" {
        var d: List[f64] = []
        for x in vs[0].xs { d.push(if x.k == 3 { float(x.n) } else { ki_float(x) }) }
        return (true, kv_t(st, RtT { axes: [vs[1].n], shape: [len(d)], data: d, boolean: vs[2].n == 1, trit: false }))
    }
    if b == "to_list" {
        let t = vs[0].e.t
        var xs: List[KV] = []
        for x in t.data { xs.push(if t.boolean { kv_b(st, x != 0.0) } else if t.trit { kv_trit(st, int(x)) } else { kv_f(st, x) }) }
        return (true, kv_l(st, 5, xs))
    }
    // M18: ternary(x), ternary(x, threshold: t); float of a t3 tensor
    if b == "ternary" { return (true, kv_t(st, rt_t_ternary(vs[0].e.t, n > 1, if n > 1 { ki_float(vs[1]) } else { 0.0 }))) }
    if b == "float" and t0 { return (true, kv_t(st, rt_t_t3_to_f(vs[0].e.t))) }
    if b == "nan_quantile" { return (true, kv_t(st, rt_t_nan_quantile(vs[0].e.t, vs[1].x, vs[2].n))) }
    if b == "merge_days" { return (true, kv_t(st, rt_t_merge_days(vs[0].e.t))) }
    if b == "rank" { return (true, kv_t(st, rt_t_rank(vs[0].e.t, vs[1].n))) }
    if b == "top_k" or b == "bottom_k" { return (true, kv_t(st, rt_t_top_k(vs[0].e.t, vs[2].n, vs[1].n, b == "top_k"))) }
    if b == "contract" {
        let x = vs[0].e.t
        let y = vs[1].e.t
        let ax = vs[2].n
        let px = rt_t_pos(x, ax)
        let py = rt_t_pos(y, ax)
        if y.shape[py] != x.shape[px] {
            let _ = ki_size_mismatch(inout st, at, ax, x.shape[px], y.shape[py])
            return (true, st.unit)
        }
        for k in 0..len(y.axes) {
            if y.axes[k] == ax { continue }
            let p = rt_t_pos(x, y.axes[k])
            if p >= 0 and x.shape[p] != y.shape[k] {
                let _ = ki_size_mismatch(inout st, at, y.axes[k], x.shape[p], y.shape[k])
                return (true, st.unit)
            }
        }
        return (true, kv_t(st, rt_t_contract(x, y, ax)))
    }
    if b == "observed" { return (true, vs[0]) }
    if (b == "and" or b == "or") and any_t {
        let ta = ki_op_t(vs[0])
        let tb = ki_op_t(vs[1])
        if not ki_frame_ok(inout st, [ta, tb], at) { return (true, st.unit) }
        return (true, kv_t(st, rt_t_map2(if b == "and" { 12 } else { 13 }, ta, tb)))
    }
    (false, st.unit)
}

// ------------------------------------------------------------------ grad (src/interp/diff.rs)

fn kv_node(st: KSt, i: i64) -> KV {
    KV { k: 14, n: i, m: 0, x: 0.0, s: "", xs: st.no, e: st.e0 }
}

// the plain value behind a tracked one
fn ki_fwd(st: KSt, v: KV) -> KV {
    if v.k == 14 { return kv_t(st, rt_d_val(st.tape, v.n)) }
    v
}

// fwd all the way down structs, tuples, lists, enums and maps
fn ki_deep_fwd(st: KSt, v: KV) -> KV {
    if v.k == 14 { return ki_fwd(st, v) }
    if v.k == 5 or v.k == 6 or v.k == 7 or v.k == 8 {
        if not ki_has_node(v) { return v }
        var xs: List[KV] = []
        for x in v.xs { xs.push(ki_deep_fwd(st, x)) }
        var r = v
        r.xs = xs
        return r
    }
    if v.k == 10 and ki_has_node(v) {
        var r = v
        for key in keys(v.e.mp) { r.e.mp[key] = ki_deep_fwd(st, v.e.mp[key]) }
        return r
    }
    v
}

// does v hold a tracked value (inside structs, tuples, lists, enums and maps too)?
fn ki_has_node(v: KV) -> bool {
    if v.k == 14 { return true }
    if v.k == 5 or v.k == 6 or v.k == 7 or v.k == 8 {
        for x in v.xs {
            if ki_has_node(x) { return true }
        }
        return false
    }
    if v.k == 10 {
        for key in keys(v.e.mp) {
            if ki_has_node(v.e.mp[key]) { return true }
        }
    }
    false
}

fn ki_any_node(vs: List[KV]) -> bool {
    for v in vs {
        if ki_has_node(v) { return true }
    }
    false
}

// the node of a value: a tracked one's own, a plain one recorded as a constant
fn ki_node_of(inout st: KSt, v: KV) -> i64 {
    if v.k == 14 { return v.n }
    rt_d_const(inout st.tape, ki_op_t(v))
}

// arithmetic with a tracked value: the plain result, recorded with its operands' nodes
fn ki_bin_diff(inout st: KSt, op: str, a: KV, b: KV, at: H) -> KV {
    let r = ki_bin(inout st, op, ki_fwd(st, a), ki_fwd(st, b), at)
    if st.ctl != 0 { return st.unit }
    // comparisons: plain booleans, no gradient
    if not contains(["+", "-", "*", "/", "^", "%"], op) { return r }
    let ia = ki_node_of(inout st, a)
    let ib = ki_node_of(inout st, b)
    kv_node(st, rt_d_bin(inout st.tape, ki_op_code(op), ia, ib, ki_op_t(r)))
}

fn ki_select_diff(inout st: KSt, x: KV, sels: List[(i64, i64, i64, i64)], at: H) -> KV {
    let t = ki_fwd(st, x).e.t
    if not ki_sels_ok(inout st, t, sels, at) { return st.unit }
    kv_node(st, rt_d_select(inout st.tape, x.n, sels, rt_t_select(t, sels)))
}

// x[sels] = v when x or v is tracked: a new node takes x's place
fn ki_assign_diff(inout st: KSt, old: KV, sels: List[(i64, i64, i64, i64)], v: KV, at: H) -> KV {
    var t = ki_fwd(st, old).e.t
    let fv = ki_fwd(st, v)
    if not ki_assign_ok(inout st, t, sels, fv, at) { return st.unit }
    rt_t_assign(inout t, sels, ki_op_t(fv))
    let io = ki_node_of(inout st, old)
    let iv = ki_node_of(inout st, v)
    kv_node(st, rt_d_assign(inout st.tape, io, iv, sels, t))
}

// the argument differentiated becomes leaves: floats and tensors, inside structs, tuples, lists
fn ki_leaves(inout st: KSt, v: KV) -> KV {
    if v.k == 2 or v.k == 12 { return kv_node(st, rt_d_leaf(inout st.tape, ki_op_t(v))) }
    if v.k == 5 or v.k == 6 or v.k == 7 {
        var xs: List[KV] = []
        for x in v.xs { xs.push(ki_leaves(inout st, x)) }
        var r = v
        r.xs = xs
        return r
    }
    v
}

// the gradients of the leaves, in the argument's shape (zeros where the result does not reach)
fn ki_collect(st: KSt, leaves: KV, gs: RtDGrads) -> KV {
    if leaves.k == 14 { return kv_t(st, rt_d_grad(st.tape, gs, leaves.n)) }
    if leaves.k == 5 or leaves.k == 6 or leaves.k == 7 {
        var xs: List[KV] = []
        for x in leaves.xs { xs.push(ki_collect(st, x, gs)) }
        var r = leaves
        r.xs = xs
        return r
    }
    leaves
}

// grad(f)(args): f runs with the argument `wrt` tracked, then the tape is walked backwards
fn ki_run_grad(inout st: KSt, fv: KV, vs: List[KV], at: H) -> KV {
    if st.tracking { return ki_fail(inout st, at, "R0401", "`grad` inside `grad` is not supported yet", "second derivatives arrive in a later milestone") }
    st.tape = rt_d_new()
    st.tracking = true
    var args = vs
    let leaves = ki_leaves(inout st, args[fv.m])
    args[fv.m] = leaves
    let r = ki_call_value(inout st, fv.xs[0], args, at)
    st.tracking = false
    if st.ctl != 0 { return st.unit }
    var value = r
    var gs = RtDGrads { has: [], g: [] }
    if r.k == 14 {
        gs = rt_d_backward(st.tape, r.n)
        value = kv_t(st, rt_d_val(st.tape, r.n))
    }
    let g = ki_collect(st, leaves, gs)
    st.tape = rt_d_new()
    if fv.n == 3 { return kv_l(st, 6, [value, g]) }
    g
}

// The builtins of M4 (diff.rs diff_builtin): grad, randn, the activations, the smooth rules (exact
// outside `grad`, relaxed inside), the math of structs and tracked values, zeros_like.
fn ki_diff_builtin(inout st: KSt, b: str, vs: List[KV], at: H) -> (bool, KV) {
    let n = len(vs)
    if b == "grad" or b == "value_and_grad" {
        let f: List[KV] = [vs[0]]
        return (true, kv_fn(inout st, if b == "grad" { 2 } else { 3 }, vs[1].n, f))
    }
    if b == "randn" {
        let d = ki_dims(inout st, vs, 1, true, at)
        if not d.0 { return (true, st.unit) }
        return (true, kv_t(st, rt_t_randn(vs[0].n, d.1, d.2)))
    }
    if b == "tanh" or b == "sigmoid" or b == "relu" or b == "softplus" {
        let code = if b == "tanh" { 9 } else if b == "sigmoid" { 10 } else if b == "relu" { 11 } else { 12 }
        return (true, ki_map_any(inout st, code, vs[0], at))
    }
    if b == "smooth_max" or b == "smooth_min" {
        let sc = ki_fwd(st, vs[2]).x
        if not st.tracking {
            // the exact rule outside `grad`
            let base = if b == "smooth_max" { "max" } else { "min" }
            if vs[0].k == 12 or vs[1].k == 12 {
                let ta = ki_op_t(vs[0])
                let tb = ki_op_t(vs[1])
                if not ki_frame_ok(inout st, [ta, tb], at) { return (true, st.unit) }
                return (true, kv_t(st, rt_t_map2(if base == "max" { 14 } else { 15 }, ta, tb)))
            }
            return (true, ki_max_plain(st, base, vs[0], vs[1]))
        }
        // max(x, y) = y + s * softplus((x - y) / s); min(x, y) = -max(-x, -y)
        var x = vs[0]
        var y = vs[1]
        if b == "smooth_min" {
            x = ki_neg(inout st, x, at)
            y = ki_neg(inout st, y, at)
        }
        let d = ki_bin(inout st, "-", x, y, at)
        let ds = ki_bin(inout st, "/", d, kv_f(st, sc), at)
        let sp = ki_map_any(inout st, 12, ds, at)
        let m = ki_bin(inout st, "*", sp, kv_f(st, sc), at)
        let r = ki_bin(inout st, "+", y, m, at)
        if st.ctl != 0 { return (true, st.unit) }
        return (true, if b == "smooth_min" { ki_neg(inout st, r, at) } else { r })
    }
    if b == "smooth_step" {
        let sc = ki_fwd(st, vs[1]).x
        if not st.tracking { return (true, ki_map_any(inout st, 14, vs[0], at)) }
        let d = ki_bin(inout st, "/", vs[0], kv_f(st, sc), at)
        if st.ctl != 0 { return (true, st.unit) }
        return (true, ki_map_any(inout st, 10, d, at))
    }
    if (b == "sqrt" or b == "exp" or b == "ln" or b == "abs") and n == 1 and (ki_has_node(vs[0]) or vs[0].k == 6 or vs[0].k == 7) {
        let code = if b == "sqrt" { 3 } else if b == "exp" { 4 } else if b == "ln" { 5 } else { 2 }
        return (true, ki_map_any(inout st, code, vs[0], at))
    }
    if b == "zeros_like" and n == 1 and (vs[0].k == 2 or vs[0].k == 5 or vs[0].k == 6 or vs[0].k == 7 or vs[0].k == 14) { return (true, ki_zero_of(st, vs[0])) }
    (false, st.unit)
}

// Builtins on tracked values (diff.rs, after diff_builtin): (handled, value).
fn ki_tracked_builtin(inout st: KSt, b: str, vs: List[KV], at: H) -> (bool, KV) {
    let n = len(vs)
    let rk = ki_red_kind(b)
    if rk >= 0 and rk <= 6 and n == 2 and vs[0].k == 14 and vs[1].k == 1 {
        let r = rt_t_reduce(ki_fwd(st, vs[0]).e.t, vs[1].n, rk)
        return (true, kv_node(st, rt_d_reduce(inout st.tape, rk, vs[0].n, vs[1].n, r)))
    }
    if (b == "sum" or b == "mean" or b == "prod") and vs[0].k == 5 {
        // a list with tracked elements: folded with the tracked arithmetic
        let xs = vs[0].xs
        if len(xs) == 0 and b == "mean" { return (true, ki_fail(inout st, at, "R0004", "`mean` of an empty list", "")) }
        var acc = kv_f(st, if b == "prod" { 1.0 } else { 0.0 })
        for x in xs {
            acc = ki_bin(inout st, if b == "prod" { "*" } else { "+" }, acc, x, at)
            if st.ctl != 0 { return (true, st.unit) }
        }
        if b == "mean" { acc = ki_bin(inout st, "/", acc, kv_f(st, float(len(xs))), at) }
        return (true, acc)
    }
    if b == "minimum" or b == "maximum" {
        // picked by the plain values, the tracked element kept
        let xs = vs[0].xs
        if len(xs) == 0 { return (true, ki_fail(inout st, at, "R0004", "`" + b + "` of an empty list", "")) }
        var best = xs[0]
        for i in 1..len(xs) {
            let fx = ki_fwd(st, xs[i]).x
            let fb = ki_fwd(st, best).x
            if (b == "minimum" and fx < fb) or (b == "maximum" and fb < fx) { best = xs[i] }
        }
        return (true, best)
    }
    if (b == "max" or b == "min") and n == 2 {
        // element by element: a where on the plain values
        let fa = ki_fwd(st, vs[0])
        let fb = ki_fwd(st, vs[1])
        let cond = ki_bin(inout st, if b == "max" { ">=" } else { "<=" }, fa, fb, at)
        if st.ctl != 0 { return (true, st.unit) }
        var plain = st.unit
        if fa.k == 12 or fb.k == 12 {
            let ta = ki_op_t(fa)
            let tb = ki_op_t(fb)
            if not ki_frame_ok(inout st, [ta, tb], at) { return (true, st.unit) }
            plain = kv_t(st, rt_t_map2(if b == "max" { 14 } else { 15 }, ta, tb))
        } else {
            plain = ki_max_plain(st, b, fa, fb)
        }
        let ia = ki_node_of(inout st, vs[0])
        let ib = ki_node_of(inout st, vs[1])
        return (true, kv_node(st, rt_d_where(inout st.tape, ki_op_t(cond), ia, ib, ki_op_t(plain))))
    }
    if b == "where" {
        let cond = ki_fwd(st, vs[0])
        let pr = ki_tensor_builtin(inout st, "where", [cond, ki_fwd(st, vs[1]), ki_fwd(st, vs[2])], at)
        if st.ctl != 0 { return (true, st.unit) }
        let ia = ki_node_of(inout st, vs[1])
        let ib = ki_node_of(inout st, vs[2])
        return (true, kv_node(st, rt_d_where(inout st.tape, ki_op_t(cond), ia, ib, ki_op_t(pr.1))))
    }
    if b == "fill_nan" and vs[0].k == 14 {
        let pr = ki_tensor_builtin(inout st, "fill_nan", [ki_fwd(st, vs[0]), ki_fwd(st, vs[1])], at)
        return (true, kv_node(st, rt_d_map(inout st.tape, 100, vs[0].n, ki_op_t(pr.1))))
    }
    if b == "contract" {
        let pr = ki_tensor_builtin(inout st, "contract", [ki_fwd(st, vs[0]), ki_fwd(st, vs[1]), vs[2]], at)
        if st.ctl != 0 { return (true, st.unit) }
        let ix = ki_node_of(inout st, vs[0])
        let iy = ki_node_of(inout st, vs[1])
        return (true, kv_node(st, rt_d_contract(inout st.tape, ix, iy, vs[2].n, ki_op_t(pr.1))))
    }
    if b == "tensor" {
        var plain: List[KV] = []
        for x in vs[0].xs { plain.push(ki_fwd(st, x)) }
        let pr = ki_tensor_builtin(inout st, "tensor", [kv_l(st, 5, plain), vs[1], vs[2]], at)
        var parts: List[i64] = []
        for x in vs[0].xs { parts.push(ki_node_of(inout st, x)) }
        return (true, kv_node(st, rt_d_stack(inout st.tape, parts, ki_op_t(pr.1))))
    }
    if b == "to_list" and vs[0].k == 14 {
        let t = ki_fwd(st, vs[0]).e.t
        var xs: List[KV] = []
        for k in 0..len(t.data) { xs.push(kv_node(st, rt_d_elem(inout st.tape, vs[0].n, k, rt_t_scalar(t.data[k], false)))) }
        return (true, kv_l(st, 5, xs))
    }
    if b == "float" and vs[0].k == 14 { return (true, vs[0]) }
    // M18: the straight-through estimator: the trits of a tracked tensor, as f64, whose gradient
    // is the one that reaches them
    if b == "ternary" and vs[0].k == 14 {
        var plain_args = [ki_fwd(st, vs[0])]
        if n > 1 { plain_args.push(ki_fwd(st, vs[1])) }
        let pr = ki_tensor_builtin(inout st, "ternary", plain_args, at)
        return (true, kv_node(st, rt_d_ste(inout st.tape, vs[0].n, ki_op_t(pr.1))))
    }
    if b == "full" or b == "full_like" {
        // a tracked fill: zeros + the value, so the gradient sums over the tensor
        let k = if b == "full" { 0 } else { 1 }
        var plain_args = vs
        plain_args[k] = kv_f(st, 0.0)
        let zeros = ki_tensor_builtin(inout st, b, plain_args, at)
        if st.ctl != 0 { return (true, st.unit) }
        return (true, ki_bin(inout st, "+", zeros.1, vs[k], at))
    }
    (false, st.unit)
}

// max/min of two plain values (diff.rs max_plain): a NaN wins
fn ki_max_plain(st: KSt, b: str, x: KV, y: KV) -> KV {
    if x.k == 2 {
        if is_nan(x.x) or is_nan(y.x) { return kv_f(st, nan) }
        if b == "max" { return kv_f(st, if y.x > x.x { y.x } else { x.x }) }
        return kv_f(st, if y.x < x.x { y.x } else { x.x })
    }
    if b == "max" { kv_i(st, max(x.n, y.n)) } else { kv_i(st, min(x.n, y.n)) }
}

// ------------------------------------------------------------------ builtins

fn ki_float(v: KV) -> f64 {
    if v.k == 1 or v.k == 15 { float(v.n) } else { v.x }
}

// "s".parse::<i64>() after trim: an optional sign, digits, and within i64
fn ki_int_text_ok(t: str) -> bool {
    let cs = codes(t)
    let n = len(cs)
    if n == 0 { return false }
    var i = 0
    var neg = false
    if cs[0] == 43 or cs[0] == 45 {
        neg = cs[0] == 45
        i = 1
    }
    if i == n { return false }
    var digits: List[i64] = []
    for j in i..n {
        if cs[j] < 48 or cs[j] > 57 { return false }
        digits.push(cs[j] - 48)
    }
    // without leading zeros, compared with the largest
    var s = 0
    while s < len(digits) - 1 and digits[s] == 0 { s += 1 }
    let m = len(digits) - s
    if m < 19 { return true }
    if m > 19 { return false }
    let lim = codes(if neg { "9223372036854775808" } else { "9223372036854775807" })
    for j in 0..19 {
        let d = digits[s + j]
        let l = lim[j] - 48
        if d < l { return true }
        if d > l { return false }
    }
    true
}

fn ki_code_ok(n: i64) -> bool {
    n >= 0 and n <= 1114111 and (n < 55296 or n > 57343)
}

// min/max of two values (the interpreter's: a NaN wins, else the order of `<`)
fn ki_min_max(inout st: KSt, b: str, x: KV, y: KV, at: H) -> KV {
    if x.k == 2 and y.k == 2 and (is_nan(x.x) or is_nan(y.x)) { return kv_f(st, nan) }
    let lt = ki_bin(inout st, "<", x, y, at)
    if st.ctl != 0 { return st.unit }
    let first = if b == "min" { lt.n == 1 } else { lt.n != 1 }
    if first { x } else { y }
}

fn ki_builtin(inout st: KSt, inout f: List[KV], e: H) -> KV {
    let b = e.text
    // the ones that change a place: the value first, then the place
    if b == "push" or b == "pop" or b == "sort" or b == "reverse" or b == "remove" or starts_with(b, "put_") {
        var arg = st.unit
        if len(e.kids) > 1 {
            arg = ki_ev(inout st, inout f, e.kids[1].kids[0])
            if st.ctl != 0 { return st.unit }
        }
        var steps: List[KStep] = []
        let root = ki_place(inout st, inout f, e.kids[0].kids[0], inout steps)
        if st.ctl != 0 { return st.unit }
        let puts = ["put_u8", "put_u32", "put_u64", "put_i64", "put_f64", "put_f32", "put_str"]
        var op = if b == "push" { 3 } else if b == "pop" { 4 } else if b == "sort" { 5 } else if b == "reverse" { 6 } else { 7 }
        for i in 0..len(puts) {
            if b == puts[i] { op = 10 + i }
        }
        return ki_at(inout st, inout f[root], steps, 0, op, arg, e)
    }
    var vs: List[KV] = []
    for a in e.kids {
        vs.push(ki_ev(inout st, inout f, a.kids[0]))
        if st.ctl != 0 { return st.unit }
    }
    let dr = ki_diff_builtin(inout st, b, vs, e)
    if st.ctl != 0 { return st.unit }
    if dr.0 { return dr.1 }
    if st.tracking and ki_any_node(vs) {
        let tb = ki_tracked_builtin(inout st, b, vs, e)
        if st.ctl != 0 { return st.unit }
        if tb.0 { return tb.1 }
        // not differentiable (counts, ranks, rounding, printing...): plain values from here on
        var plain: List[KV] = []
        for v in vs { plain.push(ki_deep_fwd(st, v)) }
        vs = plain
    }
    let tr = ki_tensor_builtin(inout st, b, vs, e)
    if st.ctl != 0 { return st.unit }
    if tr.0 { return tr.1 }
    if b == "print" or b == "eprint" {
        var parts: List[str] = []
        for v in vs { parts.push(ki_show(st, v, true)) }
        if b == "print" { print(join(parts, " ")) } else { eprint(join(parts, " ")) }
        return st.unit
    }
    if b == "len" {
        let v = vs[0]
        if v.k == 4 { return kv_i(st, len(v.s)) }
        if v.k == 10 { return kv_i(st, len(v.e.mp)) }
        if v.k == 11 { return kv_i(st, len(v.e.by)) }
        return kv_i(st, len(v.xs))
    }
    if b == "str" { return kv_s(st, ki_show(st, vs[0], true)) }
    if b == "float" { return kv_f(st, ki_float(vs[0])) }
    if b == "int" {
        let v = vs[0]
        if v.k == 1 { return v }
        if v.k == 15 { return kv_i(st, v.n) }
        if is_nan(v.x) or abs(v.x) >= 9.2e18 { return ki_fail(inout st, e, "R0009", "cannot convert " + str(v.x) + " to i64", "") }
        return kv_i(st, int(v.x))
    }
    if b == "contains" {
        let o = vs[0]
        if o.k == 4 { return kv_b(st, contains(o.s, vs[1].s)) }
        if o.k == 10 { return kv_b(st, contains(o.e.mp, ki_key(vs[1]))) }
        for x in o.xs {
            if ki_eq(x, vs[1]) { return kv_b(st, true) }
        }
        return kv_b(st, false)
    }
    if b == "keys" or b == "values" or b == "items" {
        let m = vs[0]
        var xs: List[KV] = []
        for key in keys(m.e.mp) {
            let kv = ki_unkey(st, m, key)
            if b == "keys" {
                xs.push(kv)
            } else if b == "values" {
                xs.push(m.e.mp[key])
            } else {
                xs.push(kv_l(st, 6, [kv, m.e.mp[key]]))
            }
        }
        return kv_l(st, 5, xs)
    }
    if b == "get" {
        let key = ki_key(vs[1])
        return if contains(vs[0].e.mp, key) { vs[0].e.mp[key] } else { vs[2] }
    }
    if b == "map" or b == "filter" {
        var out: List[KV] = []
        for x in vs[0].xs {
            let r = ki_call_value(inout st, vs[1], [x], e)
            if st.ctl != 0 { return st.unit }
            if b == "map" {
                out.push(r)
            } else if r.n == 1 {
                out.push(x)
            }
        }
        return kv_l(st, 5, out)
    }
    if b == "sum" and vs[0].k == 5 {
        var acc = vs[1]
        for x in vs[0].xs {
            acc = ki_bin(inout st, "+", acc, x, e)
            if st.ctl != 0 { return st.unit }
        }
        return acc
    }
    if (b == "mean" or b == "prod") and vs[0].k == 5 {
        let xs = vs[0].xs
        if b == "mean" {
            if len(xs) == 0 { return ki_fail(inout st, e, "R0004", "`mean` of an empty list", "") }
            var acc = 0.0
            for x in xs { acc = acc + x.x }
            return kv_f(st, acc / float(len(xs)))
        }
        var acc = 1.0
        for x in xs { acc = acc * x.x }
        return kv_f(st, acc)
    }
    if (b == "min" or b == "max") and len(vs) == 2 and vs[0].k != 12 and vs[1].k != 12 { return ki_min_max(inout st, b, vs[0], vs[1], e) }
    if b == "minimum" or b == "maximum" {
        let xs = vs[0].xs
        if len(xs) == 0 { return ki_fail(inout st, e, "R0004", "`" + b + "` of an empty list", "") }
        var best = xs[0]
        for i in 1..len(xs) {
            let better = if b == "minimum" { ki_bin(inout st, "<", xs[i], best, e) } else { ki_bin(inout st, "<", best, xs[i], e) }
            if st.ctl != 0 { return st.unit }
            if better.n == 1 { best = xs[i] }
        }
        return best
    }
    if b == "abs" and vs[0].k == 1 {
        if vs[0].n == -9223372036854775807 - 1 { return ki_overflow(inout st, e) }
        return kv_i(st, abs(vs[0].n))
    }
    if len(vs) == 1 and vs[0].k == 2 {
        let x = vs[0].x
        if b == "abs" { return kv_f(st, abs(x)) }
        if b == "sqrt" { return kv_f(st, sqrt(x)) }
        if b == "exp" { return kv_f(st, exp(x)) }
        if b == "ln" { return kv_f(st, ln(x)) }
        if b == "floor" { return kv_f(st, floor(x)) }
        if b == "ceil" { return kv_f(st, ceil(x)) }
        if b == "round" { return kv_f(st, round(x)) }
        if b == "tanh" { return kv_f(st, tanh(x)) }
        if b == "sigmoid" { return kv_f(st, sigmoid(x)) }
        if b == "relu" { return kv_f(st, relu(x)) }
        if b == "softplus" { return kv_f(st, softplus(x)) }
        if b == "is_nan" { return kv_b(st, is_nan(x)) }
        if b == "to_bits" { return kv_i(st, to_bits(x)) }
    }
    if b == "format_fixed" { return kv_s(st, format_fixed(vs[0].x, vs[1].n)) }
    if b == "substr" { return kv_s(st, substr(vs[0].s, vs[1].n, vs[2].n)) }
    if b == "split" {
        if vs[1].s == "" { return ki_fail(inout st, e, "R0010", "`split` needs a separator that is not empty", "") }
        return kv_str_list(st, split(vs[0].s, vs[1].s))
    }
    if b == "lines" { return kv_str_list(st, lines(vs[0].s)) }
    if b == "trim" { return kv_s(st, trim(vs[0].s)) }
    if b == "upper" { return kv_s(st, upper(vs[0].s)) }
    if b == "lower" { return kv_s(st, lower(vs[0].s)) }
    if b == "starts_with" { return kv_b(st, starts_with(vs[0].s, vs[1].s)) }
    if b == "ends_with" { return kv_b(st, ends_with(vs[0].s, vs[1].s)) }
    if b == "find" { return kv_i(st, find(vs[0].s, vs[1].s)) }
    if b == "replace" { return kv_s(st, replace(vs[0].s, vs[1].s, vs[2].s)) }
    if b == "parse_int" {
        let t = trim(vs[0].s)
        if not ki_int_text_ok(t) { return ki_fail(inout st, e, "R0010", "not an integer: " + ki_debug_str(vs[0].s), "") }
        return kv_i(st, parse_int(t))
    }
    if b == "parse_float" { return kv_f(st, parse_float(vs[0].s)) }
    if b == "join" {
        var ss: List[str] = []
        for x in vs[0].xs { ss.push(x.s) }
        return kv_s(st, join(ss, vs[1].s))
    }
    if b == "codes" {
        var xs: List[KV] = []
        for c in codes(vs[0].s) { xs.push(kv_i(st, c)) }
        return kv_l(st, 5, xs)
    }
    if b == "from_codes" {
        var cs: List[i64] = []
        for x in vs[0].xs {
            if not ki_code_ok(x.n) { return ki_fail(inout st, e, "R0010", str(x.n) + " is not a Unicode code point", "") }
            cs.push(x.n)
        }
        return kv_s(st, from_codes(cs))
    }
    if b == "utf8_len" { return kv_i(st, utf8_len(vs[0].s)) }
    if b == "assert" {
        if vs[0].n == 1 { return st.unit }
        return ki_fail(inout st, e, "R0003", if len(vs) > 1 { vs[1].s } else { "assertion failed" }, "")
    }
    if b == "exit" {
        exit(vs[0].n)
        return st.unit
    }
    if b == "read_line" { return kv_s(st, read_line()) }
    if b == "print_raw" {
        print_raw(vs[0].s)
        return st.unit
    }
    if b == "args" { return kv_str_list(st, st.args) }
    if b == "env" { return kv_s(st, env(vs[0].s)) }
    if b == "today" { return kv_i(st, today()) }
    if b == "bit_and" { return kv_i(st, bit_and(vs[0].n, vs[1].n)) }
    if b == "bit_or" { return kv_i(st, bit_or(vs[0].n, vs[1].n)) }
    if b == "bit_xor" { return kv_i(st, bit_xor(vs[0].n, vs[1].n)) }
    if b == "wrapping_add" { return kv_i(st, wrapping_add(vs[0].n, vs[1].n)) }
    if b == "wrapping_mul" { return kv_i(st, wrapping_mul(vs[0].n, vs[1].n)) }
    if b == "shl" or b == "shr" {
        let n = vs[1].n
        if n < 0 or n > 63 { return ki_fail(inout st, e, "R0014", "shift by " + str(n) + ": it must be from 0 to 63", "") }
        return kv_i(st, if b == "shl" { shl(vs[0].n, n) } else { shr(vs[0].n, n) })
    }
    if b == "to_hex" { return kv_s(st, to_hex(vs[0].n, vs[1].n)) }
    if b == "is_alphabetic" { return kv_b(st, is_alphabetic(vs[0].n)) }
    if b == "is_alphanumeric" { return kv_b(st, is_alphanumeric(vs[0].n)) }
    if b == "is_whitespace" { return kv_b(st, is_whitespace(vs[0].n)) }
    if b == "is_uppercase" { return kv_b(st, is_uppercase(vs[0].n)) }
    if b == "from_bits" { return kv_f(st, from_bits(vs[0].n)) }
    let io = ki_io_builtin(inout st, b, vs, e)
    if st.ctl != 0 { return st.unit }
    if io.0 { return io.1 }
    if b == "file_exists" { return kv_b(st, file_exists(vs[0].s)) }
    if b == "file_size" { return kv_i(st, file_size(vs[0].s)) }
    if b == "file_date" { return kv_i(st, file_date(vs[0].s)) }
    ki_fail(inout st, e, "K0001", "`" + b + "` is not in the interpreter written in Kairós yet", "")
}

// ------------------------------------------------------------------ files, the network, Bytes

fn kv_by(st: KSt, b: Bytes) -> KV {
    KV { k: 11, n: 0, m: 0, x: 0.0, s: "", xs: st.no, e: KE { mp: st.e0.mp, by: b, t: st.e0.t } }
}

fn kv_pair(st: KSt, a: KV, b: KV) -> KV {
    kv_l(st, 6, [a, b])
}

// an i64's bits as an unsigned number
fn ki_u64_text(n: i64) -> str {
    if n >= 0 { return str(n) }
    let q = shr(n, 1) / 5
    let r = wrapping_add(n, wrapping_mul(q, -10))
    str(q) + str(r)
}

// Are the n bytes of b at `at` UTF-8 text (Rust's from_utf8)?
fn ki_utf8_ok(b: Bytes, at: i64, n: i64) -> bool {
    var i = at
    let end = at + n
    while i < end {
        let c = get_u8(b, i)
        if c < 128 {
            i += 1
            continue
        }
        var need = 0
        var lo = 128
        var hi = 191
        if c >= 194 and c <= 223 {
            need = 1
        } else if c >= 224 and c <= 239 {
            need = 2
            if c == 224 { lo = 160 }
            if c == 237 { hi = 159 }
        } else if c >= 240 and c <= 244 {
            need = 3
            if c == 240 { lo = 144 }
            if c == 244 { hi = 143 }
        } else {
            return false
        }
        if i + need >= end { return false }
        for k in 1..need + 1 {
            let d = get_u8(b, i + k)
            if k == 1 {
                if d < lo or d > hi { return false }
            } else if d < 128 or d > 191 {
                return false
            }
        }
        i += need + 1
    }
    true
}

// R0001 unless n bytes of b at `at` exist (the interpreter's bytes_at)
fn ki_bytes_ok(inout st: KSt, b: Bytes, at: i64, n: i64, e: H) -> bool {
    if at < 0 or at > len(b) - n {
        let _ = ki_fail(inout st, e, "R0001", "reading " + str(n) + " byte(s) at " + str(at) + ", out of bounds for " + str(len(b)) + " bytes", "")
        return false
    }
    true
}

// The builtins of files, the network and Bytes: (handled, value). The try_ ones give the error the
// program stops with.
fn ki_io_builtin(inout st: KSt, b: str, vs: List[KV], e: H) -> (bool, KV) {
    if b == "read_text" or b == "try_read_text" {
        let r = try_read_text(vs[0].s)
        if b == "try_read_text" { return (true, kv_pair(st, kv_s(st, r.0), kv_s(st, r.1))) }
        if r.1 != "" { return (true, ki_fail(inout st, e, "R0011", "cannot read " + vs[0].s + ": " + r.1, "")) }
        return (true, kv_s(st, r.0))
    }
    if b == "read_bytes" or b == "try_read_bytes" {
        let r = try_read_bytes(vs[0].s)
        if b == "try_read_bytes" { return (true, kv_pair(st, kv_by(st, r.0), kv_s(st, r.1))) }
        if r.1 != "" { return (true, ki_fail(inout st, e, "R0011", "cannot read " + vs[0].s + ": " + r.1, "")) }
        return (true, kv_by(st, r.0))
    }
    if b == "write_text" or b == "append_text" or b == "try_write_text" {
        let r = try_write_text(vs[0].s, vs[1].s, if b == "try_write_text" { vs[2].n == 1 } else { b == "append_text" })
        if b == "try_write_text" { return (true, kv_s(st, r)) }
        if r != "" { return (true, ki_fail(inout st, e, "R0011", "cannot write " + vs[0].s + ": " + r, "")) }
        return (true, st.unit)
    }
    if b == "write_bytes" or b == "try_write_bytes" {
        let r = try_write_bytes(vs[0].s, vs[1].e.by)
        if b == "try_write_bytes" { return (true, kv_s(st, r)) }
        if r != "" { return (true, ki_fail(inout st, e, "R0011", "cannot write " + vs[0].s + ": " + r, "")) }
        return (true, st.unit)
    }
    if b == "list_dir" or b == "try_list_dir" {
        let r = try_list_dir(vs[0].s)
        if b == "try_list_dir" { return (true, kv_pair(st, kv_str_list(st, r.0), kv_s(st, r.1))) }
        if r.1 != "" { return (true, ki_fail(inout st, e, "R0011", "cannot list " + vs[0].s + ": " + r.1, "")) }
        return (true, kv_str_list(st, r.0))
    }
    if b == "make_dir" or b == "try_make_dir" {
        let r = try_make_dir(vs[0].s)
        if b == "try_make_dir" { return (true, kv_s(st, r)) }
        if r != "" { return (true, ki_fail(inout st, e, "R0011", "cannot create " + vs[0].s + ": " + r, "")) }
        return (true, st.unit)
    }
    if b == "zip_entries" or b == "try_zip_entries" {
        let r = try_zip_entries(vs[0].s)
        if b == "try_zip_entries" { return (true, kv_pair(st, kv_str_list(st, r.0), kv_s(st, r.1))) }
        if r.1 != "" { return (true, ki_fail(inout st, e, "R0011", "cannot read " + vs[0].s + ": " + r.1, "")) }
        return (true, kv_str_list(st, r.0))
    }
    if b == "read_lines" or b == "try_read_lines" or b == "read_zip_lines" or b == "try_read_zip_lines" {
        // a negative column first
        let zipped = b == "read_zip_lines" or b == "try_read_zip_lines"
        var keep: List[(i64, str)] = []
        for k in vs[if zipped { 2 } else { 1 }].xs {
            if k.xs[0].n < 0 { return (true, ki_fail(inout st, e, "R0010", "column " + str(k.xs[0].n) + " is negative", "")) }
            keep.push((k.xs[0].n, k.xs[1].s))
        }
        let r = if zipped { try_read_zip_lines(vs[0].s, vs[1].s, keep) } else { try_read_lines(vs[0].s, keep) }
        if b == "try_read_zip_lines" { return (true, kv_pair(st, kv_str_list(st, r.0), kv_s(st, r.1))) }
        if b == "try_read_lines" { return (true, kv_pair(st, kv_str_list(st, r.0), kv_s(st, r.1))) }
        if r.1 != "" { return (true, ki_fail(inout st, e, "R0011", "cannot read " + vs[0].s + ": " + r.1, "")) }
        return (true, kv_str_list(st, r.0))
    }
    if b == "http_get" or b == "try_http_get" {
        let r = try_http_get(vs[0].s)
        if b == "try_http_get" { return (true, kv_pair(st, kv_s(st, r.0), kv_s(st, r.1))) }
        if r.1 != "" { return (true, ki_fail(inout st, e, "R0013", r.1, "")) }
        return (true, kv_s(st, r.0))
    }
    if b == "download" or b == "try_download" {
        let r = try_download(vs[0].s, vs[1].s)
        if b == "try_download" { return (true, kv_pair(st, kv_i(st, r.0), kv_s(st, r.1))) }
        if r.1 != "" { return (true, ki_fail(inout st, e, "R0013", r.1, "")) }
        return (true, kv_i(st, r.0))
    }
    if b == "http_get_all" {
        var urls: List[str] = []
        for u in vs[0].xs { urls.push(u.s) }
        // one after the other: the same results, in the same order, as the interpreter fetching in parallel
        var out: List[KV] = []
        for u in urls {
            let r = try_http_get(u)
            out.push(kv_pair(st, kv_b(st, r.1 == ""), kv_s(st, if r.1 == "" { r.0 } else { r.1 })))
        }
        return (true, kv_l(st, 5, out))
    }
    if b == "bytes" { return (true, kv_by(st, bytes())) }
    if starts_with(b, "get_") {
        let by = vs[0].e.by
        let at = vs[1].n
        if b == "get_str" {
            let n = vs[2].n
            if n < 0 { return (true, ki_fail(inout st, e, "R0001", str(n) + " bytes", "")) }
            if not ki_bytes_ok(inout st, by, at, n, e) { return (true, st.unit) }
            if not ki_utf8_ok(by, at, n) { return (true, ki_fail(inout st, e, "R0010", "the " + str(n) + " bytes at " + str(at) + " are not UTF-8 text", "")) }
            return (true, kv_s(st, get_str(by, at, n)))
        }
        let n = if b == "get_u8" { 1 } else if b == "get_u32" or b == "get_f32" { 4 } else { 8 }
        if not ki_bytes_ok(inout st, by, at, n, e) { return (true, st.unit) }
        if b == "get_u8" { return (true, kv_i(st, get_u8(by, at))) }
        if b == "get_u32" { return (true, kv_i(st, get_u32(by, at))) }
        if b == "get_i64" { return (true, kv_i(st, get_i64(by, at))) }
        if b == "get_f64" { return (true, kv_f(st, get_f64(by, at))) }
        if b == "get_f32" { return (true, kv_f(st, get_f32(by, at))) }
        if b == "get_u64" {
            let u = get_i64(by, at)
            if u < 0 { return (true, ki_fail(inout st, e, "R0014", ki_u64_text(u) + " does not fit in i64", "")) }
            return (true, kv_i(st, u))
        }
    }
    (false, st.unit)
}

// ------------------------------------------------------------------ the bridge to the lab (b3)

// the state of the bridge, made at the first call: the program's protocols and name
fn ki_b3_init(inout st: KSt) {
    if st.b3_ready { return }
    var protos: List[RtProto] = []
    for p in st.ck.protocols { protos.push(RtProto { name: p.name, research_until: p.research_until, holdout_from: p.holdout_from, min_months: p.min_months, rule: p.rule }) }
    st.b3 = rt_b3_fresh(protos, st.prog)
    st.b3_ready = true
}

// the bridge's notes to the standard error (as the interpreter writes them, at once)
fn ki_b3_notes(inout st: KSt) {
    if st.b3.notes == "" { return }
    let n = st.b3.notes
    st.b3.notes = ""
    eprint(if ends_with(n, from_codes([10])) { substr(n, 0, len(n) - 1) } else { n })
}

// an error of the bridge, with the hint the interpreter gives
fn ki_b3_fail(inout st: KSt, e: H, code: str, msg: str) -> KV {
    ki_fail(inout st, e, code, msg, rt_b3_hint(code, msg))
}

// a tensor of the program (the lab's) as the interpreter's, axis by axis
fn ki_t_ma(x: Tensor[month, asset; f64]) -> RtT {
    let nm = size(x, month)
    let na = size(x, asset)
    var d: List[f64] = []
    for m in 0..nm {
        for v in to_list(x[month: m]) { d.push(v) }
    }
    RtT { axes: [0, 2], shape: [nm, na], data: d, boolean: false, trit: false }
}

fn ki_t_ma_bool(x: Tensor[month, asset; bool]) -> RtT {
    let nm = size(x, month)
    let na = size(x, asset)
    var d: List[f64] = []
    for m in 0..nm {
        for v in to_list(x[month: m]) { d.push(if v { 1.0 } else { 0.0 }) }
    }
    RtT { axes: [0, 2], shape: [nm, na], data: d, boolean: true, trit: false }
}

fn ki_t_m(x: Tensor[month; f64]) -> RtT {
    RtT { axes: [0], shape: [size(x, month)], data: to_list(x), boolean: false, trit: false }
}

// the interpreter's tensor of weights (its axes in any order) as the lab's
fn ki_ma_of(t: RtT) -> Tensor[month, asset; f64] {
    let pm = rt_t_pos(t, 0)
    let pa = rt_t_pos(t, 2)
    let nm = t.shape[pm]
    let na = t.shape[pa]
    let sts = rt_t_strides(t.shape)
    var w = zeros(month: nm, asset: na)
    for m in 0..nm {
        var row: List[f64] = []
        for a in 0..na { row.push(t.data[m * sts[pm] + a * sts[pa]]) }
        w[month: m] = tensor(row, asset)
    }
    w
}

fn ki_floats_of(v: KV) -> List[f64] {
    var out: List[f64] = []
    for x in v.xs { out.push(ki_float(x)) }
    out
}

// The prelude's Evaluation, field by field (src/interp/tensors.rs evaluation).
fn kv_evaluation(st: KSt, id: i64, ev: Evaluation) -> KV {
    var by: Map[str, KV] = [:]
    by["months"] = kv_i(st, ev.months)
    by["cagr"] = kv_f(st, ev.cagr)
    by["vol"] = kv_f(st, ev.vol)
    by["sharpe"] = kv_f(st, ev.sharpe)
    by["max_dd"] = kv_f(st, ev.max_dd)
    by["beta"] = kv_f(st, ev.beta)
    by["alpha"] = kv_f(st, ev.alpha)
    by["t_alpha"] = kv_f(st, ev.t_alpha)
    by["turnover"] = kv_f(st, ev.turnover)
    by["cost_bps"] = kv_f(st, ev.cost_bps)
    by["trials"] = kv_i(st, ev.trials)
    by["dsr"] = kv_f(st, ev.dsr)
    kv_fields(st, id, by)
}

fn kv_simulation(st: KSt, id: i64, sim: Simulation) -> KV {
    var by: Map[str, KV] = [:]
    by["ret"] = kv_t(st, ki_t_m(sim.ret))
    by["exposure"] = kv_t(st, ki_t_m(sim.exposure))
    by["turnover"] = kv_t(st, ki_t_m(sim.turnover))
    by["cost_bps"] = kv_f(st, sim.cost_bps)
    by["tax_paid"] = kv_f(st, sim.tax_paid)
    by["final_value"] = kv_f(st, sim.final_value)
    by["liq_value"] = kv_f(st, sim.liq_value)
    by["capped"] = kv_f(st, sim.capped)
    by["exempt_months"] = kv_i(st, sim.exempt_months)
    by["taxed_months"] = kv_i(st, sim.taxed_months)
    by["trials"] = kv_i(st, sim.trials)
    by["dsr"] = kv_f(st, sim.dsr)
    kv_fields(st, id, by)
}

// the struct `id` with its fields from `by`, in its order
fn kv_fields(st: KSt, id: i64, by: Map[str, KV]) -> KV {
    var xs: List[KV] = []
    for fd in st.ck.structs[id].fields { xs.push(by[fd.0]) }
    var v = kv_l(st, 7, xs)
    v.n = id
    v
}

// b3.f(...) (src/interp/tensors.rs host_call): the arguments first, plain values for the
// simulator; then the bridge written in Kairós, with the program's own state.
fn ki_host(inout st: KSt, inout f: List[KV], e: H) -> KV {
    var vs: List[KV] = []
    for x in e.kids {
        vs.push(ki_ev(inout st, inout f, x))
        if st.ctl != 0 { return st.unit }
    }
    if st.tracking {
        var plain: List[KV] = []
        for v in vs { plain.push(ki_deep_fwd(st, v)) }
        vs = plain
    }
    let parts = split(e.text, " ")
    let what = parts[0]
    let p1 = if len(parts) > 1 { parse_int(parts[1]) } else { -1 }
    ki_b3_init(inout st)
    if what == "open_once" { return ki_open_once(inout st, vs, p1, e) }
    var code = ""
    var msg = ""
    var out = st.unit
    if what == "monthly_returns" {
        let r = rt_b3_monthly_returns_s(inout st.b3)
        code = r.0
        msg = r.1
        if code == "" { out = kv_t(st, ki_t_ma(r.2)) }
    } else if what == "eligible" {
        let r = rt_b3_eligible_s(inout st.b3)
        code = r.0
        msg = r.1
        if code == "" { out = kv_t(st, ki_t_ma_bool(r.2)) }
    } else if what == "cdi" or what == "ipca" or what == "nefin" {
        let r = if what == "cdi" { rt_b3_cdi_s(inout st.b3) } else if what == "ipca" { rt_b3_ipca_s(inout st.b3) } else { rt_b3_nefin_s(inout st.b3, p1, vs[0].n == 1) }
        code = r.0
        msg = r.1
        if code == "" { out = kv_t(st, ki_t_m(r.2)) }
    } else if what == "daily" or what == "sessions" or what == "session_dates" or what == "nefin_daily" {
        let r = if what == "daily" { rt_b3_daily_s(inout st.b3, p1) } else if what == "sessions" { rt_b3_sessions_s(inout st.b3) } else if what == "session_dates" { rt_b3_session_dates_s(inout st.b3) } else { rt_b3_nefin_daily_s(inout st.b3, p1, vs[0].n == 1) }
        code = r.0
        msg = r.1
        if code == "" { out = kv_t(st, r.2) }
    } else if what == "months" {
        let r = rt_b3_months_s(inout st.b3)
        code = r.0
        msg = r.1
        var xs: List[KV] = []
        for m in r.2 { xs.push(kv_i(st, m)) }
        out = kv_l(st, 5, xs)
    } else if what == "month_index" {
        let r = rt_b3_month_index_s(inout st.b3, vs[0].n)
        code = r.0
        msg = r.1
        out = kv_i(st, r.2)
    } else if what == "tickers" or what == "issuers" or what == "classes" {
        let r = rt_b3_names_s(inout st.b3, if what == "tickers" { 0 } else if what == "issuers" { 1 } else { 2 })
        code = r.0
        msg = r.1
        out = kv_str_list(st, r.2)
    } else if what == "evaluate" or what == "simulate" {
        let w = ki_ma_of(vs[0].e.t)
        if what == "evaluate" {
            let r = rt_b3_evaluate_s(inout st.b3, w, vs[1].x, vs[2].n, vs[3].x, vs[4].n == 1, vs[5].n == 1, vs[6].x, vs[7].n == 1)
            code = r.0
            msg = r.1
            if code == "" { out = kv_evaluation(st, p1, r.2) }
        } else {
            let r = rt_b3_simulate_s(inout st.b3, w, vs[1].x, vs[2].n, vs[3].x, vs[4].n == 1, vs[5].n == 1, vs[6].x, vs[7].n == 1)
            code = r.0
            msg = r.1
            if code == "" { out = kv_simulation(st, p1, r.2) }
        }
    } else if what == "deflate_trial" {
        let r = rt_b3_deflate_trial_s(inout st.b3, ki_floats_of(vs[0]))
        var xs: List[KV] = []
        for x in r.2 { xs.push(kv_f(st, x)) }
        out = kv_l(st, 5, xs)
    } else if what == "record_trial" {
        let r = rt_b3_record_trial_s(inout st.b3, vs[0].s, vs[1].s, vs[2].s, vs[3].s, ki_floats_of(vs[4]))
        code = r.0
        msg = r.1
        out = kv_s(st, r.2)
    } else if what == "results_sha256" {
        let r = rt_b3_results_sha256_s(inout st.b3, vs[0].s)
        out = kv_s(st, r.2)
    } else if what == "holdout" {
        let r = rt_b3_holdout_s(inout st.b3, p1)
        code = r.0
        msg = r.1
        out = KV { k: 13, n: p1, m: 0, x: 0.0, s: "", xs: st.no, e: st.e0 }
    } else {
        return ki_fail(inout st, e, "K0001", "`b3." + what + "` is not in the interpreter written in Kairós yet", "")
    }
    ki_b3_notes(inout st)
    if code != "" { return ki_b3_fail(inout st, e, code, msg) }
    out
}

// open_once(h, || weights(), ...): the opening recorded before the weights function runs; the
// program sees all the data while it runs; an error there spends the holdout, and its hint says so.
fn ki_open_once(inout st: KSt, vs: List[KV], id: i64, e: H) -> KV {
    let k = vs[0].n
    let b = rt_b3_open_begin_s(inout st.b3, k)
    ki_b3_notes(inout st)
    if b.0 != "" { return ki_b3_fail(inout st, e, b.0, b.1) }
    let w0 = ki_call_value(inout st, vs[1], [], e)
    if st.ctl == 4 {
        let spent = rt_b3_open_failed_s(inout st.b3, "the weights function failed while the holdout was open: " + st.code + " " + st.msg)
        st.hint = if st.hint != "" { st.hint + from_codes([10]) + spent } else { spent }
        return st.unit
    }
    if st.ctl != 0 { return st.unit }
    let w = ki_deep_fwd(st, w0)
    let r = rt_b3_open_end_s(inout st.b3, k, ki_ma_of(w.e.t), vs[2].x, vs[3].n, vs[4].x, vs[5].n == 1, vs[6].n == 1, vs[7].x, vs[8].n == 1)
    ki_b3_notes(inout st)
    if r.0 != "" { return ki_b3_fail(inout st, e, r.0, r.1) }
    kv_evaluation(st, id, r.2)
}

// ------------------------------------------------------------------ a program

// Runs the program's top-level statements in order: true when it ends without an error.
fn ki_run(inout st: KSt) -> bool {
    var f = ki_frame(st, len(st.ck.main.slot_tys))
    for t in st.ck.all_tops {
        let _ = ki_ev(inout st, inout f, t)
        if st.ctl == 4 { return false }
        st.ctl = 0
    }
    true
}
