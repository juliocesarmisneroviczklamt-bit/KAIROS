// The native back end of Kairós (M21), written in Kairós: the WebAssembly module that the back end
// makes (wasmgen.krs) translated to x86-64, function by function, and written as a Windows
// executable (pe.krs). Nothing but the module and kernel32.dll: the program's operating system
// (the WASI functions the runtime calls) is Kairós too, compiled into the module (rt_win.krs).
//
// Each value of WebAssembly's operand stack has a slot of 8 bytes in the function's frame, whose
// place the translator knows at each instruction (the stack's height is fixed by the code). A
// value goes to its slot only when it must (M22): until an instruction needs it, the translator
// holds it as a constant, as the value of a local, in rax or xmm0 (the stack's top), or as a
// comparison in the flags (the top, for a branch to take directly). Before a branch, a block's start or end and
// a call's clobbering, the values go to their slots. The locals used most (counted in the code,
// eight times more inside each loop) live in rbx, rsi, rdi, r12, r13 and r14, which kernel32
// keeps; a function saves the ones it uses. The module's memory starts at r15; an address is its
// 32 bits, added to r15.
//
// The frame of a function (rbp at its start):
//   [rbp + 16 + 8i]           parameter i (the caller's outgoing area)
//   [rbp + 8], [rbp]          the return address, the caller's rbp
//   [rbp - 8 - 8j]            the other locals (zero at the start)
//   below them                the registers it saves, the operand slots, then the outgoing area
//                             at rsp (the arguments of
//                             the calls this function makes; for kernel32, its 32 bytes of shadow
//                             space and the arguments after the fourth)
// A function's first result comes back in rax (a float as its bits), the others (a function with
// `inout` parameters gives them back too) in the caller's outgoing area, from its start. Values of
// 32 bits live in the low half of their slot, and whoever reads one reads 32 bits.
//
// Functions the module exports with a mark get another body:
//   __k32_<Name>      a call to <Name> of kernel32.dll (Windows' convention: rcx, rdx, r8, r9,
//                     then the stack), with the function's parameters, giving its rax
//   __mem_base        the address where the module's memory starts (r15)
//   __wasi_<name>     the function that does WASI's <name>: a call to that import calls it
//
// Memory: 8 GiB + 64 KiB of addresses reserved, so that any 32-bit address with any 32-bit offset
// stays in them; the first 64 KiB hold the globals (8 bytes each) and, at their end, the number
// of pages in use; the module's memory follows (r15), its pages committed as it grows.
import "x64.krs"
import "pe.krs"

struct NCtl {
    kind: i64,          // 0 block, 1 loop, 2 if, 3 the function's body
    label: i64,         // where a branch to it goes: its end, or a loop's start
    else_l: i64,        // an if's else (-1: none)
    height: i64,        // the operand stack's height where it starts
    results: i64,       // the values it leaves (a block: 0 or 1; the function: any)
    has_else: bool,
}

// A value of the operand stack as the translator holds it: in its slot (kind 0), a constant (1,
// `v` its bits), the value of the local `v` (2), in rax (3), a comparison in the flags (4, `v` its
// condition code), or a float in xmm0 (5). Only the top may be in rax, the flags or xmm0.
struct NVal {
    kind: i64,
    v: i64,
}

struct Nat {
    x: X64,
    m: WMod,
    nimp: i64,                  // imported functions (their indices come first)
    labels: List[i64],          // each function's label (an import: -1)
    impl_of: List[i64],         // each import: the function that does it (-1: none)
    k32: List[str],             // the functions of kernel32.dll, in the import table's order
    k32_of: Map[i64, i64],      // a function marked __k32_ -> its entry in k32
    base_fn: i64,               // the function marked __mem_base (-1: none)
    grow_l: i64,                // memory.grow (rcx: the pages to add; rax: the old count or -1)
    trap_l: i64,                // a trap: the program stops
    table_l: i64,               // the jumps of the table (call_indirect), 5 bytes each
    iat_at: i64,                // where the import address table is in the data
    failed: bool,
    msg: str,
    // the function being translated
    code: List[i64],
    pos: i64,
    np: i64,                    // its parameters
    nl: i64,                    // its other locals
    result: i64,                // its results
    lreg: List[i64],            // each local's register (-1: its place in the frame)
    saved: List[i64],           // the registers it uses, saved below its locals
    vals: List[NVal],           // the operand stack
    h: i64,                     // its height (the length of vals)
    max_h: i64,
    max_out: i64,               // the bytes of the outgoing area
    ctl: List[NCtl],
    dead: bool,                 // after br, return, unreachable: nothing runs until the next end or else
    dead_depth: i64,            // blocks opened in dead code
    frame_at: i64,              // where the frame's size is (written at the end)
}

fn n_fail(inout n: Nat, msg: str) {
    if not n.failed {
        n.failed = true
        n.msg = msg
    }
}

// ------------------------------------------------------------------ reading the code

fn n_byte(inout n: Nat) -> i64 {
    let b = n.code[n.pos]
    n.pos += 1
    b
}

// an unsigned LEB128 number
fn n_u(inout n: Nat) -> i64 {
    var r = 0
    var s = 0
    var b = 128
    while b >= 128 {
        b = n_byte(inout n)
        if s < 63 { r = bit_or(r, shl(bit_and(b, 127), s)) }
        s += 7
    }
    r
}

// a signed LEB128 number (up to 64 bits)
fn n_s(inout n: Nat) -> i64 {
    var r = 0
    var s = 0
    var b = 128
    while b >= 128 {
        b = n_byte(inout n)
        if s < 64 { r = bit_or(r, shl(bit_and(b, 127), s)) }
        s += 7
    }
    if s < 64 and bit_and(b, 64) != 0 { r = bit_or(r, shl(-1, s)) }
    r
}

// the bytes of a constant, little-endian
fn n_fixed(inout n: Nat, k: i64) -> i64 {
    var r = 0
    for i in 0..k { r = bit_or(r, shl(n_byte(inout n), 8 * i)) }
    if k == 4 and r >= 2147483648 { r = r - 4294967296 }
    r
}

// a block's type: the values it leaves
fn n_blocktype(inout n: Nat) -> i64 {
    let b = n.code[n.pos]
    if b == 64 {
        n.pos += 1
        return 0
    }
    if b == 127 or b == 126 or b == 125 or b == 124 {
        n.pos += 1
        return 1
    }
    let t = n_s(inout n)
    if t < 0 or t >= len(n.m.tresults) or len(n.m.tparams[t]) > 0 or len(n.m.tresults[t]) > 1 {
        n_fail(inout n, "a block of several values")
        return 0
    }
    len(n.m.tresults[t])
}

// ------------------------------------------------------------------ slots

// the operand slot at height s, and the local j, as displacements from rbp
fn n_slot(n: Nat, s: i64) -> i64 {
    -8 * (1 + n.nl + len(n.saved) + s)
}

// where the i-th saved register is kept
fn n_saved_at(n: Nat, i: i64) -> i64 {
    -8 * (1 + n.nl + i)
}

// The register that holds the value (a local's), or -1.
fn n_reg(n: Nat, v: NVal) -> i64 {
    if v.kind == 2 { n.lreg[v.v] } else { -1 }
}

fn n_local(n: Nat, j: i64) -> i64 {
    if j < n.np { 16 + 8 * j } else { -8 * (1 + j - n.np) }
}

// the global g, as a displacement from r15
fn n_global(g: i64) -> i64 {
    -65536 + 8 * g
}

fn n_pages_at() -> i64 {
    -8
}

fn n_out(inout n: Nat, bytes_: i64) {
    if bytes_ > n.max_out { n.max_out = bytes_ }
}

// the top slot
fn n_top(n: Nat) -> i64 {
    n_slot(n, n.h - 1)
}

// a 32-bit constant as its value with the sign
fn n_i32(v: i64) -> i64 {
    let u = bit_and(v, 4294967295)
    if u >= 2147483648 { u - 4294967296 } else { u }
}

// ------------------------------------------------------------------ the operand stack

fn nv(kind: i64, v: i64) -> NVal {
    NVal { kind: kind, v: v }
}

// A value pushed as it is held (the caller has the top settled, or popped it).
fn n_put(inout n: Nat, kind: i64, v: i64) {
    n.vals.push(nv(kind, v))
    n.h += 1
    if n.h > n.max_h { n.max_h = n.h }
}

// A value pushed: the top before it goes to its slot if it is in rax or the flags.
fn n_pushv(inout n: Nat, kind: i64, v: i64) {
    n_settle(inout n)
    n_put(inout n, kind, v)
}

fn n_popv(inout n: Nat) -> NVal {
    n.h -= 1
    n.vals.pop()
}

// The stack cut or grown to height h, the values in their slots.
fn n_set_height(inout n: Nat, h: i64) {
    while len(n.vals) > h { let _ = n.vals.pop() }
    while len(n.vals) < h { n.vals.push(nv(0, 0)) }
    n.h = h
    if n.h > n.max_h { n.max_h = n.h }
}

// [base + disp] <- a constant, 64 bits (through rcx when it does not fit in 32 with its sign)
fn n_store_const(inout n: Nat, base: i64, disp: i64, v: i64) {
    if fits32(v) {
        x_store_imm(inout n.x, base, disp, v)
    } else {
        x_mov_imm(inout n.x, rcx(), v)
        x_store(inout n.x, base, disp, rcx())
    }
}

// The top, when in rax or the flags, to its slot.
fn n_settle(inout n: Nat) {
    let k = n.h - 1
    if k < 0 { return }
    let t = n.vals[k]
    if t.kind == 4 {
        x_setcc(inout n.x, t.v, rax())
        x_movzx8(inout n.x, rax())
    }
    if t.kind == 3 or t.kind == 4 {
        x_store(inout n.x, rbp(), n_slot(n, k), rax())
        n.vals[k] = nv(0, 0)
    }
    if t.kind == 5 {
        x_movsd_store(inout n.x, rbp(), -1, n_slot(n, k), 0)
        n.vals[k] = nv(0, 0)
    }
}

// Every value to its slot. Only moves: the flags stay as they are.
fn n_flush(inout n: Nat) {
    n_settle(inout n)
    for i in 0..n.h {
        let v = n.vals[i]
        if v.kind == 1 {
            n_store_const(inout n, rbp(), n_slot(n, i), v.v)
            n.vals[i] = nv(0, 0)
        } else if v.kind == 2 {
            n_local_to_slot(inout n, v.v, i)
            n.vals[i] = nv(0, 0)
        }
    }
}

// local j's value to the slot at height i (through rcx when it is in the frame)
fn n_local_to_slot(inout n: Nat, j: i64, i: i64) {
    let r = n.lreg[j]
    if r >= 0 {
        x_store(inout n.x, rbp(), n_slot(n, i), r)
    } else {
        x_load(inout n.x, rcx(), rbp(), n_local(n, j))
        x_store(inout n.x, rbp(), n_slot(n, i), rcx())
    }
}

// The values that are local j's, to their slots (j is about to change), but the one at `keep`.
fn n_flush_local(inout n: Nat, j: i64, keep: i64) {
    for i in 0..n.h {
        let v = n.vals[i]
        if v.kind == 2 and v.v == j and i != keep {
            n_local_to_slot(inout n, j, i)
            n.vals[i] = nv(0, 0)
        }
    }
}

// Where the value at height h is in memory: (it is, its displacement from rbp).
fn n_mem(n: Nat, v: NVal, h: i64) -> (bool, i64) {
    if v.kind == 0 { return (true, n_slot(n, h)) }
    if v.kind == 2 and n.lreg[v.v] < 0 { return (true, n_local(n, v.v)) }
    (false, 0)
}

// The value at height h into reg: 64 bits (w), or 32 with the upper half cleared. The flags stay
// as they are, unless the value is a comparison.
fn n_get(inout n: Nat, v: NVal, h: i64, reg: i64, w: bool) {
    let r = n_reg(n, v)
    if r >= 0 {
        if not w {
            x_mov32(inout n.x, reg, r)
        } else if reg != r {
            x_mov(inout n.x, reg, r)
        }
        return
    }
    if v.kind == 0 or v.kind == 2 {
        let d = if v.kind == 0 { n_slot(n, h) } else { n_local(n, v.v) }
        if w { x_load(inout n.x, reg, rbp(), d) } else { x_load32(inout n.x, reg, rbp(), d) }
        return
    }
    if v.kind == 1 {
        x_mov_imm(inout n.x, reg, if w { v.v } else { bit_and(v.v, 4294967295) })
        return
    }
    if v.kind == 5 {
        x_movq_rx(inout n.x, reg, 0)
        if not w { x_mov32(inout n.x, reg, reg) }
        return
    }
    if v.kind == 4 {
        x_setcc(inout n.x, v.v, rax())
        x_movzx8(inout n.x, rax())
    }
    if w {
        if reg != rax() { x_mov(inout n.x, reg, rax()) }
    } else {
        x_mov32(inout n.x, reg, rax())
    }
}

// [base + disp] <- the value at height h, 64 bits (through rax: the top is the value, or none
// is in rax).
fn n_put_at(inout n: Nat, v: NVal, h: i64, base: i64, disp: i64) {
    if v.kind == 1 {
        n_store_const(inout n, base, disp, v.v)
        return
    }
    if v.kind == 5 {
        x_movsd_store(inout n.x, base, -1, disp, 0)
        return
    }
    n_get(inout n, v, h, rax(), true)
    x_store(inout n.x, base, disp, rax())
}

// rax op= the value b at height bh, an ALU operation ("reg, r/m": add or and sub xor cmp)
fn n_alu_v(inout n: Nat, op: i64, w: bool, b: NVal, bh: i64) {
    if b.kind == 1 and (if w { fits32(b.v) } else { true }) {
        x_alu_i(inout n.x, (op - 3) / 8, w, rax(), if w { b.v } else { n_i32(b.v) })
        return
    }
    let m = n_mem(n, b, bh)
    if m.0 {
        x_alu_m(inout n.x, op, w, rax(), rbp(), m.1)
        return
    }
    let r = n_reg(n, b)
    if r >= 0 {
        x_alu(inout n.x, op, w, rax(), r)
        return
    }
    n_get(inout n, b, bh, rcx(), w)
    x_alu(inout n.x, op, w, rax(), rcx())
}

// rax *= the value b
fn n_imul_v(inout n: Nat, w: bool, b: NVal, bh: i64) {
    if b.kind == 1 and (if w { fits32(b.v) } else { true }) {
        x_imul_i(inout n.x, w, rax(), rax(), if w { b.v } else { n_i32(b.v) })
        return
    }
    let m = n_mem(n, b, bh)
    if m.0 {
        x_imul_m(inout n.x, w, rax(), rbp(), m.1)
        return
    }
    let r = n_reg(n, b)
    n_get(inout n, b, bh, rcx(), w)
    x_rr(inout n.x, 0, w, [15, 175], rax(), if r >= 0 { r } else { rcx() })
}

// The condition a value gives (`if`, `br_if`): its condition code, with the flags set. A
// comparison is taken as it is; any other value is tested.
fn n_cond(inout n: Nat, c: NVal, ch: i64) -> i64 {
    if c.kind == 4 { return c.v }
    let r = n_reg(n, c)
    if r >= 0 {
        x_test(inout n.x, false, r, r)
        return cc_ne()
    }
    let m = n_mem(n, c, ch)
    if m.0 {
        // cmp dword [mem], 0
        x_rm(inout n.x, 0, false, [131], 7, rbp(), -1, m.1)
        xb(inout n.x, 0)
    } else {
        n_get(inout n, c, ch, rax(), false)
        x_test(inout n.x, false, rax(), rax())
    }
    cc_ne()
}

// ------------------------------------------------------------------ control

fn n_ctl(n: Nat, depth: i64) -> NCtl {
    n.ctl[len(n.ctl) - 1 - depth]
}

// The function's results, the top `k` values (in their slots): the first to rax, the others to
// the caller's outgoing area (above the return address and the saved rbp).
fn n_results(inout n: Nat, k: i64) {
    if k == 0 { return }
    x_load(inout n.x, rax(), rbp(), n_slot(n, n.h - k))
    for i in 1..k {
        x_load(inout n.x, rcx(), rbp(), n_slot(n, n.h - k + i))
        x_store(inout n.x, rbp(), 16 + 8 * (i - 1), rcx())
    }
}

// A branch to the block `depth` levels out (the values in their slots): its value (if it takes
// one) to its slot, then the jump.
fn n_branch(inout n: Nat, depth: i64) {
    let c = n_ctl(n, depth)
    if c.kind == 3 {
        n_results(inout n, c.results)
        x_jmp(inout n.x, c.label)
        return
    }
    if c.kind != 1 and c.results == 1 {
        let from = n_top(n)
        let to = n_slot(n, c.height)
        if from != to {
            x_load(inout n.x, rax(), rbp(), from)
            x_store(inout n.x, rbp(), to, rax())
        }
    }
    x_jmp(inout n.x, c.label)
}

// Whether a branch to the block `depth` levels out moves a value.
fn n_branch_moves(n: Nat, depth: i64) -> bool {
    let c = n_ctl(n, depth)
    if c.kind == 3 { return c.results >= 1 }
    c.kind != 1 and c.results == 1 and n_top(n) != n_slot(n, c.height)
}

fn n_open(inout n: Nat, kind: i64, results: i64) {
    var cc = -1
    if kind == 2 {
        // the condition, before the other values go to their slots (which keeps the flags)
        let c = n_popv(inout n)
        cc = n_cond(inout n, c, n.h)
    }
    n_flush(inout n)
    let l = x_label(inout n.x)
    if kind == 1 { x_bind(inout n.x, l) }
    var e = -1
    if kind == 2 {
        e = x_label(inout n.x)
        x_jcc(inout n.x, bit_xor(cc, 1), e)
    }
    n.ctl.push(NCtl { kind: kind, label: l, else_l: e, height: n.h, results: results, has_else: false })
}

fn n_else(inout n: Nat) {
    let k = len(n.ctl) - 1
    let c = n.ctl[k]
    if not n.dead {
        n_flush(inout n)
        x_jmp(inout n.x, c.label)
    }
    x_bind(inout n.x, c.else_l)
    n.ctl[k].has_else = true
    n_set_height(inout n, c.height)
    n.dead = false
}

// The end of a block, or of the function (true).
fn n_end(inout n: Nat) -> bool {
    let k = len(n.ctl) - 1
    let c = n.ctl[k]
    if not n.dead { n_flush(inout n) }
    if c.kind == 3 {
        if not n.dead { n_results(inout n, c.results) }
        x_bind(inout n.x, c.label)
        for i in 0..len(n.saved) { x_load(inout n.x, n.saved[i], rbp(), n_saved_at(n, i)) }
        x_leave(inout n.x)
        x_ret(inout n.x)
        let _ = n.ctl.pop()
        return true
    }
    if c.kind == 2 and not c.has_else { x_bind(inout n.x, c.else_l) }
    if c.kind != 1 { x_bind(inout n.x, c.label) }
    let _ = n.ctl.pop()
    n_set_height(inout n, c.height + c.results)
    n.dead = false
    false
}

// The immediates of an instruction in dead code, skipped (with the blocks it opens and closes).
fn n_skip(inout n: Nat, op: i64) {
    if op == 2 or op == 3 or op == 4 {
        let _ = n_blocktype(inout n)
        n.dead_depth += 1
    } else if op == 12 or op == 13 or op == 16 or (op >= 32 and op <= 38) {
        let _ = n_u(inout n)
    } else if op == 14 {
        let k = n_u(inout n)
        for i in 0..k + 1 { let _ = n_u(inout n) }
    } else if op == 17 {
        let _ = n_u(inout n)
        let _ = n_u(inout n)
    } else if op == 28 {
        let k = n_u(inout n)
        n.pos += k
    } else if op >= 40 and op <= 62 {
        let _ = n_u(inout n)
        let _ = n_u(inout n)
    } else if op == 63 or op == 64 {
        n.pos += 1
    } else if op == 65 or op == 66 {
        let _ = n_s(inout n)
    } else if op == 67 {
        n.pos += 4
    } else if op == 68 {
        n.pos += 8
    } else if op == 252 {
        let sub = n_u(inout n)
        if sub == 8 {
            let _ = n_u(inout n)
            n.pos += 1
        } else if sub == 9 {
            let _ = n_u(inout n)
        } else if sub == 10 {
            n.pos += 2
        } else if sub == 11 {
            n.pos += 1
        } else if sub >= 12 {
            let _ = n_u(inout n)
            let _ = n_u(inout n)
        }
    }
}

// ------------------------------------------------------------------ calls

// The arguments of a call to a function of `ptypes`, to the outgoing area (a 32-bit one
// zero-extended: WASI's functions written in Kairós take i64), popped.
fn n_args(inout n: Nat, ptypes: List[i64]) {
    let k = len(ptypes)
    // with no arguments, the top is no argument: the call would lose it from rax or the flags
    if k == 0 { n_settle(inout n) }
    let base = n.h - k
    // the last one may be in rax or the flags: it goes first
    for i in 0..k {
        let v = n.vals[base + i]
        if v.kind == 3 or v.kind == 4 {
            n_get(inout n, v, base + i, rax(), ptypes[i] != wt_i32())
            x_store(inout n.x, rsp(), 8 * i, rax())
        }
        if v.kind == 5 { x_movsd_store(inout n.x, rsp(), -1, 8 * i, 0) }
    }
    for i in 0..k {
        let v = n.vals[base + i]
        let w = ptypes[i] != wt_i32()
        if v.kind == 1 {
            n_store_const(inout n, rsp(), 8 * i, if w { v.v } else { bit_and(v.v, 4294967295) })
        } else if v.kind == 0 or v.kind == 2 {
            n_get(inout n, v, base + i, rcx(), w)
            x_store(inout n.x, rsp(), 8 * i, rcx())
        }
    }
    n_set_height(inout n, base)
    n_out(inout n, 8 * k)
}

// The results of a call: the first in rax, the others from the outgoing area to their slots.
fn n_take_results(inout n: Nat, k: i64) {
    if k == 0 { return }
    if k == 1 {
        n_put(inout n, 3, 0)
        return
    }
    x_store(inout n.x, rbp(), n_slot(n, n.h), rax())
    n_put(inout n, 0, 0)
    for i in 1..k {
        x_load(inout n.x, rcx(), rsp(), 8 * (i - 1))
        x_store(inout n.x, rbp(), n_slot(n, n.h), rcx())
        n_put(inout n, 0, 0)
    }
    n_out(inout n, 8 * (k - 1))
}

fn n_call(inout n: Nat, f: i64) {
    var target = f
    var ptypes: List[i64] = []
    var results = 0
    if f < n.nimp {
        let ti = n.m.imports[f].2
        ptypes = n.m.tparams[ti]
        results = len(n.m.tresults[ti])
        target = n.impl_of[f]
        if target < 0 {
            n_fail(inout n, "a call to `" + n.m.imports[f].0 + "." + n.m.imports[f].1 + "`, which has no native function")
            return
        }
    } else {
        let ti = n.m.funcs[f - n.nimp].tidx
        ptypes = n.m.tparams[ti]
        results = len(n.m.tresults[ti])
    }
    n_args(inout n, ptypes)
    x_call(inout n.x, n.labels[target])
    n_take_results(inout n, results)
}

fn n_call_indirect(inout n: Nat, ti: i64) {
    let ptypes = n.m.tparams[ti]
    let results = len(n.m.tresults[ti])
    // the table's entry (it may be in rax or the flags: first), checked, times 5
    let at = n_popv(inout n)
    n_get(inout n, at, n.h, rdx(), false)
    n_args(inout n, ptypes)
    x_alu_i(inout n.x, 7, false, rdx(), len(n.m.table))
    x_jcc(inout n.x, cc_ae(), n.trap_l)
    x_imul_i(inout n.x, false, rdx(), rdx(), 5)
    x_lea_label(inout n.x, rcx(), n.table_l)
    x_alu(inout n.x, op_add(), true, rdx(), rcx())
    x_call_r(inout n.x, rdx())
    n_take_results(inout n, results)
}

// ------------------------------------------------------------------ instructions

// the condition codes of eq ne lt_s lt_u gt_s gt_u le_s le_u ge_s ge_u
fn n_int_cc(k: i64) -> i64 {
    [4, 5, 12, 2, 15, 7, 14, 6, 13, 3][k]
}

// an integer comparison (w: 64 bits): its result stays in the flags
fn n_compare(inout n: Nat, w: bool, cc: i64) {
    let b = n_popv(inout n)
    let bh = n.h
    let a = n_popv(inout n)
    let ah = n.h
    if b.kind == 3 or b.kind == 4 {
        n_get(inout n, b, bh, rcx(), w)
        n_get(inout n, a, ah, rax(), w)
        x_alu(inout n.x, op_cmp(), w, rax(), rcx())
    } else {
        n_get(inout n, a, ah, rax(), w)
        n_alu_v(inout n, op_cmp(), w, b, bh)
    }
    n_put(inout n, 4, cc)
}

// eqz: the negated comparison, or a test
fn n_eqz(inout n: Nat, w: bool) {
    let a = n_popv(inout n)
    let ah = n.h
    if a.kind == 4 {
        n_put(inout n, 4, bit_xor(a.v, 1))
        return
    }
    let r = n_reg(n, a)
    if r >= 0 {
        x_test(inout n.x, w, r, r)
        n_put(inout n, 4, cc_e())
        return
    }
    let m = n_mem(n, a, ah)
    if m.0 {
        x_rm(inout n.x, 0, w, [131], 7, rbp(), -1, m.1)
        xb(inout n.x, 0)
    } else {
        n_get(inout n, a, ah, rax(), w)
        x_test(inout n.x, w, rax(), rax())
    }
    n_put(inout n, 4, cc_e())
}

// The float value at height h into xmm (a constant through rcx).
fn n_getx(inout n: Nat, v: NVal, h: i64, xmm: i64) {
    let m = n_mem(n, v, h)
    if m.0 {
        x_movsd_load(inout n.x, xmm, rbp(), -1, m.1)
    } else if v.kind == 1 {
        x_mov_imm(inout n.x, rcx(), v.v)
        x_movq_xr(inout n.x, xmm, rcx())
    } else if n_reg(n, v) >= 0 {
        x_movq_xr(inout n.x, xmm, n_reg(n, v))
    } else if v.kind == 5 {
        if xmm != 0 { x_movsd_rr(inout n.x, xmm, 0) }
    } else {
        x_movq_xr(inout n.x, xmm, rax())
    }
}

// xmm0 as the result
fn n_fresult(inout n: Nat) {
    n_put(inout n, 5, 0)
}

// a float comparison: eq ne lt gt le ge (k 0..5)
fn n_fcompare(inout n: Nat, k: i64) {
    let b = n_popv(inout n)
    let bh = n.h
    let a = n_popv(inout n)
    let ah = n.h
    n_getx(inout n, b, bh, 1)
    n_getx(inout n, a, ah, 0)
    if k == 0 or k == 1 {
        x_ucomisd(inout n.x, 0, 1)
        if k == 0 {
            x_setcc(inout n.x, cc_e(), rax())
            x_setcc(inout n.x, cc_np(), rcx())
            x_alu(inout n.x, op_and(), false, rax(), rcx())
        } else {
            x_setcc(inout n.x, cc_ne(), rax())
            x_setcc(inout n.x, cc_p(), rcx())
            x_alu(inout n.x, op_or(), false, rax(), rcx())
        }
        x_movzx8(inout n.x, rax())
        n_put(inout n, 3, 0)
    } else if k == 2 or k == 4 {
        // a < b is b > a (false on NaN: "above" needs CF = 0)
        x_ucomisd(inout n.x, 1, 0)
        n_put(inout n, 4, if k == 2 { cc_a() } else { cc_ae() })
    } else {
        x_ucomisd(inout n.x, 0, 1)
        n_put(inout n, 4, if k == 3 { cc_a() } else { cc_ae() })
    }
}

// integer arithmetic: add sub mul div_s div_u rem_s rem_u and or xor shl shr_s shr_u rotl rotr (k 0..14)
fn n_arith(inout n: Nat, w: bool, k: i64) {
    let b = n_popv(inout n)
    let bh = n.h
    let a = n_popv(inout n)
    let ah = n.h
    let b_in_rax = b.kind == 3 or b.kind == 4
    if k >= 3 and k <= 6 {
        // division: the divisor in rcx, the dividend in rax; by zero traps; rem_s by -1 is 0
        // (idiv would fault on the most negative)
        if b_in_rax {
            n_get(inout n, b, bh, rcx(), w)
            n_get(inout n, a, ah, rax(), w)
        } else {
            n_get(inout n, a, ah, rax(), w)
            n_get(inout n, b, bh, rcx(), w)
        }
        let zero_free = b.kind == 1 and bit_and(b.v, if w { -1 } else { 4294967295 }) != 0
        if not zero_free {
            x_test(inout n.x, w, rcx(), rcx())
            x_jcc(inout n.x, cc_e(), n.trap_l)
        }
        let done = x_label(inout n.x)
        if k == 5 {
            let go = x_label(inout n.x)
            x_alu_i(inout n.x, 7, w, rcx(), -1)
            x_jcc(inout n.x, cc_ne(), go)
            x_imm(inout n.x, rdx(), 0)
            x_jmp(inout n.x, done)
            x_bind(inout n.x, go)
        }
        if k == 3 or k == 5 {
            x_cqo(inout n.x, w)
            x_div(inout n.x, 7, w, rcx())
        } else {
            x_imm(inout n.x, rdx(), 0)
            x_div(inout n.x, 6, w, rcx())
        }
        x_bind(inout n.x, done)
        if k == 5 or k == 6 { x_mov(inout n.x, rax(), rdx()) }
        n_put(inout n, 3, 0)
        return
    }
    if k >= 10 {
        // shifts and rotations: the count modulo the width, as WebAssembly
        let ext = [4, 7, 5, 0, 1][k - 10]
        if b.kind == 1 {
            n_get(inout n, a, ah, rax(), w)
            x_shift_i(inout n.x, ext, w, rax(), bit_and(b.v, if w { 63 } else { 31 }))
        } else {
            if b_in_rax {
                n_get(inout n, b, bh, rcx(), w)
                n_get(inout n, a, ah, rax(), w)
            } else {
                n_get(inout n, a, ah, rax(), w)
                n_get(inout n, b, bh, rcx(), w)
            }
            x_shift_cl(inout n.x, ext, w, rax())
        }
        n_put(inout n, 3, 0)
        return
    }
    let commutes = k == 0 or k == 2 or k == 7 or k == 8 or k == 9
    var x = b
    var xh = bh
    if b_in_rax {
        n_get(inout n, b, bh, rax(), w)
        if commutes {
            x = a
            xh = ah
        } else {
            // a - b, with b in rax
            x_mov(inout n.x, rcx(), rax())
            n_get(inout n, a, ah, rax(), w)
            x_alu(inout n.x, op_sub(), w, rax(), rcx())
            n_put(inout n, 3, 0)
            return
        }
    } else {
        n_get(inout n, a, ah, rax(), w)
    }
    if k == 2 {
        n_imul_v(inout n, w, x, xh)
    } else {
        n_alu_v(inout n, [op_add(), op_sub(), 0, 0, 0, 0, 0, op_and(), op_or(), op_xor()][k], w, x, xh)
    }
    n_put(inout n, 3, 0)
}

// clz ctz popcnt (k 0..2)
fn n_count(inout n: Nat, w: bool, k: i64) {
    let a = n_popv(inout n)
    n_get(inout n, a, n.h, rcx(), w)
    x_bitcount(inout n.x, [189, 188, 184][k], w, rax(), rcx())
    n_put(inout n, 3, 0)
}

// float arithmetic: abs neg ceil floor trunc nearest sqrt add sub mul div min max copysign (k 0..13)
fn n_farith(inout n: Nat, k: i64) {
    if k <= 6 {
        let a = n_popv(inout n)
        let ah = n.h
        if k <= 1 {
            n_get(inout n, a, ah, rax(), true)
            x_bit_i(inout n.x, if k == 0 { 6 } else { 7 }, rax(), 63)
            n_put(inout n, 3, 0)
            return
        }
        n_getx(inout n, a, ah, 0)
        if k == 6 { x_sse(inout n.x, 81, 0, 0) } else { x_roundsd(inout n.x, 0, 0, [10, 9, 11, 8][k - 2]) }
        n_fresult(inout n)
        return
    }
    let b = n_popv(inout n)
    let bh = n.h
    let a = n_popv(inout n)
    let ah = n.h
    if k <= 10 {
        let op = [88, 92, 89, 94][k - 7]
        let m = n_mem(n, b, bh)
        if m.0 {
            n_getx(inout n, a, ah, 0)
            x_sse_m(inout n.x, op, 0, rbp(), m.1)
        } else {
            n_getx(inout n, b, bh, 1)
            n_getx(inout n, a, ah, 0)
            x_sse(inout n.x, op, 0, 1)
        }
        n_fresult(inout n)
        return
    }
    if k == 13 {
        // copysign: a's magnitude, b's sign
        if b.kind == 3 {
            n_get(inout n, b, bh, rcx(), true)
            n_get(inout n, a, ah, rax(), true)
        } else {
            n_get(inout n, a, ah, rax(), true)
            n_get(inout n, b, bh, rcx(), true)
        }
        x_bit_i(inout n.x, 6, rax(), 63)
        x_shift_i(inout n.x, 5, true, rcx(), 63)
        x_shift_i(inout n.x, 4, true, rcx(), 63)
        x_alu(inout n.x, op_or(), true, rax(), rcx())
        n_put(inout n, 3, 0)
        return
    }
    // min and max: NaN if either is; -0 below +0
    let nan = x_label(inout n.x)
    let diff = x_label(inout n.x)
    let done = x_label(inout n.x)
    n_getx(inout n, b, bh, 1)
    n_getx(inout n, a, ah, 0)
    x_ucomisd(inout n.x, 0, 1)
    x_jcc(inout n.x, cc_p(), nan)
    x_jcc(inout n.x, cc_ne(), diff)
    // equal (or zeros of either sign): the bits or-ed (min) or and-ed (max)
    x_movq_rx(inout n.x, rax(), 0)
    x_movq_rx(inout n.x, rcx(), 1)
    x_alu(inout n.x, if k == 11 { op_or() } else { op_and() }, true, rax(), rcx())
    x_jmp(inout n.x, done)
    x_bind(inout n.x, diff)
    x_sse(inout n.x, if k == 11 { 93 } else { 95 }, 0, 1)
    x_movq_rx(inout n.x, rax(), 0)
    x_jmp(inout n.x, done)
    x_bind(inout n.x, nan)
    x_sse(inout n.x, 88, 0, 1)
    x_movq_rx(inout n.x, rax(), 0)
    x_bind(inout n.x, done)
    n_put(inout n, 3, 0)
}

// i32/i64.trunc_f64_s: toward zero, trapping on NaN and out of range
fn n_trunc(inout n: Nat, w: bool) {
    let a = n_popv(inout n)
    n_getx(inout n, a, n.h, 0)
    let ok = x_label(inout n.x)
    if w {
        x_cvttsd2si(inout n.x, true, rax(), 0)
        // 2^63 marks an invalid one, unless the float is exactly -2^63
        x_mov_imm(inout n.x, rcx(), -9223372036854775807 - 1)
        x_alu(inout n.x, op_cmp(), true, rax(), rcx())
        x_jcc(inout n.x, cc_ne(), ok)
        x_mov_imm(inout n.x, rdx(), to_bits(-9223372036854775808.0))
        x_movq_xr(inout n.x, 1, rdx())
        x_ucomisd(inout n.x, 0, 1)
        x_jcc(inout n.x, cc_p(), n.trap_l)
        x_jcc(inout n.x, cc_ne(), n.trap_l)
    } else {
        // through 64 bits: in range when it fits in 32 with its sign
        x_cvttsd2si(inout n.x, true, rax(), 0)
        x_movsxd(inout n.x, rcx(), rax())
        x_alu(inout n.x, op_cmp(), true, rax(), rcx())
        x_jcc(inout n.x, cc_ne(), n.trap_l)
        x_ucomisd(inout n.x, 0, 0)
        x_jcc(inout n.x, cc_p(), n.trap_l)
    }
    x_bind(inout n.x, ok)
    n_put(inout n, 3, 0)
}

// The address of a memory access: (a constant one, its value), or else in rax (32 bits) with
// the offset in the result's second part.
fn n_address(inout n: Nat, a: NVal, ah: i64, off: i64) -> (bool, i64) {
    if a.kind == 1 and bit_and(a.v, 4294967295) + off <= 2147483647 {
        return (true, bit_and(a.v, 4294967295) + off)
    }
    n_get(inout n, a, ah, rax(), false)
    if off > 2147483647 {
        x_mov_imm(inout n.x, rdx(), off)
        x_alu(inout n.x, op_add(), true, rax(), rdx())
        return (false, 0)
    }
    (false, off)
}

fn n_load(inout n: Nat, op: i64) {
    let _ = n_u(inout n)
    let off = n_u(inout n)
    let a = n_popv(inout n)
    let at = n_address(inout n, a, n.h, off)
    let kind = [4, 6, 4, 6, 1, 0, 3, 2, 1, 0, 3, 2, 5, 4][op - 40]
    let w = op == 48 or op == 50
    if at.0 {
        x_load_kind(inout n.x, kind, w, rax(), r15(), -1, at.1)
    } else {
        x_load_kind(inout n.x, kind, w, rax(), r15(), rax(), at.1)
    }
    n_put(inout n, 3, 0)
}

fn n_store(inout n: Nat, op: i64) {
    let _ = n_u(inout n)
    let off = n_u(inout n)
    let v = n_popv(inout n)
    let vh = n.h
    let a = n_popv(inout n)
    let ah = n.h
    let size = [4, 8, 4, 8, 1, 2, 1, 2, 4][op - 54]
    // the value: an immediate, xmm0, or rcx (taken first: it may be in rax)
    let imm = v.kind == 1 and (size < 8 or fits32(v.v))
    let in_xmm = v.kind == 5 and (op == 57 or op == 56)
    if not imm and not in_xmm { n_get(inout n, v, vh, rcx(), true) }
    let at = n_address(inout n, a, ah, off)
    let index = if at.0 { -1 } else { rax() }
    if in_xmm {
        if op == 57 { x_movsd_store(inout n.x, r15(), index, at.1, 0) } else { x_movss_store(inout n.x, r15(), index, at.1, 0) }
    } else if imm {
        x_store_imm_n(inout n.x, size, r15(), index, at.1, v.v)
    } else {
        x_store_n(inout n.x, size, rcx(), r15(), index, at.1)
    }
}

// select: v1 if the condition holds, else v2
fn n_select(inout n: Nat) {
    let c = n_popv(inout n)
    let ch = n.h
    let v2 = n_popv(inout n)
    let v2h = n.h
    let v1 = n_popv(inout n)
    let v1h = n.h
    if c.kind == 1 {
        // known now
        let v = if bit_and(c.v, 4294967295) != 0 { v1 } else { v2 }
        n_get(inout n, v, if bit_and(c.v, 4294967295) != 0 { v1h } else { v2h }, rax(), true)
        n_put(inout n, 3, 0)
        return
    }
    if c.kind == 3 { x_mov32(inout n.x, rdx(), rax()) }
    // (moves only: a comparison's flags stay)
    n_get(inout n, v2, v2h, rcx(), true)
    n_get(inout n, v1, v1h, rax(), true)
    var cc = 0
    if c.kind == 4 {
        cc = c.v
    } else if c.kind == 3 {
        x_test(inout n.x, false, rdx(), rdx())
        cc = cc_ne()
    } else if n_reg(n, c) >= 0 {
        x_test(inout n.x, false, n_reg(n, c), n_reg(n, c))
        cc = cc_ne()
    } else {
        let m = n_mem(n, c, ch)
        x_rm(inout n.x, 0, false, [131], 7, rbp(), -1, m.1)
        xb(inout n.x, 0)
        cc = cc_ne()
    }
    x_cmov(inout n.x, bit_xor(cc, 1), rax(), rcx())
    n_put(inout n, 3, 0)
}

// local.set (or local.tee: the value stays on the stack)
fn n_set_local(inout n: Nat, j: i64, tee: bool) {
    if tee {
        let k = n.h - 1
        let v = n.vals[k]
        if v.kind == 2 and v.v == j { return }
        n_flush_local(inout n, j, k)
        if v.kind == 4 {
            n_get(inout n, v, k, rax(), true)
            n.vals[k] = nv(3, 0)
        }
        n_to_local(inout n, n.vals[k], k, j)
        return
    }
    let v = n_popv(inout n)
    let vh = n.h
    if v.kind == 2 and v.v == j { return }
    n_flush_local(inout n, j, -1)
    n_to_local(inout n, v, vh, j)
}

// local j <- the value at height h
fn n_to_local(inout n: Nat, v: NVal, h: i64, j: i64) {
    let r = n.lreg[j]
    if r >= 0 {
        n_get(inout n, v, h, r, true)
    } else {
        n_put_at(inout n, v, h, rbp(), n_local(n, j))
    }
}

// How much each local is used: its gets, sets and tees, 8 times more in each loop around them
// (up to 8^5), with no instruction translated.
fn n_weights(inout n: Nat) -> List[i64] {
    var w: List[i64] = []
    for j in 0..n.np + n.nl { w.push(0) }
    var open: List[i64] = []
    var loops = 0
    n.pos = 0
    let depth0 = n.dead_depth
    while n.pos < len(n.code) {
        let op = n_byte(inout n)
        if op == 11 {
            if len(open) == 0 { break }
            let k = open.pop()
            if k == 3 { loops -= 1 }
        } else if op == 32 or op == 33 or op == 34 {
            let j = n_u(inout n)
            var add = 1
            for i in 0..min(loops, 5) { add = add * 8 }
            if j < len(w) { w[j] = w[j] + add }
        } else {
            if op == 2 or op == 3 or op == 4 {
                open.push(op)
                if op == 3 { loops += 1 }
            }
            n_skip(inout n, op)
        }
    }
    n.dead_depth = depth0
    n.pos = 0
    w
}

// The registers of the locals used most (at least 3 times, by weight): up to six.
fn n_alloc_regs(inout n: Nat) {
    let total = n.np + n.nl
    n.lreg = []
    n.saved = []
    for j in 0..total { n.lreg.push(-1) }
    let w = n_weights(inout n)
    let regs = [rbx(), rsi(), rdi(), 12, 13, 14]
    var taken = 0
    while taken < len(regs) {
        var best = -1
        for j in 0..total {
            if n.lreg[j] < 0 and w[j] >= 3 and (best < 0 or w[j] > w[best]) { best = j }
        }
        if best < 0 { break }
        n.lreg[best] = regs[taken]
        n.saved.push(regs[taken])
        taken += 1
    }
}

// One instruction (its opcode read). True at the function's end.
fn n_inst(inout n: Nat, op: i64) -> bool {
    if n.dead {
        if op == 11 {
            if n.dead_depth > 0 {
                n.dead_depth -= 1
                return false
            }
            return n_end(inout n)
        }
        if op == 5 and n.dead_depth == 0 {
            n_else(inout n)
            return false
        }
        n_skip(inout n, op)
        return false
    }
    if op == 0 {
        x_jmp(inout n.x, n.trap_l)
        n.dead = true
    } else if op == 1 {
    } else if op == 2 or op == 3 or op == 4 {
        let r = n_blocktype(inout n)
        n_open(inout n, op - 2, r)
    } else if op == 5 {
        n_else(inout n)
    } else if op == 11 {
        return n_end(inout n)
    } else if op == 12 {
        n_flush(inout n)
        n_branch(inout n, n_u(inout n))
        n.dead = true
    } else if op == 13 {
        let depth = n_u(inout n)
        let c = n_popv(inout n)
        let cc = n_cond(inout n, c, n.h)
        n_flush(inout n)
        if n_branch_moves(n, depth) {
            let skip = x_label(inout n.x)
            x_jcc(inout n.x, bit_xor(cc, 1), skip)
            n_branch(inout n, depth)
            x_bind(inout n.x, skip)
        } else {
            let t = n_ctl(n, depth)
            x_jcc(inout n.x, cc, t.label)
        }
    } else if op == 14 {
        let k = n_u(inout n)
        var ds: List[i64] = []
        for i in 0..k + 1 { ds.push(n_u(inout n)) }
        let c = n_popv(inout n)
        n_get(inout n, c, n.h, rdx(), false)
        n_flush(inout n)
        for i in 0..k {
            let next = x_label(inout n.x)
            x_alu_i(inout n.x, 7, false, rdx(), i)
            x_jcc(inout n.x, cc_ne(), next)
            n_branch(inout n, ds[i])
            x_bind(inout n.x, next)
        }
        n_branch(inout n, ds[k])
        n.dead = true
    } else if op == 15 {
        n_flush(inout n)
        n_branch(inout n, len(n.ctl) - 1)
        n.dead = true
    } else if op == 16 {
        n_call(inout n, n_u(inout n))
    } else if op == 17 {
        let ti = n_u(inout n)
        let _ = n_u(inout n)
        n_call_indirect(inout n, ti)
    } else if op == 26 {
        let _ = n_popv(inout n)
    } else if op == 27 or op == 28 {
        if op == 28 {
            let k = n_u(inout n)
            n.pos += k
        }
        n_select(inout n)
    } else if op == 32 {
        n_pushv(inout n, 2, n_u(inout n))
    } else if op == 33 {
        n_set_local(inout n, n_u(inout n), false)
    } else if op == 34 {
        n_set_local(inout n, n_u(inout n), true)
    } else if op == 35 {
        let g = n_u(inout n)
        n_settle(inout n)
        x_load(inout n.x, rax(), r15(), n_global(g))
        n_put(inout n, 3, 0)
    } else if op == 36 {
        let g = n_u(inout n)
        let v = n_popv(inout n)
        n_put_at(inout n, v, n.h, r15(), n_global(g))
    } else if op >= 40 and op <= 53 {
        n_load(inout n, op)
    } else if op >= 54 and op <= 62 {
        n_store(inout n, op)
    } else if op == 63 {
        n.pos += 1
        n_settle(inout n)
        x_load(inout n.x, rax(), r15(), n_pages_at())
        n_put(inout n, 3, 0)
    } else if op == 64 {
        n.pos += 1
        let a = n_popv(inout n)
        n_get(inout n, a, n.h, rcx(), false)
        x_call(inout n.x, n.grow_l)
        n_put(inout n, 3, 0)
    } else if op == 65 {
        n_pushv(inout n, 1, n_i32(n_s(inout n)))
    } else if op == 66 {
        n_pushv(inout n, 1, n_s(inout n))
    } else if op == 67 {
        n_pushv(inout n, 1, n_fixed(inout n, 4))
    } else if op == 68 {
        n_pushv(inout n, 1, n_fixed(inout n, 8))
    } else if op == 69 {
        n_eqz(inout n, false)
    } else if op >= 70 and op <= 79 {
        n_compare(inout n, false, n_int_cc(op - 70))
    } else if op == 80 {
        n_eqz(inout n, true)
    } else if op >= 81 and op <= 90 {
        n_compare(inout n, true, n_int_cc(op - 81))
    } else if op >= 97 and op <= 102 {
        n_fcompare(inout n, op - 97)
    } else if op >= 103 and op <= 105 {
        n_count(inout n, false, op - 103)
    } else if op >= 106 and op <= 120 {
        n_arith(inout n, false, op - 106)
    } else if op >= 121 and op <= 123 {
        n_count(inout n, true, op - 121)
    } else if op >= 124 and op <= 138 {
        n_arith(inout n, true, op - 124)
    } else if op >= 153 and op <= 166 {
        n_farith(inout n, op - 153)
    } else if op == 167 {
        // wrap: the low 32 bits (a constant keeps them with their sign)
        let k = n.h - 1
        let v = n.vals[k]
        if v.kind == 1 { n.vals[k] = nv(1, n_i32(v.v)) }
    } else if op == 188 or op == 189 or op == 190 or op == 191 {
        // the reinterpretations: the same bits (a float's from xmm0 to rax)
        let k = n.h - 1
        if n.vals[k].kind == 5 {
            x_movq_rx(inout n.x, rax(), 0)
            n.vals[k] = nv(3, 0)
        }
    } else if op == 170 {
        n_trunc(inout n, false)
    } else if op == 176 {
        n_trunc(inout n, true)
    } else if op == 172 or op == 196 {
        let a = n_popv(inout n)
        let ah = n.h
        if a.kind == 1 {
            n_put(inout n, 1, n_i32(a.v))
        } else {
            let m = n_mem(n, a, ah)
            if m.0 {
                x_load32s(inout n.x, rax(), rbp(), m.1)
            } else {
                n_get(inout n, a, ah, rax(), false)
                x_movsxd(inout n.x, rax(), rax())
            }
            n_put(inout n, 3, 0)
        }
    } else if op == 173 {
        let a = n_popv(inout n)
        if a.kind == 1 {
            n_put(inout n, 1, bit_and(a.v, 4294967295))
        } else {
            n_get(inout n, a, n.h, rax(), false)
            n_put(inout n, 3, 0)
        }
    } else if op >= 192 and op <= 195 {
        // extend8_s, extend16_s of i32 and i64
        let a = n_popv(inout n)
        let w = op >= 194
        n_get(inout n, a, n.h, rax(), w)
        x_movsx_r(inout n.x, op == 192 or op == 194, w, rax())
        n_put(inout n, 3, 0)
    } else if op == 183 or op == 184 or op == 185 {
        let a = n_popv(inout n)
        let ah = n.h
        if op == 183 {
            n_get(inout n, a, ah, rax(), false)
            x_movsxd(inout n.x, rax(), rax())
        } else {
            n_get(inout n, a, ah, rax(), op == 185)
        }
        x_cvtsi2sd(inout n.x, 0, rax())
        n_fresult(inout n)
    } else if op == 182 {
        let a = n_popv(inout n)
        n_getx(inout n, a, n.h, 0)
        x_cvtsd2ss(inout n.x, 0, 0)
        n_fresult(inout n)
    } else if op == 187 {
        let a = n_popv(inout n)
        n_get(inout n, a, n.h, rax(), false)
        x_movq_xr(inout n.x, 0, rax())
        x_cvtss2sd(inout n.x, 0, 0)
        n_fresult(inout n)
    } else {
        n_fail(inout n, "the instruction " + to_hex(op, 2))
    }
    false
}

// ------------------------------------------------------------------ functions

fn n_func(inout n: Nat, k: i64) {
    let f = n.m.funcs[k]
    let fi = n.nimp + k
    x_bind(inout n.x, n.labels[fi])
    n.np = len(n.m.tparams[f.tidx])
    n.nl = len(f.locals)
    n.result = len(n.m.tresults[f.tidx])
    // a function marked for kernel32: the call, in Windows' convention
    if contains(n.k32_of, fi) {
        let slot = n.k32_of[fi]
        let stack = if n.np > 4 { 8 * (n.np - 4) } else { 0 }
        x_push(inout n.x, rbp())
        x_mov(inout n.x, rbp(), rsp())
        x_alu_i(inout n.x, 5, true, rsp(), (32 + stack + 15) / 16 * 16)
        let regs = [rcx(), rdx(), r8(), r9()]
        for i in 0..n.np {
            if i < 4 {
                x_load(inout n.x, regs[i], rbp(), 16 + 8 * i)
            } else {
                x_load(inout n.x, rax(), rbp(), 16 + 8 * i)
                x_store(inout n.x, rsp(), 32 + 8 * (i - 4), rax())
            }
        }
        x_call_rdata(inout n.x, n.iat_at + 8 * slot)
        x_leave(inout n.x)
        x_ret(inout n.x)
        return
    }
    if fi == n.base_fn {
        x_mov(inout n.x, rax(), r15())
        x_ret(inout n.x)
        return
    }
    n.code = f.code
    n.pos = 0
    n_alloc_regs(inout n)
    n.vals = []
    n.h = 0
    n.max_h = 0
    n.max_out = 0
    n.dead = false
    n.dead_depth = 0
    n.ctl = [NCtl { kind: 3, label: x_label(inout n.x), else_l: -1, height: 0, results: n.result, has_else: false }]
    x_push(inout n.x, rbp())
    x_mov(inout n.x, rbp(), rsp())
    // sub rsp, the frame (written at the end)
    x_rr(inout n.x, 0, true, [129], 5, rsp())
    n.frame_at = len(n.x.code)
    x_i32(inout n.x, 0)
    for i in 0..len(n.saved) { x_store(inout n.x, rbp(), n_saved_at(n, i), n.saved[i]) }
    for j in 0..n.np {
        if n.lreg[j] >= 0 { x_load(inout n.x, n.lreg[j], rbp(), n_local(n, j)) }
    }
    if n.nl > 0 {
        x_imm(inout n.x, rax(), 0)
        for j in 0..n.nl {
            let r = n.lreg[n.np + j]
            if r >= 0 { x_imm(inout n.x, r, 0) } else { x_store(inout n.x, rbp(), -8 * (1 + j), rax()) }
        }
    }
    var done = false
    while not done and not n.failed {
        if n.pos >= len(n.code) {
            n_fail(inout n, "a function without its end")
            return
        }
        done = n_inst(inout n, n_byte(inout n))
    }
    let frame = (8 * (n.nl + len(n.saved) + n.max_h) + n.max_out + 15) / 16 * 16
    x_patch32(inout n.x, n.frame_at, frame)
}

// memory.grow: rcx the pages to add (32 bits); rax the old count, or -1 (32 bits) when it cannot
fn n_grow_fn(inout n: Nat, va_slot: i64) {
    x_bind(inout n.x, n.grow_l)
    x_push(inout n.x, rbp())
    x_mov(inout n.x, rbp(), rsp())
    // (its locals above the 32 bytes of shadow space VirtualAlloc may use)
    x_alu_i(inout n.x, 5, true, rsp(), 64)
    let fail = x_label(inout n.x)
    let done = x_label(inout n.x)
    x_mov32(inout n.x, rcx(), rcx())
    x_load(inout n.x, rax(), r15(), n_pages_at())
    x_store(inout n.x, rbp(), -8, rax())
    x_store(inout n.x, rbp(), -16, rcx())
    x_alu(inout n.x, op_add(), true, rax(), rcx())
    x_alu_i(inout n.x, 7, true, rax(), 65536)
    x_jcc(inout n.x, cc_a(), fail)
    x_store(inout n.x, rbp(), -24, rax())
    x_test(inout n.x, true, rcx(), rcx())
    x_jcc(inout n.x, cc_e(), done)
    // VirtualAlloc(memory + old * 64 KiB, pages * 64 KiB, MEM_COMMIT, PAGE_READWRITE)
    x_load(inout n.x, rcx(), rbp(), -8)
    x_shift_i(inout n.x, 4, true, rcx(), 16)
    x_alu(inout n.x, op_add(), true, rcx(), r15())
    x_load(inout n.x, rdx(), rbp(), -16)
    x_shift_i(inout n.x, 4, true, rdx(), 16)
    x_imm(inout n.x, r8(), 4096)
    x_imm(inout n.x, r9(), 4)
    x_call_rdata(inout n.x, n.iat_at + 8 * va_slot)
    x_test(inout n.x, true, rax(), rax())
    x_jcc(inout n.x, cc_e(), fail)
    x_load(inout n.x, rax(), rbp(), -24)
    x_store(inout n.x, r15(), n_pages_at(), rax())
    x_bind(inout n.x, done)
    x_load(inout n.x, rax(), rbp(), -8)
    x_leave(inout n.x)
    x_ret(inout n.x)
    x_bind(inout n.x, fail)
    x_imm(inout n.x, rax(), 4294967295)
    x_leave(inout n.x)
    x_ret(inout n.x)
}

// The index of a kernel32 function in the import table, added when new.
fn n_k32(inout n: Nat, name: str) -> i64 {
    for i in 0..len(n.k32) {
        if n.k32[i] == name { return i }
    }
    n.k32.push(name)
    len(n.k32) - 1
}

// The module as a Windows executable: (no error, its bytes, the error).
fn native_exe(m: WMod) -> (bool, Bytes, str) {
    var n = Nat {
        x: x64_new(), m: m, nimp: len(m.imports), labels: [], impl_of: [], k32: [], k32_of: [:], base_fn: -1,
        grow_l: 0, trap_l: 0, table_l: 0, iat_at: 0, failed: false, msg: "",
        code: [], pos: 0, np: 0, nl: 0, result: 0, lreg: [], saved: [], vals: [], h: 0, max_h: 0, max_out: 0, ctl: [], dead: false, dead_depth: 0, frame_at: 0,
    }
    let total = n.nimp + len(m.funcs)
    for i in 0..total { n.labels.push(if i < n.nimp { -1 } else { x_label(inout n.x) }) }
    for i in 0..n.nimp { n.impl_of.push(-1) }
    let va = n_k32(inout n, "VirtualAlloc")
    let exit_slot = n_k32(inout n, "ExitProcess")
    var start = -1
    for e in m.exports {
        if e.1 != 0 { continue }
        if e.0 == "_start" { start = e.2 }
        if starts_with(e.0, "__k32_") { n.k32_of[e.2] = n_k32(inout n, substr(e.0, 6, len(e.0) - 6)) }
        if e.0 == "__mem_base" { n.base_fn = e.2 }
        if starts_with(e.0, "__wasi_") {
            let name = substr(e.0, 7, len(e.0) - 7)
            for i in 0..n.nimp {
                if m.imports[i].0 == "wasi_snapshot_preview1" and m.imports[i].1 == name { n.impl_of[i] = e.2 }
            }
        }
    }
    if start < 0 { return (false, bytes(), "a module without _start") }
    n.iat_at = pe_iat_at(len(n.k32))
    n.grow_l = x_label(inout n.x)
    n.trap_l = x_label(inout n.x)
    n.table_l = x_label(inout n.x)
    // the entry: memory, globals, data, then _start and ExitProcess(0)
    let entry = len(n.x.code)
    x_alu_i(inout n.x, 5, true, rsp(), 40)
    let fail = x_label(inout n.x)
    // VirtualAlloc(0, 8 GiB + 64 KiB, MEM_RESERVE, PAGE_NOACCESS)
    x_imm(inout n.x, rcx(), 0)
    x_imm(inout n.x, rdx(), 8589934592 + 65536)
    x_imm(inout n.x, r8(), 8192)
    x_imm(inout n.x, r9(), 1)
    x_call_rdata(inout n.x, n.iat_at + 8 * va)
    x_test(inout n.x, true, rax(), rax())
    x_jcc(inout n.x, cc_e(), fail)
    x_mov(inout n.x, r15(), rax())
    // VirtualAlloc(it, (1 + pages) * 64 KiB, MEM_COMMIT, PAGE_READWRITE)
    x_mov(inout n.x, rcx(), rax())
    x_imm(inout n.x, rdx(), 65536 * (1 + m.pages))
    x_imm(inout n.x, r8(), 4096)
    x_imm(inout n.x, r9(), 4)
    x_call_rdata(inout n.x, n.iat_at + 8 * va)
    x_test(inout n.x, true, rax(), rax())
    x_jcc(inout n.x, cc_e(), fail)
    x_alu_i(inout n.x, 0, true, r15(), 65536)
    x_imm(inout n.x, rax(), m.pages)
    x_store(inout n.x, r15(), n_pages_at(), rax())
    for g in 0..len(m.globals) {
        x_imm(inout n.x, rax(), m.globals[g].1)
        x_store(inout n.x, r15(), n_global(g), rax())
    }
    let data_off = pe_data_at(n.k32)
    if len(m.data) > 0 {
        x_lea_rdata(inout n.x, rsi(), data_off)
        x_lea(inout n.x, rdi(), r15(), m.data_at)
        x_imm(inout n.x, rcx(), len(m.data))
        x_rep_movsb(inout n.x)
    }
    x_call(inout n.x, n.labels[start])
    x_imm(inout n.x, rcx(), 0)
    x_call_rdata(inout n.x, n.iat_at + 8 * exit_slot)
    x_bind(inout n.x, fail)
    x_imm(inout n.x, rcx(), 3)
    x_call_rdata(inout n.x, n.iat_at + 8 * exit_slot)
    // the trap: stop (an illegal instruction)
    x_bind(inout n.x, n.trap_l)
    x_ud2(inout n.x)
    n_grow_fn(inout n, va)
    for k in 0..len(m.funcs) {
        n_func(inout n, k)
        if n.failed { return (false, bytes(), "function " + str(n.nimp + k) + ": " + n.msg) }
    }
    // the table: a jump to each function
    x_bind(inout n.x, n.table_l)
    for f in m.table {
        let t = if f < n.nimp { n.impl_of[f] } else { f }
        if t < 0 { return (false, bytes(), "an import in the table") }
        x_jmp(inout n.x, n.labels[t])
    }
    if not x_resolve(inout n.x) { return (false, bytes(), "a label never placed") }
    let data_rva = pe_data_rva(len(n.x.code))
    x_resolve_rdata(inout n.x, pe_text_rva(), data_rva)
    var data = pe_imports(n.k32, data_rva)
    while len(data) < data_off { data.push(0) }
    for b in m.data { data.push(b) }
    (true, pe_image(n.x.code, entry, data, data_rva, len(n.k32)), "")
}
