// The operating system of Kairós programs compiled to Linux executables (M23), written in Kairós:
// the WASI functions the runtime (rt.krs) calls, over the system calls of the Linux kernel
// (x86-64). The native back end (native.krs) calls `os_wasi_<name>` for each WASI import and gives
// the functions below with a mark their bodies:
//   os_syscall(n, a, b, c, d, e, f)    the system call n (its result: negative, -errno, on error)
//   os_mem_base()                      the address where the module's memory starts
//   os_initial_sp()                    the stack the kernel started the program with: argc, the
//                                      arguments' addresses, 0, the environment's, 0
//   os_native_copy(dst, src, n)        n bytes from one address of the process to another
//   os_native_strlen(p)                the length of the C string at an address of the process
//
// Paths are relative to the current folder (WASI's descriptor 3, `--dir=.`) and are given to the
// kernel as they are: a descriptor of WASI is the kernel's. An error is WASI's code.

// ------------------------------------------------------------------ the marked functions

fn os_syscall(n: i64, a: i64, b: i64, c: i64, d: i64, e: i64, f: i64) -> i64 {
    0
}

fn os_mem_base() -> i64 {
    0
}

fn os_initial_sp() -> i64 {
    0
}

fn os_native_copy(dst: i64, src: i64, n: i64) -> i64 {
    0
}

fn os_native_strlen(p: i64) -> i64 {
    0
}

// ------------------------------------------------------------------ helpers

// a native address from an address of the module
fn rt_lin_at(a: i64) -> i64 {
    os_mem_base() + a
}

// WASI's code for a system call's negative result
fn rt_lin_errno(r: i64) -> i64 {
    let e = -r
    if e == 1 { return 63 }
    if e == 2 { return 44 }
    if e == 4 { return 27 }
    if e == 9 { return 8 }
    if e == 11 { return 6 }
    if e == 12 { return 48 }
    if e == 13 { return 2 }
    if e == 17 { return 20 }
    if e == 20 { return 54 }
    if e == 21 { return 31 }
    if e == 22 { return 28 }
    if e == 24 { return 33 }
    if e == 28 { return 51 }
    if e == 30 { return 69 }
    if e == 36 { return 37 }
    if e == 39 { return 55 }
    if e == 40 { return 32 }
    29
}

// The path at p (n bytes) as a C string at a new address: (it, the bytes allocated).
fn rt_lin_cpath(p: i64, n: i64) -> (i64, i64) {
    let q = rt_alloc(n + 1)
    for i in 0..n { wasm_store8(q + i, wasm_load8(p + i)) }
    wasm_store8(q + n, 0)
    (q, n + 1)
}

// Nanoseconds from a timespec (or the two fields of struct stat) at a.
fn rt_lin_ns(a: i64) -> i64 {
    wasm_load64(a) * 1000000000 + wasm_load64(a + 8)
}

// ------------------------------------------------------------------ WASI

fn os_wasi_fd_write(fd: i64, iovs: i64, n: i64, nwritten_at: i64) -> i64 {
    var total = 0
    for i in 0..n {
        let buf = wasm_load32(iovs + 8 * i)
        let len_ = wasm_load32(iovs + 8 * i + 4)
        var at = 0
        while at < len_ {
            let r = os_syscall(1, fd, rt_lin_at(buf + at), len_ - at, 0, 0, 0)
            if r < 0 {
                if r != -4 {
                    wasm_store32(nwritten_at, total + at)
                    return rt_lin_errno(r)
                }
            } else {
                at += r
            }
        }
        total += len_
    }
    wasm_store32(nwritten_at, total)
    0
}

fn os_wasi_fd_read(fd: i64, iovs: i64, n: i64, nread_at: i64) -> i64 {
    var total = 0
    for i in 0..n {
        let buf = wasm_load32(iovs + 8 * i)
        let len_ = wasm_load32(iovs + 8 * i + 4)
        var r = -4
        while r == -4 { r = os_syscall(0, fd, rt_lin_at(buf), len_, 0, 0, 0) }
        if r < 0 {
            wasm_store32(nread_at, total)
            return rt_lin_errno(r)
        }
        total += r
        if r < len_ { break }
    }
    wasm_store32(nread_at, total)
    0
}

fn os_wasi_fd_close(fd: i64) -> i64 {
    let r = os_syscall(3, fd, 0, 0, 0, 0, 0)
    if r < 0 { rt_lin_errno(r) } else { 0 }
}

// path_open: openat in the current folder; WASI's flags as the kernel's (a folder: O_DIRECTORY,
// for fd_readdir)
fn os_wasi_path_open(dir: i64, dirflags: i64, path: i64, plen: i64, oflags: i64, rights: i64, inherit: i64, fdflags: i64, fd_at: i64) -> i64 {
    let c = rt_lin_cpath(path, plen)
    let read = bit_and(rights, 2) != 0
    let write = bit_and(rights, 64) != 0 or bit_and(fdflags, 1) != 0
    var flags = if read and write { 2 } else if write { 1 } else { 0 }
    if bit_and(oflags, 1) != 0 { flags += 64 }
    if bit_and(oflags, 2) != 0 { flags += 65536 }
    if bit_and(oflags, 4) != 0 { flags += 128 }
    if bit_and(oflags, 8) != 0 { flags += 512 }
    if bit_and(fdflags, 1) != 0 { flags += 1024 }
    flags += 524288
    let r = os_syscall(257, -100, rt_lin_at(c.0), flags, 420, 0, 0)
    rt_free(c.0, c.1)
    if r < 0 { return rt_lin_errno(r) }
    wasm_store32(fd_at, r)
    0
}

fn os_wasi_path_create_directory(dir: i64, path: i64, plen: i64) -> i64 {
    let c = rt_lin_cpath(path, plen)
    let r = os_syscall(258, -100, rt_lin_at(c.0), 511, 0, 0, 0)
    rt_free(c.0, c.1)
    if r < 0 { rt_lin_errno(r) } else { 0 }
}

// WASI's filestat: the type (3 folder, 4 file, 7 link) at 16, the size at 32, the times at 40, 48, 56.
fn os_wasi_path_filestat_get(dir: i64, flags: i64, path: i64, plen: i64, st: i64) -> i64 {
    let c = rt_lin_cpath(path, plen)
    let s = rt_alloc(160)
    let r = os_syscall(262, -100, rt_lin_at(c.0), rt_lin_at(s), 0, 0, 0)
    rt_free(c.0, c.1)
    if r < 0 {
        rt_free(s, 160)
        return rt_lin_errno(r)
    }
    for i in 0..8 { wasm_store64(st + 8 * i, 0) }
    let kind = bit_and(wasm_load32(s + 24), 61440)
    wasm_store64(st, wasm_load64(s))
    wasm_store64(st + 8, wasm_load64(s + 8))
    wasm_store8(st + 16, if kind == 16384 { 3 } else if kind == 32768 { 4 } else if kind == 40960 { 7 } else { 0 })
    wasm_store64(st + 24, wasm_load64(s + 16))
    wasm_store64(st + 32, wasm_load64(s + 48))
    wasm_store64(st + 40, rt_lin_ns(s + 72))
    wasm_store64(st + 48, rt_lin_ns(s + 88))
    wasm_store64(st + 56, rt_lin_ns(s + 104))
    rt_free(s, 160)
    0
}

// The names of a folder from `cookie` (the kernel's position in it), as WASI's entries: the next
// cookie (8 bytes), the inode (8), the name's length (4), the type (1), 3 more, then the name;
// cut at the buffer's end.
fn os_wasi_fd_readdir(fd: i64, buf: i64, size: i64, cookie: i64, used_at: i64) -> i64 {
    let sk = os_syscall(8, fd, cookie, 0, 0, 0, 0)
    if sk < 0 { return rt_lin_errno(sk) }
    let cap = 32768
    let d = rt_alloc(cap)
    var at = 0
    var more = true
    while more and at < size {
        let got = os_syscall(217, fd, rt_lin_at(d), cap, 0, 0, 0)
        if got < 0 {
            rt_free(d, cap)
            return rt_lin_errno(got)
        }
        if got == 0 { more = false }
        var k = 0
        while k < got and at < size {
            let reclen = wasm_load8(d + k + 16) + 256 * wasm_load8(d + k + 17)
            var n = 0
            while wasm_load8(d + k + 19 + n) != 0 { n += 1 }
            let t = wasm_load8(d + k + 18)
            let head = rt_alloc(24)
            wasm_store64(head, wasm_load64(d + k + 8))
            wasm_store64(head + 8, wasm_load64(d + k))
            wasm_store32(head + 16, n)
            wasm_store32(head + 20, if t == 4 { 3 } else if t == 8 { 4 } else if t == 10 { 7 } else { 0 })
            for i in 0..24 {
                if at + i < size { wasm_store8(buf + at + i, wasm_load8(head + i)) }
            }
            for i in 0..n {
                if at + 24 + i < size { wasm_store8(buf + at + 24 + i, wasm_load8(d + k + 19 + i)) }
            }
            rt_free(head, 24)
            at += 24 + n
            k += reclen
        }
    }
    rt_free(d, cap)
    wasm_store32(used_at, min(at, size))
    0
}

// The time in nanoseconds: 0 the wall clock (since 1970), 1 a monotonic one.
fn os_wasi_clock_time_get(id: i64, precision: i64, time_at: i64) -> i64 {
    let ts = rt_alloc(16)
    let r = os_syscall(228, if id == 0 { 0 } else { 1 }, rt_lin_at(ts), 0, 0, 0, 0)
    let ns = rt_lin_ns(ts)
    rt_free(ts, 16)
    if r < 0 { return rt_lin_errno(r) }
    wasm_store64(time_at, ns)
    0
}

fn os_wasi_proc_exit(code: i64) {
    let _ = os_syscall(231, code, 0, 0, 0, 0, 0)
}

// ------------------------------------------------------------------ the arguments and the environment

// The 8 bytes at an address of the process.
fn rt_lin_word(p: i64) -> i64 {
    let w = rt_alloc(16)
    let _ = os_native_copy(rt_lin_at(w), p, 8)
    let v = wasm_load64(w)
    rt_free(w, 16)
    v
}

// The C string at an address of the process, as a text.
fn rt_lin_text(p: i64) -> str {
    let n = os_native_strlen(p)
    let q = rt_alloc(n + 1)
    let _ = os_native_copy(rt_lin_at(q), p, n)
    let s = rt_text_of(q, n)
    rt_free(q, n + 1)
    s
}

// The arguments (the program's first) and, with `env`, the environment, from the first stack.
fn rt_lin_strings(env: bool) -> List[str] {
    let sp = os_initial_sp()
    let argc = rt_lin_word(sp)
    var out: List[str] = []
    var at = sp + 8
    if env { at = sp + 8 * (argc + 2) }
    var count = 0
    while true {
        let p = rt_lin_word(at)
        if p == 0 or (not env and count >= argc) { break }
        out.push(rt_lin_text(p))
        at += 8
        count += 1
    }
    out
}

// The texts as WASI gives them: their count and the bytes of their C strings at the two cells,
// or (`list` >= 0) the addresses at `list` and the strings at `buf`.
fn rt_lin_cstrings(ts: List[str], count_at: i64, size_at: i64, list: i64, buf: i64) -> i64 {
    if list < 0 {
        var size = 0
        for t in ts { size += wasm_load32(wasm_str_addr(t) + 4) + 1 }
        wasm_store32(count_at, len(ts))
        wasm_store32(size_at, size)
        return 0
    }
    var at = buf
    for i in 0..len(ts) {
        wasm_store32(list + 4 * i, at)
        let a = wasm_str_addr(ts[i])
        let n = wasm_load32(a + 4)
        for k in 0..n { wasm_store8(at + k, wasm_load8(a + 8 + k)) }
        wasm_store8(at + n, 0)
        at += n + 1
    }
    0
}

fn os_wasi_args_sizes_get(argc_at: i64, size_at: i64) -> i64 {
    rt_lin_cstrings(rt_lin_strings(false), argc_at, size_at, -1, 0)
}

fn os_wasi_args_get(argv_at: i64, buf_at: i64) -> i64 {
    rt_lin_cstrings(rt_lin_strings(false), 0, 0, argv_at, buf_at)
}

fn os_wasi_environ_sizes_get(n_at: i64, size_at: i64) -> i64 {
    rt_lin_cstrings(rt_lin_strings(true), n_at, size_at, -1, 0)
}

fn os_wasi_environ_get(env_at: i64, buf_at: i64) -> i64 {
    rt_lin_cstrings(rt_lin_strings(true), 0, 0, env_at, buf_at)
}
