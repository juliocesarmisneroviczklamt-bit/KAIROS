// Kairós prelude: the standard library, written in Kairós itself.
// Loaded into every session before user code.
// (`mean`, `sum` and `prod` are builtins: they work on lists and on tensors.)

// statistics and the lab's simulator (b3.evaluate and b3.simulate run it), written in Kairós
import "std/stats.krs"
import "std/sim.krs"

// sample variance (n - 1)
fn variance(xs: List[f64]) -> f64 {
    assert(len(xs) > 1, "variance needs at least two values")
    let m = mean(xs)
    var acc = 0.0
    for x in xs { acc += (x - m) ^ 2 }
    acc / float(len(xs) - 1)
}

fn std_dev(xs: List[f64]) -> f64 {
    sqrt(variance(xs))
}

fn product(xs: List[f64]) -> f64 {
    var p = 1.0
    for x in xs { p *= x }
    p
}

// compound return of a series of simple returns: (1 + r1)(1 + r2)... - 1
fn compound(returns: List[f64]) -> f64 {
    var g = 1.0
    for r in returns { g *= 1.0 + r }
    g - 1.0
}

// cumulative wealth path starting at 1
fn wealth(returns: List[f64]) -> List[f64] {
    var w = 1.0
    var path = []
    for r in returns {
        w *= 1.0 + r
        path.push(w)
    }
    path
}

// worst peak-to-trough loss (a negative number)
fn max_drawdown(returns: List[f64]) -> f64 {
    var peak = 1.0
    var worst = 0.0
    for w in wealth(returns) {
        peak = max(peak, w)
        worst = min(worst, w / peak - 1.0)
    }
    worst
}

// annualized Sharpe ratio of monthly returns over a monthly risk-free rate
fn sharpe(returns: List[f64], rf: f64) -> f64 {
    let ex = returns.map(|r| r - rf)
    mean(ex) / std_dev(ex) * sqrt(12.0)
}

// Result of `b3.evaluate(weights, ...)`: the quant-b3 realistic simulator, after costs
// (and after taxes with `tax: true`). Rates are fractions: 0.146 = 14.6% a year.
struct Evaluation {
    months: i64,       // simulated months
    cagr: f64,         // compound annual growth of total wealth
    vol: f64,          // annualized volatility of monthly returns
    sharpe: f64,       // annualized Sharpe over the CDI
    max_dd: f64,       // worst drawdown of the monthly series (negative)
    beta: f64,         // CAPM beta against the NEFIN market factor
    alpha: f64,        // annualized CAPM alpha (Newey-West regression)
    t_alpha: f64,      // t statistic of the alpha
    turnover: f64,     // traded value per year, as a fraction of wealth (buys + sells)
    cost_bps: f64,     // average cost paid per traded real, in basis points
    trials: i64,       // trials the DSR accounts for: the whole registry (research), 1 (holdout)
    dsr: f64,          // deflated Sharpe ratio: P(true Sharpe > best of `trials` tries without skill)
}

// What `b3.simulate` returns: the simulation month by month (NaN outside the simulated months),
// for the studies that compute their own statistics. It is a trial in the registry, like
// `b3.evaluate`.
struct Simulation {
    ret: Tensor[month; f64],        // monthly return of total wealth, after costs and IR
    exposure: Tensor[month; f64],   // fraction of wealth invested
    turnover: Tensor[month; f64],   // value traded / wealth (buys + sells)
    cost_bps: f64,                  // average cost per traded real, in basis points
    tax_paid: f64,                  // R$
    final_value: f64,               // R$
    liq_value: f64,                 // R$, selling everything at the end (paying the deferred IR)
    capped: f64,                    // fraction of the target value cut by `cap_adv`
    exempt_months: i64,             // months with sales, exempt (up to R$ 20 thousand) or taxed
    taxed_months: i64,
    trials: i64,
    dsr: f64,
}

// ------------------------------------------------------------------ AI engine (M4)
// Written in Kairós itself: `grad` differentiates any of it, and the optimizers are generic over
// the parameters (any struct/tuple of f64 and f64 tensors: the tangent space).

axis sample      // rows of a data set
axis feature     // inputs
axis hidden      // hidden units
axis output      // outputs

// Multilayer perceptron with one hidden layer of `tanh` units.
struct Mlp {
    w1: Tensor[feature, hidden; f64],
    b1: Tensor[hidden; f64],
    w2: Tensor[hidden, output; f64],
    b2: Tensor[output; f64],
}

// Reproducible initialization (Xavier/Glorot scale for tanh).
fn mlp_init(seed: i64, inputs: i64, width: i64, outputs: i64) -> Mlp {
    Mlp {
        w1: randn(seed: seed, feature: inputs, hidden: width) * sqrt(1.0 / float(inputs)),
        b1: zeros(hidden: width),
        w2: randn(seed: seed + 1, hidden: width, output: outputs) * sqrt(1.0 / float(width)),
        b2: zeros(output: outputs),
    }
}

fn mlp(p: Mlp, x: Tensor[sample, feature; f64]) -> Tensor[sample, output; f64] {
    let h = tanh(contract(x, p.w1, over: feature) + p.b1)
    contract(h, p.w2, over: hidden) + p.b2
}

// mean squared error
fn mse(pred: Tensor[sample, output; f64], target: Tensor[sample, output; f64]) -> f64 {
    mean((pred - target) ^ 2.0)
}

// One step of gradient descent, for any differentiable parameters.
fn sgd_step[P](inout p: P, g: P, lr: f64) {
    p = p - lr * g
}

// One step of Adam (Kingma & Ba, 2015). `m` and `v` start as `zeros_like(p)`; `t` counts from 1.
fn adam_step[P](inout p: P, g: P, inout m: P, inout v: P, t: i64, lr: f64) {
    let b1 = 0.9
    let b2 = 0.999
    m = b1 * m + (1.0 - b1) * g
    v = b2 * v + (1.0 - b2) * (g * g)
    let mh = m / (1.0 - b1 ^ float(t))
    let vh = v / (1.0 - b2 ^ float(t))
    p = p - lr * mh / (sqrt(vh) + 1e-8)
}
