// SHA-256 (FIPS 180-4) in Kairós: the hash the lab uses to name strategies (the weights of an
// evaluation) and files. Words of 32 bits are kept in i64, masked to 32 bits; their sums cannot
// overflow 64 bits, so they are wrapping (unchecked) additions.

fn sha_k() -> List[i64] {
    [1116352408, 1899447441, 3049323471, 3921009573, 961987163, 1508970993, 2453635748, 2870763221,
        3624381080, 310598401, 607225278, 1426881987, 1925078388, 2162078206, 2614888103, 3248222580,
        3835390401, 4022224774, 264347078, 604807628, 770255983, 1249150122, 1555081692, 1996064986,
        2554220882, 2821834349, 2952996808, 3210313671, 3336571891, 3584528711, 113926993, 338241895,
        666307205, 773529912, 1294757372, 1396182291, 1695183700, 1986661051, 2177026350, 2456956037,
        2730485921, 2820302411, 3259730800, 3345764771, 3516065817, 3600352804, 4094571909, 275423344,
        430227734, 506948616, 659060556, 883997877, 958139571, 1322822218, 1537002063, 1747873779,
        1955562222, 2024104815, 2227730452, 2361852424, 2428436474, 2756734187, 3204031479, 3329325298]
}

fn sha_rotr(x: i64, n: i64) -> i64 {
    bit_or(shr(x, n), bit_and(shl(x, 32 - n), 4294967295))
}

fn sha_add(a: i64, b: i64) -> i64 {
    bit_and(wrapping_add(a, b), 4294967295)
}

// One block: the 16 words in w[0..16] (the schedule fills the rest), added into h.
fn sha_block(inout h: List[i64], inout w: List[i64], k: List[i64]) {
    let m = 4294967295
    for i in 16..64 {
        let x = w[i - 15]
        let y = w[i - 2]
        let s0 = bit_xor(bit_xor(bit_or(shr(x, 7), bit_and(shl(x, 25), m)), bit_or(shr(x, 18), bit_and(shl(x, 14), m))), shr(x, 3))
        let s1 = bit_xor(bit_xor(bit_or(shr(y, 17), bit_and(shl(y, 15), m)), bit_or(shr(y, 19), bit_and(shl(y, 13), m))), shr(y, 10))
        w[i] = bit_and(wrapping_add(wrapping_add(w[i - 16], s0), wrapping_add(w[i - 7], s1)), m)
    }
    var a = h[0]
    var b = h[1]
    var c = h[2]
    var d = h[3]
    var e = h[4]
    var f = h[5]
    var g = h[6]
    var hh = h[7]
    for i in 0..64 {
        let s1 = bit_xor(bit_xor(bit_or(shr(e, 6), bit_and(shl(e, 26), m)), bit_or(shr(e, 11), bit_and(shl(e, 21), m))), bit_or(shr(e, 25), bit_and(shl(e, 7), m)))
        let ch = bit_xor(bit_and(e, f), bit_and(bit_xor(e, m), g))
        let t1 = wrapping_add(wrapping_add(wrapping_add(hh, s1), wrapping_add(ch, k[i])), w[i])
        let s0 = bit_xor(bit_xor(bit_or(shr(a, 2), bit_and(shl(a, 30), m)), bit_or(shr(a, 13), bit_and(shl(a, 19), m))), bit_or(shr(a, 22), bit_and(shl(a, 10), m)))
        let maj = bit_xor(bit_xor(bit_and(a, b), bit_and(a, c)), bit_and(b, c))
        hh = g
        g = f
        f = e
        e = bit_and(wrapping_add(d, t1), m)
        d = c
        c = b
        b = a
        a = bit_and(wrapping_add(t1, wrapping_add(s0, maj)), m)
    }
    h[0] = sha_add(h[0], a)
    h[1] = sha_add(h[1], b)
    h[2] = sha_add(h[2], c)
    h[3] = sha_add(h[3], d)
    h[4] = sha_add(h[4], e)
    h[5] = sha_add(h[5], f)
    h[6] = sha_add(h[6], g)
    h[7] = sha_add(h[7], hh)
}

// The hash of the bytes of b, in lowercase hexadecimal (64 digits).
fn sha256_hex(b: Bytes) -> str {
    let k = sha_k()
    var h = [1779033703, 3144134277, 1013904242, 2773480762, 1359893119, 2600822924, 528734635, 1541459225]
    var w: List[i64] = []
    for i in 0..64 { w.push(0) }
    let n = len(b)
    // the whole blocks, read in place (big-endian words)
    let whole = n / 64
    for blk in 0..whole {
        let at = 64 * blk
        for i in 0..16 {
            let j = at + 4 * i
            w[i] = bit_or(bit_or(shl(get_u8(b, j), 24), shl(get_u8(b, j + 1), 16)), bit_or(shl(get_u8(b, j + 2), 8), get_u8(b, j + 3)))
        }
        sha_block(inout h, inout w, k)
    }
    // the rest, then 0x80, zeros, and the length in bits (64 bits, big-endian): one or two blocks
    var tail: List[i64] = []
    for i in 64 * whole..n { tail.push(get_u8(b, i)) }
    tail.push(128)
    while len(tail) % 64 != 56 { tail.push(0) }
    let bits = n * 8
    var s = 56
    while s >= 0 {
        tail.push(bit_and(shr(bits, s), 255))
        s -= 8
    }
    var at = 0
    while at < len(tail) {
        for i in 0..16 {
            let j = at + 4 * i
            w[i] = bit_or(bit_or(shl(tail[j], 24), shl(tail[j + 1], 16)), bit_or(shl(tail[j + 2], 8), tail[j + 3]))
        }
        sha_block(inout h, inout w, k)
        at += 64
    }
    var out = ""
    for x in h { out = out + to_hex(x, 8) }
    out
}
