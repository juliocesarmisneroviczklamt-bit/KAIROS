// JSON (RFC 8259), written in Kairós: `import "std/json.krs"`.
//
//   json_parse(text) -> Json     a malformed text stops the program, saying where
//   json_try(text) -> (bool, Json)   (true, value), or (false, Str(what is wrong and where))
//   json_text(v) -> str          compact JSON; json_pretty(v): indented by two spaces
//   json_get(v, key), json_at(v, i)                  a field / an element (Null when missing)
//   json_num(v), json_str(v), json_bool(v), json_list(v), json_keys(v)
//
// Numbers are f64; whole numbers are written without decimals (202611, not 202611.0), and
// NaN or infinities as null. Objects keep the order of their keys. The reader is strict, as
// RFC 8259 (and Rust's serde_json): no unknown escapes, no control characters inside strings,
// no lone surrogates.

enum Json {
    Null,
    Bool(bool),
    Num(f64),
    Str(str),
    Arr(List[Json]),
    Obj(Map[str, Json]),
}

// where the reader is, and the first problem found ("" while there is none)
struct JsonPos {
    i: i64,
    err: str,
}

fn json_try(text: str) -> (bool, Json) {
    let c = codes(text)
    var p = JsonPos { i: 0, err: "" }
    let v = jp_value(c, inout p)
    if p.err == "" {
        jp_ws(c, inout p)
        if p.i < len(c) { jp_fail(inout p, "text after the value") }
    }
    if p.err != "" { return (false, Json.Str(p.err)) }
    (true, v)
}

fn json_parse(text: str) -> Json {
    let r = json_try(text)
    if not r.0 { assert(false, "json: " + json_str(r.1)) }
    r.1
}

fn jp_fail(inout p: JsonPos, what: str) {
    if p.err == "" { p.err = what + " at character " + str(p.i + 1) }
}

// spaces, tabs and line breaks
fn jp_ws(c: List[i64], inout p: JsonPos) {
    while p.i < len(c) and (c[p.i] == 32 or c[p.i] == 9 or c[p.i] == 10 or c[p.i] == 13) { p.i += 1 }
}

fn jp_value(c: List[i64], inout p: JsonPos) -> Json {
    jp_ws(c, inout p)
    if p.i >= len(c) {
        jp_fail(inout p, "missing value")
        return Json.Null
    }
    let ch = c[p.i]
    if ch == 123 { return jp_object(c, inout p) }                       // {
    if ch == 91 { return jp_array(c, inout p) }                         // [
    if ch == 34 { return Json.Str(jp_string(c, inout p)) }              // "
    if ch == 116 {
        jp_word(c, inout p, "true")
        return Json.Bool(true)
    }
    if ch == 102 {
        jp_word(c, inout p, "false")
        return Json.Bool(false)
    }
    if ch == 110 {
        jp_word(c, inout p, "null")
        return Json.Null
    }
    if ch == 45 or (ch >= 48 and ch <= 57) { return Json.Num(jp_number(c, inout p)) }   // - 0-9
    jp_fail(inout p, "unexpected " + from_codes([ch]))
    Json.Null
}

fn jp_word(c: List[i64], inout p: JsonPos, word: str) {
    let w = codes(word)
    for k in 0..len(w) {
        if p.i + k >= len(c) or c[p.i + k] != w[k] {
            jp_fail(inout p, "expected " + word)
            return
        }
    }
    p.i += len(w)
}

fn jp_number(c: List[i64], inout p: JsonPos) -> f64 {
    let start = p.i
    if c[p.i] == 45 { p.i += 1 }
    // digits, the point, the exponent and its sign
    while p.i < len(c) and ((c[p.i] >= 48 and c[p.i] <= 57) or c[p.i] == 46 or c[p.i] == 101 or c[p.i] == 69 or c[p.i] == 43 or c[p.i] == 45) {
        p.i += 1
    }
    var digits = []
    for k in start..p.i { digits.push(c[k]) }
    let x = parse_float(from_codes(digits))
    if is_nan(x) {
        p.i = start
        jp_fail(inout p, "invalid number")
    }
    x
}

fn jp_hex4(c: List[i64], inout p: JsonPos) -> i64 {
    var u = 0
    for k in 0..4 {
        if p.i >= len(c) {
            jp_fail(inout p, "short unicode escape")
            return 0
        }
        let h = c[p.i]
        let d = if h >= 48 and h <= 57 { h - 48 } else if h >= 97 and h <= 102 { h - 87 } else if h >= 65 and h <= 70 { h - 55 } else { -1 }
        if d < 0 {
            jp_fail(inout p, "invalid unicode escape")
            return 0
        }
        u = u * 16 + d
        p.i += 1
    }
    u
}

fn jp_string(c: List[i64], inout p: JsonPos) -> str {
    let start = p.i
    p.i += 1
    var out = []
    while true {
        if p.i >= len(c) {
            p.i = start
            jp_fail(inout p, "unterminated string")
            return ""
        }
        let ch = c[p.i]
        if ch == 34 {
            p.i += 1
            break
        }
        if ch < 32 {
            jp_fail(inout p, "control character in a string")
            return ""
        }
        if ch == 92 {
            if p.i + 1 >= len(c) {
                jp_fail(inout p, "unterminated escape")
                return ""
            }
            let e = c[p.i + 1]
            p.i += 2
            if e == 110 {
                out.push(10)
            } else if e == 116 {
                out.push(9)
            } else if e == 114 {
                out.push(13)
            } else if e == 98 {
                out.push(8)
            } else if e == 102 {
                out.push(12)
            } else if e == 34 or e == 92 or e == 47 {
                out.push(e)
            } else if e == 117 {
                // 4 hex digits, with surrogate pairs for code points above U+FFFF
                var u = jp_hex4(c, inout p)
                if p.err != "" { return "" }
                if u >= 55296 and u <= 56319 and p.i + 1 < len(c) and c[p.i] == 92 and c[p.i + 1] == 117 {
                    p.i += 2
                    let lo = jp_hex4(c, inout p)
                    if p.err != "" { return "" }
                    if lo < 56320 or lo > 57343 {
                        jp_fail(inout p, "invalid surrogate pair")
                        return ""
                    }
                    u = 65536 + (u - 55296) * 1024 + (lo - 56320)
                }
                if u >= 55296 and u <= 57343 {
                    jp_fail(inout p, "lone surrogate")
                    return ""
                }
                out.push(u)
            } else {
                p.i -= 2
                jp_fail(inout p, "invalid escape")
                return ""
            }
            continue
        }
        out.push(ch)
        p.i += 1
    }
    from_codes(out)
}

fn jp_array(c: List[i64], inout p: JsonPos) -> Json {
    p.i += 1
    var xs = []
    jp_ws(c, inout p)
    if p.i < len(c) and c[p.i] == 93 {
        p.i += 1
        return Json.Arr(xs)
    }
    while true {
        xs.push(jp_value(c, inout p))
        if p.err != "" { return Json.Null }
        jp_ws(c, inout p)
        if p.i >= len(c) {
            jp_fail(inout p, "unterminated array")
            return Json.Null
        }
        if c[p.i] == 44 {
            p.i += 1
            continue
        }
        if c[p.i] == 93 {
            p.i += 1
            break
        }
        jp_fail(inout p, "expected , or ]")
        return Json.Null
    }
    Json.Arr(xs)
}

fn jp_object(c: List[i64], inout p: JsonPos) -> Json {
    p.i += 1
    var m: Map[str, Json] = [:]
    jp_ws(c, inout p)
    if p.i < len(c) and c[p.i] == 125 {
        p.i += 1
        return Json.Obj(m)
    }
    while true {
        jp_ws(c, inout p)
        if p.i >= len(c) or c[p.i] != 34 {
            jp_fail(inout p, "expected a key in quotes")
            return Json.Null
        }
        let k = jp_string(c, inout p)
        if p.err != "" { return Json.Null }
        jp_ws(c, inout p)
        if p.i >= len(c) or c[p.i] != 58 {
            jp_fail(inout p, "expected :")
            return Json.Null
        }
        p.i += 1
        m[k] = jp_value(c, inout p)
        if p.err != "" { return Json.Null }
        jp_ws(c, inout p)
        if p.i >= len(c) {
            jp_fail(inout p, "unterminated object")
            return Json.Null
        }
        if c[p.i] == 44 {
            p.i += 1
            continue
        }
        if c[p.i] == 125 {
            p.i += 1
            break
        }
        jp_fail(inout p, "expected , or }")
        return Json.Null
    }
    Json.Obj(m)
}

// ------------------------------------------------------------------ writing

fn json_num_text(x: f64) -> str {
    if is_nan(x - x) { return "null" }
    if x == floor(x) and abs(x) < 9007199254740992.0 { return str(int(x)) }
    str(x)
}

fn json_quote(s: str) -> str {
    let hx = codes("0123456789abcdef")
    var out = [34]
    for ch in codes(s) {
        if ch == 34 or ch == 92 {
            out.push(92)
            out.push(ch)
        } else if ch == 10 {
            out.push(92)
            out.push(110)
        } else if ch == 13 {
            out.push(92)
            out.push(114)
        } else if ch == 9 {
            out.push(92)
            out.push(116)
        } else if ch < 32 {
            for d in [92, 117, 48, 48, hx[ch / 16], hx[ch % 16]] { out.push(d) }
        } else {
            out.push(ch)
        }
    }
    out.push(34)
    from_codes(out)
}

fn json_text(v: Json) -> str {
    match v {
        Null => "null",
        Bool(b) => if b { "true" } else { "false" },
        Num(x) => json_num_text(x),
        Str(s) => json_quote(s),
        Arr(xs) => {
            var parts = []
            for x in xs { parts.push(json_text(x)) }
            "[" + join(parts, ",") + "]"
        },
        Obj(m) => {
            var parts = []
            for (k, x) in items(m) { parts.push(json_quote(k) + ":" + json_text(x)) }
            "{" + join(parts, ",") + "}"
        },
    }
}

fn json_indent(v: Json, pad: str) -> str {
    let inner = pad + "  "
    match v {
        Arr(xs) => {
            if len(xs) == 0 { return "[]" }
            var parts = []
            for x in xs { parts.push(inner + json_indent(x, inner)) }
            "[\n" + join(parts, ",\n") + "\n" + pad + "]"
        },
        Obj(m) => {
            if len(m) == 0 { return "{}" }
            var parts = []
            for (k, x) in items(m) { parts.push(inner + json_quote(k) + ": " + json_indent(x, inner)) }
            "{\n" + join(parts, ",\n") + "\n" + pad + "}"
        },
        _ => json_text(v),
    }
}

fn json_pretty(v: Json) -> str {
    json_indent(v, "")
}

// ------------------------------------------------------------------ reading values

fn json_get(v: Json, key: str) -> Json {
    match v {
        Obj(m) => get(m, key, Json.Null),
        _ => Json.Null,
    }
}

fn json_at(v: Json, i: i64) -> Json {
    match v {
        Arr(xs) => if i >= 0 and i < len(xs) { xs[i] } else { Json.Null },
        _ => Json.Null,
    }
}

// a number (also one written as text, as some APIs do); NaN otherwise
fn json_num(v: Json) -> f64 {
    match v {
        Num(x) => x,
        Str(s) => parse_float(s),
        _ => nan,
    }
}

fn json_str(v: Json) -> str {
    match v {
        Str(s) => s,
        Num(x) => json_num_text(x),
        Bool(b) => if b { "true" } else { "false" },
        _ => "",
    }
}

fn json_bool(v: Json) -> bool {
    match v {
        Bool(b) => b,
        _ => false,
    }
}

fn json_list(v: Json) -> List[Json] {
    match v {
        Arr(xs) => xs,
        _ => [],
    }
}

fn json_keys(v: Json) -> List[str] {
    match v {
        Obj(m) => keys(m),
        _ => [],
    }
}
