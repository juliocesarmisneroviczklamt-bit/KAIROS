// JSON (RFC 8259), written in Kairós: `import "std/json.krs"`.
//
//   json_parse(text) -> Json     a malformed text stops the program, saying where
//   json_text(v) -> str          compact JSON; json_pretty(v): indented by two spaces
//   json_get(v, key), json_at(v, i)                  a field / an element (Null when missing)
//   json_num(v), json_str(v), json_bool(v), json_list(v), json_keys(v)
//
// Numbers are f64; whole numbers are written without decimals (202611, not 202611.0), and
// NaN or infinities as null. Objects keep the order of their keys.

enum Json {
    Null,
    Bool(bool),
    Num(f64),
    Str(str),
    Arr(List[Json]),
    Obj(Map[str, Json]),
}

fn json_parse(text: str) -> Json {
    let c = codes(text)
    var i = 0
    let v = jp_value(c, inout i)
    jp_ws(c, inout i)
    if i < len(c) { jp_fail(i, "text after the value") }
    v
}

fn jp_fail(i: i64, what: str) {
    assert(false, "json: " + what + " at character " + str(i + 1))
}

// spaces, tabs and line breaks
fn jp_ws(c: List[i64], inout i: i64) {
    while i < len(c) and (c[i] == 32 or c[i] == 9 or c[i] == 10 or c[i] == 13) { i += 1 }
}

fn jp_value(c: List[i64], inout i: i64) -> Json {
    jp_ws(c, inout i)
    if i >= len(c) {
        jp_fail(i, "missing value")
        return Json.Null
    }
    let ch = c[i]
    if ch == 123 { return jp_object(c, inout i) }                       // {
    if ch == 91 { return jp_array(c, inout i) }                         // [
    if ch == 34 { return Json.Str(jp_string(c, inout i)) }              // "
    if ch == 116 {
        jp_word(c, inout i, "true")
        return Json.Bool(true)
    }
    if ch == 102 {
        jp_word(c, inout i, "false")
        return Json.Bool(false)
    }
    if ch == 110 {
        jp_word(c, inout i, "null")
        return Json.Null
    }
    if ch == 45 or (ch >= 48 and ch <= 57) { return Json.Num(jp_number(c, inout i)) }   // - 0-9
    jp_fail(i, "unexpected " + from_codes([ch]))
    Json.Null
}

fn jp_word(c: List[i64], inout i: i64, word: str) {
    let w = codes(word)
    for k in 0..len(w) {
        if i + k >= len(c) or c[i + k] != w[k] { jp_fail(i, "expected " + word) }
    }
    i += len(w)
}

fn jp_number(c: List[i64], inout i: i64) -> f64 {
    let start = i
    if c[i] == 45 { i += 1 }
    // digits, the point, the exponent and its sign
    while i < len(c) and ((c[i] >= 48 and c[i] <= 57) or c[i] == 46 or c[i] == 101 or c[i] == 69 or c[i] == 43 or c[i] == 45) {
        i += 1
    }
    var digits = []
    for k in start..i { digits.push(c[k]) }
    let x = parse_float(from_codes(digits))
    if is_nan(x) { jp_fail(start, "invalid number") }
    x
}

fn jp_hex4(c: List[i64], inout i: i64) -> i64 {
    var u = 0
    for k in 0..4 {
        if i >= len(c) { jp_fail(i, "short \\u escape") }
        let h = c[i]
        let d = if h >= 48 and h <= 57 { h - 48 } else if h >= 97 and h <= 102 { h - 87 } else if h >= 65 and h <= 70 { h - 55 } else { -1 }
        if d < 0 { jp_fail(i, "invalid \\u escape") }
        u = u * 16 + d
        i += 1
    }
    u
}

fn jp_string(c: List[i64], inout i: i64) -> str {
    let start = i
    i += 1
    var out = []
    while true {
        if i >= len(c) { jp_fail(start, "unterminated string") }
        let ch = c[i]
        if ch == 34 {
            i += 1
            break
        }
        if ch == 92 {
            if i + 1 >= len(c) { jp_fail(i, "unterminated escape") }
            let e = c[i + 1]
            i += 2
            if e == 110 {
                out.push(10)
            } else if e == 116 {
                out.push(9)
            } else if e == 114 {
                out.push(13)
            } else if e == 98 {
                out.push(8)
            } else if e == 102 {
                out.push(12)
            } else if e == 117 {
                // \uXXXX, with surrogate pairs for code points above U+FFFF
                var u = jp_hex4(c, inout i)
                if u >= 55296 and u <= 56319 and i + 1 < len(c) and c[i] == 92 and c[i + 1] == 117 {
                    i += 2
                    let lo = jp_hex4(c, inout i)
                    u = 65536 + (u - 55296) * 1024 + (lo - 56320)
                }
                out.push(u)
            } else {
                out.push(e)
            }
            continue
        }
        out.push(ch)
        i += 1
    }
    from_codes(out)
}

fn jp_array(c: List[i64], inout i: i64) -> Json {
    i += 1
    var xs = []
    jp_ws(c, inout i)
    if i < len(c) and c[i] == 93 {
        i += 1
        return Json.Arr(xs)
    }
    while true {
        xs.push(jp_value(c, inout i))
        jp_ws(c, inout i)
        if i >= len(c) { jp_fail(i, "unterminated array") }
        if c[i] == 44 {
            i += 1
            continue
        }
        if c[i] == 93 {
            i += 1
            break
        }
        jp_fail(i, "expected , or ]")
    }
    Json.Arr(xs)
}

fn jp_object(c: List[i64], inout i: i64) -> Json {
    i += 1
    var m: Map[str, Json] = [:]
    jp_ws(c, inout i)
    if i < len(c) and c[i] == 125 {
        i += 1
        return Json.Obj(m)
    }
    while true {
        jp_ws(c, inout i)
        if i >= len(c) or c[i] != 34 { jp_fail(i, "expected a key in quotes") }
        let k = jp_string(c, inout i)
        jp_ws(c, inout i)
        if i >= len(c) or c[i] != 58 { jp_fail(i, "expected :") }
        i += 1
        m[k] = jp_value(c, inout i)
        jp_ws(c, inout i)
        if i >= len(c) { jp_fail(i, "unterminated object") }
        if c[i] == 44 {
            i += 1
            continue
        }
        if c[i] == 125 {
            i += 1
            break
        }
        jp_fail(i, "expected , or }")
    }
    Json.Obj(m)
}

// ------------------------------------------------------------------ writing

fn json_num_text(x: f64) -> str {
    if is_nan(x - x) { return "null" }
    if x == floor(x) and abs(x) < 9007199254740992.0 { return str(int(x)) }
    str(x)
}

fn json_quote(s: str) -> str {
    let hx = codes("0123456789abcdef")
    var out = [34]
    for ch in codes(s) {
        if ch == 34 or ch == 92 {
            out.push(92)
            out.push(ch)
        } else if ch == 10 {
            out.push(92)
            out.push(110)
        } else if ch == 13 {
            out.push(92)
            out.push(114)
        } else if ch == 9 {
            out.push(92)
            out.push(116)
        } else if ch < 32 {
            for d in [92, 117, 48, 48, hx[ch / 16], hx[ch % 16]] { out.push(d) }
        } else {
            out.push(ch)
        }
    }
    out.push(34)
    from_codes(out)
}

fn json_text(v: Json) -> str {
    match v {
        Null => "null",
        Bool(b) => if b { "true" } else { "false" },
        Num(x) => json_num_text(x),
        Str(s) => json_quote(s),
        Arr(xs) => {
            var parts = []
            for x in xs { parts.push(json_text(x)) }
            "[" + join(parts, ",") + "]"
        },
        Obj(m) => {
            var parts = []
            for (k, x) in items(m) { parts.push(json_quote(k) + ":" + json_text(x)) }
            "{" + join(parts, ",") + "}"
        },
    }
}

fn json_indent(v: Json, pad: str) -> str {
    let inner = pad + "  "
    match v {
        Arr(xs) => {
            if len(xs) == 0 { return "[]" }
            var parts = []
            for x in xs { parts.push(inner + json_indent(x, inner)) }
            "[\n" + join(parts, ",\n") + "\n" + pad + "]"
        },
        Obj(m) => {
            if len(m) == 0 { return "{}" }
            var parts = []
            for (k, x) in items(m) { parts.push(inner + json_quote(k) + ": " + json_indent(x, inner)) }
            "{\n" + join(parts, ",\n") + "\n" + pad + "}"
        },
        _ => json_text(v),
    }
}

fn json_pretty(v: Json) -> str {
    json_indent(v, "")
}

// ------------------------------------------------------------------ reading values

fn json_get(v: Json, key: str) -> Json {
    match v {
        Obj(m) => get(m, key, Json.Null),
        _ => Json.Null,
    }
}

fn json_at(v: Json, i: i64) -> Json {
    match v {
        Arr(xs) => if i >= 0 and i < len(xs) { xs[i] } else { Json.Null },
        _ => Json.Null,
    }
}

// a number (also one written as text, as some APIs do); NaN otherwise
fn json_num(v: Json) -> f64 {
    match v {
        Num(x) => x,
        Str(s) => parse_float(s),
        _ => nan,
    }
}

fn json_str(v: Json) -> str {
    match v {
        Str(s) => s,
        Num(x) => json_num_text(x),
        Bool(b) => if b { "true" } else { "false" },
        _ => "",
    }
}

fn json_bool(v: Json) -> bool {
    match v {
        Bool(b) => b,
        _ => false,
    }
}

fn json_list(v: Json) -> List[Json] {
    match v {
        Arr(xs) => xs,
        _ => [],
    }
}

fn json_keys(v: Json) -> List[str] {
    match v {
        Obj(m) => keys(m),
        _ => [],
    }
}
