// Monte Carlo with a Park-Miller generator: integer arithmetic feeding floating point.
fn pi_estimate(n: i64) -> f64 {
    var seed = 12345
    var hits = 0
    for i in 0..n {
        seed = seed * 16807 % 2147483647
        let x = float(seed) / 2147483647.0
        seed = seed * 16807 % 2147483647
        let y = float(seed) / 2147483647.0
        if x * x + y * y <= 1.0 { hits += 1 }
    }
    4.0 * float(hits) / float(n)
}
