// `b3.evaluate` written in Kairós (the bridge's sim_prepare, sim_data and the simulator of
// std/sim.krs): the plans of the weights, checked as the bridge checks them, the panel and the
// calendar the simulator reads, the simulation and its statistics.
import "data.krs"

fn fmt_ym(ym: i64) -> str {
    let m = ym % 100
    str(ym / 100) + "-" + (if m < 10 { "0" } else { "" }) + str(m)
}

// The plans of the months the program sees: each month's assets with a weight and their
// weights (long-only fractions of wealth adding up to at most 1); a month is traded only if its
// holding window ends within the months seen. `err`: R0102's message, or "".
struct Plans {
    m: List[i64],
    t: List[List[i64]],
    w: List[List[f64]],
    err: str,
}

fn window_end(d: LabData, m: i64, lag: i64) -> i64 {
    let nd = len(d.dates)
    let e = if m + 1 < len(d.cal.months) { d.cal.mfrom[m + 1] + lag } else { nd }
    min(e, nd)
}

fn make_plans(d: LabData, w: Tensor[month, asset; f64], n: i64, cfg: SimCfg) -> Plans {
    var p = Plans { m: [], t: [], w: [], err: "" }
    let nm = len(d.cal.months)
    let nt = len(d.tks)
    if size(w, month) != n or size(w, asset) != nt {
        p.err = "the weights have " + str(size(w, month)) + " months x " + str(size(w, asset)) + " assets, but the B3 data has " + str(n) + " x " + str(nt)
        return p
    }
    if cfg.lag < 0 {
        p.err = "`lag` must be between 0 and the number of sessions, got " + str(cfg.lag)
        return p
    }
    if not (cfg.capital > 0.0 and abs(cfg.capital) != inf) {
        p.err = "`capital` must be positive, got " + str(cfg.capital)
        return p
    }
    if not (cfg.cost_bps >= 0.0 and abs(cfg.cost_bps) != inf) {
        p.err = "`cost_bps` must be >= 0, got " + str(cfg.cost_bps)
        return p
    }
    let end = if n < nm { d.cal.mfrom[n] } else { len(d.dates) }
    for m in 0..n {
        let row = to_list(w[month: m])
        var ts: List[i64] = []
        var ws: List[f64] = []
        var tot = 0.0
        for t in 0..nt {
            let x = row[t]
            if x == 0.0 { continue }
            if is_nan(x) or abs(x) == inf or x < 0.0 {
                p.err = "invalid weight " + str(x) + " for " + d.tks[t].ticker + " in " + fmt_ym(d.cal.months[m])
                return p
            }
            ts.push(t)
            ws.push(x)
            tot = tot + x
        }
        if tot > 1.0 + 1e-9 {
            p.err = "the weights of " + fmt_ym(d.cal.months[m]) + " add up to " + format_fixed(tot, 6) + ", more than 1"
            return p
        }
        if len(ts) > 0 and (n == nm or window_end(d, m, cfg.lag) <= end) {
            p.m.push(m)
            p.t.push(ts)
            p.w.push(ws)
        }
    }
    if len(p.m) == 0 { p.err = "all weights are zero: there is nothing to evaluate" }
    p
}

// The panel and the calendar for std/sim.krs, up to the sessions of the first n months.
fn sim_panel(d: LabData, end: i64) -> PanelDays {
    var p = PanelDays { first: [], di: [], r: [], vol: [], div: [], jcp: [], spr: [], px: [] }
    for tk in d.tks {
        p.first.push(len(p.di))
        for x in tk.days {
            if x.di >= end { break }
            p.di.push(x.di)
            p.r.push(x.r)
            p.vol.push(x.vol)
            p.div.push(x.div)
            p.jcp.push(x.jcp)
            p.spr.push(x.spr)
            p.px.push(x.px)
        }
    }
    p.first.push(len(p.di))
    p
}

fn sim_calendar(d: LabData, cdi_d: List[f64], n: i64, end: i64) -> Calendar {
    var c = Calendar { dates: [], month_first: [], cdi: [] }
    for i in 0..end {
        c.dates.push(d.dates[i])
        c.cdi.push(cdi_d[i])
    }
    for m in 0..n { c.month_first.push(d.cal.mfrom[m]) }
    c
}

// The evaluation of weights w over the first n months: (R0102's message or "", the run, its
// statistics).
fn kairos_evaluate(d: LabData, cdi_d: List[f64], w: Tensor[month, asset; f64], n: i64, cfg: SimCfg) -> (str, SimRun, SimEval) {
    let p = make_plans(d, w, n, cfg)
    let end = if n < len(d.cal.months) { d.cal.mfrom[n] } else { len(d.dates) }
    let none = SimRun { mi: [], ret: [], turnover: [], exposure: [], cost_paid: 0.0, traded: 0.0, tax_paid: 0.0, jcp_withheld: 0.0, final_value: 0.0, liq_value: 0.0, exempt_months: 0, taxed_months: 0, capped_frac: 0.0 }
    let zero = SimEval { cagr: nan, vol: nan, sharpe: nan, max_dd: nan, beta: nan, alpha: nan, t_alpha: nan, turnover: nan, cost_bps: nan }
    if p.err != "" { return (p.err, none, zero) }
    if not (cfg.cap_adv >= 0.0 and abs(cfg.cap_adv) != inf) { return ("`cap_adv` must be >= 0 (0: no limit), got " + str(cfg.cap_adv), none, zero) }
    let run = sim_run(sim_panel(d, end), sim_calendar(d, cdi_d, n, end), p.m, p.t, p.w, cfg)
    if len(run.ret) == 0 { return ("the simulation produced no months", run, zero) }
    ("", run, sim_eval(run))
}
