// `b3.evaluate` written in Kairós (the bridge's sim_prepare, sim_data and the simulator of
// std/sim.krs): the plans of the weights, checked as the bridge checks them, the panel and the
// calendar the simulator reads, the simulation and its statistics.
import "data.krs"
import "std/sha256.krs"

fn fmt_ym(ym: i64) -> str {
    let m = ym % 100
    str(ym / 100) + "-" + (if m < 10 { "0" } else { "" }) + str(m)
}

// The plans of the months the program sees: each month's assets with a weight and their
// weights (long-only fractions of wealth adding up to at most 1); a month is traded only if its
// holding window ends within the months seen. `err`: R0102's message, or "".
struct Plans {
    m: List[i64],
    t: List[List[i64]],
    w: List[List[f64]],
    err: str,
}

fn window_end(d: LabData, m: i64, lag: i64) -> i64 {
    let nd = len(d.dates)
    let e = if m + 1 < len(d.cal.months) { d.cal.mfrom[m + 1] + lag } else { nd }
    min(e, nd)
}

fn make_plans(d: LabData, w: Tensor[month, asset; f64], n: i64, cfg: SimCfg) -> Plans {
    plans_from(d, w, n, 0, cfg, if n < len(d.cal.months) { " visible to this program (see the note above)" } else { "" })
}

// The plans of the months from `from` on (a holdout: a fresh portfolio from its first month);
// `cut`: what the error of the weights' shape adds.
fn plans_from(d: LabData, w: Tensor[month, asset; f64], n: i64, from: i64, cfg: SimCfg, cut: str) -> Plans {
    var p = Plans { m: [], t: [], w: [], err: "" }
    let nm = len(d.cal.months)
    let nt = len(d.tks)
    if size(w, month) != n or size(w, asset) != nt {
        p.err = "the weights have " + str(size(w, month)) + " months x " + str(size(w, asset)) + " assets, but the B3 data has " + str(n) + " x " + str(nt) + cut
        return p
    }
    if cfg.lag < 0 {
        p.err = "`lag` must be between 0 and the number of sessions, got " + str(cfg.lag)
        return p
    }
    if not (cfg.capital > 0.0 and abs(cfg.capital) != inf) {
        p.err = "`capital` must be positive, got " + str(cfg.capital)
        return p
    }
    if not (cfg.cost_bps >= 0.0 and abs(cfg.cost_bps) != inf) {
        p.err = "`cost_bps` must be >= 0, got " + str(cfg.cost_bps)
        return p
    }
    let end = if n < nm { d.cal.mfrom[n] } else { len(d.dates) }
    for m in 0..n {
        let row = to_list(w[month: m])
        var ts: List[i64] = []
        var ws: List[f64] = []
        var tot = 0.0
        for t in 0..nt {
            let x = row[t]
            if x == 0.0 { continue }
            if is_nan(x) or abs(x) == inf or x < 0.0 {
                p.err = "invalid weight " + str(x) + " for " + d.tks[t].ticker + " in " + fmt_ym(d.cal.months[m])
                return p
            }
            ts.push(t)
            ws.push(x)
            tot = tot + x
        }
        if tot > 1.0 + 1e-9 {
            p.err = "the weights of " + fmt_ym(d.cal.months[m]) + " add up to " + format_fixed(tot, 6) + ", more than 1"
            return p
        }
        if len(ts) > 0 and m >= from and (n == nm or window_end(d, m, cfg.lag) <= end) {
            p.m.push(m)
            p.t.push(ts)
            p.w.push(ws)
        }
    }
    if len(p.m) == 0 { p.err = "all weights are zero: there is nothing to evaluate" }
    p
}

// The panel and the calendar for std/sim.krs, up to the sessions of the first n months.
fn sim_panel(d: LabData, end: i64) -> PanelDays {
    var p = PanelDays { first: [], di: [], r: [], vol: [], div: [], jcp: [], spr: [], px: [] }
    for tk in d.tks {
        p.first.push(len(p.di))
        for x in tk.days {
            if x.di >= end { break }
            p.di.push(x.di)
            p.r.push(x.r)
            p.vol.push(x.vol)
            p.div.push(x.div)
            p.jcp.push(x.jcp)
            p.spr.push(x.spr)
            p.px.push(x.px)
        }
    }
    p.first.push(len(p.di))
    p
}

fn sim_calendar(d: LabData, cdi_d: List[f64], n: i64, end: i64) -> Calendar {
    var c = Calendar { dates: [], month_first: [], cdi: [] }
    for i in 0..end {
        c.dates.push(d.dates[i])
        c.cdi.push(cdi_d[i])
    }
    for m in 0..n { c.month_first.push(d.cal.mfrom[m]) }
    c
}

// The market's series the statistics of an evaluation use (std/sim.krs sim_eval_on): the CDI and
// NEFIN's, over the months, from the first. `has`: false to read them through `b3` (sim_eval).
struct SimMarket {
    has: bool,
    cdi: Tensor[month; f64],
    rm: Tensor[month; f64],
    rf: Tensor[month; f64],
    rf_ew: Tensor[month; f64],
}

// what `b3.cdi()` and `b3.nefin(...)` give over the first n months
fn sim_market(d: LabData, cdi_m: List[f64], nef: Map[i64, List[f64]], nef_vw: Map[i64, List[f64]], n: i64) -> SimMarket {
    SimMarket {
        has: true, cdi: tensor(cdi_m, month)[month: 0 .. n], rm: data_nefin(d.cal, nef_vw, 0)[month: 0 .. n],
        rf: data_nefin(d.cal, nef_vw, 5)[month: 0 .. n], rf_ew: data_nefin(d.cal, nef, 5)[month: 0 .. n],
    }
}

fn no_market() -> SimMarket {
    SimMarket { has: false, cdi: zeros(month: 0), rm: zeros(month: 0), rf: zeros(month: 0), rf_ew: zeros(month: 0) }
}

// The evaluation of weights w over the first n months: (R0102's message or "", the run, its
// statistics).
fn kairos_evaluate(d: LabData, cdi_d: List[f64], w: Tensor[month, asset; f64], n: i64, cfg: SimCfg) -> (str, SimRun, SimEval) {
    kairos_evaluate_on(d, cdi_d, w, n, cfg, no_market())
}

fn kairos_evaluate_on(d: LabData, cdi_d: List[f64], w: Tensor[month, asset; f64], n: i64, cfg: SimCfg, mk: SimMarket) -> (str, SimRun, SimEval) {
    var p = make_plans(d, w, n, cfg)
    if p.err == "" and not (cfg.cap_adv >= 0.0 and abs(cfg.cap_adv) != inf) { p.err = "`cap_adv` must be >= 0 (0: no limit), got " + str(cfg.cap_adv) }
    simulate_plans_on(d, cdi_d, p, n, cfg, mk)
}

// The simulation of the plans over the first n months, and its statistics.
fn simulate_plans(d: LabData, cdi_d: List[f64], p: Plans, n: i64, cfg: SimCfg) -> (str, SimRun, SimEval) {
    simulate_plans_on(d, cdi_d, p, n, cfg, no_market())
}

fn simulate_plans_on(d: LabData, cdi_d: List[f64], p: Plans, n: i64, cfg: SimCfg, mk: SimMarket) -> (str, SimRun, SimEval) {
    let end = if n < len(d.cal.months) { d.cal.mfrom[n] } else { len(d.dates) }
    let none = SimRun { mi: [], ret: [], turnover: [], exposure: [], cost_paid: 0.0, traded: 0.0, tax_paid: 0.0, jcp_withheld: 0.0, final_value: 0.0, liq_value: 0.0, exempt_months: 0, taxed_months: 0, capped_frac: 0.0 }
    let zero = SimEval { cagr: nan, vol: nan, sharpe: nan, max_dd: nan, beta: nan, alpha: nan, t_alpha: nan, turnover: nan, cost_bps: nan }
    if p.err != "" { return (p.err, none, zero) }
    let run = sim_run(sim_panel(d, end), sim_calendar(d, cdi_d, n, end), p.m, p.t, p.w, cfg)
    if len(run.ret) == 0 { return ("the simulation produced no months", run, zero) }
    ("", run, if mk.has { sim_eval_on(run, mk.cdi, mk.rm, mk.rf, mk.rf_ew) } else { sim_eval(run) })
}

// The name of a strategy: the first 12 digits of the SHA-256 of its weights over the months seen
// (their number, the number of assets, then each weight's 64 bits, month by month).
fn weights_sha(w: Tensor[month, asset; f64], n: i64) -> str {
    var b = bytes()
    put_u64(inout b, n)
    put_u64(inout b, size(w, asset))
    for m in 0..n {
        for x in to_list(w[month: m]) { put_f64(inout b, x) }
    }
    substr(sha256_hex(b), 0, 12)
}

// ------------------------------------------------------------------ the registry
import "trials.krs"

// A float as Rust's `{}` writes it: the shortest digits, never an exponent, no ".0" on whole
// numbers (25.0 is "25", 1e21 is 1 and 21 zeros).
fn fmt_display(x: f64) -> str {
    let s = str(x)
    if is_nan(x) or abs(x) == inf { return s }
    let e = find(s, "e")
    if e < 0 { return if ends_with(s, ".0") { substr(s, 0, len(s) - 2) } else { s } }
    let neg = starts_with(s, "-")
    let from = if neg { 1 } else { 0 }
    let mant = substr(s, from, e - from)
    let k = parse_int(substr(s, e + 1, len(s) - e - 1))
    let dot = find(mant, ".")
    let digits = if dot < 0 { mant } else { substr(mant, 0, dot) + substr(mant, dot + 1, len(mant) - dot - 1) }
    let int_len = (if dot < 0 { len(mant) } else { dot }) + k
    var out = ""
    if int_len <= 0 {
        out = "0."
        for i in 0..-int_len { out = out + "0" }
        out = out + digits
    } else if int_len >= len(digits) {
        out = digits
        for i in 0..int_len - len(digits) { out = out + "0" }
    } else {
        out = substr(digits, 0, int_len) + "." + substr(digits, int_len, len(digits) - int_len)
    }
    (if neg { "-" } else { "" }) + out
}

// Records the evaluation of the weights named `wsha` as a trial of the registry in `results`
// (the same strategy is one trial, however it is run: the same weights, already recorded or
// seen in this run, or the same statistics); without `trial`, it is only deflated against the
// registry. (trials in the registry, the DSR)
fn record_evaluation(results: str, t: Trial, wsha: str, inout seen: List[str], trial: bool) -> (i64, f64) {
    let path = results + "/registro_testes.csv"
    var all = load(path)
    if not trial {
        if len(all) == 0 { return (1, deflate(t, [t]).1) }
        return (len(all), deflate(t, all).1)
    }
    let counted = contains(seen, wsha)
    if not counted { seen.push(wsha) }
    let tag = "pesos " + wsha + ";"
    var same = counted
    for x in all {
        if (x.study == "kairos" and starts_with(x.params, tag)) or (x.n == t.n and abs(x.sr_m - t.sr_m) <= 0.000001 and abs(x.skew - t.skew) <= 0.0001 and abs(x.kurt - t.kurt) <= 0.0001) { same = true }
    }
    if not same {
        make_dir(results)
        all = upsert(path, t)
    }
    (max(len(all), 1), deflate(t, all).1)
}

// The trial of an evaluation (as the bridge's sim_record names it): the program, the weights, the
// costs, the delay, the capital, the tax, and the period simulated.
fn evaluation_trial(d: LabData, cdi_m: List[f64], run: SimRun, wsha: str, cfg: SimCfg, program: str) -> Trial {
    var excess: List[f64] = []
    for k in 0..len(run.ret) { excess.push(run.ret[k] - cdi_m[run.mi[k]]) }
    let period = fmt_ym(d.cal.months[run.mi[0]]) + ".." + fmt_ym(d.cal.months[run.mi[len(run.mi) - 1]])
    let costs = if cfg.real_costs { "custo real" } else { "custo " + fmt_display(cfg.cost_bps) + " bps" }
    let params = "pesos " + wsha + "; " + costs + "; lag " + str(cfg.lag) + "; capital " + fmt_display(cfg.capital) + "; " + (if cfg.tax { "com IR" } else { "sem IR" })
    new_trial("kairos", program, params, period, excess)
}
