// Macro data in Kairós (quant-b3 `fetch-macro`): the whole CDI, the IPCA and NEFIN's factors.
//
//   kairos run kairos/lab/fetch_macro.krs [data/raw]
import "macro.krs"

let root = if len(args()) > 0 { args()[0] } else { "data/raw" }
make_dir(root + "/bcb")
make_dir(root + "/nefin")
fetch_cdi(root + "/bcb", 1995)
fetch_ipca(root + "/bcb")
fetch_nefin(root + "/nefin")
