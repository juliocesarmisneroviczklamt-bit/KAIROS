// The lab's statistics: Kairós's standard library (std/stats.krs) under the lab's names.
import "std/stats.krs"

fn avg(x: List[f64]) -> f64 {
    stat_mean(x)
}

// Sample standard deviation (n - 1).
fn sd(x: List[f64]) -> f64 {
    stat_sd(x)
}

fn corr(x: List[f64], y: List[f64]) -> f64 {
    stat_corr(x, y)
}

// The pairs where both are finite.
fn corr_finite(x: List[f64], y: List[f64]) -> (f64, i64) {
    stat_corr_finite(x, y)
}

// Compound annual growth; `ppy`: periods per year.
fn cagr(x: List[f64], ppy: f64) -> f64 {
    stat_cagr(x, ppy)
}

fn max_dd(x: List[f64]) -> f64 {
    stat_max_dd(x)
}

// (annual mean, annual volatility, Newey-West t of the mean, Sharpe) of monthly returns.
fn annual(x: List[f64]) -> (f64, f64, f64, f64) {
    stat_annual(x)
}
