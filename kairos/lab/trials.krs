// The registry of trials (quant-b3 `registro`), written in Kairós: every strategy ever
// evaluated is in results/registro_testes.csv, and each Sharpe is discounted by the number of
// trials (the Deflated Sharpe Ratio, Bailey & López de Prado 2014): the best of N trials must beat
// what the best of N would give by pure chance. lab/registry.krs writes the report; the bridge
// written in Kairós (lab/bridge.krs) records evaluations here.
import "stats.krs"

struct Trial {
    study: str,
    name: str,
    params: str,
    period: str,
    n: i64,
    sr_m: f64,      // monthly Sharpe (mean / sd of the excess returns)
    skew: f64,
    kurt: f64,      // kurtosis (3 = normal)
}

fn finite(x: f64) -> bool {
    not is_nan(x - x)
}

// The trials of the file (none if it is not there); lines that do not parse are skipped.
fn load(path: str) -> List[Trial] {
    var out = []
    if not file_exists(path) { return out }
    let ls = lines(read_text(path))
    for k in 1..len(ls) {
        let f = split(ls[k], ",")
        if len(f) < 8 { continue }
        let n = parse_float(f[4])
        if is_nan(n) or n < 0.0 or n != floor(n) { continue }
        out.push(Trial { study: f[0], name: f[1], params: f[2], period: f[3], n: int(n), sr_m: parse_float(f[5]), skew: parse_float(f[6]), kurt: parse_float(f[7]) })
    }
    out
}

fn erfc(x: f64) -> f64 {
    let z = abs(x)
    let t = 1.0 / (1.0 + 0.5 * z)
    let r = t * exp(-z * z - 1.26551223 + t * (1.00002368 + t * (0.37409196 + t * (0.09678418 + t * (-0.18628806 + t * (0.27886807 + t * (-1.13520398 + t * (1.48851587 + t * (-0.82215223 + t * 0.17087277)))))))))
    if x >= 0.0 { r } else { 2.0 - r }
}

fn norm_cdf(x: f64) -> f64 {
    0.5 * erfc(-x / 1.4142135623730951)
}

// The inverse of the standard normal (Acklam's algorithm).
fn norm_inv(p: f64) -> f64 {
    let a = [-39.69683028665376, 220.9460984245205, -275.9285104469687, 138.357751867269, -30.66479806614716, 2.506628277459239]
    let b = [-54.47609879822406, 161.5858368580409, -155.6989798598866, 66.80131188771972, -13.28068155288572]
    let c = [-0.007784894002430293, -0.3223964580411365, -2.400758277161838, -2.549732539343734, 4.374664141464968, 2.938163982698783]
    let d = [0.007784695709041462, 0.3224671290700398, 2.445134137142996, 3.754408661907416]
    if p <= 0.0 { return -1.0 / 0.0 }
    if p >= 1.0 { return 1.0 / 0.0 }
    let pl = 0.02425
    if p < pl {
        let q = sqrt(-2.0 * ln(p))
        return (((((c[0] * q + c[1]) * q + c[2]) * q + c[3]) * q + c[4]) * q + c[5]) / ((((d[0] * q + d[1]) * q + d[2]) * q + d[3]) * q + 1.0)
    }
    if p <= 1.0 - pl {
        let q = p - 0.5
        let r = q * q
        return (((((a[0] * r + a[1]) * r + a[2]) * r + a[3]) * r + a[4]) * r + a[5]) * q / (((((b[0] * r + b[1]) * r + b[2]) * r + b[3]) * r + b[4]) * r + 1.0)
    }
    let q = sqrt(-2.0 * ln(1.0 - p))
    -(((((c[0] * q + c[1]) * q + c[2]) * q + c[3]) * q + c[4]) * q + c[5]) / ((((d[0] * q + d[1]) * q + d[2]) * q + d[3]) * q + 1.0)
}

// The Sharpe the best of `n` trials gives with no skill at all (`v2`: variance across trials).
fn expected_max_sr(n: i64, v2: f64) -> f64 {
    if n <= 1 { return 0.0 }
    let g = 0.5772156649
    let nf = float(n)
    sqrt(v2) * ((1.0 - g) * norm_inv(1.0 - 1.0 / nf) + g * norm_inv(1.0 - 1.0 / (nf * 2.718281828459045)))
}

// (the Sharpe chance gives the best of the registry, a year; the DSR of `t`)
fn deflate(t: Trial, all: List[Trial]) -> (f64, f64) {
    let n = max(len(all), 1)
    var srs = []
    for x in all {
        if finite(x.sr_m) { srs.push(x.sr_m) }
    }
    let s = sd(srs)
    let v2 = if len(srs) >= 3 { s * s } else { 1.0 / float(max(t.n, 2)) }
    let sr0 = expected_max_sr(n, v2)
    // as Rust's f64::max: a NaN gives the other side
    let d = 1.0 - t.skew * t.sr_m + (t.kurt - 1.0) / 4.0 * t.sr_m * t.sr_m
    let denom = sqrt(if is_nan(d) or d < 0.000000001 { 0.000000001 } else { d })
    let z = (t.sr_m - sr0) * sqrt(max(float(t.n) - 1.0, 1.0)) / denom
    (sr0 * sqrt(12.0), norm_cdf(z))
}

// ------------------------------------------------------------------ recording

// The monthly Sharpe, skewness and kurtosis of excess returns (quant-b3 registry::moments; powi
// is a product, and Rust's sum starts at -0.0).
fn moments(x: List[f64]) -> (f64, f64, f64) {
    let n = len(x)
    var s0 = -0.0
    for v in x { s0 = s0 + v }
    let m = if n == 0 { nan } else { s0 / float(n) }
    var sq = -0.0
    for v in x { sq = sq + (v - m) * (v - m) }
    let s = if n < 2 { nan } else { sqrt(sq / float(n - 1)) }
    var s3 = -0.0
    var s4 = -0.0
    for v in x {
        let z = (v - m) / s
        let z2 = z * z
        s3 = s3 + z2 * z
        s4 = s4 + z2 * z2
    }
    (m / s, s3 / float(n), s4 / float(n))
}

fn new_trial(study: str, name: str, params: str, period: str, excess: List[f64]) -> Trial {
    let mo = moments(excess)
    Trial { study: study, name: name, params: params, period: period, n: len(excess), sr_m: mo.0, skew: mo.1, kurt: mo.2 }
}

// a field of the CSV: commas and line breaks become ;
fn esc(s: str) -> str {
    replace(replace(s, ",", ";"), from_codes([10]), ";")
}

fn trial_key(t: Trial) -> str {
    t.study + "|" + t.name + "|" + t.params + "|" + t.period
}

// Writes (or replaces: the same study, name, params and period) the trial; the whole registry.
fn upsert(path: str, t: Trial) -> List[Trial] {
    var all: List[Trial] = []
    for x in load(path) {
        if trial_key(x) != trial_key(t) { all.push(x) }
    }
    all.push(t)
    let nl = from_codes([10])
    var s = "estudo,nome,params,periodo,n_meses,sharpe_mensal,assimetria,curtose" + nl
    for x in all { s = s + esc(x.study) + "," + esc(x.name) + "," + esc(x.params) + "," + esc(x.period) + "," + str(x.n) + "," + format_fixed(x.sr_m, 6) + "," + format_fixed(x.skew, 4) + "," + format_fixed(x.kurt, 4) + nl }
    write_text(path, s)
    all
}
