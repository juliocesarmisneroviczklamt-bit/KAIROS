// The daily tensors of b3 compiled to WebAssembly (M14): [month, session, asset], one at a time
var t = b3.daily_returns()
print("returns", size(t, month), size(t, session), size(t, asset), nan_sum(t), nan_count(t))
t = b3.daily_volume()
print("volume", nan_sum(t), nan_count(t))
t = b3.daily_price()
print("price", nan_sum(t), nan_count(t))
t = b3.daily_dividends()
print("dividends", nan_sum(t), nan_count(t))
let s = b3.sessions()
let d = b3.session_dates()
print("sessions", count(s), "dates", nan_sum(d), nan_count(d))
let w = b3.nefin_daily("wml")
let rf = b3.nefin_daily("rf", vw: true)
print("nefin daily", nan_sum(w), nan_count(w), nan_sum(rf), nan_count(rf))
let i = b3.ipca()
print("ipca", nan_sum(i), nan_count(i))
