// rt_tanh, rt_sigmoid and rt_softplus (the runtime, in Kairós) against the interpreter's (libm),
// bit for bit: kairos run act.krs <how many>
import "../../compiler/rt.krs"

fn same(a: f64, b: f64) -> bool {
    if is_nan(a) or is_nan(b) { return is_nan(a) and is_nan(b) }
    to_bits(a) == to_bits(b)
}
var bad = 0
var n = 0
fn check(x: f64) -> i64 {
    var b = 0
    if not same(rt_tanh(x), tanh(x)) {
        b += 1
        print("DIFF tanh", x, rt_tanh(x), tanh(x))
    }
    if not same(rt_sigmoid(x), sigmoid(x)) {
        b += 1
        print("DIFF sigmoid", x, rt_sigmoid(x), sigmoid(x))
    }
    if not same(rt_softplus(x), softplus(x)) {
        b += 1
        print("DIFF softplus", x, rt_softplus(x), softplus(x))
    }
    b
}
for x in [0.0, -0.0, 1.0, -1.0, 0.5493, 0.2554, 0.1, 20.0, 20.5, -20.5, 1e-300, 5e-324, 2.2250738585072014e-308, nan, inf, -inf,
    30.0, 30.5, -30.0, 40.0, 709.0, 710.0, -745.0, -746.0, 38.0, 37.5, -37.5, 1e-17, 3e-9, 0.34657359027997264, 1.0397207708399179] {
    n += 3
    bad += check(x)
}
var s = 88172645463325252
for i in 0..parse_int(args()[0]) {
    s = bit_xor(s, shr(s, 12))
    s = bit_xor(s, shl(s, 25))
    s = bit_xor(s, shr(s, 27))
    let a = wrapping_mul(s, 2685821657736338717)
    for x in [from_bits(a), float(bit_and(a, 1048575) - 524288) / 10000.0, float(bit_and(a, 1048575) - 524288) * 1e-9,
        float(bit_and(shr(a, 20), 1048575) - 524288) / 1000.0] {
        n += 3
        let b = check(x)
        bad += b
        if bad > 30 { break }
    }
}
print(n, "values,", bad, "different")
