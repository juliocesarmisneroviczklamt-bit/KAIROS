// rt_fmod (the runtime, in Kairós) against Rust's `%` on floats: kairos run fmod.krs <how many>
import "../../compiler/rt.krs"

var bad = 0
var n = 0
fn same(a: f64, b: f64) -> bool {
    if is_nan(a) or is_nan(b) { return is_nan(a) and is_nan(b) }
    to_bits(a) == to_bits(b)
}
let special = [0.0, -0.0, 1.0, -1.0, 0.5, 3.0, -7.5, 1e300, -1e300, 5e-324, -5e-324, 2.2250738585072014e-308,
    1e-310, 1.7976931348623157e308, nan, inf, -inf, 0.1, 10.0, 360.0, 6.283185307179586, 1e16, 3.5e-320]
for x in special {
    for y in special {
        n += 1
        if not same(rt_fmod(x, y), x % y) {
            bad += 1
            print("DIFF", x, y, rt_fmod(x, y), x % y)
        }
    }
}
var s = 88172645463325252
fn next(v: i64) -> i64 {
    var t = bit_xor(v, shr(v, 12))
    t = bit_xor(t, shl(t, 25))
    bit_xor(t, shr(t, 27))
}
for i in 0..parse_int(args()[0]) {
    s = next(s)
    let a = wrapping_mul(s, 2685821657736338717)
    s = next(s)
    let b = wrapping_mul(s, 2685821657736338717)
    // any bits, and nearby exponents (where the loop runs)
    let x = from_bits(a)
    let y = from_bits(b)
    let y2 = from_bits(bit_or(bit_and(b, 4503599627370495 + shl(1, 63)), bit_and(a, shl(2047, 52))))
    for p in [(x, y), (x, y2), (float(bit_and(a, 1048575)) / 7.0, float(bit_and(b, 1023) + 1) / 3.0)] {
        n += 1
        if not same(rt_fmod(p.0, p.1), p.0 % p.1) {
            bad += 1
            if bad < 20 { print("DIFF", p.0, p.1, rt_fmod(p.0, p.1), p.0 % p.1) }
        }
    }
}
print(n, "pairs,", bad, "different")
