// rt_parse_float (the runtime, in Kairós) against parse_float (Rust's parse::<f64>), bit for bit:
// kairos run decimal.krs <how many>
import "../../compiler/rt.krs"

fn same(a: f64, b: f64) -> bool {
    if is_nan(a) or is_nan(b) { return is_nan(a) and is_nan(b) }
    to_bits(a) == to_bits(b)
}
var bad = 0
var n = 0
fn check(s: str) -> i64 {
    if same(rt_parse_float(s), parse_float(s)) { return 0 }
    print("DIFF", "[" + s + "]", rt_parse_float(s), parse_float(s))
    1
}
let special = ["0", "-0", "1", "1.5", ".5", "5.", ".", "", "+", "-", "e5", "1e", "1e+", "1e-5", "1E5", "+1.25e+2", "  3.5  ",
    "inf", "-inf", "Infinity", "-INFINITY", "nan", "NaN", "-nan", "infinit", "nanx", "0.1", "0.2", "0.3", "1e23", "1e22", "1e-22",
    "9007199254740993", "9007199254740992", "9007199254740995", "2.2250738585072011e-308", "2.2250738585072014e-308",
    "4.9406564584124654e-324", "2.4703282292062327e-324", "2.4703282292062328e-324", "1.7976931348623157e308",
    "1.7976931348623158e308", "1.7976931348623159e308", "1e309", "1e-400", "123456789012345678901234567890", "0.000000000000000000000000000001",
    "1_000", "0x10", "1e5.5", "12a", "1.2.3", "00012.50", "-0.0e-5", "7e-10", "3.14159265358979323846264338327950288",
    "5e-324", "1e-323", "8.98846567431158e307", "4.4501477170144023e-308", "2.225073858507201136057409796709131975934819546351645648e-308"]
for s in special {
    n += 1
    bad += check(s)
}
var r = 88172645463325252
fn next(v: i64) -> i64 {
    var t = bit_xor(v, shr(v, 12))
    t = bit_xor(t, shl(t, 25))
    bit_xor(t, shr(t, 27))
}
for k in 0..parse_int(args()[0]) {
    r = next(r)
    let a = wrapping_mul(r, 2685821657736338717)
    // the text of a random float (shortest digits), and random digits with random exponents
    let x = from_bits(a)
    n += 1
    bad += check(str(x))
    let nd = 1 + bit_and(shr(a, 3), 31)
    var ds = ""
    var v = a
    for j in 0..nd {
        v = next(v)
        ds = ds + str(bit_and(shr(v, 7), 7) + bit_and(shr(v, 11), 3))
    }
    let ex = bit_and(shr(a, 40), 1023) - 512
    n += 1
    bad += check(ds + "e" + str(ex))
    n += 1
    bad += check("0." + ds + "e" + str(bit_and(shr(a, 20), 63) - 32))
    if bad > 20 { break }
}
// halfway cases: the midpoint between two floats, in decimal (exactly)
var y = 1.0
for k in 0..2000 {
    r = next(r)
    let b = bit_and(wrapping_mul(r, 2685821657736338717), 9218868437227405311)
    let lo = from_bits(b)
    let hi = from_bits(b + 1)
    if not is_nan(lo) and not is_nan(hi) and abs(hi) < 1e300 {
        n += 1
        bad += check(str((lo + hi) / 2.0))
    }
}
print(n, "texts,", bad, "different")

// exact midpoints: between m × 2^e and (m + 1) × 2^e lies (2m + 1) × 2^(e - 1), whose decimal
// expansion is finite; the nearest float to it is the one with the even mantissa
fn big_dec(a0: List[i64]) -> str {
    var a = rt_big_trim(a0)
    var out: List[i64] = []
    while len(a) > 0 {
        // a / 10, from the top limb down
        var q: List[i64] = []
        var rem = 0
        var i = len(a) - 1
        while i >= 0 {
            let cur = rem * 1073741824 + a[i]
            q.push(cur / 10)
            rem = cur % 10
            i -= 1
        }
        out.push(rem)
        var qq: List[i64] = []
        var j = len(q) - 1
        while j >= 0 {
            qq.push(q[j])
            j -= 1
        }
        a = rt_big_trim(qq)
    }
    if len(out) == 0 { return "0" }
    var s = ""
    var k = len(out) - 1
    while k >= 0 {
        s = s + str(out[k])
        k -= 1
    }
    s
}
var nm = 0
for k in 0..parse_int(args()[0]) / 10 {
    r = next(r)
    let a = wrapping_mul(r, 2685821657736338717)
    let m = bit_or(bit_and(a, 4503599627370495), 4503599627370496)
    // binary exponents from -1100 to 1000 (beyond -1074 the midpoints are among subnormals)
    let e = bit_and(shr(a, 52), 2047) - 1100
    var big = rt_big_mul_add([], 1, 2 * m + 1)
    var text = ""
    if e - 1 >= 0 {
        for j in 0..e - 1 { big = rt_big_mul_add(big, 2, 0) }
        text = big_dec(big)
    } else {
        for j in 0..1 - e { big = rt_big_mul_add(big, 5, 0) }
        text = big_dec(big) + "e-" + str(1 - e)
    }
    nm += 1
    bad += check(text)
}
print(nm, "exact midpoints (and the texts above),", bad, "different")
