// Tuples and structs in WebAssembly: values, not references. A copy that changes leaves the
// original as it was (the object is copied when shared); the text of a value is the
// interpreter's.
struct Point {
    x: i64,
    y: i64,
}

struct Trade {
    ticker: str,
    at: Point,
    price: f64,
    open: bool,
}

fn moved(p: Point, dx: i64) -> Point {
    var q = p
    q.x += dx
    q
}

fn norm1(p: Point) -> i64 {
    abs(p.x) + abs(p.y)
}

fn split_name(s: str) -> (str, str) {
    (substr(s, 0, 4), substr(s, 4, len(s) - 4))
}

fn classify(t: (i64, str)) -> str {
    match t {
        (0, _) => "zero",
        (1, "one") => "one, named",
        (n, name) => name + " is " + str(n),
    }
}

let a = Point { x: 3, y: -4 }
let b = moved(a, 10)
print(a, b, norm1(b))
var t = Trade { ticker: "PETR4", at: a, price: 37.5, open: true }
let saved = t
t.at.y = 100
t.ticker = t.ticker + "F"
t.price *= 2.0
print(saved)
print(t)
print(t.at.y, saved.at.y, t == saved, saved == Trade { ticker: "PETR4", at: Point { x: 3, y: -4 }, price: 37.5, open: true })
let (left, right) = split_name("VALE3")
print(left, right, (left, right), ("solo",), (1, 2.5, true, "q\"uote\n"))
print(classify((0, "x")), classify((1, "one")), classify((7, "seven")))
// many values made and dropped: the memory of the old ones is reused
var total = 0
for i in 0..20000 {
    let p = Point { x: i, y: 2 * i }
    let q = moved(p, 1)
    let s = str(q.x) + "," + str(q.y)
    total += len(s) + q.x - p.x
}
print(total)
var pts = (Point { x: 1, y: 1 }, Point { x: 2, y: 2 })
let first = pts.0
pts.0.x = 50
print(first, pts, str(pts) == "(Point { x: 50, y: 1 }, Point { x: 2, y: 2 })")

// the output, line by line:
// out: Point { x: 3, y: -4 } Point { x: 13, y: -4 } 17
// out: Trade { ticker: "PETR4", at: Point { x: 3, y: -4 }, price: 37.5, open: true }
// out: Trade { ticker: "PETR4F", at: Point { x: 3, y: 100 }, price: 75.0, open: true }
// out: 100 -4 false true
// out: VALE 3 ("VALE", "3") ("solo",) (1, 2.5, true, "q\"uote\n")
// out: zero one, named seven is 7
// out: 223339
// out: Point { x: 1, y: 1 } (Point { x: 50, y: 1 }, Point { x: 2, y: 2 }) true
