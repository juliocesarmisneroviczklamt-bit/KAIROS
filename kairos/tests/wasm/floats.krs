// out: NaN inf -inf false true
// out: inf -inf NaN
// out: 1.5 -1.5 1.5 5.0 1.0
// out: -3.0 -2.0 -3.0 3.0 0.0
// out: -0.0 3.25 1.4142135623730951 NaN
// out: NaN 0.0 3.0 2.0
// out: true false 7.0 2.5
// out: 2 -2 7.0 -9007199254740992.0
// out: 4607182418800017408 2.0 -9223372036854775808
