// format_fixed: the exact value of the float, rounded half to even (Rust's `{:.d}`); lines; today
print(format_fixed(0.125, 2), format_fixed(2.5, 0), format_fixed(0.5, 0), format_fixed(1.5, 0), format_fixed(0.375, 2))
print(format_fixed(-0.0, 2), format_fixed(-0.004, 2), format_fixed(1e21, 1), format_fixed(5e-324, 3), format_fixed(0.0, 0))
print(format_fixed(0.1, 30), format_fixed(123.456, 1), format_fixed(nan, 2), format_fixed(-inf, 1), format_fixed(inf, 0))
print(format_fixed(0.063921, 6), format_fixed(-0.80176, 4), format_fixed(9.9999, 3), format_fixed(99.95, 1), format_fixed(1.0, -3))
print(format_fixed(1.7976931348623157e308, 0) == "")
print(format_fixed(2.2250738585072014e-308, 30), format_fixed(0.3, 17), format_fixed(1234.5, 0), format_fixed(1235.5, 0))
print(len(lines("a\nb\r\n\nc")), lines("x\r\ny\n"), len(lines("")), lines("one"), lines("z\r"))
let d = today()
print(d > 20260000 and d < 30000000, d % 100 >= 1 and d % 100 <= 31)
