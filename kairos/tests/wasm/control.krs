// Control flow in the WebAssembly back end.
var s = 0
for i in 0..10 {
    if i % 2 == 0 { continue }
    if i > 7 { break }
    s += i
}
print(s)                                // out: 16
var n = 0
while true {
    n += 1
    if n == 5 { break }
}
print(n)                                // out: 5

fn kind(x: i64) -> i64 {
    match x { 0 => 100, 1 => 200, _ => 300 }
}

print(kind(0), kind(1), kind(7))        // out: 100 200 300
let b = 3 < 4 and not (2 > 5)
print(b, true or false, 1 == 1, b != b) // out: true true true false
for k in 1..=3 { print("k =", k) }      // out: k = 1
// out: k = 2
// out: k = 3
print(match b { true => 1, false => 0 }) // out: 1
let t = if s > 10 { s * 2 } else { 0 }
print(t, { let a = 2
 a * a })                               // out: 32 4
print(())                               // out: ()
