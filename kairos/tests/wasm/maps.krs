// Maps in WebAssembly: keys in the order they came, values as values (a copy changes alone),
// the interpreter's text and equality (the same keys and values, in any order).
struct Pos {
    qty: i64,
    cost: f64,
}

fn count_words(words: List[str]) -> Map[str, i64] {
    var m: Map[str, i64] = [:]
    for w in words {
        if contains(m, w) { m[w] += 1 } else { m[w] = 1 }
    }
    m
}

fn buy(inout book: Map[str, Pos], t: str, q: i64, p: f64) {
    if not contains(book, t) { book[t] = Pos { qty: 0, cost: 0.0 } }
    book[t].cost += float(q) * p
    book[t].qty += q
}

let m = count_words(split("b a c a b a", " "))
print(m, len(m), m["a"], keys(m), values(m), items(m))
var squares = [1: 1, 2: 4, 3: 9, 2: 40]
let saved = squares
squares[4] = 16
squares[1] = -1
remove(inout squares, 3)
remove(inout squares, 99)
print(squares, saved, get(squares, 3, 0), get(saved, 3, 0), contains(squares, 4))
var book: Map[str, Pos] = [:]
buy(inout book, "PETR4", 100, 37.5)
buy(inout book, "VALE3", 10, 60.0)
buy(inout book, "PETR4", 50, 40.0)
print(book)
let empty: Map[i64, str] = [:]
print(empty, len(empty), [1: "um"] == [1: "um"], ["a": 1, "b": 2] == ["b": 2, "a": 1], ["a": 1] != ["a": 2])
var big: Map[i64, i64] = [:]
for i in 0..1000 { big[i * 7 % 1009] = i }
var s = 0
for i in 0..1009 { s += get(big, i, 0) }
for i in 0..200 { remove(inout big, i * 7 % 1009) }
print(s, len(big), keys(big)[0], big[200 * 7 % 1009])
var nested = ["x": [1, 2], "y": []]
let before = nested
nested["y"].push(3)
nested["x"][0] = 10
print(nested, before)

// the output, line by line:
// out: ["b": 2, "a": 3, "c": 1] 3 3 ["b", "a", "c"] [2, 3, 1] [("b", 2), ("a", 3), ("c", 1)]
// out: [1: -1, 2: 40, 4: 16] [1: 1, 2: 40, 3: 9] 0 9 true
// out: ["PETR4": Pos { qty: 150, cost: 5750.0 }, "VALE3": Pos { qty: 10, cost: 600.0 }]
// out: [:] 0 true true true
// out: 499500 800 391 200
// out: ["x": [10, 2], "y": [3]] ["x": [1, 2], "y": []]
