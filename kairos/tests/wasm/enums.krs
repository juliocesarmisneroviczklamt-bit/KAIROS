// Enums in WebAssembly: variants with and without fields, patterns that look inside them,
// recursive types, their text and equality as the interpreter's.
enum Shape {
    Circle(f64),
    Rect(f64, f64),
    Dot,
}

enum Expr {
    Num(i64),
    Add(Expr, Expr),
    Mul(Expr, Expr),
    Neg(Expr),
    Var(str),
}

enum Side {
    Buy,
    Sell,
}

fn area(s: Shape) -> f64 {
    match s {
        Circle(r) => 3.0 * r * r,
        Rect(w, h) => w * h,
        Dot => 0.0,
    }
}

fn eval(e: Expr, x: i64) -> i64 {
    match e {
        Num(n) => n,
        Add(a, b) => eval(a, x) + eval(b, x),
        Mul(a, b) => eval(a, x) * eval(b, x),
        Neg(a) => -eval(a, x),
        Var(_) => x,
    }
}

fn simplify(e: Expr) -> Expr {
    match e {
        Add(Num(0), b) => simplify(b),
        Mul(Num(1), b) => simplify(b),
        Add(a, b) => Expr.Add(simplify(a), simplify(b)),
        Mul(a, b) => Expr.Mul(simplify(a), simplify(b)),
        _ => e,
    }
}

fn sign(s: Side) -> i64 {
    match s {
        Buy => 1,
        Sell => -1,
    }
}

let shapes = [Shape.Circle(1.5), Shape.Rect(2.0, 3.0), Shape.Dot]
var total = 0.0
for s in shapes { total += area(s) }
print(shapes, total)
let e = Expr.Add(Expr.Num(0), Expr.Mul(Expr.Num(1), Expr.Add(Expr.Var("x"), Expr.Neg(Expr.Num(4)))))
print(eval(e, 10), simplify(e))
print(e == e, simplify(e) == e, Shape.Dot == Shape.Dot, Shape.Circle(1.0) != Shape.Circle(2.0))
print(sign(Side.Buy) + sign(Side.Sell), [Side.Buy, Side.Sell], (Side.Sell, 3))
var deep = Expr.Num(0)
for i in 0..2000 { deep = Expr.Add(deep, Expr.Num(i)) }
print(eval(deep, 0))

// the output, line by line:
// out: [Circle(1.5), Rect(2.0, 3.0), Dot] 12.75
// out: 6 Add(Var("x"), Neg(Num(4)))
// out: true false true true
// out: 0 [Buy, Sell] (Sell, 3)
// out: 1999000
