// merge_days and contract
print(minimum([3, 1, 2, 1]), maximum([3, 1, 2, 3]), minimum([2.5, -0.0, 0.0]), maximum([nan, 1.0, 2.0]), minimum([1.0, nan, 0.5]))
write_text("tests/wasm/tmp/appended.txt", "a")
append_text("tests/wasm/tmp/appended.txt", "b")
append_text("tests/wasm/tmp/appended.txt", "c")
print(read_text("tests/wasm/tmp/appended.txt"))
print(list_dir("tests/wasm/listing"))
print(file_date("tests/wasm/fixed.krs") > 20200101, file_date("no such file"))
let t = tensor([3.0, nan, 1.0, 2.0, 5.0], asset)
print(nan_quantile(t, 0.5), nan_quantile(t, 0.0), nan_quantile(t, 1.0), nan_quantile(t, nan))
var m = zeros(month: 2, asset: 3)
m[month: 0] = tensor([1.0, 2.0, 3.0], asset)
m[month: 1] = tensor([4.0, nan, 6.0], asset)
print(nan_quantile(m, 0.5, over: asset), nan_quantile(m, 0.25, over: month))
let w = tensor([0.5, 0.25, 0.25], asset)
print(contract(m, w, over: asset), contract(w, w, over: asset))
var d = zeros(month: 2, session: 3, asset: 2)
for i in 0..2 {
    for j in 0..3 { d[month: i, session: j] = tensor([float(10 * i + j), float(100 + 10 * i + j)], asset) }
}
let md = merge_days(d)
print(size(md, day), size(md, asset), to_list(md[asset: 0]), to_list(md[asset: 1]))
