// randn: the samples the interpreter draws (xoshiro256**, Box-Muller with libm's sin and cos)
let a = randn(seed: 7, asset: 5)
print(a)
let b = randn(seed: -1, month: 3, asset: 2)
print(to_list(b[month: 0]), to_list(b[month: 2]))
print(nan_sum(randn(seed: 42, month: 100, asset: 33)))
