// Structs, enums with data, exhaustive match, tuples, destructuring.
struct Point { x: f64, y: f64 }

enum Shape { Circle(f64), Rect(f64, f64), Empty }

fn area(s: Shape) -> f64 {
    match s {
        Circle(r) => 3.0 * r * r,
        Rect(w, h) => w * h,
        Empty => 0.0,
    }
}

fn describe(n: i64) -> str {
    match n {
        0 => "zero",
        1 => "one",
        _ => "many",
    }
}

fn shift(inout p: Point, dx: f64) {
    p.x += dx
}

var p = Point { x: 1.0, y: 2.0 }
let q = p
p.x = 10.0
print(p.x, q.x)                                     // out: 10.0 1.0
print(p)                                            // out: Point { x: 10.0, y: 2.0 }
p.shift(0.5)
print(p.x)                                          // out: 10.5
print(area(Shape.Rect(2.0, 3.0)))                   // out: 6.0
print(area(Shape.Empty), area(Shape.Circle(1.0)))   // out: 0.0 3.0
let shapes = [Shape.Circle(2.0), Shape.Empty]
print(shapes)                                       // out: [Circle(2.0), Empty]
let t = (1, "a", true)
print(t.0, t.1, t.2)                                // out: 1 a true
let (a, b) = (5, 6)
print(a + b, describe(1), describe(7))              // out: 11 one many
var total = 0.0
for s in shapes { total += area(s) }
print(total)                                        // out: 12.0
