// Core: arithmetic, variables, control flow, functions, recursion, strings.
fn fib(n: i64) -> i64 {
    if n < 2 { n } else { fib(n - 1) + fib(n - 2) }
}

fn classify(x: f64) -> str {
    if x > 0.0 {
        "positive"
    }
    else if x < 0.0 {
        "negative"
    } else {
        "zero"
    }
}

fn first_negative(xs: List[i64]) -> i64 {
    for x in xs {
        if x < 0 { return x }
    }
    0
}

let n = 10
var total = 0
for i in 0..n { total += i }
print(total)                            // out: 45
print(fib(20))                          // out: 6765
let r = 1.5 * 2
print(r)                                // out: 3.0
print(2 ^ 10, 2.0 ^ 3, 2 * r)           // out: 1024 8.0 6.0
var k = 0
while true {
    k += 1
    if k == 3 { break }
}
print("k =", k)                         // out: k = 3
print(10 % 3, -7 / 2, not (1 > 2))      // out: 1 -3 true
print(classify(-2.5), classify(0.0))    // out: negative zero
var s = "Kai"
s += "rós"
print(s, len(s))                        // out: Kairós 6
for i in 1..=3 { print(i * i) }
// out: 1
// out: 4
// out: 9
print(first_negative([3, -4, -5]), first_negative([1]))   // out: -4 0
let big = 3_000_000
print(big / 1_000, float(big) / 7.0 > 428571.0)           // out: 3000 true
