// Nor captured by a function, which could be called any number of times.
protocol "golden-v1" { research: until 201812  holdout: from 201901  rule: "accept if alpha > 0" }
fn weights() -> Tensor[month, asset; f64] {
    zeros_like(b3.monthly_returns())
}
let h = b3.holdout("golden-v1")
let peek = |lag: i64| open_once(h, || weights(), lag: lag)   // error: E0501
print(peek(0).sharpe)
