// M9: maps (`Map[K, V]`), with keys `i64` or `str`, in insertion order.
var px = ["PETR4": 38.5, "VALE3": 61.25]
px["ITUB4"] = 33.0
px["PETR4"] += 1.0
print(px)                                            // out: ["PETR4": 39.5, "VALE3": 61.25, "ITUB4": 33.0]
print(len(px), px["VALE3"], contains(px, "BBAS3"), get(px, "BBAS3", 0.0))   // out: 3 61.25 false 0.0
remove(inout px, "VALE3")
print(px.keys(), px.values())                        // out: ["PETR4", "ITUB4"] [39.5, 33.0]
for (t, p) in items(px) {
    print(t, p)
}
// out: PETR4 39.5
// out: ITUB4 33.0

// counting by key
var count: Map[str, i64] = [:]
for w in split("a b a c b a", " ") {
    count[w] = get(count, w, 0) + 1
}
print(count, [:] == count)                           // out: ["a": 3, "b": 2, "c": 1] false

// integer keys and value semantics: a copy does not change with the original
var by_year: Map[i64, List[str]] = [:]
by_year[2024] = ["x"]
let snapshot = by_year
by_year[2024].push("y")
print(by_year[2024], snapshot[2024])                 // out: ["x", "y"] ["x"]
print(by_year == snapshot, ["a": 1, "b": 2] == ["b": 2, "a": 1])   // out: false true

// a map inside a struct, changed through `inout`
struct Book { pos: Map[str, f64] }
fn buy(inout b: Book, t: str, q: f64) {
    b.pos[t] = get(b.pos, t, 0.0) + q
}
var b = Book { pos: [:] }
b.buy("PETR4", 100.0)
b.buy("PETR4", 50.0)
print(b.pos, len(b.pos))                             // out: ["PETR4": 150.0] 1
