axis feature
axis output
let x = zeros(month: 3, asset: 2)
let y = zeros(asset: 2)
let b = x > 0.0
let a = abs(x)
let s = sqrt(x)
let i = is_nan(x)
let f = fill_nan(x, 0.0)
let w = where(b, x, 0.0)
let w2 = where(b, 1.0, y)
let n = size(x, month)
let zl = zeros_like(x)
let fl = full_like(x, true)
let tl = to_list(y)
let t = tensor([1.0, 2.0], asset)
let tb = tensor([true], month)
let ti = tensor([1, 2], asset)
let rk = rank(x, over: asset)
let tk = top_k(x, 1, over: asset)
let bk = bottom_k(y, 1)
let nq = nan_quantile(x, 0.5, over: month)
let c = contract(x, y, over: asset)
let mx = max(x, y)
let mn = min(x, 0.5)
let cnt = count(b, over: month)
let nm = nan_mean(x, over: month)
let o = ones(feature: 4)
let fu = full(true, output: 2)
let fi = full(1, feature: 2)
